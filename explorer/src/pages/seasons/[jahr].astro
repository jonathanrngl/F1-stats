---
import { datumKurz as datum, ein, zahl } from '../../lib/format.js'
import Seite from '../../layouts/Seite.astro'
import { alle, eine, saisonListe, rennenListe, pfad } from '../../lib/db.js'
import Verlauf from '../../components/Verlauf.astro'
import { db } from '../../lib/db.js'
import { saisonNeuRechnen, systemDesJahres } from '../../engine/whatif.js'

export async function getStaticPaths() {
  return saisonListe().map((s) => ({ params: { jahr: String(s.jahr) } }))
}

const jahr = Number(Astro.params.jahr)

const saison = eine(
  `SELECT s.*,
          (SELECT COUNT(*) FROM race WHERE year = s.year) AS rennen
     FROM season s WHERE s.year = ?`,
  jahr,
)

const fahrerWertung = alle(
  `SELECT sds.position, sds.points, sds.championship_won AS meister,
          d.id, d.display_name AS name, d.abbreviation AS kuerzel,
          (SELECT COUNT(*) FROM race_result rr JOIN race r ON r.id = rr.race_id
            WHERE r.year = ?1 AND rr.driver_id = d.id AND rr.position = 1) AS siege,
          (SELECT GROUP_CONCAT(DISTINCT k.name) FROM race_result rr
             JOIN race r ON r.id = rr.race_id JOIN constructor k ON k.id = rr.constructor_id
            WHERE r.year = ?1 AND rr.driver_id = d.id) AS teams
     FROM season_driver_standing sds
     JOIN driver d ON d.id = sds.driver_id
    WHERE sds.year = ?1
    ORDER BY sds.position`,
  jahr,
)

const teamWertung = alle(
  `SELECT scs.position, scs.points, scs.championship_won AS meister, k.id, k.name
     FROM season_constructor_standing scs
     JOIN constructor k ON k.id = scs.constructor_id
    WHERE scs.year = ? ORDER BY scs.position`,
  jahr,
)

const rennen = rennenListe(jahr).sort((a, b) => a.runde - b.runde)

// Kennzahlen der Saison, direkt aus den Ergebnissen.
const kennzahlen = eine(
  `SELECT COUNT(DISTINCT CASE WHEN rr.position = 1 THEN rr.driver_id END) AS sieger,
          COUNT(DISTINCT CASE WHEN rr.qualifying_position = 1 THEN rr.driver_id END) AS polesetter,
          SUM(CASE WHEN rr.started = 1 THEN 1 ELSE 0 END) AS starts,
          SUM(CASE WHEN rr.started = 1 AND rr.classified = 0 THEN 1 ELSE 0 END) AS ausfaelle
     FROM race_result rr JOIN race r ON r.id = rr.race_id WHERE r.year = ?`,
  jahr,
)

/*
 * Der Verlauf kommt aus den Zwischenständen nach jeder Runde, nicht aus der
 * Summe der Rennpunkte: Bis 1990 verfielen Streichresultate, dort wären beide
 * Kurven verschieden – und nur die Wertung ist die amtliche.
 *
 * Fehlt einem Fahrer eine Runde (Einstieg mitten in der Saison), wird der
 * letzte bekannte Stand fortgeschrieben. Eine Lücke als Null zu zeichnen,
 * ließe die Linie auf die Achse abstürzen.
 */
const staende = alle(
  `SELECT r.round AS runde, rds.driver_id AS id, rds.points AS punkte
     FROM race_driver_standing rds
     JOIN race r ON r.id = rds.race_id
    WHERE r.year = ?
    ORDER BY r.round`,
  jahr,
)

const rundenMitStand = [...new Set(staende.map((s) => s.runde))].sort((a, b) => a - b)
const standProRunde = new Map()
for (const s of staende) {
  if (!standProRunde.has(s.runde)) standProRunde.set(s.runde, new Map())
  standProRunde.get(s.runde).set(s.id, s.punkte)
}

const namen = new Map(fahrerWertung.map((f) => [f.id, f]))
const verlauf = fahrerWertung
  .filter((f) => namen.has(f.id))
  .map((f) => {
    let getragen = 0
    return {
      id: f.id,
      name: f.name,
      kuerzel: f.kuerzel ?? null,
      punkte: rundenMitStand.map((r) => {
        const w = standProRunde.get(r)?.get(f.id)
        if (w !== undefined) getragen = w
        return getragen
      }),
    }
  })

const verlaufRunden = rundenMitStand.map((r) => ({
  runde: r,
  name: rennen.find((x) => x.runde === r)?.name ?? `Round ${r}`,
}))

const entscheidung = rennen.find((r) => r.titelentscheidung)
const meister = fahrerWertung.find((f) => f.meister)
const meisterId = meister?.id ?? null

/*
 * Was wäre nach heutigem Punktesystem herausgekommen?
 *
 * Nur dort gezeigt, wo die Frage eine ist: Für Saisons, die ohnehin nach dem
 * heutigen System gewertet wurden, gäbe es nichts zu vergleichen. Interessant
 * wird es, wo der Titel wechselt – 1988 fuhr Prost mehr Punkte ein als Senna
 * und verlor trotzdem, weil Streichresultate verfielen.
 */
const galtSchonHeute = systemDesJahres(jahr) === 'heute'
const neuGerechnet = galtSchonHeute ? null : saisonNeuRechnen(db(), jahr, 'heute')
const andererMeister =
  neuGerechnet && meisterId && neuGerechnet.tabelle[0] &&
  neuGerechnet.tabelle[0].driverId !== meisterId
const teamMeister = teamWertung.find((t) => t.meister)
---

<Seite
  titel={`Formula 1 season ${jahr} – standings and races`}
  beschreibung={`${saison.rennen} races${meister ? `, World Champion ${meister.name}` : ''}${teamMeister ? `, constructors' title ${teamMeister.name}` : ''}.`}
>
  <h1>Season {jahr}</h1>
  <p class="lead">
    {saison.rennen} races
    {meister && <> · World Champion <a href={pfad.fahrer(meister.id)}>{meister.name}</a></>}
    {teamMeister && <> · Constructors' title <a href={pfad.team(teamMeister.id)}>{teamMeister.name}</a></>}
  </p>

  <ul class="kacheln">
    <li><b>{saison.rennen}</b><span>Races</span></li>
    <li><b>{kennzahlen.sieger}</b><span>Different winners</span></li>
    <li><b>{kennzahlen.polesetter}</b><span>Pole-sitters</span></li>
    <li>
      <b>{kennzahlen.starts ? Math.round((kennzahlen.ausfaelle / kennzahlen.starts) * 100) : 0}%</b>
      <span>Starts not classified</span>
      <i>{kennzahlen.ausfaelle} of {kennzahlen.starts}</i>
    </li>
  </ul>

  {saison.dropped_scores === 1 && (
    <p class="hinweis">
      In this season not every result counted towards the championship: only a driver's best
      races went into the standings, the rest were dropped. The championship standings therefore
      sit below the sum of the points scored in races.
    </p>
  )}

  {entscheidung && (
    <p class="hinweis entschieden">
      The title was decided in round {entscheidung.runde}:{' '}
      <a href={pfad.rennen(entscheidung.id)}>{entscheidung.name}</a>
      {' '}on {datum(entscheidung.datum)}.
    </p>
  )}

  {verlauf.length > 0 && verlaufRunden.length > 1 && (
    <section>
      <h2>Points progression</h2>
      <Verlauf
        fahrer={verlauf}
        runden={verlaufRunden}
        streichresultate={saison.dropped_scores === 1}
      />
    </section>
  )}

  <section>
    <h2>Drivers' standings</h2>
    <div class="tabelle">
      <table>
        <thead>
          <tr><th class="num">#</th><th>Driver</th><th>Team</th><th class="num">Wins</th><th class="num">Points</th></tr>
        </thead>
        <tbody>
          {fahrerWertung.map((f) => (
            <tr>
              <td class={`num${f.meister ? ' meister' : ''}`}>{f.position ?? '–'}</td>
              <td><a class="zeile" href={pfad.fahrer(f.id)}>{f.name}</a></td>
              <td style="color:var(--muted)">{f.teams}</td>
              <td class="num">{f.siege || ''}</td>
              <td class="num">{ein(f.points)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  {teamWertung.length > 0 && (
    <section>
      <h2>Constructors' standings</h2>
      <div class="tabelle">
        <table>
          <thead><tr><th class="num">#</th><th>Team</th><th class="num">Points</th></tr></thead>
          <tbody>
            {teamWertung.map((t) => (
              <tr>
                <td class={`num${t.meister ? ' meister' : ''}`}>{t.position ?? '–'}</td>
                <td><a class="zeile" href={pfad.team(t.id)}>{t.name}</a></td>
                <td class="num">{ein(t.points)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {neuGerechnet && neuGerechnet.tabelle.length > 0 && (
    <section>
      <h2>Under today's points system</h2>
      <p class="lead">
        The same races, the same finishing positions – only scored under today's system
        (25-18-15-12-10-8-6-4-2-1) instead of the one in force at the time. Dropped scores fall
        away with it, because today there are none.
      </p>

      {andererMeister ? (
        <p class="hinweis entschieden">
          The title would have changed hands: <a href={pfad.fahrer(neuGerechnet.tabelle[0].driverId)}>
          {neuGerechnet.tabelle[0].name}</a> instead of {meister?.name}.
        </p>
      ) : (
        <p class="hinweis">The World Champion would be the same.</p>
      )}

      <div class="tabelle">
        <table>
          <thead>
            <tr>
              <th class="num">#</th><th>Driver</th><th class="num">Points today</th>
              <th class="num">Official</th><th class="num">Championship position</th>
            </tr>
          </thead>
          <tbody>
            {neuGerechnet.tabelle.slice(0, 12).map((t) => {
              const amtlich = fahrerWertung.find((f) => f.id === t.driverId)
              const verschoben = amtlich?.position && amtlich.position !== t.platz
              return (
                <tr>
                  <td class={`num${t.platz === 1 ? ' meister' : ''}`}>{t.platz}</td>
                  <td><a class="zeile" href={pfad.fahrer(t.driverId)}>{t.name}</a></td>
                  <td class="num">{ein(t.punkte)}</td>
                  <td class="num" style="color:var(--muted)">{amtlich ? ein(amtlich.points) : '–'}</td>
                  <td class={`num ${verschoben ? 'verschoben' : ''}`} style={verschoben ? '' : 'color:var(--muted)'}>
                    {amtlich?.position ? 'P' + amtlich.position : '–'}
                  </td>
                </tr>
              )
            })}
          </tbody>
        </table>
      </div>

      <p class="fussnote">
        {neuGerechnet.mitGeteiltenFahrten > 0 && (
          <>
            In this season drivers shared a car. The points for a shared position are split,
            just as the era itself split them – {neuGerechnet.mitGeteiltenFahrten}
            {' '}drivers are affected.{' '}
          </>
        )}
        {neuGerechnet.sprintPunkte > 0 && (
          <>Sprint points are left unchanged: a race points system does not apply to them. </>
        )}
        A calculation, not a rewriting of history – drivers would have raced differently if
        different points had been at stake.
      </p>
    </section>
  )}

  <section>
    <h2>Race calendar</h2>
    <div class="tabelle">
      <table>
        <thead><tr><th class="num">Round</th><th>Race</th><th>Circuit</th><th>Date</th><th>Winner</th></tr></thead>
        <tbody>
          {rennen.map((r) => (
            <tr>
              <td class="num">{r.runde}</td>
              <td><a class="zeile" href={pfad.rennen(r.id)}>{r.name}</a></td>
              <td style="color:var(--muted)">{r.strecke}</td>
              <td style="color:var(--muted)">{datum(r.datum)}</td>
              <td>
                {r.siegerId
                  ? <a class="zeile" href={pfad.fahrer(r.siegerId)}>{r.sieger}</a>
                  : <span style="color:var(--muted)">–</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Seite>

<style>
  .kacheln {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(9rem, 100%), 1fr));
    gap: 0.75rem; margin: 1.75rem 0 0; padding: 0; list-style: none;
  }
  .kacheln li {
    display: flex; flex-direction: column; gap: 0.1rem; padding: 0.9rem 1rem;
    background: var(--surface-2); border: 1px solid var(--border); border-radius: 0.6rem;
  }
  .kacheln b {
    font-size: 1.6rem; font-weight: 680; line-height: 1.1; color: var(--ink);
    font-variant-numeric: tabular-nums; letter-spacing: -0.02em;
  }
  .kacheln span { font-size: 0.78rem; color: var(--muted); }
  .kacheln i { font-style: normal; font-size: 0.72rem; color: var(--muted); opacity: 0.8; }
  .hinweis {
    margin: 1.25rem 0 0; padding: 0.85rem 1rem; font-size: 0.87rem;
    background: var(--surface-2); border: 1px solid var(--border);
    border-left: 3px solid var(--axis); border-radius: 0.5rem; max-width: 46rem; text-wrap: pretty;
  }
  .hinweis.entschieden { border-left-color: var(--accent); background: var(--accent-wash); }
  section { margin-top: 2.5rem; }
  h2 { font-size: 1.15rem; margin: 0 0 0.75rem; }
  td.meister { color: var(--accent); font-weight: 700; }
  td.verschoben { color: var(--warn); font-weight: 650; }
  .fussnote { margin: 0.85rem 0 0; font-size: 0.79rem; color: var(--muted); max-width: 46rem; text-wrap: pretty; }
</style>
