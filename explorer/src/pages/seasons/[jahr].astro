---
import { datumKurz as datum, ein, plakette, tagMonat } from '../../lib/format.js'
import Seite from '../../layouts/Seite.astro'
import { alle, saisonListe, pfad } from '../../lib/db.js'
import { saisonDaten } from '../../lib/saison.js'
import Verlauf from '../../components/Verlauf.astro'
import Sprung from '../../components/Sprung.astro'
import WasWaereWenn from '../../components/WasWaereWenn.astro'
import Meisterband from '../../components/Meisterband.astro'
import Turm from '../../components/Turm.astro'
import { meisterbandDaten } from '../../components/meisterband-daten.js'

export async function getStaticPaths() {
  return saisonListe().map((s) => ({ params: { jahr: String(s.jahr) } }))
}

const jahr = Number(Astro.params.jahr)
const d = saisonDaten(jahr)
const { saison, fahrerWertung, teamWertung, kalender: rennen, kennzahlen, zellen, nennungen, punkte } = d

/*
 * Der Verlauf kommt aus den Zwischenständen nach jeder Runde, nicht aus der
 * Summe der Rennpunkte: Bis 1990 verfielen Streichresultate, dort wären beide
 * Kurven verschieden – und nur die Wertung ist die amtliche.
 *
 * Fehlt einem Fahrer eine Runde (Einstieg mitten in der Saison), wird der
 * letzte bekannte Stand fortgeschrieben. Eine Lücke als Null zu zeichnen,
 * ließe die Linie auf die Achse abstürzen.
 */
const staende = alle(
  `SELECT r.round AS runde, rds.driver_id AS id, rds.points AS punkte
     FROM race_driver_standing rds
     JOIN race r ON r.id = rds.race_id
    WHERE r.year = ?
    ORDER BY r.round`,
  jahr,
)

const rundenMitStand = [...new Set(staende.map((s) => s.runde))].sort((a, b) => a - b)
const fortgeschrieben = (liste, eintraege) => {
  const proRunde = new Map()
  for (const s of eintraege) {
    if (!proRunde.has(s.runde)) proRunde.set(s.runde, new Map())
    proRunde.get(s.runde).set(s.id, s.punkte)
  }
  return liste.map((f) => {
    let getragen = 0
    return {
      id: f.id,
      name: f.name,
      kuerzel: f.kuerzel ?? null,
      punkte: rundenMitStand.map((r) => {
        const w = proRunde.get(r)?.get(f.id)
        if (w !== undefined) getragen = w
        return getragen
      }),
    }
  })
}
const verlauf = fortgeschrieben(fahrerWertung, staende)
const teamVerlauf = fortgeschrieben(teamWertung.map((t) => ({ ...t, kuerzel: null })), d.teamStaende)

const verlaufRunden = rundenMitStand.map((r) => ({
  runde: r,
  name: rennen.find((x) => x.runde === r)?.nameVoll ?? `Round ${r}`,
}))

const entscheidung = rennen.find((r) => r.titelentscheidung)
const meister = fahrerWertung.find((f) => f.meister)
const teamMeister = teamWertung.find((t) => t.meister)
const fuehrender = fahrerWertung[0] ?? null
const gefahren = rennen.filter((r) => r.siegerId).length
const saisonLaeuft = !meister && gefahren < rennen.length
const mitSprints = rennen.some((r) => r.mitSprint)

/* Noch nicht alle Rennen gefahren – auch wenn der Titel schon vergeben ist. */
const offen = gefahren < rennen.length
const naechstesJahr = saisonListe()[0]?.jahr > jahr

/*
 * Die Lackierung der Seite: das Team, für das der Meister – oder, solange es
 * keinen gibt, der Führende – in diesem Jahr die meisten Rennen fuhr. Dieselbe
 * Farbe trägt sein Balken im Meisterband.
 */
const lackierung = meisterbandDaten().find((b) => b.jahr === jahr)?.teamId ?? null

/* Die Ergebnismatrix: eine Zelle je Fahrer und Rennen. */
const zelle = (fahrerId, runde) => zellen.get(`${fahrerId}|${runde}`)
const zellText = (z) => {
  if (!z) return ''
  if (z.gewertet) return String(z.platz)
  if (!z.gestartet) return z.text === 'DNQ' || z.text === 'DNPQ' ? 'DNQ' : z.text
  return 'Ret'
}
const zellKlasse = (z) => {
  if (!z) return 'leer'
  if (z.gewertet && z.platz <= 3) return `p${z.platz}`
  if (z.punkte > 0) return 'punkte'
  if (z.gewertet) return 'ziel'
  return z.gestartet ? 'aus' : 'nicht'
}
const matrixFahrer = fahrerWertung.filter((f) => rennen.some((r) => zelle(f.id, r.runde)))

/*
 * Was wäre unter einem anderen Punktesystem herausgekommen? Erst, wenn es
 * Ergebnisse gibt – für eine Saison ohne ein gefahrenes Rennen gäbe es nichts
 * neu zu rechnen.
 */
const mitWhatif = gefahren > 0

const ziele = [
  verlauf.length > 0 && verlaufRunden.length > 1 && { id: 'verlauf', label: 'Progression' },
  { id: 'wertung', label: 'Standings' },
  gefahren > 0 && { id: 'ergebnisse', label: 'Results grid' },
  { id: 'kalender', label: 'Calendar' },
  nennungen.length > 0 && { id: 'nennungen', label: 'Entries' },
  mitWhatif && { id: 'whatif', label: 'What if' },
].filter(Boolean)
---

<Seite
  titel={`Formula 1 season ${jahr}: standings and races`}
  beschreibung={`${saison.rennen} races${meister ? `, World Champion ${meister.name}` : ''}${teamMeister ? `, constructors' title ${teamMeister.name}` : ''}: standings, results grid, calendar and every entry.`}
  brotkrumen={[{ name: 'Seasons', pfad: '/seasons/' }]}
  lackierung={lackierung}
>
  {/*
    * Der Kopf: das Jahr auf dem Streifen der Lackierung des Meisterteams, ein
    * Satz zur Lage, das Meisterband im Kleinen – wo die Saison zwischen allen
    * anderen steht. Der laute Moment der Seite ist der Stand darunter.
    */}
  <header class="seitenkopf">
    <nav class="nachbarn" aria-label="Neighbouring seasons">
      {jahr > 1950 && <a href={pfad.saison(jahr - 1)}>‹ {jahr - 1}</a>}
      {naechstesJahr && <a href={pfad.saison(jahr + 1)}>{jahr + 1} ›</a>}
    </nav>
    <div>
      <p class="oberzeile">
        <a href={pfad.seite('/seasons/')}>Seasons</a>
      </p>
      <div class="titelblock">
        <h1>{jahr} season</h1>
        <p class="kopfsatz">
          {saison.rennen} {saison.rennen === 1 ? 'race' : 'races'}{offen && gefahren > 0 && `, ${gefahren} run so far`}{mitSprints && `, ${rennen.filter((r) => r.mitSprint).length} with a sprint`}.{' '}
          {meister ? (
            <>
              {meister.name} won the title
              {entscheidung && <> in round {entscheidung.runde}, at the <a href={pfad.rennen(entscheidung.id)}>{entscheidung.nameVoll}</a></>}.{' '}
            </>
          ) : fuehrender && gefahren > 0 ? (
            <>{fuehrender.name} leads the championship. </>
          ) : null}
          {teamMeister ? (
            <>{teamMeister.name} won the constructors' championship.</>
          ) : teamWertung[0] ? (
            <>{teamWertung[0].name} lead the constructors.</>
          ) : (
            <>There was no constructors' championship yet; it was first awarded in 1958.</>
          )}
        </p>
      </div>
      <Meisterband markiert={jahr} />
    </div>
  </header>

  {/*
    * Der Stand als zwei Türme, Fahrer und Konstrukteure nebeneinander: Das ist
    * der Grund, die Seite aufzurufen. Vorher stand er im zweiten Abschnitt,
    * unter einem Diagramm. Die ganze Wertung mit Siegen und Teams steht unten.
    */}
  <div class="tuerme">
    <section aria-labelledby="turm-fahrer">
      <div class="abschnitt-kopf">
        <div><h2 id="turm-fahrer">{offen ? 'Drivers, so far' : 'Drivers'}</h2></div>
        <a class="mehr" href="#wertung">All {fahrerWertung.length}</a>
      </div>
      <Turm
        einheit="points"
        zeilen={fahrerWertung.slice(0, 5).map((f, i) => ({
          platz: f.position ?? f.text,
          teamId: f.teams.at(-1)?.id,
          code: f.kuerzel,
          name: f.name,
          href: pfad.fahrer(f.id),
          team: f.teams.map((t) => t.name).join(', '),
          wert: ein(f.points),
          abstand: i > 0 ? `−${ein(fahrerWertung[0].points - f.points)}` : null,
        }))}
      />
    </section>
    {teamWertung.length > 0 && (
      <section aria-labelledby="turm-teams">
        <div class="abschnitt-kopf">
          <div><h2 id="turm-teams">{offen ? 'Constructors, so far' : 'Constructors'}</h2></div>
          <a class="mehr" href="#wertung">All {teamWertung.length}</a>
        </div>
        <Turm
          einheit="points"
          zeilen={teamWertung.slice(0, 5).map((t, i) => ({
            platz: t.position,
            teamId: t.id,
            name: t.name,
            href: pfad.team(t.id),
            wert: ein(t.points),
            abstand: i > 0 ? `−${ein(teamWertung[0].points - t.points)}` : null,
          }))}
        />
      </section>
    )}
  </div>

  <ul class="kacheln">
    <li><span>Different winners</span><b>{kennzahlen.sieger}</b><i>in {gefahren} {gefahren === 1 ? 'race' : 'races'}</i></li>
    <li><span>Pole-sitters</span><b>{kennzahlen.polesetter}</b></li>
    <li>
      <span>Not classified</span>
      <b>{kennzahlen.starts ? Math.round((kennzahlen.ausfaelle / kennzahlen.starts) * 100) : 0}%</b>
      <i>{kennzahlen.ausfaelle} of {kennzahlen.starts} starts</i>
    </li>
  </ul>

  <p class="punktesystem">
    <b>Points:</b> {punkte.system.beschreibung}
    {punkte.sprint && <> Sprints: {punkte.sprint.join('-')} for the top {punkte.sprint.length}.</>}
    {punkte.regelText && <> {punkte.regelText}</>}
  </p>

  {saison.dropped_scores === 1 && (
    <p class="hinweis warn">
      <b>Dropped scores:</b> not every result counted towards the championship. Only a driver's
      best races went into the standings, so the standings sit below the sum of the points
      scored in races.
    </p>
  )}

  {!offen && gefahren > 0 && (
    <p class="hinweis karo">
      <b>Season complete.</b> All {gefahren} races have been run; the standings are final.
    </p>
  )}

  <Sprung ziele={ziele} />

  {verlauf.length > 0 && verlaufRunden.length > 1 && (
    <section class="abschnitt" id="verlauf">
      <div class="abschnitt-kopf"><div><h2>Progression</h2></div></div>
      <Verlauf fahrer={verlauf} runden={verlaufRunden} streichresultate={saison.dropped_scores === 1} />
      {teamVerlauf.length > 1 && (
        <details class="team-verlauf">
          <summary>The constructors' championship, round by round</summary>
          <Verlauf fahrer={teamVerlauf} runden={verlaufRunden} art="team" />
        </details>
      )}
    </section>
  )}

  <section class="abschnitt" id="wertung">
    <div class="abschnitt-kopf"><div><h2>Standings</h2></div></div>
    <div class="wertungen">
      <div>
        <h3>Drivers</h3>
        <div class="tabelle">
          <table>
            <thead>
              <tr>
                <th class="num" scope="col">Pos</th><th scope="col">Driver</th><th scope="col">Team</th>
                <th class="num" scope="col">Wins</th>
                {mitSprints && <th class="num" scope="col"><abbr title="Sprint wins">Sprint</abbr></th>}
                <th class="num" scope="col">Points</th>
              </tr>
            </thead>
            <tbody>
              {fahrerWertung.map((f) => (
                <tr class={f.meister ? 'meister' : undefined}>
                  <td class="num"><span class={plakette(f.position)}>{f.position ?? f.text ?? '–'}</span></td>
                  <th scope="row"><a class="zeile" href={pfad.fahrer(f.id)}>{f.name}</a></th>
                  <td class="leise">
                    {f.teams.map((t, i) => (
                      <>{i > 0 && ', '}<a class="leise" href={pfad.team(t.id)}>{t.name}</a></>
                    ))}
                  </td>
                  <td class="num">{f.siege || ''}</td>
                  {mitSprints && <td class="num">{f.sprintSiege || ''}</td>}
                  <td class="num fett">{ein(f.points)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div>
        <h3>Constructors</h3>
        {teamWertung.length > 0 ? (
          <div class="tabelle">
            <table>
              <thead><tr><th class="num" scope="col">Pos</th><th scope="col">Team</th><th class="num" scope="col">Points</th></tr></thead>
              <tbody>
                {teamWertung.map((t) => (
                  <tr class={t.meister ? 'meister' : undefined}>
                    <td class="num"><span class={plakette(t.position)}>{t.position ?? '–'}</span></td>
                    <th scope="row"><a class="zeile" href={pfad.team(t.id)}>{t.name}</a></th>
                    <td class="num fett">{ein(t.points)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="hinweis">
            There was no constructors' championship yet; it was first awarded in 1958. Until then
            only the drivers were ranked.
          </p>
        )}
      </div>
    </div>
  </section>

  {gefahren > 0 && (
    <section class="abschnitt" id="ergebnisse">
      <div class="abschnitt-kopf">
        <div>
          <h2>Results grid</h2>
          <p>Every driver in every race: the finishing position, or why there was none. Gold, silver and bronze for the podium.</p>
        </div>
      </div>
      <div class="tabelle matrix">
        <table>
          <caption class="sr-only">Results of every driver in every race of {jahr}</caption>
          <thead>
            <tr>
              <th scope="col">Driver</th>
              {rennen.map((r) => (
                <th class="num" scope="col">
                  <a class="leise" href={pfad.rennen(r.id)} title={`${r.nameVoll}, round ${r.runde}`}>{r.runde}</a>
                  {r.mitSprint === 1 && <span class="sprintmarke" title="Sprint weekend">S</span>}
                </th>
              ))}
              <th class="num" scope="col">Pts</th>
            </tr>
          </thead>
          <tbody>
            {matrixFahrer.map((f) => (
              <tr>
                <th scope="row"><a class="zeile" href={pfad.fahrer(f.id)}>{f.kuerzel ?? f.name}</a><span class="sr-only"> ({f.name})</span></th>
                {rennen.map((r) => {
                  const z = zelle(f.id, r.runde)
                  return (
                    <td class={`num zelle ${zellKlasse(z)}`}>
                      {zellText(z)}
                      {z?.pole === 1 && <sup title="Pole position">P</sup>}
                      {z?.schnellste === 1 && <sup title="Fastest lap">F</sup>}
                    </td>
                  )
                })}
                <td class="num fett">{ein(f.points)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="fussnote">
        Ret: retired. DNQ: did not qualify. P: pole position. F: fastest lap. S above a round: a
        sprint weekend. Hover or tap a round number for the race.
      </p>
    </section>
  )}

  <section class="abschnitt" id="kalender">
    <div class="abschnitt-kopf"><div><h2>Calendar</h2></div></div>
    <div class="tabelle">
      <table>
        <thead>
          <tr>
            <th class="num" scope="col"><abbr title="Round">Rd</abbr></th><th scope="col">Race</th><th class="strecke" scope="col">Circuit</th>
            <th scope="col">Date</th><th scope="col">Pole</th><th scope="col">Winner</th>
          </tr>
        </thead>
        <tbody>
          {rennen.map((r) => (
            <tr class={r.siegerId ? undefined : 'raus'}>
              <td class="num leise">{r.runde}</td>
              <th scope="row">
                <a class="zeile" href={pfad.rennen(r.id)}>{r.name}</a>
                {r.mitSprint === 1 && <span class="etikett" title="Sprint weekend">sprint</span>}
                {r.titelentscheidung === 1 && <span class="etikett akzent">Title decided</span>}
              </th>
              <td class="leise strecke"><a class="leise" href={pfad.strecke(r.streckeId)}>{r.strecke}</a></td>
              <td class="leise datum">{tagMonat(r.datum)}<span class="sr-only"> {jahr}</span></td>
              <td class="leise">{r.pole ? <a class="leise" href={pfad.fahrer(r.pole.fahrerId)}>{r.pole.name}</a> : ''}</td>
              <td>
                {r.siegerId
                  ? <a class="zeile" href={pfad.fahrer(r.siegerId)}>{r.sieger}</a>
                  : <span class="leise">still to come</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  {nennungen.length > 0 && (
    <section class="abschnitt" id="nennungen">
      <div class="abschnitt-kopf">
        <div>
          <h2>Entries</h2>
          <p>Who entered with which car, engine and tyres. The entrant is the organisation that entered the car, not always the team that built it.</p>
        </div>
      </div>
      <div class="tabelle">
        <table>
          <thead>
            <tr><th scope="col">Constructor</th><th scope="col">Entrant</th><th scope="col">Chassis</th><th scope="col">Engine</th><th scope="col">Tyres</th><th scope="col">Drivers</th></tr>
          </thead>
          <tbody>
            {nennungen.map((n) => (
              <tr>
                <th scope="row">{n.teamMitSeite ? <a class="zeile" href={pfad.team(n.teamId)}>{n.team}</a> : n.team}</th>
                <td class="leise">{n.meldungName}</td>
                <td class="leise">{n.chassis ?? '–'}</td>
                <td class="leise"><a class="leise" href={pfad.seite(`/engines/${n.motorId}/`)}>{n.motor ?? n.motorHersteller}</a></td>
                <td class="leise">{n.reifen ?? '–'}</td>
                <td>
                  {n.fahrer.map((f, i) => (
                    <>{i > 0 && ', '}{f.mitSeite ? <a class="leise" href={pfad.fahrer(f.id)}>{f.name}</a> : f.name}</>
                  ))}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {mitWhatif && (
    <section class="abschnitt" id="whatif">
      <div class="abschnitt-kopf">
        <div>
          <h2>What if: other points systems</h2>
          <p>
            The same finishing positions, scored under any points system used since 1950
            {saison.dropped_scores === 1 && ', with or without the dropped-scores rule of the time'}.
          </p>
        </div>
      </div>
      <WasWaereWenn jahr={jahr} amtlich={fahrerWertung} />
    </section>
  )}
</Seite>

<style>
  /* Kalender wie auf /races/: Datum ohne Jahr, das die Seite schon trägt, am Telefon ohne Strecke. */
  .datum { white-space: nowrap; }

  @media (max-width: 34rem) {
    .strecke { display: none; }
  }

  /* Fahrer- und Teamwertung nebeneinander, in den Spalten der Türme oben (7 zu 5): Man liest sie zusammen. */
  .wertungen {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: start;
    gap: var(--abstand-6) var(--abstand-7);
  }

  @media (max-width: 56rem) {
    .wertungen { grid-template-columns: minmax(0, 1fr); }
  }

  /* Der Stand oben: Fahrer und Konstrukteure nebeneinander, wie die Wertungen unten (7 zu 5). */
  .tuerme {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--abstand-6) var(--abstand-7);
    align-items: start;
    margin-bottom: var(--abstand-6);
  }

  @media (max-width: 56rem) {
    .tuerme { grid-template-columns: minmax(0, 1fr); }
  }

  .punktesystem { max-width: var(--mass); margin: 0 0 var(--abstand-4); color: var(--ink-2); }
  .team-verlauf { margin-top: var(--abstand-4); }
  .team-verlauf summary { cursor: pointer; min-height: 2.25rem; font-weight: 600; color: var(--ink); margin-bottom: var(--abstand-2); }

  /*
   * Die Matrix: dicht, aber jede Zelle ist lesbar – schmale Ziffern statt
   * kleiner. Die Farbe trägt nie allein: In jeder Zelle steht die Zahl oder
   * das Kürzel. Gold, Silber, Bronze fürs Podium; Ausfall und Nichtstart
   * leise. Eine Farbe für „in den Punkten“ gibt es nicht mehr – die Punkte
   * stehen in ihrer Spalte (docs/DESIGN.md 8.7).
   */
  .matrix th, .matrix td { padding: var(--abstand-1); }
  .matrix thead th { text-align: center; }
  .matrix .zelle { text-align: center; min-width: 2rem; font-weight: 650; }
  .matrix .p1 { background: var(--gold); color: var(--podest-ink); }
  .matrix .p2 { background: var(--silber); color: var(--podest-ink); }
  .matrix .p3 { background: var(--bronze); color: var(--podest-ink); }
  .matrix .punkte,
  .matrix .ziel { color: var(--ink); }
  .matrix .aus, .matrix .nicht { color: var(--muted); font-weight: 500; }
  .matrix sup { font-size: var(--text-1); font-weight: 750; }
  .sprintmarke { display: block; color: var(--muted); }
</style>
