---
import Seite from '../../layouts/Seite.astro'
import Sprung from '../../components/Sprung.astro'
import { saisonListe, pfad } from '../../lib/db.js'

const saisons = saisonListe()
const mitStreich = saisons.filter((s) => s.streichresultate).length

/*
 * Nach Jahrzehnten gegliedert. 77 Zeilen einer Tabelle lesen sich als eine
 * Wand; in Jahrzehnte geteilt findet man ein Jahr, ohne zu zählen, und sieht
 * nebenbei die Epochen – die Fünfziger mit Fangio, die Nuller mit Schumacher.
 */
const proJahrzehnt = new Map()
for (const s of saisons) {
  const j = Math.floor(s.jahr / 10) * 10
  if (!proJahrzehnt.has(j)) proJahrzehnt.set(j, [])
  proJahrzehnt.get(j).push(s)
}
const jahrzehnte = [...proJahrzehnt.entries()]
---

<Seite titel="All Formula 1 seasons" beschreibung={`${saisons.length} seasons from 1950 to the present.`}>
  <header class="seitenkopf">
    <div>
      <h1>All seasons since 1950</h1>
      <p class="lead">{saisons.length} seasons of the World Championship, by decade.</p>
    </div>
  </header>

  <Sprung ziele={jahrzehnte.map(([j]) => ({ id: `j${j}`, label: `${j}s` }))} />

  {jahrzehnte.map(([j, liste]) => (
    <section class="abschnitt" id={`j${j}`}>
      {/* Die Überschrift ist zugleich die Beschriftung in der Sprungleiste (docs/DESIGN.md 8.9). */}
      <div class="abschnitt-kopf"><div><h2>{j}s</h2></div></div>
      <ul class="saisons">
        {liste.map((s) => (
          <li>
            <a href={pfad.saison(s.jahr)}>
              <span class="kopfzeile">
                <b class="jahr anzeige">{s.jahr}</b>
                <span class="rennen">{s.rennen} races</span>
              </span>
              {s.meister ? (
                <span class="wer">{s.meister}</span>
              ) : (
                <span class="laeuft">Season in progress</span>
              )}
              <span class="team">
                {s.teamMeister ?? (s.mitTeamWM ? '' : 'No constructors’ championship until 1958')}
              </span>
              {s.streichresultate === 1 && <span class="etikett">Dropped scores</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <p class="fussnote">
    <b>Dropped scores:</b> in {mitStreich} seasons not every result counted towards the
    standings; only a driver's best races did. There the championship standings sit below the
    sum of the points scored in races. The constructors' championship began in 1958.
  </p>
</Seite>

<style>
  /*
   * Jedes Jahrzehnt als eine Tafel auf der Fläche: zehn Felder in zwei Reihen,
   * getrennt durch Haarlinien, ohne Rahmen und Rundung. Einzelne Karten mit
   * Abstand ließen die Seite in achtzig gleich wichtige Kästchen zerfallen.
   */
  .saisons {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--surface);
    overflow: hidden;
  }

  /* Die Haarlinien rechts und unter jedem Feld; die am Rand der Tafel schneidet overflow ab. */
  .saisons li { box-shadow: 1px 0 0 var(--border), 0 1px 0 var(--border); }

  .saisons a {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    height: 100%;
    padding: var(--abstand-3) var(--abstand-4) var(--abstand-4);
    color: inherit;
    text-decoration: none;
  }

  .saisons a:hover { background: var(--surface-2); }

  .kopfzeile { display: flex; align-items: baseline; justify-content: space-between; width: 100%; margin-bottom: var(--abstand-1); }
  .jahr { font-size: var(--text-7); line-height: 1; color: var(--ink); }
  .rennen { font-size: var(--text-2); color: var(--muted); font-variant-numeric: tabular-nums; }
  .wer { font-size: var(--text-3); font-weight: 600; color: var(--ink); }
  .team { font-size: var(--text-2); color: var(--muted); }
  .laeuft { font-size: var(--text-3); font-weight: 600; color: var(--ink); }
  .etikett { margin: var(--abstand-2) 0 0; }

  @media (max-width: 56rem) {
    .saisons { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (max-width: 34rem) {
    .saisons { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .saisons a { padding: var(--abstand-3); }
  }
</style>
