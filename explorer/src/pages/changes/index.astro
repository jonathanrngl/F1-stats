---
/**
 * Bewegung in den Rekordlisten.
 *
 * Die Rekordseite beantwortet „wer hält die Marke?". Diese hier beantwortet
 * „was hat sich bewegt, und was bewegt sich als Nächstes?" – die Frage, mit
 * der man eine Saison verfolgt.
 *
 * Die Seite ist statisch: Alles darauf gilt für den Datenstand, der oben
 * genannt ist, nicht für den Augenblick des Lesens. Deshalb steht das Rennen,
 * auf dem gerechnet wurde, im Kopf und nicht im Kleingedruckten.
 */
import { datum, ein, zahl } from '../../lib/format.js'
import Seite from '../../layouts/Seite.astro'
import Sprung from '../../components/Sprung.astro'
import { db, pfad } from '../../lib/db.js'
import {
  datenstand, inReichweite, juengsteAenderungen, laufendeSerien, rekordVerlaeufe,
  saisonMarken, zahlwort, beschreibeAenderung,
} from '../../engine/aenderungen.js'

const stand = datenstand(db())
const verlaeufe = rekordVerlaeufe(db())

/*
 * Zehn Jahre sind das Fenster für „zuletzt". Kürzer, und eine ruhige Phase
 * ließe den Abschnitt leer; länger, und „zuletzt" wäre kein Wort mehr dafür.
 * Die Ereignisse tragen ihr Datum, der Leser sieht die Spanne also selbst.
 */
const seit = stand ? `${stand.jahr - 10}-01-01` : undefined
const { einzeln, ausbauten } = juengsteAenderungen(verlaeufe, { seit })

const gefallen = einzeln.slice(0, 8)
const laufendeAusbauten = ausbauten.filter((a) => a.laeuftNoch)
const marken = saisonMarken(db(), stand)
const aussichten = inReichweite(db(), verlaeufe, stand)
const serien = laufendeSerien(db(), stand)

const tageZwischen = (a, b) =>
  Math.round((Date.parse(`${b}T12:00:00Z`) - Date.parse(`${a}T12:00:00Z`)) / 86400000)

/** Wohin ein Halter verlinkt: Fahrer und Teams liegen in verschiedenen Bäumen. */
const zielVon = (k, id) => (k.wer === 'team' ? pfad.team(id) : pfad.fahrer(id))

const WORT = {
  alleinVorn: { kurz: 'broken', farbe: 'neu' },
  eingestellt: { kurz: 'equalled', farbe: 'gleich' },
}

const { rennen: rennenGesamt } = db()
  .prepare('SELECT COUNT(*) AS rennen FROM race WHERE EXISTS (SELECT 1 FROM race_result rr WHERE rr.race_id = race.id)')
  .get()

const satz = beschreibeAenderung

/** Der Schluss des Kopfsatzes: wie viele Rennen der Saison noch offen sind. */
const rest = !stand || stand.offen === 0
  ? ''
  : stand.offen === 1 ? ', with one race remaining' : `, with ${stand.offen} races remaining`

const ziele = [
  gefallen.length > 0 && { id: 'gefallen', label: 'Recently fallen' },
  laufendeAusbauten.length > 0 && { id: 'ausbau', label: 'Being extended' },
  stand && marken.length > 0 && { id: 'saison', label: 'Within reach' },
  aussichten.length > 0 && { id: 'naechste', label: 'Closest' },
  serien.length > 0 && { id: 'serien', label: 'Active streaks' },
].filter(Boolean)
---

<Seite
  titel="Changes: what is moving in the record lists"
  beschreibung="Which Formula 1 record fell most recently, what is still within reach this season, and who is closest to the all-time marks."
>
  {/*
    * Kopf ohne Lackierung (DESIGN.md, Prinzip 1). Der Datenstand – vorher eine
    * Zeile Eckdaten mit Trennlinien – steht als Satz unter dem Lead: Alles auf
    * der Seite gilt für dieses Rennen, nicht für den Augenblick des Lesens.
    */}
  <header class="seitenkopf">
    <div>
      <p class="oberzeile">Analysis</p>
      <div class="titelblock">
        <h1>Changes</h1>
        <p class="lead">
          When each record last moved, what can still fall this season, and who is closest to the
          all-time marks.
        </p>
        {stand && (
          <p class="kopfsatz">
            As at <a href={pfad.rennen(stand.id)}>{stand.grandPrix} {stand.jahr}</a> on{' '}
            {datum(stand.datum)}, round {stand.runde} of {stand.rennenImJahr}{rest}.
          </p>
        )}
      </div>
    </div>
  </header>

  {!stand && <p class="hinweis">There are no results to calculate from.</p>}

  <Sprung ziele={ziele} />

  {/* ------------------------------------------------------ zuletzt gefallen */}

  {
    gefallen.length > 0 && (
      <section class="abschnitt" id="gefallen">
        <div class="abschnitt-kopf">
          <div>
            <h2>Recently fallen</h2>
            <p>
              To break a record you must first equal it, so each broken record carries the date
              it was equalled, often weeks earlier.
            </p>
          </div>
        </div>
        <ol class="ereignisse">
          {gefallen.map((e) => (
            <li>
              <div class="wann">
                <b>{datum(e.datum)}</b>
                <a href={pfad.rennen(e.rennen)}>{e.grandPrix} {e.jahr}</a>
              </div>
              <div class="was">
                <span class={`etikett ${WORT[e.art].farbe === 'neu' ? 'akzent' : ''}`}>{WORT[e.art].kurz}</span>
                <b>{e.kategorie.titel}</b>
                <p>{satz(e)}</p>
                {e.zuvorEingestellt && (
                  <p class="davor">
                    Equalled on {datum(e.zuvorEingestellt.datum)} at{' '}
                    <a href={pfad.rennen(e.zuvorEingestellt.rennen)}>
                      {e.zuvorEingestellt.grandPrix} {e.zuvorEingestellt.jahr}
                    </a>
                    , {tageZwischen(e.zuvorEingestellt.datum, e.datum)} days earlier.
                  </p>
                )}
                <p class="spur">
                  {e.vorher.wert > 0 && e.vorher.wert !== e.wert ? `${zahl(e.vorher.wert)} to ` : ''}
                  {zahl(e.wert)},{' '}
                  {e.halter.map((h, i) => (
                    <>
                      {i > 0 && ', '}
                      <a href={zielVon(e.kategorie, h.id)}>{h.name}</a>
                    </>
                  ))}
                  .{e.wert !== e.rekordJetzt && ` Stands today at ${zahl(e.rekordJetzt)}.`}
                </p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {/* --------------------------------------------------------- wird ausgebaut */}

  {
    laufendeAusbauten.length > 0 && (
      <section class="abschnitt" id="ausbau">
        <div class="abschnitt-kopf">
          <div>
            <h2>Being extended</h2>
            <p>A record holder who is still racing adds to it in every successful race. Here that counts as one gain, not one entry per race.</p>
          </div>
        </div>
        <div class="tabelle">
          <table>
            <thead>
              <tr>
                <th>Record</th>
                <th>Holder</th>
                <th class="num">Gain</th>
                <th>Extending since</th>
                <th>Most recently</th>
              </tr>
            </thead>
            <tbody>
              {laufendeAusbauten.map((a) => (
                <tr>
                  <td class="fett">{a.kategorie.titel}</td>
                  <td>
                    {a.halter.map((h, i) => (
                      <>
                        {i > 0 && ', '}
                        <a class="zeile" href={zielVon(a.kategorie, h.id)}>{h.name}</a>
                      </>
                    ))}
                  </td>
                  <td class="num">
                    <b>{zahl(a.bis)}</b>
                    <span class="neben">from {zahl(a.von)}, in {a.schritte} steps</span>
                  </td>
                  <td class="leise">
                    <a class="leise" href={pfad.rennen(a.seit.rennen)}>{a.seit.grandPrix} {a.seit.jahr}</a>
                  </td>
                  <td class="leise">
                    <a class="leise" href={pfad.rennen(a.zuletzt.rennen)}>{a.zuletzt.grandPrix} {a.zuletzt.jahr}</a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  {/* ------------------------------------------------------------ diese Saison */}

  {
    stand && marken.length > 0 && (
      <section class="abschnitt" id="saison">
        <div class="abschnitt-kopf">
          <div>
            <h2>Within reach this season</h2>
            <p>Not a projection but arithmetic: this many successes are needed, this many races remain. Anything already ruled out never appears here.</p>
          </div>
        </div>
        <ul class="marken">
          {marken.map((m) => (
            <li class="karte">
              <span class="titel">{m.art.titel}</span>
              <p class="gross">
                <a href={pfad.fahrer(m.fuehrender.id)}>{m.fuehrender.name}</a>
                <span class="wert">{zahlwort(m.fuehrender.wert, m.art)}</span>
              </p>
              <p class="spur">
                Record <span class="fett">{m.rekord.wert}</span> –{' '}
                <a href={pfad.fahrer(m.rekord.id)}>{m.rekord.name}</a> {m.rekord.jahr}
              </p>
              <p class={m.brechenMoeglich ? 'urteil moeglich' : 'urteil knapp'}>
                {m.haeltSchon
                  ? `Already level with the record; every further success sets a new one.`
                  : m.brechenMoeglich
                    ? `${m.fehltZumBrechen} more needed to break it, with ${stand.offen} races remaining.`
                    : `With ${stand.offen} races left it can still be equalled (${m.fehltZumEinstellen} more), but no longer broken.`}
              </p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* ------------------------------------------------------- ewige Bestmarken */}

  {
    aussichten.length > 0 && (
      <section class="abschnitt" id="naechste">
        <div class="abschnitt-kopf">
          <div>
            <h2>Closest to the all-time records</h2>
            <p>
              The nearest challenger to each record. The gap is a fact; the projection beside it is
              not: it carries forward the strike rate of the past three seasons.
            </p>
          </div>
        </div>
        <div class="tabelle">
          <table>
            <thead>
              <tr>
                <th>Driver</th>
                <th>Record</th>
                <th class="num"><abbr title="How many they have now">Has</abbr></th>
                <th class="num"><abbr title="How many more to equal the record">To equal</abbr></th>
                <th>At this rate</th>
              </tr>
            </thead>
            <tbody>
              {aussichten.map((a) => (
                <tr class={a.naechstesRennen ? 'meister' : undefined}>
                  <td>
                    <a class="zeile" href={pfad.fahrer(a.fahrer.id)}>{a.fahrer.name}</a>
                    {a.alter !== null && <span class="neben">{Math.floor(a.alter)} years old</span>}
                  </td>
                  <td>
                    {a.kategorie.titel}
                    <span class="neben">
                      {zahl(a.rekord)},{' '}
                      {a.halter.map((h, i) => (
                        <>
                          {i > 0 && ', '}
                          <a href={zielVon(a.kategorie, h.id)}>{h.name}</a>
                        </>
                      ))}
                      {a.halterAktiv && ', still racing, so the record keeps growing'}
                    </span>
                  </td>
                  <td class="num">{zahl(a.eigene)}</td>
                  <td class="num">
                    <b>{zahl(a.fehlt)}</b>
                    {a.naechstesRennen && <span class="neben">next race</span>}
                  </td>
                  <td>
                    {a.hochrechnung.value === null ? (
                      <span class="luecke">{a.hochrechnung.caveat}</span>
                    ) : (
                      <>
                        {zahl(a.hochrechnung.value)} races
                        <span class="neben">
                          ≈ {ein(a.saisonNoetig)} seasons
                          {a.alterAmZiel !== null &&
                            `, aged ${Math.round(a.alterAmZiel)} by then`}
                        </span>
                      </>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="fussnote">Highlighted: the record could fall at the next race.</p>
      </section>
    )
  }

  {/* ------------------------------------------------------------ laufende Serien */}

  {
    serien.length > 0 && (
      <section class="abschnitt" id="serien">
        <div class="abschnitt-kopf">
          <div>
            <h2>Active streaks</h2>
            <p>Streaks still running at the driver's last start. Missing a race does not break one.</p>
          </div>
        </div>
        <div class="tabelle">
          <table>
            <thead>
              <tr>
                <th>Driver</th>
                <th>Streak</th>
                <th class="num">Length</th>
                <th>Record</th>
              </tr>
            </thead>
            <tbody>
              {serien.map((s) => (
                <tr>
                  <td><a class="zeile" href={pfad.fahrer(s.id)}>{s.name}</a></td>
                  <td>{s.art.titel}</td>
                  <td class="num fett">{s.laenge}</td>
                  <td>
                    {s.rekord}
                    <span class="neben">
                      {s.rekordHalter.map((h, i) => (
                        <>
                          {i > 0 && ', '}
                          <a href={pfad.fahrer(h.id)}>{h.name}</a>
                        </>
                      ))}
                      {', '}
                      {s.haeltRekord ? 'equalled' : `${s.fehlt} more to the record`}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  {/* ------------------------------------------------------------------ Methode */}

  <details class="erklaerung abschnitt">
    <summary>How this is worked out</summary>
    <div>
      <p>
        All {zahl(rennenGesamt)} races held since 1950 are walked through in chronological
        order, and after each one we know whether the top mark has moved.
      </p>
      <p>
        <b>Counting is by starts, not by entries.</b> That shifts individual dates away from the
        record books, which often count entries. Räikkönen, for instance, reached Barrichello's
        322 starts at Mugello in 2020 and passed him two races later at Sochi. His 326th
        <i>entry</i>, the mark usually quoted, did not fall until the Eifel Grand Prix. Both
        statements are correct; they count different things.
      </p>
      <p>
        <b>A projection is not a prediction.</b> It takes the strike rate of the past three
        seasons and carries it forward. A driver with too few starts in that window, or no
        success of that kind at all, gets no number: "infinitely many races" would be false
        precision. Where the record is held by a driver who is still racing, it keeps growing while the
        challenger closes in; that is noted on the relevant row.
      </p>
      <p>
        The all-time points table is deliberately absent. The scoring systems have changed more
        than a dozen times. A record of that kind mostly measures the system.
      </p>
      <p>
        The full lists are under <a href={pfad.seite('/records/')}>Records</a>, and the next race
        under <a href={pfad.seite('/preview/')}>Next race</a>.
      </p>
    </div>
  </details>
</Seite>

<style>
  /* ---------------------------------------------------------- Ereignisliste */

  /*
   * Die gefallenen Rekorde als Zeilen auf der Fläche, getrennt durch
   * Haarlinien wie die Zeilen eines Turms. Vorher stand jeder in einer eigenen
   * gerahmten, gerundeten Karte.
   */
  .ereignisse {
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--surface);
  }

  .ereignisse li {
    display: grid;
    grid-template-columns: minmax(0, 10rem) minmax(0, 1fr);
    gap: var(--abstand-1) var(--abstand-5);
    padding: var(--abstand-4);
    border-bottom: 1px solid var(--border);
  }

  .ereignisse li:last-child { border-bottom: 0; }

  .wann {
    display: grid;
    gap: var(--abstand-1);
    align-content: start;
    font-size: var(--text-2);
  }

  .wann b { color: var(--ink); font-weight: 700; font-variant-numeric: tabular-nums lining-nums; }
  .wann a { color: var(--muted); text-decoration: none; }
  .wann a:hover { color: var(--ink); text-decoration: underline 2px; }

  .was .etikett { margin-left: 0; }

  .was > b {
    display: block;
    margin-top: var(--abstand-1);
    font-size: var(--text-3);
    font-weight: 700;
    color: var(--ink);
  }

  .was p { margin: var(--abstand-1) 0 0; font-size: var(--text-3); color: var(--ink-2); text-wrap: pretty; }
  .was .davor { font-size: var(--text-2); color: var(--muted); }

  /* Nebenangaben: leise. Die Verweise darin wie in der Brotkrume – dünn unterstrichen, nicht nur andersfarbig. */
  .spur,
  .was .spur { font-size: var(--text-2); color: var(--muted); font-variant-numeric: tabular-nums lining-nums; }

  .was .davor a,
  .spur a { color: var(--ink-2); text-decoration-thickness: 1px; text-decoration-color: var(--border-input); }

  .was .davor a:hover,
  .spur a:hover { color: var(--ink); text-decoration-thickness: 2px; text-decoration-color: currentColor; }

  /* --------------------------------------------------------- Saisonmarken */

  .marken {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
    gap: var(--abstand-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .marken .titel { font-size: var(--text-2); font-weight: 600; color: var(--muted); }

  .gross { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--abstand-2); margin: var(--abstand-1) 0 0; }
  .gross a { font-size: var(--text-4); font-weight: 750; color: var(--ink); text-decoration: none; }
  .gross a:hover { text-decoration: underline 2px; }
  .gross .wert { font-size: var(--text-3); font-weight: 700; color: var(--ink); }
  .marken .spur { margin: var(--abstand-1) 0 0; }
  .spur .fett { color: var(--ink-2); font-weight: 700; }

  /*
   * Das Urteil. „Noch zu brechen“ ist nicht „besser als die eigene
   * Bezugsgröße“ – darum kein Grün, sondern Tinte und fett. Nur noch
   * einzustellen steht leise.
   */
  .urteil {
    margin: var(--abstand-3) 0 0;
    padding-top: var(--abstand-2);
    border-top: 1px solid var(--border);
    font-size: var(--text-3);
    text-wrap: pretty;
  }

  .urteil.moeglich { color: var(--ink); font-weight: 700; }
  .urteil.knapp { color: var(--muted); }

  .luecke { font-size: var(--text-2); color: var(--warn); text-wrap: pretty; }

  @media (max-width: 34rem) {
    .ereignisse li { grid-template-columns: minmax(0, 1fr); gap: var(--abstand-2); }
    .wann { display: flex; flex-wrap: wrap; gap: var(--abstand-1) var(--abstand-2); }
  }
</style>
