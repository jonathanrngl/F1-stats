---
/**
 * Bewegung in den Rekordlisten.
 *
 * Die Rekordseite beantwortet „wer hält die Marke?". Diese hier beantwortet
 * „was hat sich bewegt, und was bewegt sich als Nächstes?" – die Frage, mit
 * der man eine Saison verfolgt.
 *
 * Die Seite ist statisch: Alles darauf gilt für den Datenstand, der oben
 * genannt ist, nicht für den Augenblick des Lesens. Deshalb steht das Rennen,
 * auf dem gerechnet wurde, im Kopf und nicht im Kleingedruckten.
 */
import Seite from '../../layouts/Seite.astro'
import { db, pfad } from '../../lib/db.js'
import {
  datenstand, inReichweite, juengsteAenderungen, laufendeSerien, rekordVerlaeufe,
  saisonMarken, zahlwort,
} from '../../engine/aenderungen.js'

const stand = datenstand(db())
const verlaeufe = rekordVerlaeufe(db())

/*
 * Zehn Jahre sind das Fenster für „zuletzt". Kürzer, und eine ruhige Phase
 * ließe den Abschnitt leer; länger, und „zuletzt" wäre kein Wort mehr dafür.
 * Die Ereignisse tragen ihr Datum, der Leser sieht die Spanne also selbst.
 */
const seit = stand ? `${stand.jahr - 10}-01-01` : undefined
const { einzeln, ausbauten } = juengsteAenderungen(verlaeufe, { seit })

const gefallen = einzeln.slice(0, 8)
const laufendeAusbauten = ausbauten.filter((a) => a.laeuftNoch)
const marken = saisonMarken(db(), stand)
const aussichten = inReichweite(db(), verlaeufe, stand)
const serien = laufendeSerien(db(), stand)

const nf = new Intl.NumberFormat('en-GB')
const datum = (s) =>
  new Intl.DateTimeFormat('en-GB', { dateStyle: 'long', timeZone: 'UTC' }).format(
    new Date(`${s}T12:00:00Z`),
  )
/** Eine Saison und ein Bruchteil – „5,7" sagt hier mehr als „6". */
const ein = (n) => nf.format(Math.round(n * 10) / 10)
const tageZwischen = (a, b) =>
  Math.round((Date.parse(`${b}T12:00:00Z`) - Date.parse(`${a}T12:00:00Z`)) / 86400000)

/** Wohin ein Halter verlinkt: Fahrer und Teams liegen in verschiedenen Bäumen. */
const zielVon = (k, id) => (k.wer === 'team' ? pfad.team(id) : pfad.fahrer(id))

const WORT = {
  alleinVorn: { kurz: 'broken', farbe: 'neu' },
  eingestellt: { kurz: 'equalled', farbe: 'gleich' },
}

const { rennen: rennenGesamt } = db()
  .prepare('SELECT COUNT(*) AS rennen FROM race WHERE EXISTS (SELECT 1 FROM race_result rr WHERE rr.race_id = race.id)')
  .get()

/** Ein Ereignis in einen Satz – die Formulierung trägt die Unterscheidung. */
function satz(e) {
  const wer = e.halter.map((h) => h.name).join(' and ')
  /** Wer die Marke bisher hielt und sie nun nicht mehr allein hat. */
  const alt = e.vorher.halter
    .filter((h) => !e.halter.some((n) => n.id === h.id))
    .map((h) => h.name)
    .join(' and ')

  if (e.art === 'eingestellt') {
    return `${wer} reaches ${zahlwort(e.wert, e.kategorie)} and now shares the record${alt ? ` with ${alt}` : ''}.`
  }
  return `${wer} moves clear on ${zahlwort(e.wert, e.kategorie)}${
    alt ? ` – ${alt} loses a share of the record` : ''
  }.`
}
---

<Seite
  titel="Changes – what is moving in the record lists"
  beschreibung="Which Formula 1 record fell most recently, what is still within reach this season, and who is closest to the all-time marks."
>
  <h1>Changes</h1>
  <p class="lead">
    Record lists look settled, and they are not. This page works out from the results themselves
    when each record last moved – and who is closest to it right now.
  </p>

  {
    stand && (
      <p class="stand">
        As at <a href={pfad.rennen(stand.id)}>{stand.grandPrix} {stand.jahr}</a>,
        {' '}{datum(stand.datum)} · round {stand.runde} of {stand.rennenImJahr}
        {stand.offen > 0 && ` · ${stand.offen} races remaining`}
      </p>
    )
  }

  {!stand && <p class="hinweis">There are no results to calculate from.</p>}

  {/* ------------------------------------------------------ zuletzt gefallen */}

  {
    gefallen.length > 0 && (
      <section>
        <h2>Recently fallen</h2>
        <p class="unter">
          Every record grows one at a time. To break one you must first equal it – so each broken
          record carries the date it was equalled, often weeks earlier. An entry without that line
          is a record currently being shared.
        </p>
        <ol class="ereignisse">
          {gefallen.map((e) => (
            <li>
              <div class="wann">
                <b>{datum(e.datum)}</b>
                <a href={pfad.rennen(e.rennen)}>{e.grandPrix} {e.jahr}</a>
              </div>
              <div class="was">
                <span class={`etikett ${WORT[e.art].farbe}`}>{WORT[e.art].kurz}</span>
                <b>{e.kategorie.titel}</b>
                <p>{satz(e)}</p>
                {e.zuvorEingestellt && (
                  <p class="davor">
                    Equalled on {datum(e.zuvorEingestellt.datum)} at{' '}
                    <a href={pfad.rennen(e.zuvorEingestellt.rennen)}>
                      {e.zuvorEingestellt.grandPrix} {e.zuvorEingestellt.jahr}
                    </a>
                    , {tageZwischen(e.zuvorEingestellt.datum, e.datum)} days earlier.
                  </p>
                )}
                <p class="spur">
                  {e.vorher.wert > 0 ? `${nf.format(e.vorher.wert)} → ` : ''}
                  {nf.format(e.wert)}
                  {' · '}
                  {e.halter.map((h, i) => (
                    <>
                      {i > 0 && ', '}
                      <a href={zielVon(e.kategorie, h.id)}>{h.name}</a>
                    </>
                  ))}
                  {e.wert !== e.rekordJetzt &&
                    ` · stands today at ${nf.format(e.rekordJetzt)}`}
                </p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {/* --------------------------------------------------------- wird ausgebaut */}

  {
    laufendeAusbauten.length > 0 && (
      <section>
        <h2>Currently being extended</h2>
        <p class="unter">
          A driver who holds a record and is still racing adds to it in every successful race.
          That is gathered here as a single gain rather than one notice per race.
        </p>
        <div class="tabelle">
          <table>
            <thead>
              <tr>
                <th>Record</th>
                <th>Holder</th>
                <th class="zahl">Gain</th>
                <th>Extending since</th>
                <th>Most recently</th>
              </tr>
            </thead>
            <tbody>
              {laufendeAusbauten.map((a) => (
                <tr>
                  <td>{a.kategorie.titel}</td>
                  <td>
                    {a.halter.map((h, i) => (
                      <>
                        {i > 0 && ', '}
                        <a class="zeile" href={zielVon(a.kategorie, h.id)}>{h.name}</a>
                      </>
                    ))}
                  </td>
                  <td class="zahl">
                    {nf.format(a.von)} → <b>{nf.format(a.bis)}</b>
                    <span class="neben">in {a.schritte} steps</span>
                  </td>
                  <td>
                    <a href={pfad.rennen(a.seit.rennen)}>{a.seit.grandPrix} {a.seit.jahr}</a>
                  </td>
                  <td>
                    <a href={pfad.rennen(a.zuletzt.rennen)}>{a.zuletzt.grandPrix} {a.zuletzt.jahr}</a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  {/* ------------------------------------------------------------ diese Saison */}

  {
    stand && marken.length > 0 && (
      <section>
        <h2>Still within reach this season</h2>
        <p class="unter">
          Not a projection but a calculation: this many successes are needed, this many races
          remain. Anything no longer possible on the arithmetic does not appear here at all.
        </p>
        <ul class="karten">
          {marken.map((m) => (
            <li class="karte marke-karte">
              <span class="titel">{m.art.titel}</span>
              <p class="gross">
                <a href={pfad.fahrer(m.fuehrender.id)}>{m.fuehrender.name}</a>
                <span class="wert">{zahlwort(m.fuehrender.wert, m.art)}</span>
              </p>
              <p class="spur">
                Record <span class="fett">{m.rekord.wert}</span> –{' '}
                <a href={pfad.fahrer(m.rekord.id)}>{m.rekord.name}</a> {m.rekord.jahr}
              </p>
              <p class={m.brechenMoeglich ? 'urteil moeglich' : 'urteil knapp'}>
                {m.haeltSchon
                  ? `Already level with the record; every further success sets a new one.`
                  : m.brechenMoeglich
                    ? `${m.fehltZumBrechen} more needed to break it, with ${stand.offen} races remaining.`
                    : `Equalling it is still possible with ${m.fehltZumEinstellen} more; breaking it is not, with ${stand.offen} races remaining.`}
              </p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* ------------------------------------------------------- ewige Bestmarken */}

  {
    aussichten.length > 0 && (
      <section>
        <h2>Closest to the all-time records</h2>
        <p class="unter">
          The nearest challenger to each record. The gap is a fact; the projection beside it is
          not – it merely carries forward the strike rate of the past three seasons and assumes
          the driver keeps racing.
        </p>
        <div class="tabelle">
          <table>
            <thead>
              <tr>
                <th>Driver</th>
                <th>Record</th>
                <th class="zahl">Tally</th>
                <th class="zahl">Needed</th>
                <th>At this rate</th>
              </tr>
            </thead>
            <tbody>
              {aussichten.map((a) => (
                <tr class={a.naechstesRennen ? 'dringend' : undefined}>
                  <td>
                    <a class="zeile" href={pfad.fahrer(a.fahrer.id)}>{a.fahrer.name}</a>
                    {a.alter !== null && <span class="neben">{Math.floor(a.alter)} years old</span>}
                  </td>
                  <td>
                    {a.kategorie.titel}
                    <span class="neben">
                      {nf.format(a.rekord)} ·{' '}
                      {a.halter.map((h, i) => (
                        <>
                          {i > 0 && ', '}
                          <a href={zielVon(a.kategorie, h.id)}>{h.name}</a>
                        </>
                      ))}
                      {a.halterAktiv && ' – still racing, so the record keeps growing'}
                    </span>
                  </td>
                  <td class="zahl">{nf.format(a.eigene)}</td>
                  <td class="zahl">
                    <b>{nf.format(a.fehlt)}</b>
                    {a.naechstesRennen && <span class="neben">next race</span>}
                  </td>
                  <td>
                    {a.hochrechnung.value === null ? (
                      <span class="luecke">{a.hochrechnung.caveat}</span>
                    ) : (
                      <>
                        {nf.format(a.hochrechnung.value)} races
                        <span class="neben">
                          ≈ {ein(a.saisonNoetig)} seasons
                          {a.alterAmZiel !== null &&
                            ` – he would then be ${Math.round(a.alterAmZiel)}`}
                        </span>
                      </>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  {/* ------------------------------------------------------------ laufende Serien */}

  {
    serien.length > 0 && (
      <section>
        <h2>Active streaks</h2>
        <p class="unter">
          Streaks still open at their driver's most recent start. A race sat out does not break
          one – a driver who was not there had nothing to lose.
        </p>
        <div class="tabelle">
          <table>
            <thead>
              <tr>
                <th>Driver</th>
                <th>Streak</th>
                <th class="zahl">Length</th>
                <th>Record</th>
              </tr>
            </thead>
            <tbody>
              {serien.map((s) => (
                <tr>
                  <td><a class="zeile" href={pfad.fahrer(s.id)}>{s.name}</a></td>
                  <td>{s.art.titel}</td>
                  <td class="zahl"><b>{s.laenge}</b></td>
                  <td>
                    {s.rekord}
                    <span class="neben">
                      {s.rekordHalter.map((h, i) => (
                        <>
                          {i > 0 && ', '}
                          <a href={pfad.fahrer(h.id)}>{h.name}</a>
                        </>
                      ))}
                      {' · '}
                      {s.haeltRekord ? 'equalled' : `${s.fehlt} more to the record`}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  {/* ------------------------------------------------------------------ Methode */}

  <section>
    <h2>How this is worked out</h2>
    <div class="methode">
      <p>
        The history of every record is derived from the results themselves: all
        {' '}{nf.format(rennenGesamt)} races held since 1950 are walked through in chronological
        order, and after each one it is settled whether the top mark has moved. There is no
        curated list of record dates that anyone could forget to update.
      </p>
      <p>
        <b>Counting is by starts, not by entries.</b> That shifts individual dates away from the
        record books, which often count entries. Räikkönen, for instance, reached Barrichello's
        322 starts at Mugello in 2020 and passed him two races later at Sochi – his 326th
        <i>entry</i>, the mark usually quoted, did not fall until the Eifel Grand Prix. Both
        statements are correct; they count different things.
      </p>
      <p>
        <b>A projection is not a prediction.</b> It takes the strike rate of the past three
        seasons and carries it forward. A driver with too few starts in that window, or no
        success of that kind at all, gets no number – "infinitely many races" would be false
        precision. Where an active driver holds the record himself, it keeps growing while the
        challenger closes in; that is noted on the relevant row.
      </p>
      <p>
        The all-time points table is deliberately absent. The scoring systems have changed more
        than a dozen times – a record of that kind mostly measures the system.
      </p>
      <p class="weiter">
        The full lists are under <a href={pfad.seite('/records/')}>Records</a>, and the next race
        under <a href={pfad.seite('/preview/')}>Preview</a>.
      </p>
    </div>
  </section>
</Seite>

<style>
  h2 {
    margin: 2.75rem 0 0;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
  }

  .stand {
    margin: 1rem 0 0;
    font-size: 0.88rem;
    color: var(--muted);
  }

  .unter {
    max-width: 46rem;
    margin: 0.4rem 0 0;
    font-size: 0.88rem;
    color: var(--muted);
    text-wrap: pretty;
  }

  .hinweis {
    margin-top: 1.5rem;
    padding: 0.9rem 1rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 0.6rem;
  }

  /* ---------------------------------------------------------- Ereignisliste */

  .ereignisse {
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }

  .ereignisse li {
    display: grid;
    grid-template-columns: minmax(0, 9.5rem) minmax(0, 1fr);
    gap: 0.25rem 1rem;
    padding: 0.85rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.6rem;
  }

  .wann {
    display: grid;
    gap: 0.15rem;
    align-content: start;
    font-size: 0.82rem;
  }

  .wann b {
    color: var(--ink);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .wann a {
    color: var(--muted);
    text-decoration: none;
  }

  .wann a:hover {
    color: var(--accent);
  }

  .was > b {
    display: block;
    margin-top: 0.15rem;
    color: var(--ink);
    font-weight: 650;
  }

  .was p {
    margin: 0.3rem 0 0;
    font-size: 0.9rem;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .was .davor {
    font-size: 0.83rem;
    color: var(--muted);
  }

  .was .davor a {
    color: var(--ink-2);
    text-decoration: none;
  }

  .was .davor a:hover {
    color: var(--accent);
  }

  /*
   * Nicht `.marke`: So heißt in theme.css der Schriftzug der Kopfleiste, und
   * der ist global. Ein `display: flex` von dort machte aus dieser Plakette
   * eine Zeile.
   */
  .etikett {
    display: inline-block;
    padding: 0.1rem 0.45rem;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 999px;
  }

  .etikett.neu {
    color: var(--accent);
    background: var(--accent-wash);
  }

  .etikett.gleich {
    color: var(--muted);
    background: var(--surface-3);
  }

  /*
   * Zwei Selektoren statt `!important`: `.was p` und `.karte span` aus
   * theme.css sind spezifischer als ein einzelner Klassenname, und Astros
   * Bereichsstile heben die Spezifität nicht an.
   */
  .was .spur,
  .karte .spur {
    font-size: 0.82rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .spur a {
    color: var(--ink-2);
    text-decoration: none;
  }

  .spur a:hover {
    color: var(--accent);
  }

  /* --------------------------------------------------------- Saisonmarken */

  .marke-karte .titel {
    display: block;
    font-size: 0.82rem;
    color: var(--muted);
    font-weight: 600;
  }

  .gross {
    margin: 0.35rem 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
  }

  .gross a {
    color: var(--ink);
    font-weight: 650;
    text-decoration: none;
  }

  .gross a:hover {
    color: var(--accent);
  }

  .gross .wert {
    font-size: 0.85rem;
    color: var(--accent);
    font-weight: 600;
  }

  .marke-karte .spur {
    margin: 0.3rem 0 0;
  }

  .spur .fett {
    color: var(--ink-2);
    font-weight: 650;
  }

  .urteil {
    margin: 0.55rem 0 0;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.82rem;
    text-wrap: pretty;
  }

  .urteil.moeglich {
    color: var(--good);
  }

  .urteil.knapp {
    color: var(--muted);
  }

  /* ------------------------------------------------------------- Tabellen */

  .zahl {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  /*
   * Rennverweise in Tabellenzellen ruhig halten. In der Standardfarbe stünden
   * in „Ausbau seit" und „Zuletzt" zwei Spalten voller roter, unterstrichener
   * Links nebeneinander – der Blick fände dann keinen Anfang mehr.
   */
  .tabelle td a:not(.zeile) {
    color: var(--ink-2);
    text-decoration: none;
  }

  .tabelle td a:not(.zeile):hover {
    color: var(--accent);
  }

  td .neben {
    display: block;
    font-size: 0.76rem;
    color: var(--muted);
    text-wrap: pretty;
  }

  td .neben a {
    color: var(--muted);
    text-decoration: none;
  }

  td .neben a:hover {
    color: var(--accent);
  }

  tr.dringend td {
    background: var(--accent-wash);
  }

  .luecke {
    font-size: 0.82rem;
    color: var(--warn);
    text-wrap: pretty;
  }

  /* -------------------------------------------------------------- Methode */

  .methode {
    max-width: 46rem;
    margin-top: 1.25rem;
    padding: 1rem 1.15rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 0.6rem;
  }

  .methode p {
    margin: 0 0 0.75rem;
    font-size: 0.86rem;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .methode p:last-child {
    margin-bottom: 0;
  }

  .methode b {
    color: var(--ink);
  }

  .weiter {
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
    color: var(--muted) !important;
  }

  /* ---------------------------------------------------------- schmale Sicht */

  @media (max-width: 34rem) {
    .ereignisse li {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.35rem;
    }

    .wann {
      display: flex;
      flex-wrap: wrap;
      gap: 0.15rem 0.5rem;
    }
  }
</style>
