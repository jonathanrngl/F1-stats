---
/**
 * Fahrerprofil. Eine Seite je Fahrer, beim Bauen erzeugt.
 *
 * Alle Zahlen kommen aus der Engine und aus lib/profil.js, nicht aus SQL an
 * dieser Stelle – damit dieselbe Kennzahl hier, in der API und im Explorer aus
 * derselben Quelle stammt. Wo eine Kennzahl nicht belegt ist, steht ein
 * Gedankenstrich statt einer Null.
 */
import { datum, ein, plakette, prozent as proz, zahl } from '../../lib/format.js'
import Seite from '../../layouts/Seite.astro'
import Karriere from '../../components/Karriere.astro'
import Sprung from '../../components/Sprung.astro'
import MehrZeigen from '../../components/MehrZeigen.astro'
import { alle, eine, fahrerListe, pfad } from '../../lib/db.js'
import { land } from '../../lib/laender.js'
import { db } from '../../lib/db.js'
import { fahrerZusatz } from '../../lib/profil.js'
import {
  calculateAverageFinish, calculateAverageStart, calculateChampionships,
  calculateDNFRate, calculateEntries, calculateFastestLaps, calculatePodiumRate,
  calculatePodiums, calculatePoints, calculatePoles, calculatePoleToWinRate,
  calculatePositionsGained, calculateStarts, calculateStartsFromPole,
  calculateStreaks, calculateTeamMateComparison, calculateTrackPerformance,
  calculateWinRate, calculateWins, driverRaces,
} from '../../engine/driver.js'

export async function getStaticPaths() {
  return fahrerListe().map((f) => ({ params: { id: f.id } }))
}

const { id } = Astro.params

const fahrer = eine(
  `SELECT d.*, c.ioc AS land, c.name AS landName, c.demonym AS demonym
     FROM driver d LEFT JOIN country c ON c.id = d.nationality_id
    WHERE d.id = ?`,
  id,
)

const heimat = land(fahrer.demonym, fahrer.landName, fahrer.land)

/*
 * Sass dieser Fahrer je in einem Formel-1-Wagen? Fuer 103 der 860 lautet die
 * Antwort nein: Sie traten nur beim Indianapolis 500 an, das von 1950 bis 1960
 * zur Weltmeisterschaft zaehlte. Ihre Seite sieht sonst aus wie jede andere,
 * und das waere eine stille Behauptung.
 */
const inFormel1 =
  eine(
    `SELECT MAX(r.formula_one) AS ja
       FROM race_result rr JOIN race r ON r.id = rr.race_id
      WHERE rr.driver_id = ?`,
    id,
  ).ja === 1

const rennen = driverRaces(db(), id)
const titel = calculateChampionships(db(), id)
const serien = calculateStreaks(rennen)
/*
 * Alle Teamkollegen und Strecken, nicht nur die ersten acht und zehn: Die
 * ersten stehen offen, der Rest auf Knopfdruck darunter. Vorher fehlte, wer
 * nicht vorn stand, einfach.
 */
const duelle = calculateTeamMateComparison(db(), id)
const strecken = calculateTrackPerformance(db(), id, 2)
const zusatz = fahrerZusatz(id)

const namen = new Map(
  alle('SELECT id, display_name AS name FROM driver').map((d) => [d.id, d.name]),
)
const teamNamen = new Map(alle('SELECT id, name FROM constructor').map((t) => [t.id, t.name]))
const streckenNamen = new Map(alle('SELECT id, name FROM circuit').map((z) => [z.id, z.name]))

/*
 * Teams mit ihren Jahren. Nach Team gebündelt, nicht nach Abschnitt: Fangio
 * fuhr 1953 und noch einmal 1957/58 für Maserati – zweimal „Maserati" ohne
 * Jahreszahl sähe nach einem Fehler aus.
 */
const proTeam = new Map()
for (const r of rennen) {
  const e = proTeam.get(r.constructorId) ?? { id: r.constructorId, jahre: new Set() }
  e.jahre.add(r.year)
  proTeam.set(r.constructorId, e)
}
/** Zusammenhängende Jahre zu Spannen zusammenfassen: 1953, 1957–1958. */
const spannen = (jahre) => {
  const s = [...jahre].sort((a, b) => a - b)
  const teile = []
  let von = s[0]
  let bis = s[0]
  for (const j of s.slice(1)) {
    if (j === bis + 1) bis = j
    else {
      teile.push(von === bis ? String(von) : `${von}–${bis}`)
      von = bis = j
    }
  }
  teile.push(von === bis ? String(von) : `${von}–${bis}`)
  return teile.join(', ')
}
const teams = [...proTeam.values()].sort((a, b) => Math.min(...a.jahre) - Math.min(...b.jahre))

/** Zeigt den Wert, oder den Grund, warum es keinen gibt. */
const wert = (m, f = (v) => zahl(v)) => (m.value === null ? '–' : f(m.value))

const zeitraum =
  rennen.length === 0
    ? '–'
    : rennen[0].year === rennen.at(-1).year
      ? String(rennen[0].year)
      : `${rennen[0].year}–${rennen.at(-1).year}`

/*
 * Die Saisons kommen aus den Rennen, die Wertung wird nur dazugesucht. F1DB
 * führt in der Wertung nur, wer Punkte holte – aus ihr allein fehlten 1.585
 * Fahrer-Saisons, darunter Sennas letzte, 1994 bei Williams. So wie in
 * lib/profil.js.
 */
const wmProJahr = new Map(titel.seasons.map((s) => [s.year, s]))
const saisons = [...new Set(rennen.map((r) => r.year))].map(
  (year) => wmProJahr.get(year) ?? { year, position: null, points: 0, won: 0 },
)

/*
 * Die Saisonzahlen fuer das Bild – aus denselben Quellen wie die Tabelle
 * darunter, damit Bild und Tabelle nicht auseinanderlaufen koennen.
 */
const karriere = saisons.map((s) => {
  const jahrRennen = rennen.filter((r) => r.year === s.year)
  return {
    jahr: s.year,
    starts: jahrRennen.filter((r) => r.started).length,
    siege: jahrRennen.filter((r) => r.position === 1).length,
    podien: jahrRennen.filter((r) => r.classified && r.position <= 3).length,
    wmPlatz: s.position ?? null,
    meister: Boolean(s.won),
  }
})

const beschreibung =
  `${fahrer.display_name}: ${calculateStarts(rennen).value} starts, ` +
  `${calculateWins(rennen).value} wins, ${calculatePodiums(rennen).value} podiums, ` +
  `${titel.titles.value} World Championships (${zeitraum}).`

const siege = calculateWins(rennen)
const titelZahl = titel.titles.value ?? 0
const titelJahre = titel.seasons.filter((s) => s.won).map((s) => s.year)

/** Nur Abschnitte, die es auf dieser Seite auch gibt. */
const ziele = [
  { id: 'zahlen', label: 'Numbers' },
  karriere.length > 1 && { id: 'karriere', label: 'Career' },
  saisons.length > 0 && { id: 'saisons', label: 'Seasons' },
  { id: 'rennen', label: 'Races' },
  duelle.length > 0 && { id: 'teamkollegen', label: 'Team-mates' },
  strecken.length > 0 && { id: 'strecken', label: 'Circuits' },
].filter(Boolean)

const { sprint, besondere, geburt, familie, meilensteine } = zusatz
const jeSaison = Map.groupBy(zusatz.rennen, (r) => r.jahr)
const ergebnis = (r) => (r.gewertet ? `P${r.platz}` : r.text)

const SEITE = 'https://jonathanrngl.github.io'
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: fahrer.display_name,
  ...(fahrer.full_name !== fahrer.display_name ? { alternateName: fahrer.full_name } : {}),
  ...(fahrer.date_of_birth ? { birthDate: fahrer.date_of_birth } : {}),
  ...(fahrer.date_of_death ? { deathDate: fahrer.date_of_death } : {}),
  ...(geburt?.ort ? { birthPlace: [geburt.ort, geburt.land].filter(Boolean).join(', ') } : {}),
  nationality: heimat.name,
  jobTitle: 'Racing driver',
  url: `${SEITE}${pfad.fahrer(id)}`,
}
---

<Seite
  titel={`${fahrer.display_name} – statistics and career`}
  beschreibung={beschreibung}
  strukturiert={[person]}
  brotkrumen={[{ name: 'Drivers', pfad: '/drivers/' }]}
>
  <header class="seitenkopf">
    <span class="wappen" title={heimat.name}>{heimat.code}</span>
    <div>
      <p class="oberzeile">
        <a href={pfad.seite('/drivers/')}>Drivers</a>
        <span class="trenner">/</span>
        <span class="still">{heimat.name}</span>
      </p>
      <h1>{fahrer.display_name}</h1>
      {/*
        * Der Name aus dem Pass steht hier und nur hier. In der Überschrift
        * wäre er falsch am Platz – niemand sucht nach „Andreas Nikolaus
        * Lauda" –, aber auf der Profilseite gehört er dazu.
        */}
      <ul class="eckdaten">
        {titelZahl > 0 && (
          <li class="stark">{titelZahl}× World Champion</li>
        )}
        <li>{zeitraum}</li>
        {fahrer.abbreviation && <li>{fahrer.abbreviation}</li>}
        {geburt?.nummer && <li>Car number {geburt.nummer}</li>}
        {fahrer.date_of_birth && (
          <li>Born {datum(fahrer.date_of_birth)}{geburt?.ort && ` in ${geburt.ort}${geburt.land && geburt.land !== heimat.name ? `, ${geburt.land}` : ''}`}</li>
        )}
        {fahrer.date_of_death && <li>Died {datum(fahrer.date_of_death)}</li>}
        {fahrer.full_name !== fahrer.display_name && <li>{fahrer.full_name}</li>}
      </ul>
      {familie.length > 0 && (
        <p class="familie">
          Family in Formula 1:{' '}
          {familie.map((v, i) => (
            <>
              {i > 0 && ', '}
              {v.mitSeite ? <a href={pfad.fahrer(v.id)}>{v.name}</a> : v.name} ({v.wort})
            </>
          ))}
        </p>
      )}
      <p class="aktionen">
        <a class="knopf" href={`${pfad.seite('/comparison/')}?a=${fahrer.id}`}>Compare with another driver →</a>
        <a class="knopf leise" href={`${pfad.seite('/explorer/')}?fahrer=${fahrer.id}&d=saison&s=punkte`}>Season by season in the Explorer</a>
      </p>
    </div>
  </header>

  {!inFormel1 && (
    <p class="hinweis warn">
      Never drove a Formula 1 race. All of these appearances were at the Indianapolis 500,
      which counted towards the drivers' championship from 1950 to 1960 but was run to
      different regulations with a different field.
    </p>
  )}

  <ul class="kacheln">
    <li><span>Starts</span><b>{wert(calculateStarts(rennen))}</b>
      {calculateEntries(rennen).value !== calculateStarts(rennen).value && (
        <i>{calculateEntries(rennen).value} entries</i>
      )}
    </li>
    <li class={siege.value > 0 ? 'stark' : undefined}>
      <span>Wins</span><b>{wert(siege)}</b><i>{proz(calculateWinRate(rennen))} of starts</i>
    </li>
    <li><span>Podiums</span><b>{wert(calculatePodiums(rennen))}</b><i>{proz(calculatePodiumRate(rennen))} of starts</i></li>
    <li><span>Pole positions</span><b>{wert(calculatePoles(rennen))}</b>
      <i>{wert(calculateStartsFromPole(rennen))}× started from P1</i></li>
    <li><span>Fastest laps</span><b>{wert(calculateFastestLaps(rennen))}</b></li>
    {sprint.starts > 0 && (
      <li><span>Sprint wins</span><b>{sprint.siege}</b><i>{sprint.starts} sprints · {ein(sprint.punkte)} points</i></li>
    )}
    {besondere.dotdMoeglich === 1 && (
      <li><span>Driver of the Day</span><b>{besondere.dotd ?? 0}</b><i>fan vote, since 2016</i></li>
    )}
    {besondere.slams > 0 && (
      <li><span>Grand Slams</span><b>{besondere.slams}</b><i>pole, win, fastest lap, every lap led</i></li>
    )}
    <li class={titelZahl > 0 ? 'stark' : undefined}>
      <span>Titles</span><b>{wert(titel.titles)}</b>
      <i>{titelJahre.length > 0 ? titelJahre.join(', ') : `best finish ${wert(titel.best, (v) => 'P' + v)}`}</i>
    </li>
  </ul>

  <Sprung ziele={ziele} />

  <section class="abschnitt" id="zahlen">
    <div class="abschnitt-kopf"><div><h2>Career numbers</h2></div></div>
    <ul class="daten">
      <li><span>Avg grid position</span><b>{ein(calculateAverageStart(rennen).value)}</b></li>
      <li><span>Avg finish</span><b>{ein(calculateAverageFinish(rennen).value)}</b></li>
      <li><span>Retirement rate</span><b>{proz(calculateDNFRate(rennen))}</b></li>
      <li><span>Pole-to-win conversion</span><b>{proz(calculatePoleToWinRate(rennen))}</b></li>
      <li><span>Positions gained</span><b>{wert(calculatePositionsGained(rennen), (v) => (v > 0 ? '+' : '') + zahl(v))}</b></li>
      <li><span>Points scored</span><b>{ein(calculatePoints(rennen).value)}</b></li>
      <li><span>Longest winning streak</span><b>{serien.wins.length || '–'}</b></li>
      <li><span>Longest podium streak</span><b>{serien.podiums.length || '–'}</b></li>
      <li><span>Longest points-scoring streak</span><b>{serien.points.length || '–'}</b></li>
      <li class="breit">
        <span>Teams</span>
        <b>
          {teams.map((t, i) => (
            <>
              {i > 0 && ' · '}
              <a href={pfad.team(t.id)}>{teamNamen.get(t.id)}</a> ({spannen(t.jahre)})
            </>
          ))}
        </b>
      </li>
    </ul>
    <p class="fussnote">
      Pole position means the fastest time in qualifying. That is not the same as a start from
      P1 – grid penalties move a driver down the grid. Up to the 2000s the two numbers
      coincide.
    </p>
  </section>

  {karriere.length > 1 && (
    <section class="abschnitt" id="karriere">
      <div class="abschnitt-kopf"><div><h2>The career at a glance</h2></div></div>
      <Karriere saisons={karriere} name={fahrer.display_name} tabelle={false} />
    </section>
  )}

  {saisons.length > 0 && (
    <section class="abschnitt" id="saisons">
      <div class="abschnitt-kopf"><div><h2>Season by season</h2></div></div>
      <div class="tabelle">
        <table>
          <thead>
            <tr>
              <th>Season</th><th>Team</th>
              <th class="num">Races</th><th class="num">Wins</th><th class="num">Podiums</th>
              <th class="num">Points</th><th class="num">Championship</th>
            </tr>
          </thead>
          <tbody>
            {saisons.map((s) => {
              const jahrRennen = rennen.filter((r) => r.year === s.year)
              return (
                <tr class={s.won ? 'meister' : undefined}>
                  <th scope="row"><a class="zeile" href={pfad.saison(s.year)}>{s.year}</a></th>
                  <td class="leise">
                    {[...new Set(jahrRennen.map((r) => r.constructorId))].map((t, i) => (
                      <>{i > 0 && ', '}<a class="leise" href={pfad.team(t)}>{teamNamen.get(t)}</a></>
                    ))}
                  </td>
                  <td class="num">{jahrRennen.filter((r) => r.started).length}</td>
                  <td class="num">{jahrRennen.filter((r) => r.position === 1).length || ''}</td>
                  <td class="num">{jahrRennen.filter((r) => r.classified && r.position <= 3).length || ''}</td>
                  <td class="num">{ein(s.points)}</td>
                  <td class="num">
                    {s.position ? <span class={plakette(s.position)}>P{s.position}</span> : '–'}
                  </td>
                </tr>
              )
            })}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <section class="abschnitt" id="rennen">
    <div class="abschnitt-kopf">
      <div>
        <h2>Every race</h2>
        <p>
          {zusatz.rennen.length} {zusatz.rennen.length === 1 ? 'entry' : 'entries'}
          {calculateStarts(rennen).value !== zusatz.rennen.length && `, ${calculateStarts(rennen).value} of them started`}.
          DNQ: did not qualify; DNS: did not start; DNF: retired.
        </p>
      </div>
    </div>
    {meilensteine.length > 0 && (
      <ul class="meilensteine">
        {meilensteine.map((m) => (
          <li>
            <span>{m.was}</span>
            <a href={pfad.rennen(m.r.id)}>{m.r.name} {m.r.jahr}</a>
            <i>{ergebnis(m.r)} · {m.r.team}</i>
          </li>
        ))}
      </ul>
    )}
    <details class="alle-rennen" open={zusatz.rennen.length <= 20}>
      <summary>All {zusatz.rennen.length} {zusatz.rennen.length === 1 ? 'race' : 'races'}, season by season</summary>
      <div class="tabelle">
        <table>
          <thead>
            <tr>
              <th class="num" scope="col">Year</th><th scope="col">Race</th><th scope="col">Team</th>
              <th class="num" scope="col">Grid</th><th class="num" scope="col">Result</th><th class="num" scope="col">Points</th>
            </tr>
          </thead>
          <tbody>
            {[...jeSaison.values()].flatMap((liste) =>
              liste.map((r, i) => (
                <tr class={r.gestartet && r.gewertet ? undefined : 'raus'}>
                  <td class="num leise">{i === 0 ? r.jahr : ''}</td>
                  <th scope="row">
                    <a class="zeile" href={pfad.rennen(r.id)}>{r.name}</a>
                    {r.pole === 1 && <span class="etikett" title="Pole position">pole</span>}
                    {r.schnellste === 1 && <span class="etikett akzent" title="Fastest lap">fastest lap</span>}
                    {r.geteilt === 1 && <span class="etikett" title="Shared car">shared</span>}
                  </th>
                  <td class="leise"><a class="leise" href={pfad.team(r.teamId)}>{r.team}</a></td>
                  <td class="num">{r.start ?? '–'}</td>
                  <td class="num"><span class={plakette(r.gewertet ? r.platz : null)}>{ergebnis(r)}</span></td>
                  <td class="num fett">{r.punkte ? ein(r.punkte) : ''}</td>
                </tr>
              )),
            )}
          </tbody>
        </table>
      </div>
    </details>
  </section>

  {duelle.length > 0 && (
    <section class="abschnitt" id="teamkollegen">
      <div class="abschnitt-kopf">
        <div>
          <h2>Against team-mates</h2>
          <p>
            Same car, same races. In the race only those where both reached the finish count –
            a retirement says nothing about the head-to-head.
          </p>
        </div>
      </div>
      <div class="tabelle">
        <table>
          <thead>
            <tr>
              <th>Team-mate</th><th>Years</th>
              <th class="num">Races</th><th class="num">Qualifying</th><th class="num">Points</th><th></th>
            </tr>
          </thead>
          <tbody>
            {duelle.map((d, i) => (
              <tr data-weitere={i >= 8 ? '' : undefined}>
                <th scope="row"><a class="zeile" href={pfad.fahrer(d.driverId)}>{namen.get(d.driverId)}</a></th>
                <td class="leise">
                  {d.years.length === 1 ? d.years[0] : `${d.years[0]}–${d.years.at(-1)}`}
                </td>
                <td class={`num${d.raceWins * 2 > d.raceDuels ? ' gut' : ''}`}>{d.raceWins}:{d.raceDuels - d.raceWins}</td>
                <td class={`num${d.qualiWins * 2 > d.qualiDuels ? ' gut' : ''}`}>{d.qualiWins}:{d.qualiDuels - d.qualiWins}</td>
                <td class="num">{ein(d.pointsSelf)} : {ein(d.pointsOther)}</td>
                {/* Der Gedanke "und wer war besser?" entsteht genau hier.
                    Die Vergleichsseite liest a und b aus der Adresse. */}
                <td class="num">
                  <a
                    class="vergleichen"
                    href={`${pfad.seite('/comparison/')}?a=${fahrer.id}&b=${d.driverId}`}
                  >
                    Compare →
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {duelle.length > 8 && <MehrZeigen anzahl={duelle.length - 8} wort="team-mates" />}
      <p class="fussnote">Green: {fahrer.display_name} came out ahead in that duel.</p>
    </section>
  )}

  {strecken.length > 0 && (
    <section class="abschnitt" id="strecken">
      <div class="abschnitt-kopf"><div><h2>Strongest circuits</h2><p>Circuits with at least two starts, most wins first.</p></div></div>
      <div class="tabelle">
        <table>
          <thead>
            <tr>
              <th>Circuit</th><th class="num">Starts</th><th class="num">Wins</th>
              <th class="num">Podiums</th><th class="num">Avg finish</th>
            </tr>
          </thead>
          <tbody>
            {strecken.map((s, i) => (
              <tr data-weitere={i >= 10 ? '' : undefined}>
                <th scope="row"><a class="zeile" href={pfad.strecke(s.circuitId)}>{streckenNamen.get(s.circuitId)}</a></th>
                <td class="num">{s.starts}</td>
                <td class="num">{s.wins.value || ''}</td>
                <td class="num">{s.podiums.value || ''}</td>
                <td class="num">{ein(s.averageFinish.value)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {strecken.length > 10 && <MehrZeigen anzahl={strecken.length - 10} wort="circuits" />}
    </section>
  )}
</Seite>

<style>
  .familie { margin: 0.6rem 0 0; font-size: 0.9rem; color: var(--ink-2); }
  .aktionen { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0.9rem 0 0; }

  .meilensteine {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(15rem, 100%), 1fr));
    gap: 0.5rem;
    margin: 0 0 0.9rem;
    padding: 0;
    list-style: none;
  }

  .meilensteine li {
    display: grid;
    gap: 0.1rem;
    padding: 0.65rem 0.85rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-s);
  }

  .meilensteine span { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .meilensteine a { font-weight: 650; color: var(--ink); text-decoration: none; }
  .meilensteine a:hover { color: var(--accent); text-decoration: underline; }
  .meilensteine i { font-style: normal; font-size: 0.84rem; color: var(--muted); }

  .alle-rennen summary { cursor: pointer; min-height: 2.25rem; font-weight: 600; color: var(--ink); }
  .alle-rennen .tabelle { margin-top: 0.5rem; }

  .vergleichen {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.2rem 0.65rem;
    font-size: 0.8rem;
    font-weight: 650;
    color: var(--ink-2);
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  .vergleichen:hover { color: var(--accent); border-color: var(--accent); }
</style>
