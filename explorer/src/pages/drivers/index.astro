---
import { zahl } from '../../lib/format.js'
import Seite from '../../layouts/Seite.astro'
import { fahrerListe, pfad } from '../../lib/db.js'

const fahrer = fahrerListe()
// Nach Siegen sortiert zeigt die Übersicht sofort, worauf es ankommt.
const nachSiegen = [...fahrer].sort(
  (a, b) => (b.siege ?? 0) - (a.siege ?? 0) || (b.starts ?? 0) - (a.starts ?? 0),
)
---

<Seite
  titel="Every Formula 1 driver since 1950"
  beschreibung={`${zahl(fahrer.length)} drivers with starts, wins, podiums and titles.`}
>
  <h1>Drivers</h1>
  <p class="lead">
    {zahl(fahrer.length)} drivers who were entered at least once since 1950. Click a column
    heading to sort by it.
  </p>

  <div class="tabelle">
    <table>
      <thead>
        <tr>
          <th><button type="button" data-spalte="0" data-art="name">Driver</button></th>
          <th><button type="button" data-spalte="1" data-art="jahr">Period</button></th>
          <th class="num"><button type="button" data-spalte="2" data-art="zahl">Starts</button></th>
          <th class="num"><button type="button" data-spalte="3" data-art="zahl" data-aktiv="1">Wins</button></th>
          <th class="num"><button type="button" data-spalte="4" data-art="zahl">Podiums</button></th>
          <th class="num"><button type="button" data-spalte="5" data-art="zahl">Titles</button></th>
        </tr>
      </thead>
      <tbody>
        {/*
          * Nur der Nachname hängt an der Zeile – die Zahlen stehen ohnehin in
          * den Zellen, und 860 Zeilen mal fünf Attribute blähten die Seite von
          * 240 auf 507 KB, ohne etwas hinzuzufügen.
          */}
        {nachSiegen.map((f) => (
          <tr data-name={f.nachname ?? f.name}>
            <td>
              <span class="kuerzel" title={f.landName ?? ''}>{f.land ?? '—'}</span>
              <a class="zeile" href={pfad.fahrer(f.id)}>{f.name}</a>
            </td>
            <td style="color:var(--muted)">{f.von === f.bis ? f.von : `${f.von}–${f.bis}`}</td>
            <td class="num">{f.starts ?? 0}</td>
            <td class="num">{f.siege || ''}</td>
            <td class="num">{f.podien || ''}</td>
            <td class="num">{f.titel || ''}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Seite>

<script>
  /*
   * Sortieren im Browser. Die Reihenfolge nach Siegen kommt weiterhin fertig
   * vom Server – wer nichts anklickt, bekommt sie auch ohne JavaScript.
   *
   * Gelesen wird aus den Zellen, nicht aus zusätzlichen Attributen. Zwei
   * Dinge muss das berücksichtigen: Die Seite zeigt keine Null, sondern eine
   * leere Zelle, und der Zeitraum steht als „2007–2026" – sortiert wird nach
   * dem letzten Jahr, also den letzten vier Ziffern.
   */
  const koerper = document.querySelector('main tbody')
  const zeilen = [...koerper.querySelectorAll('tr')]
  const knoepfe = [...document.querySelectorAll('main thead button')]

  const STARTS = 2

  /* Zahlen absteigend, Namen aufsteigend – das ist jeweils die nützliche Richtung. */
  let sortiert = { spalte: 3, ab: true }

  const zellen = new Map(zeilen.map((tr) => [tr, [...tr.cells]]))
  const zahlAus = (tr, i) => Number(zellen.get(tr)[i].textContent.trim()) || 0

  function wert(tr, spalte, art) {
    if (art === 'name') return tr.dataset.name ?? ''
    if (art === 'jahr') return Number(zellen.get(tr)[spalte].textContent.trim().slice(-4)) || 0
    return zahlAus(tr, spalte)
  }

  function sortiere(spalte, art) {
    const ab = sortiert.spalte === spalte ? !sortiert.ab : art !== 'name'
    sortiert = { spalte, ab }

    zeilen.sort((a, b) => {
      const x = wert(a, spalte, art)
      const y = wert(b, spalte, art)
      const v = art === 'name' ? String(x).localeCompare(String(y), 'en') : x - y
      /* Gleichstand nach Starts, damit die Reihenfolge nicht zufällig wirkt. */
      return (ab ? -v : v) || zahlAus(b, STARTS) - zahlAus(a, STARTS)
    })

    const stueck = document.createDocumentFragment()
    for (const tr of zeilen) stueck.append(tr)
    koerper.append(stueck)

    for (const k of knoepfe) {
      const an = Number(k.dataset.spalte) === spalte
      k.dataset.aktiv = an ? '1' : ''
      k.closest('th').setAttribute('aria-sort', an ? (ab ? 'descending' : 'ascending') : 'none')
      k.dataset.richtung = an && !ab ? 'auf' : ''
    }
  }

  for (const k of knoepfe) {
    k.addEventListener('click', () => sortiere(Number(k.dataset.spalte), k.dataset.art))
  }
</script>
