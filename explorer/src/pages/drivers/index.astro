---
import { zahl } from '../../lib/format.js'
import Seite from '../../layouts/Seite.astro'
import Filter from '../../components/Filter.astro'
import Sortierung from '../../components/Sortierung.astro'
import { fahrerListe, pfad } from '../../lib/db.js'

const fahrer = fahrerListe()
const nurIndy = fahrer.filter((f) => f.inFormel1 === 0).length
// Nach Siegen sortiert zeigt die Übersicht sofort, worauf es ankommt.
const nachSiegen = [...fahrer].sort(
  (a, b) => (b.siege ?? 0) - (a.siege ?? 0) || (b.starts ?? 0) - (a.starts ?? 0),
)
const neuestesJahr = Math.max(...fahrer.map((f) => f.bis ?? 0))
---

<Seite
  titel="Every Formula 1 driver since 1950"
  beschreibung={`${zahl(fahrer.length)} drivers with starts, wins, podiums and titles.`}
>
  <header class="seitenkopf">
    <div>
      <p class="oberzeile">Drivers</p>
      <h1>Every driver since 1950</h1>
      <p class="lead">
        {zahl(fahrer.length)} drivers who were entered at least once. Type a name, or pick a
        quick filter; click a column heading to sort.
      </p>
    </div>
  </header>

  <Filter
    platzhalter="Filter by name, country or period"
    einheit={['driver', 'drivers']}
    pillen={[
      { label: 'Race winners', spalte: 3, art: 'gefuellt' },
      { label: 'World Champions', spalte: 5, art: 'gefuellt' },
      { label: `Active in ${neuestesJahr}`, spalte: 1, art: 'bis', wert: neuestesJahr },
    ]}
  />

  <div class="tabelle lang">
    <table>
      <thead>
        <tr>
          <th><button type="button" data-spalte="0" data-art="name">Driver</button></th>
          <th><button type="button" data-spalte="1" data-art="jahr">Period</button></th>
          <th class="num"><button type="button" data-spalte="2" data-art="zahl">Starts</button></th>
          <th class="num"><button type="button" data-spalte="3" data-art="zahl" data-aktiv="1">Wins</button></th>
          <th class="num"><button type="button" data-spalte="4" data-art="zahl">Podiums</button></th>
          <th class="num"><button type="button" data-spalte="5" data-art="zahl">Titles</button></th>
        </tr>
      </thead>
      <tbody>
        {/*
          * Nur der Nachname hängt an der Zeile – die Zahlen stehen ohnehin in
          * den Zellen, und 860 Zeilen mal fünf Attribute blähten die Seite von
          * 240 auf 507 KB, ohne etwas hinzuzufügen.
          */}
        {nachSiegen.map((f) => (
          <tr data-name={f.nachname ?? f.name}>
            <td>
              <span class="kuerzel" title={f.landName ?? ''}>{f.land ?? '—'}</span>
              <a class="zeile" href={pfad.fahrer(f.id)}>{f.name}</a>
              {f.inFormel1 === 0 && <span class="etikett" title="Indianapolis 500 only – never drove a Formula 1 race">Indy</span>}
            </td>
            <td class="leise">{f.von === f.bis ? f.von : `${f.von}–${f.bis}`}</td>
            <td class="num">{f.starts ?? 0}</td>
            <td class="num">{f.siege || ''}</td>
            <td class="num">{f.podien || ''}</td>
            <td class="num meister">{f.titel || ''}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="fussnote">
    <b>Indy:</b> {nurIndy} of these drivers never drove a Formula 1 race. The Indianapolis 500
    counted towards the drivers' championship from 1950 to 1960 but was run to different
    regulations with a different field – their points counted, so they belong in the
    standings, and they are marked.
  </p>

  <Sortierung vorsortiert={3} gleichstand={2} />
</Seite>
