---
import Seite from '../../layouts/Seite.astro'
import { fahrerListe, pfad } from '../../lib/db.js'

const fahrer = fahrerListe()
const nf = new Intl.NumberFormat('en-GB')
// Nach Siegen sortiert zeigt die Übersicht sofort, worauf es ankommt.
const nachSiegen = [...fahrer].sort(
  (a, b) => (b.siege ?? 0) - (a.siege ?? 0) || (b.starts ?? 0) - (a.starts ?? 0),
)
---

<Seite
  titel="Every Formula 1 driver since 1950"
  beschreibung={`${fahrer.length} drivers with starts, wins, podiums and titles.`}
>
  <h1>Drivers</h1>
  <p class="lead">
    {nf.format(fahrer.length)} drivers who were entered at least once since 1950. Sorted by
    wins.
  </p>

  <div class="tabelle">
    <table>
      <thead>
        <tr>
          <th>Driver</th>
          <th>Period</th>
          <th class="num">Starts</th>
          <th class="num">Wins</th>
          <th class="num">Podiums</th>
          <th class="num">Titles</th>
        </tr>
      </thead>
      <tbody>
        {nachSiegen.map((f) => (
          <tr>
            <td>
              <span class="kuerzel" title={f.landName ?? ''}>{f.land ?? '—'}</span>
              <a class="zeile" href={pfad.fahrer(f.id)}>{f.name}</a>
            </td>
            <td style="color:var(--muted)">{f.von === f.bis ? f.von : `${f.von}–${f.bis}`}</td>
            <td class="num">{f.starts ?? 0}</td>
            <td class="num">{f.siege || ''}</td>
            <td class="num">{f.podien || ''}</td>
            <td class="num">{f.titel || ''}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Seite>
