---
import Seite from '../../layouts/Seite.astro'
import Quiz from '../../components/Quiz.jsx'
import { db, eine } from '../../lib/db.js'
import { zahl } from '../../lib/format.js'
import { quizFragen, quizUebersicht, STUFEN } from '../../engine/quiz.js'

/*
 * Die Fragen selbst lädt die Insel als Datei nach (/data/quiz.json). Hier
 * kommen nur die Zahlen je Bereich und Stufe mit – so steht die Auswahl mit
 * ihren Zahlen sofort da, und die Seite trägt nicht 350 KB Fragen im HTML.
 */
const fragen = quizFragen(db())
const bereiche = quizUebersicht(fragen)

const stand = eine(`
  SELECT r.year AS jahr, g.full_name AS gp
    FROM race r JOIN grand_prix g ON g.id = r.grand_prix_id
   WHERE EXISTS (SELECT 1 FROM race_result rr WHERE rr.race_id = r.id)
   ORDER BY r.date DESC LIMIT 1`)
---

<Seite
  titel="Formula 1 quiz: from easy to expert"
  beschreibung={`${zahl(fragen.length)} questions on drivers, teams, seasons, races, circuits, records, engines and tyres, in three levels of difficulty.`}
>
  <header class="seitenkopf">
    <div>
      <p class="oberzeile">Analysis</p>
      <div class="titelblock">
        <h1>Quiz</h1>
        <p class="lead">
          {zahl(fragen.length)} questions on Formula 1 since 1950, in three levels of difficulty.
          The answers are current to {stand ? `the ${stand.jahr} ${stand.gp}` : 'the latest race'}.
        </p>
      </div>
    </div>
  </header>

  <p class="hinweis nur-ohne-js">
    The quiz runs in your browser and needs JavaScript. Its questions are drawn from the
    {' '}<a href={`${import.meta.env.BASE_URL}records/`}>records</a> and the season, race and driver pages.
  </p>

  <div class="nur-mit-js">
    <Quiz bereiche={bereiche} stufen={STUFEN} client:load />
  </div>

  <details class="erklaerung abschnitt">
    <summary>Where the questions come from</summary>
    <div>
      <p>
        <b>No question is written by hand.</b> Each one is generated from the same results that
        fill the rest of this site, every time the site is rebuilt. When a record falls, the
        question about it changes with it.
      </p>
      <p>
        <b>The wrong answers are chosen to be tempting.</b> Asked who won a title, you choose
        between the champion and the drivers who finished right behind. Asked for a team-mate, the
        alternatives raced for other teams that same year. Asked where a Grand Prix was held, the
        alternatives are other circuits that have hosted it.
      </p>
      <p>
        <b>Difficulty follows time and fame.</b> The last dozen seasons and the best-known names are
        easy; from 1985 on is medium; the early decades, pole-sitters and the fine print are hard.
      </p>
      <p>
        <b>Every answer has a way to check it.</b> After each question, a link leads to the page
        the answer comes from.
      </p>
    </div>
  </details>
</Seite>

<style is:global>
  .quiz { margin-top: var(--abstand-2); }

  /* ------------------------------------------------------------ Auswahl */

  /*
   * Die Auswahl steht auf dem Grund, in Gruppen ohne Kasten. Jede Wahl ist
   * eine flache Option: nicht gewählt mit Rand, gewählt gefüllt in Tinte –
   * dasselbe Muster wie .pillen und .wahl-chip in theme.css.
   */
  .quiz-wahl { display: grid; gap: var(--abstand-5); max-width: 56rem; }

  .quiz-wahl fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: none;
  }

  .quiz-wahl legend {
    margin-bottom: var(--abstand-2);
    padding: 0;
    font-size: var(--text-2);
    font-weight: 600;
    color: var(--muted);
  }

  /* Echte Radios unter flachen Optionen: Pfeiltasten, Formularverhalten und
     Bildschirmleser gibt es damit umsonst. */
  .stufenwahl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(11rem, 100%), 1fr));
    gap: var(--abstand-2);
  }

  .stufenwahl label {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--abstand-1);
    padding: var(--abstand-3);
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--border-input);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .stufenwahl label:hover { border-color: var(--ink); }
  .stufenwahl b { font-weight: 700; }
  .stufenwahl span { font-size: var(--text-2); color: var(--ink-2); text-wrap: pretty; }
  .stufenwahl i { font-style: normal; font-size: var(--text-2); color: var(--muted); font-variant-numeric: tabular-nums; }

  .stufenwahl label.an,
  .stufenwahl label.an :is(span, i) { color: var(--plane); }
  .stufenwahl label.an { background: var(--ink); border-color: var(--ink); }

  .stufenwahl input,
  .laengenwahl input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .stufenwahl label:has(input:focus-visible),
  .laengenwahl label:has(input:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  .themenwahl,
  .laengenwahl { display: flex; flex-wrap: wrap; gap: var(--abstand-1); }

  .themenwahl button,
  .laengenwahl label {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.25rem;
    padding: var(--abstand-1) var(--abstand-3);
    font: inherit;
    font-size: var(--text-2);
    font-weight: 550;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--border-input);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .themenwahl button:hover,
  .laengenwahl label:hover { border-color: var(--ink); }

  .themenwahl button[aria-pressed='true'],
  .laengenwahl label.an { color: var(--plane); background: var(--ink); border-color: var(--ink); }

  /* „Select all“ ist kein Thema: ein Verweis-Knopf ohne Rand. */
  .themenwahl button.alle {
    color: var(--muted);
    background: none;
    border-color: transparent;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .themenwahl button.alle:hover { color: var(--ink); border-color: transparent; text-decoration-thickness: 2px; }

  .laengenwahl label { min-width: 3.25rem; font-variant-numeric: tabular-nums; }

  .quiz-start {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--abstand-2) var(--abstand-4);
    margin-top: var(--abstand-1);
  }

  .quiz-start p { margin: 0; color: var(--muted); text-wrap: pretty; }

  /* Die Hauptaktion: gefüllt in Tinte, wie .knopf in theme.css. */
  .quiz-knopf {
    min-height: 2.75rem;
    padding: var(--abstand-2) var(--abstand-5);
    font: inherit;
    font-weight: 650;
    color: var(--plane);
    background: var(--ink);
    border: 1px solid var(--ink);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .quiz-knopf:hover { background: var(--ink-2); border-color: var(--ink-2); }
  .quiz-knopf:disabled { opacity: 0.55; cursor: progress; }
  .quiz-knopf.leise { color: var(--ink); background: transparent; border-color: var(--border-input); }
  .quiz-knopf.leise:hover { background: var(--surface-2); border-color: var(--ink); }

  /* Ein Fehler ist eine blaue Flagge wie jeder Hinweis – Rot heißt hier „Ausfall“. */
  .quiz-fehler {
    max-width: 50rem;
    margin: 0;
    padding: var(--abstand-3) var(--abstand-4);
    color: var(--ink-2);
    background: var(--surface);
    border-left: 4px solid var(--flagge-blau);
  }

  /* -------------------------------------------------------------- Frage */

  /* Die Frage steht flach auf der Fläche: kein Rahmen, keine Rundung, kein Schatten. */
  .quiz-frage {
    max-width: 48rem;
    padding: var(--abstand-5);
    background: var(--surface);
  }

  .quiz-kopf {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--abstand-2) var(--abstand-1);
    font-size: var(--text-2);
    color: var(--muted);
  }

  .quiz-kopf .zaehler { margin-right: var(--abstand-2); }
  .quiz-kopf b { color: var(--ink); font-variant-numeric: tabular-nums; }
  .quiz-kopf .stand { margin-left: auto; }
  /* Bereich und Stufe als schlichte Etiketten: die Stufe steht im Wort, nicht in einer Farbe. */
  .quiz-kopf .etikett { margin-left: var(--abstand-1); }

  /*
   * Fortschritt als Reihe von Segmenten: grün richtig, rot falsch, wie die
   * Antworten selbst. Man sieht den Verlauf der Runde, ohne zu zählen.
   */
  .quiz-leiste {
    display: flex;
    gap: var(--abstand-1);
    margin: var(--abstand-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .quiz-leiste li { flex: 1; height: var(--abstand-1); background: var(--surface-3); }
  .quiz-leiste li.jetzt { background: var(--axis); }
  .quiz-leiste li.gut { background: var(--good); }
  .quiz-leiste li.schlecht { background: var(--danger-fg); }

  .quiz-frage h2 {
    margin: var(--abstand-4) 0;
    line-height: 1.25;
    outline: none;
  }

  .antworten {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    gap: var(--abstand-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .antworten button {
    display: flex;
    align-items: center;
    gap: var(--abstand-3);
    width: 100%;
    height: 100%;
    padding: var(--abstand-3);
    font: inherit;
    font-weight: 600;
    text-align: left;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--border-input);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .antworten button:not(:disabled):hover { border-color: var(--ink); background: var(--surface-2); }
  .antworten button:disabled { cursor: default; }

  .antworten kbd {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    font: inherit;
    font-size: var(--text-2);
    font-weight: 600;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-s);
  }

  .antworten span { flex: 1; min-width: 0; overflow-wrap: anywhere; }
  .antworten i { flex: none; font-style: normal; font-weight: 800; }

  .antworten button.gut { color: var(--ink); background: var(--good-wash); border-color: var(--good); box-shadow: inset 0 0 0 1px var(--good); }
  .antworten button.gut kbd,
  .antworten button.gut i { color: var(--good); border-color: var(--good); }
  .antworten button.schlecht { color: var(--danger-fg); background: var(--danger-bg); border-color: var(--danger-border); }
  .antworten button.schlecht kbd,
  .antworten button.schlecht i { color: var(--danger-fg); border-color: var(--danger-border); }
  /* Die übrigen Antworten treten zurück, bleiben aber lesbar. */
  .antworten button.still { color: var(--muted); border-color: var(--border); }

  /* Die Auflösung: ein Absatz mit Streifen wie ein Hinweis; die Art sagt das erste, fette Wort. */
  .aufloesung {
    margin-top: var(--abstand-4);
    padding: var(--abstand-3) var(--abstand-4);
    border-left: 4px solid var(--good);
  }

  .aufloesung.schlecht { border-left-color: var(--danger-fg); }
  .aufloesung p { margin: 0; color: var(--ink-2); text-wrap: pretty; }
  .aufloesung p b { color: var(--ink); }

  .aufloesung-fuss {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--abstand-2) var(--abstand-4);
    margin-top: var(--abstand-3);
  }

  .quiz-verweis { font-size: var(--text-2); font-weight: 650; white-space: nowrap; }
  .aufloesung-fuss .quiz-knopf { margin-left: auto; }

  .tastenhinweis { display: none; margin: var(--abstand-3) 0 0; font-size: var(--text-2); color: var(--muted); }

  /* Den Hinweis auf die Tasten braucht nur, wer eine Tastatur hat. */
  @media (hover: hover) and (pointer: fine) {
    .tastenhinweis { display: block; }
  }

  .quiz-abbruch {
    margin-top: var(--abstand-3);
    padding: 0;
    font: inherit;
    font-size: var(--text-2);
    color: var(--muted);
    background: none;
    border: none;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .quiz-abbruch:hover { color: var(--ink); text-decoration-thickness: 2px; }

  /* ----------------------------------------------------------- Ergebnis */

  .quiz-ende {
    max-width: 48rem;
    padding: var(--abstand-5);
    color: var(--muted);
    background: var(--surface);
  }

  .quiz-ende h2 { display: grid; gap: var(--abstand-1); outline: none; }

  .quiz-ende h2 span {
    font-size: var(--text-2);
    font-stretch: 100%;
    font-weight: 550;
    color: var(--muted);
  }

  /* Die Punktzahl groß und eng wie eine Kennzahl. */
  .quiz-ende h2 b {
    font-size: clamp(var(--text-7), 1.6rem + 2.2vw, var(--text-8));
    font-stretch: var(--eng);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0;
    color: var(--ink);
    font-variant-numeric: tabular-nums lining-nums;
  }

  .quiz-ende h2 small { font-size: var(--text-5); font-weight: 700; color: var(--muted); }
  .quiz-ende .urteil { margin: var(--abstand-2) 0 0; font-size: var(--text-4); font-weight: 650; color: var(--ink); }

  .nach-stufe {
    display: flex;
    flex-wrap: wrap;
    gap: var(--abstand-2) var(--abstand-5);
    margin: var(--abstand-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .nach-stufe b { color: var(--ink); font-variant-numeric: tabular-nums; }

  .quiz-knoepfe { display: flex; flex-wrap: wrap; gap: var(--abstand-2); margin-top: var(--abstand-5); }

  .rueckblick-kopf { margin: var(--abstand-7) 0 var(--abstand-3); }

  .rueckblick {
    display: grid;
    gap: var(--abstand-2);
    max-width: 48rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rueckblick li {
    display: flex;
    gap: var(--abstand-3);
    padding: var(--abstand-3) var(--abstand-4);
    background: var(--surface);
  }

  .rueckblick .marke {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    font-weight: 800;
    border-radius: 50%;
  }

  .rueckblick li.gut .marke { color: var(--good); background: var(--good-wash); }
  .rueckblick li.schlecht .marke { color: var(--danger-fg); background: var(--danger-bg); }
  .rueckblick li > div { min-width: 0; }
  .rueckblick p { margin: 0; text-wrap: pretty; }
  .rueckblick .frage-text { font-weight: 650; color: var(--ink); }
  .rueckblick .antwort-text { margin-top: var(--abstand-1); }
  .rueckblick .antwort-text s { color: var(--muted); }
  .rueckblick .antwort-text b { color: var(--good); }
  .rueckblick .erklaer-text { margin-top: var(--abstand-1); font-size: var(--text-2); color: var(--muted); }

  @media (max-width: 34rem) {
    .quiz-frage { padding: var(--abstand-4); }
    .quiz-kopf .stand { margin-left: 0; width: 100%; }
    .aufloesung-fuss .quiz-knopf { width: 100%; }
  }
</style>
