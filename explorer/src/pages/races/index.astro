---
import { datumKurz as datum, zahl } from '../../lib/format.js'
import Seite from '../../layouts/Seite.astro'
import Filter from '../../components/Filter.astro'
import { rennenListe, pfad } from '../../lib/db.js'

const rennen = rennenListe()

/*
 * Alle 1172 Rennen auf einer Seite, nach Saison gegliedert. Das ist viel, aber
 * es ist fertiges HTML ohne Nachladen – und wer ein bestimmtes Rennen sucht,
 * findet es mit dem Filter schneller als über eine Blätterfunktion.
 */
const proJahr = new Map()
for (const r of rennen) {
  const e = proJahr.get(r.jahr) ?? []
  e.push(r)
  proJahr.set(r.jahr, e)
}
const jahre = [...proJahr.keys()].sort((a, b) => b - a)

/* Die Sprungleiste nach Jahrzehnten gebündelt – 77 Jahreszahlen in einer
   Reihe waren eine Wand aus Ziffern. */
const jahrzehnte = new Map()
for (const j of jahre) {
  const d = Math.floor(j / 10) * 10
  if (!jahrzehnte.has(d)) jahrzehnte.set(d, [])
  jahrzehnte.get(d).push(j)
}
---

<Seite
  titel="All Formula 1 races since 1950"
  beschreibung={`${zahl(rennen.length)} World Championship rounds with winner, circuit and date.`}
>
  <header class="seitenkopf">
    <div>
      <p class="oberzeile">Races</p>
      <h1>Every race since 1950</h1>
      <p class="lead">
        {zahl(rennen.length)} World Championship rounds, arranged by season. Filter for a race,
        a circuit or a winner – try “Monaco” or “Senna”.
      </p>
    </div>
  </header>

  {/*
    * Die Sprungleiste bringt einen zu einer Saison. Sie hilft nicht, wenn die
    * Frage quer dazu liegt – alle Rennen in Monaco, alle Siege von Senna. Dafür
    * ist der Filter da; solange er greift, tritt die Sprungleiste zurück.
    */}
  <Filter platzhalter="Filter by race, circuit or winner" einheit={['race', 'races']} />

  <nav class="jahre" aria-label="Jump to a season" data-beim-filtern-weg>
    {[...jahrzehnte.entries()].map(([d, liste]) => (
      <div>
        <b>{d}s</b>
        <span>{liste.map((j) => <a href={`#j${j}`}>{j}</a>)}</span>
      </div>
    ))}
  </nav>

  {jahre.map((j) => (
    <section class="abschnitt" id={`j${j}`} data-gruppe>
      <div class="abschnitt-kopf">
        <div><h2><a href={pfad.saison(j)}>{j}</a></h2></div>
        <span class="leise">{proJahr.get(j).length} races</span>
      </div>
      <div class="tabelle">
        <table>
          <thead>
            <tr><th class="num" scope="col"><abbr title="Round">Rd</abbr></th><th scope="col">Race</th><th scope="col">Circuit</th><th scope="col">Date</th><th scope="col">Winner</th></tr>
          </thead>
          <tbody>
            {proJahr.get(j).map((r) => (
              <tr class={r.siegerId ? undefined : 'raus'}>
                <td class="num leise">{r.runde}</td>
                <th scope="row">
                  <a class="zeile" href={pfad.rennen(r.id)}>{r.name}</a>
                  {r.mitSprint === 1 && <span class="etikett">sprint</span>}
                </th>
                <td class="leise"><a class="leise" href={pfad.strecke(r.streckeId)}>{r.strecke}</a></td>
                <td class="leise">{datum(r.datum)}</td>
                <td>
                  {r.siegerId
                    ? <a class="zeile" href={pfad.fahrer(r.siegerId)}>{r.sieger}</a>
                    : <span class="leise">still to come</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))}
</Seite>

{/*
  * Global statt seitenlokal: Ein <style> ohne is:global hängt in Astro jedem
  * Element der Seite ein Bereichsattribut an. Bei 1.172 Rennen mal neun
  * Elementen war das der größte Teil von 660 KB HTML. Die Klassen hier sind
  * eindeutig genug, um niemandem in die Quere zu kommen.
  */}
<style is:global>
  .jahre {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(14rem, 100%), 1fr));
    gap: 0.6rem 1.5rem;
    margin: 0 0 2.5rem;
    padding: 1rem 1.2rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-s);
  }

  .jahre div { display: flex; align-items: baseline; gap: 0.6rem; }
  .jahre b { flex: none; width: 3rem; font-size: 0.8rem; font-weight: 750; color: var(--ink); font-variant-numeric: tabular-nums; }
  .jahre span { display: flex; flex-wrap: wrap; gap: 0.15rem; }

  /* Vier Ziffern, nicht zwei: „05“ ist nicht von „50“ zu unterscheiden. Und groß genug für einen Finger. */
  .jahre a {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    min-width: 2.75rem;
    padding: 0.1rem 0.35rem;
    font-size: 0.8rem;
    color: var(--muted);
    text-decoration: none;
    border-radius: 0.25rem;
    font-variant-numeric: tabular-nums;
  }

  .jahre a:hover { color: var(--accent-strong); background: var(--accent-wash); }

  .abschnitt h2 a { color: var(--ink); text-decoration: none; }
  .abschnitt h2 a:hover { color: var(--accent); }
</style>
