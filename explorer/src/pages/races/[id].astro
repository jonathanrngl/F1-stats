---
import { datum, ein, plakette, zahl } from '../../lib/format.js'
import Seite from '../../layouts/Seite.astro'
import { alle, eine, rennenListe, pfad } from '../../lib/db.js'

export async function getStaticPaths() {
  return rennenListe().map((r) => ({ params: { id: r.id } }))
}

const { id } = Astro.params

const rennen = eine(
  `SELECT r.*, g.name AS gpName, g.full_name AS gpVoll,
          z.name AS strecke, z.place_name AS ort, c.name AS land, c.ioc AS ioc, c.demonym AS demonym
     FROM race r
     JOIN grand_prix g ON g.id = r.grand_prix_id
     JOIN circuit z ON z.id = r.circuit_id
     LEFT JOIN country c ON c.id = z.country_id
    WHERE r.id = ?`,
  id,
)

/*
 * Ergebnisse in der Reihenfolge der Anzeige: Erst die Gewerteten nach Platz,
 * danach Ausfälle und Nichtstarter. display_order aus F1DB trägt genau das.
 */
const ergebnisse = alle(
  `SELECT rr.*, d.display_name AS fahrer, d.id AS fahrerId, k.name AS team, k.id AS teamId
     FROM race_result rr
     JOIN driver d ON d.id = rr.driver_id
     JOIN constructor k ON k.id = rr.constructor_id
    WHERE rr.race_id = ?
    ORDER BY rr.display_order`,
  id,
)

const boxenstopps = alle(
  `SELECT p.driver_id AS fahrerId, d.display_name AS fahrer, COUNT(*) AS stopps,
          MIN(p.duration_ms) AS schnellster
     FROM pit_stop p JOIN driver d ON d.id = p.driver_id
    WHERE p.race_id = ? GROUP BY p.driver_id ORDER BY stopps, schnellster`,
  id,
)

const nachbarn = alle(
  `SELECT id, round, (SELECT name FROM grand_prix WHERE id = grand_prix_id) AS name
     FROM race WHERE year = ? AND round IN (?, ?)`,
  rennen.year, rennen.round - 1, rennen.round + 1,
)
const vorher = nachbarn.find((n) => n.round === rennen.round - 1)
const nachher = nachbarn.find((n) => n.round === rennen.round + 1)


/** Millisekunden als Rennzeit oder Abstand. */
function zeit(ms) {
  if (ms === null || ms === undefined) return ''
  const s = ms / 1000
  const h = Math.floor(s / 3600)
  const m = Math.floor((s % 3600) / 60)
  const rest = (s % 60).toFixed(3).padStart(6, '0')
  return h > 0 ? `${h}:${String(m).padStart(2, '0')}:${rest}` : `${m}:${rest}`
}

const sieger = ergebnisse.find((e) => e.position === 1)
const pole = ergebnisse.find((e) => e.qualifying_position === 1)
const schnellste = ergebnisse.find((e) => e.fastest_lap)

/*
 * Das Podium steht über der Ergebnisliste: Wer die Seite eines Rennens
 * aufschlägt, will zuerst wissen, wer gewonnen hat – und nicht erst eine
 * Tabelle mit zwanzig Zeilen lesen.
 */
const podium = [1, 2, 3].map((p) => ergebnisse.find((e) => e.position === p)).filter(Boolean)
const zeitVon = (e) =>
  e.position === 1 && e.time_ms
    ? zeit(e.time_ms)
    : e.gap_ms
      ? `+${zeit(e.gap_ms)}`
      : e.gap_laps
        ? `+${e.gap_laps} ${e.gap_laps === 1 ? 'lap' : 'laps'}`
        : (e.reason_retired ?? '')
---

<Seite
  titel={`${rennen.gpName} Grand Prix ${rennen.year} – Result`}
  beschreibung={`Round ${rennen.round} of the ${rennen.year} season in ${rennen.ort}${sieger ? `. Winner: ${sieger.fahrer}` : ''}.`}
>
  <header class="seitenkopf">
    <span class="wappen" title={rennen.land ?? ''}>{rennen.ioc ?? '—'}</span>
    <div>
      <p class="oberzeile">
        <a href={pfad.saison(rennen.year)}>{rennen.year} season</a>
        <span class="trenner">/</span>
        <span class="still">Round {rennen.round}</span>
      </p>
      <h1>{rennen.gpName} Grand Prix {rennen.year}</h1>
      <ul class="eckdaten">
        <li><a href={pfad.strecke(rennen.circuit_id)}>{rennen.strecke}</a></li>
        {rennen.ort && rennen.ort !== rennen.strecke && <li>{rennen.ort}</li>}
        <li>{datum(rennen.date)}</li>
        {rennen.laps > 0 && <li>{rennen.laps} laps</li>}
        {rennen.distance_km > 0 && <li>{ein(rennen.distance_km)} km</li>}
        {rennen.drivers_title_decider === 1 && <li class="stark">Title decided here</li>}
      </ul>
    </div>
  </header>

  {podium.length > 0 && (
    <ol class="podium" aria-label="Podium">
      {podium.map((e) => (
        <li class={`p${e.position}`}>
          <span class={plakette(e.position)}>P{e.position}</span>
          <a class="name" href={pfad.fahrer(e.fahrerId)}>{e.fahrer}</a>
          <span class="team">{e.team}</span>
          <span class="zeit">{zeitVon(e)}</span>
        </li>
      ))}
    </ol>
  )}

  <ul class="kacheln namen">
    {pole && (
      <li><span>Pole position</span><b><a href={pfad.fahrer(pole.fahrerId)}>{pole.fahrer}</a></b><i>{pole.team}</i></li>
    )}
    {schnellste && (
      <li><span>Fastest lap</span><b><a href={pfad.fahrer(schnellste.fahrerId)}>{schnellste.fahrer}</a></b>
        <i>{schnellste.team}</i></li>
    )}
    {sieger?.grid_position && (
      <li><span>Winner started from</span><b>P{sieger.grid_position}</b><i>on the grid</i></li>
    )}
  </ul>

  <section class="abschnitt">
    <div class="abschnitt-kopf"><div><h2>Result</h2></div></div>
    <div class="tabelle">
      <table>
        <thead>
          <tr>
            <th class="num">Pos</th><th>Driver</th><th>Team</th>
            <th class="num">Grid</th><th class="num">Laps</th>
            <th>Time / Reason</th><th class="num">Points</th>
          </tr>
        </thead>
        <tbody>
          {ergebnisse.map((e) => (
            <tr class={e.classified ? '' : 'raus'}>
              <td class="num"><span class={plakette(e.position)}>{e.position ?? e.position_text}</span></td>
              <td>
                <a class="zeile" href={pfad.fahrer(e.fahrerId)}>{e.fahrer}</a>
                {e.shared_car === 1 && <span class="etikett" title="Shared car">shared</span>}
                {e.fastest_lap === 1 && <span class="etikett akzent" title="Fastest lap">fastest lap</span>}
              </td>
              <td class="leise"><a class="leise" href={pfad.team(e.teamId)}>{e.team}</a></td>
              <td class="num">{e.grid_position ?? '–'}</td>
              <td class="num">{e.laps ?? ''}</td>
              <td class="leise">{zeitVon(e)}</td>
              <td class="num fett">{e.points ? ein(e.points) : ''}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="fussnote">
      A number in the first column means classified. DNF, DNQ and DNS stand for retirement,
      did not qualify and did not start. ‘shared’ marks a car that two drivers shared
      between them – permitted in the 1950s, and both were classified.
    </p>
  </section>

  {boxenstopps.length > 0 && (
    <section class="abschnitt">
      <div class="abschnitt-kopf"><div><h2>Pit stops</h2></div></div>
      <div class="tabelle boxen">
        <table>
          <thead><tr><th>Driver</th><th class="num">Stops</th><th class="num">Fastest</th></tr></thead>
          <tbody>
            {boxenstopps.map((b) => (
              <tr>
                <td><a class="zeile" href={pfad.fahrer(b.fahrerId)}>{b.fahrer}</a></td>
                <td class="num">{b.stopps}</td>
                <td class="num">{b.schnellster ? `${(b.schnellster / 1000).toFixed(3)} s` : '–'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <nav class="nachbarn" aria-label="Neighbouring races">
    {vorher
      ? <a class="karte" href={pfad.rennen(vorher.id)}><span>‹ Previous round</span><b>{vorher.name}</b></a>
      : <span></span>}
    {nachher && <a class="karte rechts" href={pfad.rennen(nachher.id)}><span>Next round ›</span><b>{nachher.name}</b></a>}
  </nav>
</Seite>

<style>
  /*
   * Das Podium: der Sieger in der Mitte und etwas höher, wie auf dem echten.
   * Am Telefon untereinander in der Reihenfolge 1, 2, 3.
   */
  .podium {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: end;
    gap: 0.75rem;
    margin: 0 0 0.75rem;
    padding: 0;
    list-style: none;
  }

  .podium li {
    display: grid;
    justify-items: start;
    gap: 0.2rem;
    padding: 1rem 1.15rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-s);
    min-width: 0;
  }

  .podium > .p1 { order: 2; padding-block: 1.5rem; border-top: 4px solid var(--gold); }
  .podium > .p2 { order: 1; border-top: 4px solid var(--silber); }
  .podium > .p3 { order: 3; border-top: 4px solid var(--bronze); }

  .podium .pos { margin-bottom: 0.3rem; }
  .podium .name {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 1.15rem;
    font-weight: 750;
    color: var(--ink);
    text-decoration: none;
  }
  .podium > .p1 .name { font-size: 1.35rem; }
  .podium .name:hover { color: var(--accent); }
  .podium .team { font-size: 0.85rem; color: var(--muted); }
  .podium .zeit { font-size: 0.85rem; font-weight: 600; color: var(--ink-2); font-variant-numeric: tabular-nums; }

  @media (max-width: 40rem) {
    .podium { grid-template-columns: minmax(0, 1fr); }
    .podium > li.p1, .podium > li.p2, .podium > li.p3 { order: 0; padding-block: 0.9rem; }
  }

  .kacheln.namen { grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr)); }
  .boxen { max-width: 36rem; }

  .nachbarn {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.85rem;
    margin-top: 3rem;
  }

  .nachbarn .karte { display: grid; gap: 0.1rem; }
  .nachbarn .rechts { text-align: right; grid-column: 2; }
  .nachbarn span { font-size: 0.78rem; font-weight: 650; color: var(--muted); }
  .nachbarn b { color: var(--ink); font-size: 1rem; }
</style>
