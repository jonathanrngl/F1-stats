---
import { datum, zahl } from '../lib/format.js'
import Seite from '../layouts/Seite.astro'
import Countdown from '../components/Countdown.astro'
import { db, eine, saisonListe, pfad } from '../lib/db.js'
import { naechstesRennen, standVorRennen } from '../engine/vorschau.js'
import { datenstand, juengsteAenderungen, rekordVerlaeufe, zahlwort } from '../engine/aenderungen.js'

/*
 * Gezählt wird, was eine eigene Seite hat. Die Tabellen führen mehr: 57
 * Fahrer, die gemeldet, aber nie in einer Ergebnisliste standen, einen
 * Konstrukteur ohne Rennen, und die noch ausstehenden Rennen der Saison.
 * „917 Drivers“ neben einer Liste mit 860 Einträgen war eine Zahl, die man
 * nicht nachzählen konnte.
 */
const zahlen = eine(`
  SELECT (SELECT COUNT(DISTINCT race_id) FROM race_result)        AS rennen,
         (SELECT COUNT(DISTINCT driver_id) FROM race_result)      AS fahrer,
         (SELECT COUNT(DISTINCT constructor_id) FROM race_result) AS teams,
         (SELECT COUNT(DISTINCT circuit_id) FROM race)            AS strecken,
         (SELECT COUNT(*) FROM race_result)                       AS ergebnisse,
         (SELECT MIN(year) FROM season)                           AS von,
         (SELECT MAX(year) FROM season)                           AS bis`)

const saisons = saisonListe().slice(0, 6)

/*
 * Die Startseite zeigte bisher nur Verweise auf Daten, keine Daten. Bei 2.384
 * Seiten und einem nächsten Rennen in der Datenbank war das verschenkt – die
 * drei Dinge unten sind genau die, wegen derer jemand eine Statistikseite
 * überhaupt aufruft, und alle drei werden auf Unterseiten ohnehin gerechnet.
 *
 * Jedes Stück steht für sich: Fehlt eines, fällt nur dieses weg. Am
 * Saisonende gibt es kein nächstes Rennen, und die Seite soll dann nicht
 * mit einer leeren Kachel dastehen.
 *
 * Nichts davon hängt am Tag des Bauens: Das nächste Rennen ist das erste
 * ohne Ergebnis, und die Tage bis dahin rechnet der Browser.
 */
const naechstes = naechstesRennen(db())
const stand = naechstes ? standVorRennen(db(), naechstes) : null
const fuehrend = stand && !stand.vorsaison ? (stand.fahrer?.[0] ?? null) : null
const zweiter = stand && !stand.vorsaison ? (stand.fahrer?.[1] ?? null) : null

/*
 * Die jüngste Rekordbewegung. Der Verlauf über alle Bestmarken kostet beim
 * Bauen rund eine Sekunde; das ist für eine einzelne Seite vertretbar und
 * spart eine zweite, vereinfachte Rechnung, die auseinanderlaufen könnte.
 */
const datenStand = datenstand(db())
const letzteMarke = datenStand
  ? (juengsteAenderungen(rekordVerlaeufe(db()), { seit: `${datenStand.jahr - 12}-01-01` })
      .einzeln[0] ?? null)
  : null

/*
 * Die Einstiege, zweigeteilt wie die Navigation: erst die Dinge selbst, dann
 * die Werkzeuge. Wo es etwas zu zählen gibt, steht die Zahl daneben – sie
 * sagt mehr über die Seite dahinter als ein Symbol.
 */
const DINGE = [
  { weg: '/seasons/', titel: 'Seasons', zahl: zahlen.bis - zahlen.von + 1, text: 'Standings, calendar and points progression for every year' },
  { weg: '/races/', titel: 'Races', zahl: zahlen.rennen, text: 'Every Grand Prix so far, result by result' },
  { weg: '/drivers/', titel: 'Drivers', zahl: zahlen.fahrer, text: 'Profiles with career, streaks and team-mates' },
  { weg: '/teams/', titel: 'Teams', zahl: zahlen.teams, text: 'Constructors and the names they raced under' },
  { weg: '/circuits/', titel: 'Circuits', zahl: zahlen.strecken, text: 'On a map, season by season, and who went well where' },
]
const WERKZEUGE = [
  { weg: '/records/', titel: 'Records', text: 'Every all-time mark, linked to the race behind it' },
  { weg: '/comparison/', titel: 'Compare', text: 'Two careers side by side, over any period' },
  { weg: '/explorer/', titel: 'Explorer', text: 'Your own queries over every result, with export' },
  { weg: '/quiz/', titel: 'Quiz', text: 'Questions on every part of the sport, easy to expert' },
]
---

<Seite
  titel="Formula 1 statistics – every season since 1950"
  beschreibung={`Results, standings and analysis from ${zahl(zahlen.rennen)} races between ${zahlen.von} and ${zahlen.bis}.`}
>
  <header class="start">
    <div>
      <p class="oberzeile">World Championship · {zahlen.von}–{zahlen.bis}</p>
      <h1>All of Formula 1,<br /> <em>in numbers</em></h1>
      <p class="lead">
        Results, standings and records for every race since {zahlen.von} – worked out from
        {' '}{zahl(zahlen.ergebnisse)} result rows, not copied from a curated list.
      </p>
    </div>
    <ul class="kacheln startzahlen">
      <li><b>{zahl(zahlen.rennen)}</b><span>Races</span></li>
      <li><b>{zahl(zahlen.fahrer)}</b><span>Drivers</span></li>
      <li><b>{zahlen.teams}</b><span>Teams</span></li>
      <li><b>{zahlen.strecken}</b><span>Circuits</span></li>
    </ul>
  </header>

  {(naechstes || fuehrend || letzteMarke) && (
    <section class="abschnitt">
      <div class="abschnitt-kopf"><div><h2>Right now</h2></div></div>
      <div class="jetzt">
        {naechstes && (
          <a class="karte jetzt-rennen" href={pfad.seite('/preview/')}>
            <span class="etikett-klein">Next race · Round {naechstes.runde}</span>
            <b class="gross">{naechstes.grandPrixVoll ?? naechstes.grandPrix} {naechstes.jahr}</b>
            <span class="dazu">{naechstes.strecke} · {datum(naechstes.datum)}</span>
            <span class="countdown"><Countdown datum={naechstes.datum} zeit={naechstes.zeit} /></span>
            <span class="weiter">Read the preview →</span>
          </a>
        )}
        {fuehrend && (
          <a class="karte" href={pfad.fahrer(fuehrend.id)}>
            <span class="etikett-klein">Championship leader · after round {stand.bezug.runde}</span>
            <b class="gross">{fuehrend.name}</b>
            <span class="dazu">{fuehrend.team}</span>
            <span class="zahlreihe">
              <span><b>{zahl(fuehrend.punkte)}</b> points</span>
              {zweiter && <span><b>+{zahl(fuehrend.punkte - zweiter.punkte)}</b> on {zweiter.name}</span>}
            </span>
          </a>
        )}
        {letzteMarke && (
          <a class="karte" href={pfad.seite('/changes/')}>
            <span class="etikett-klein">Latest record change</span>
            <b class="gross">{letzteMarke.kategorie.titel}</b>
            <span class="dazu">
              {letzteMarke.halter.map((h) => h.name).join(' and ')}
              {letzteMarke.art === 'eingestellt' ? ' equalled it' : ' took it'} on {datum(letzteMarke.datum)}
            </span>
            {/*
              * Der Wert der Übernahme, nicht der heutige: Alonso übernahm den
              * Startrekord 2022 mit 351 und baut ihn seither aus. „351 starts“
              * allein las sich wie der Stand von heute.
              */}
            <span class="zahlreihe">
              <span><b>{zahlwort(letzteMarke.wert, letzteMarke.kategorie)}</b> then</span>
              {letzteMarke.rekordJetzt > letzteMarke.wert && (
                <span><b>{zahl(letzteMarke.rekordJetzt)}</b> now</span>
              )}
            </span>
          </a>
        )}
      </div>
    </section>
  )}

  {/*
    * „On this day": welcher Tag heute ist, weiß nur der Browser. Ohne Skript
    * fehlt der Abschnitt ganz, statt einen Tag zu zeigen, der nicht heute ist.
    */}
  <section class="abschnitt heute nur-mit-js" data-heute aria-labelledby="heute-titel">
    <div class="abschnitt-kopf">
      <div>
        <h2 id="heute-titel">On this day</h2>
        <p data-heute-datum>Races held on this date, and race winners born on it.</p>
      </div>
      <div class="blaettern" role="group" aria-label="Choose a day">
        <button type="button" data-schritt="-1" aria-label="Previous day">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
        </button>
        <button type="button" class="heute-knopf" data-zurueck hidden>Today</button>
        <button type="button" data-schritt="1" aria-label="Next day">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
        </button>
      </div>
    </div>
    <div class="heute-inhalt" data-heute-inhalt aria-live="polite">
      <p class="heute-leer">Loading …</p>
    </div>
  </section>

  <section class="abschnitt">
    <div class="abschnitt-kopf"><div><h2>Explore</h2></div></div>
    <div class="einstiege">
      <ul class="verzeichnis">
        {DINGE.map((e) => (
          <li>
            <a href={pfad.seite(e.weg)}>
              <b>{e.titel}</b>
              <span class="text">{e.text}</span>
              <span class="zahl anzeige">{zahl(e.zahl)}</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="werkzeugkasten">
        <h3>Tools</h3>
        <ul class="verzeichnis klein">
          {WERKZEUGE.map((e) => (
            <li>
              <a href={pfad.seite(e.weg)}>
                <b>{e.titel}</b>
                <span class="text">{e.text}</span>
                <span class="pfeil" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="abschnitt">
    <div class="abschnitt-kopf">
      {/* Ohne diese Zeile las sich „2021 · Max Verstappen · Mercedes“ als sein Team. */}
      <div><h2>Recent seasons</h2><p>Drivers' champion, then constructors' champion.</p></div>
      <a class="mehr" href={pfad.seite('/seasons/')}>All seasons →</a>
    </div>
    <ul class="saisons">
      {saisons.map((s) => (
        <li>
          <a href={pfad.saison(s.jahr)}>
            <b class="jahr anzeige">{s.jahr}</b>
            {s.meister ? (
              <>
                <span class="wer">{s.meister}</span>
                {s.teamMeister && <span class="team">{s.teamMeister}</span>}
              </>
            ) : (
              <span class="laeuft">Season in progress</span>
            )}
          </a>
        </li>
      ))}
    </ul>
  </section>
</Seite>

<script>
  /*
   * „On this day": den Tag des Besuchers aus dem Kalender lesen
   * (/data/heute.json, gebaut von lib/heute.js) und zeigen. Geblättert wird
   * durch ein Schaltjahr, damit auch der 29. Februar erreichbar bleibt.
   */
  const BASIS = import.meta.env.BASE_URL.replace(/\/$/, '')
  const abschnitt = document.querySelector<HTMLElement>('[data-heute]')

  type Rennen = [number, string, string, string, string]
  type Geboren = [number, string, string, number, number]
  type Tag = { rennen: Rennen[]; geboren: Geboren[] }

  if (abschnitt) {
    const inhalt = abschnitt.querySelector<HTMLElement>('[data-heute-inhalt]')!
    const kopf = abschnitt.querySelector<HTMLElement>('[data-heute-datum]')!
    const zurueck = abschnitt.querySelector<HTMLButtonElement>('[data-zurueck]')!
    const jetzt = new Date()
    const diesesJahr = jetzt.getFullYear()
    /* Der Tag als Datum im Schaltjahr 2024, in UTC – nur Monat und Tag zählen. */
    const heute = Date.UTC(2024, jetzt.getMonth(), jetzt.getDate())
    let gezeigt = heute
    let kalender: Record<string, Tag> = {}

    const TAG_MS = 86_400_000
    const schluessel = (t: number) => new Date(t).toISOString().slice(5, 10)
    const alsText = (t: number) =>
      new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', timeZone: 'UTC' }).format(t)
    /* Einen Tag weiter, über das Jahresende hinweg im Kreis. */
    const weiter = (t: number, n: number) => {
      const neu = t + n * TAG_MS
      if (neu >= Date.UTC(2025, 0, 1)) return neu - 366 * TAG_MS
      if (neu < Date.UTC(2024, 0, 1)) return neu + 366 * TAG_MS
      return neu
    }

    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, klasse?: string, text?: string) => {
      const e = document.createElement(tag)
      if (klasse) e.className = klasse
      if (text !== undefined) e.textContent = text
      return e
    }
    const verweis = (weg: string, text: string) => {
      const a = el('a', undefined, text)
      a.href = `${BASIS}${weg}`
      return a
    }
    const vor = (jahr: number) => {
      const n = diesesJahr - jahr
      return n === 0 ? 'this year' : n === 1 ? 'a year ago' : `${n} years ago`
    }

    function spalte(titel: string) {
      const s = el('div', 'heute-spalte')
      s.append(el('h3', undefined, titel))
      const liste = el('ol', 'heute-liste')
      s.append(liste)
      return { s, liste }
    }

    function zeige() {
      const tag = kalender[schluessel(gezeigt)] ?? { rennen: [], geboren: [] }
      const istHeute = gezeigt === heute
      kopf.textContent = istHeute
        ? `Today, ${alsText(gezeigt)}: races held on this date, and race winners born on it.`
        : `${alsText(gezeigt)}: races held on this date, and race winners born on it.`
      zurueck.hidden = istHeute
      inhalt.replaceChildren()

      if (tag.rennen.length) {
        const { s, liste } = spalte(`${tag.rennen.length} ${tag.rennen.length === 1 ? 'race' : 'races'}`)
        for (const [jahr, gp, id, sieger, siegerId] of tag.rennen) {
          const li = el('li')
          li.append(el('b', 'anzeige', String(jahr)))
          const was = el('span', 'was')
          was.append(verweis(`/races/${id}/`, gp))
          const wer = el('span', 'wer', 'won by ')
          wer.append(verweis(`/drivers/${siegerId}/`, sieger))
          was.append(wer)
          li.append(was, el('span', 'wann', vor(jahr)))
          liste.append(li)
        }
        inhalt.append(s)
      } else {
        /* Kein Rennen an diesem Tag – dann wenigstens sagen, wann das nächste war. */
        let t = gezeigt
        for (let i = 0; i < 366 && !kalender[schluessel(t)]?.rennen.length; i++) t = weiter(t, 1)
        const p = el('div', 'heute-spalte heute-leer')
        p.append(el('p', undefined, `No World Championship race has ever been held on ${alsText(gezeigt)}.`))
        const sprung = el('button', 'leise-knopf', `Next race day: ${alsText(t)} →`)
        sprung.type = 'button'
        sprung.addEventListener('click', () => { gezeigt = t; zeige() })
        p.append(sprung)
        inhalt.append(p)
      }

      if (tag.geboren.length) {
        const { s, liste } = spalte('Born on this day')
        for (const [jahr, name, id, siege, titel] of tag.geboren) {
          const li = el('li')
          li.append(el('b', 'anzeige', String(jahr)))
          const was = el('span', 'was')
          was.append(verweis(`/drivers/${id}/`, name))
          was.append(el('span', 'wer', titel > 0
            ? `${titel}× World Champion, ${siege} ${siege === 1 ? 'win' : 'wins'}`
            : `${siege} ${siege === 1 ? 'win' : 'wins'}`))
          li.append(was)
          liste.append(li)
        }
        s.classList.add('geboren')
        inhalt.append(s)
      }
    }

    for (const knopf of abschnitt.querySelectorAll<HTMLButtonElement>('[data-schritt]')) {
      knopf.addEventListener('click', () => {
        gezeigt = weiter(gezeigt, Number(knopf.dataset.schritt))
        zeige()
      })
    }
    zurueck.addEventListener('click', () => { gezeigt = heute; zeige() })

    fetch(`${BASIS}/data/heute.json`)
      .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
      .then((d) => { kalender = d; zeige() })
      .catch(() => { abschnitt.hidden = true })
  }
</script>

<style>
  /* Der Kopf der Startseite: links die Aussage, rechts die vier Zahlen. */
  .start {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    align-items: end;
    gap: 2rem 3rem;
    margin-bottom: 3.25rem;
  }

  .start h1 { font-size: clamp(2.6rem, 6.4vw, 4.4rem); font-stretch: 72%; line-height: 0.95; }
  .start h1 em { font-style: normal; color: var(--accent); }
  .startzahlen { grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 0; }
  .startzahlen b { font-size: 2.6rem; }

  @media (max-width: 56rem) {
    .start { grid-template-columns: minmax(0, 1fr); }
    .startzahlen { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  @media (max-width: 34rem) {
    .startzahlen { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .startzahlen b { font-size: 2.1rem; }
  }

  /*
   * „Right now": drei Karten. Die erste – das nächste Rennen – ist dunkel und
   * trägt den Countdown; sie ist der Grund, warum jemand während der Saison
   * wiederkommt.
   */
  .jetzt {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
    gap: 0.85rem;
  }

  .jetzt .karte {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .etikett-klein {
    font-family: var(--display);
    font-stretch: 88%;
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .jetzt .gross {
    font-family: var(--display);
    font-stretch: 80%;
    font-size: 1.6rem;
    font-weight: 750;
    line-height: 1.1;
    color: var(--ink);
  }

  .jetzt .dazu { font-size: 0.88rem; color: var(--muted); }

  .zahlreihe {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
    margin-top: auto;
    padding-top: 0.8rem;
    font-size: 0.86rem;
    color: var(--muted);
  }

  .zahlreihe b {
    font-family: var(--display);
    font-stretch: 80%;
    font-size: 1.45rem;
    font-weight: 750;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  /*
   * Das nächste Rennen: dunkel wie die Kopfleiste, mit den Rot-Weiß-Streifen
   * eines Randsteins an der Unterkante – die eine Stelle der Seite, an der
   * Rennstrecke zu sehen sein darf.
   */
  .jetzt-rennen {
    position: relative;
    overflow: hidden;
    padding-bottom: 1.5rem;
    color: var(--kopf-muted);
    background: var(--kopf-bg);
    border-color: var(--kopf-bg);
  }

  .jetzt-rennen::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 6px;
    background: repeating-linear-gradient(90deg, var(--accent) 0 18px, #f5f5f3 18px 36px);
  }

  a.jetzt-rennen:hover { box-shadow: none; border-color: var(--accent); }
  .jetzt-rennen .etikett-klein { color: var(--accent); }
  .jetzt-rennen .gross { color: var(--kopf-ink); }
  .jetzt-rennen .dazu { color: var(--kopf-muted); }
  /* :global – Zahl und Beschriftung schreibt Countdown.astro, teils erst im Browser. */
  .countdown { margin-top: 0.8rem; font-size: 0.9rem; color: var(--kopf-muted); }
  .countdown :global(b) {
    font-family: var(--display);
    font-stretch: 75%;
    font-size: 2.6rem;
    font-weight: 800;
    line-height: 1;
    color: var(--kopf-ink);
  }
  .weiter { margin-top: auto; padding-top: 0.6rem; font-size: 0.85rem; font-weight: 600; color: var(--kopf-ink); }
  .jetzt-rennen:hover .weiter { color: var(--accent); }

  /*
   * „On this day": links die Rennen des Tages, rechts die Geburtstage. Die
   * Einträge schreibt das Skript – daher :global, Astros Bereichsattribut
   * tragen nur die Elemente aus dem Gerüst.
   */
  .blaettern { display: flex; flex: none; align-items: center; gap: 0.35rem; }

  .blaettern button {
    display: grid;
    place-items: center;
    min-width: 2.4rem;
    height: 2.4rem;
    padding: 0 0.6rem;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--ink-2);
    background: var(--surface);
    border: 1px solid var(--border-input);
    border-radius: var(--radius-s);
    cursor: pointer;
  }

  .blaettern button:hover { color: var(--ink); border-color: var(--accent); }
  .blaettern button[hidden] { display: none; }
  .blaettern svg { width: 1.05rem; height: 1.05rem; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }

  .heute-inhalt {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 1rem;
    min-height: 8rem;
  }

  .heute-inhalt :global(.heute-spalte) {
    flex: 1 1 26rem;
    min-width: 0;
    padding: 0.35rem 1.2rem 0.4rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .heute-inhalt :global(.heute-spalte.geboren) { flex: 0 1 22rem; }

  .heute-inhalt :global(h3) {
    margin: 0.7rem 0 0.25rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted);
  }

  .heute-inhalt :global(.heute-liste) { margin: 0; padding: 0; list-style: none; }

  .heute-inhalt :global(.heute-liste li) {
    display: grid;
    grid-template-columns: 3.4rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.9rem;
    padding: 0.6rem 0;
    border-top: 1px solid var(--border);
  }

  .heute-inhalt :global(.heute-liste li b) {
    font-size: 1.45rem;
    font-weight: 750;
    font-stretch: 76%;
    line-height: 1;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .heute-inhalt :global(.was) { display: grid; min-width: 0; }
  .heute-inhalt :global(.was > a) { font-weight: 650; color: var(--ink); text-decoration: none; }
  .heute-inhalt :global(.was > a:hover) { color: var(--accent); }
  .heute-inhalt :global(.wer) { font-size: 0.84rem; color: var(--muted); }
