---
import { datum, zahl } from '../lib/format.js'
import Seite from '../layouts/Seite.astro'
import Countdown from '../components/Countdown.astro'
import Gefolgt from '../components/Gefolgt.astro'
import Meisterband from '../components/Meisterband.astro'
import { alle, db, eine, saisonListe, pfad } from '../lib/db.js'
import { naechstesRennen, standVorRennen, titelKannFallen } from '../engine/vorschau.js'
import { datenstand, juengsteAenderungen, rekordVerlaeufe, zahlwort } from '../engine/aenderungen.js'

/*
 * Die Startseite beantwortet drei Fragen, in dieser Reihenfolge und alle in den
 * ersten 800 Pixeln: Wie steht es um die Geschichte (das Meisterband), wie
 * steht die Weltmeisterschaft, wann ist das nächste Rennen. Dazu der jüngste
 * Rekordwechsel, „On this day“ und, wer folgt, „Following“.
 *
 * Was vorher hier stand und gegangen ist: vier Zahlenkacheln (Races, Drivers,
 * Teams, Circuits), „Right now“ in drei gleichen Spalten, ein Verzeichnis aller
 * Bereiche – das leistet die Navigation – und die sechs jüngsten Saisons, die
 * jetzt im Meisterband stehen. Siehe docs/DESIGN.md, Abbauliste.
 *
 * Jedes Stück steht für sich: Fehlt eines, fällt nur dieses weg. Am
 * Saisonende gibt es kein nächstes Rennen, und die Seite soll dann nicht mit
 * einem leeren Block dastehen. Nichts hängt am Tag des Bauens: Das nächste
 * Rennen ist das erste ohne Ergebnis, die Tage bis dahin rechnet der Browser.
 */
const { von, bis } = eine('SELECT MIN(year) AS von, MAX(year) AS bis FROM season')

const naechstes = naechstesRennen(db())
const stand = naechstes ? standVorRennen(db(), naechstes) : null
const mitStand = stand && !stand.vorsaison
const fuehrend = mitStand ? (stand.fahrer?.[0] ?? null) : null
const kuerzel = new Map(alle('SELECT id, abbreviation AS k FROM driver').map((d) => [d.id, d.k]))

/* Der Meister des laufenden Jahres, wenn der Titel schon vergeben ist, und wann es so weit war. */
const saison = mitStand ? saisonListe().find((s) => s.jahr === stand.bezug.jahr) : null
const entschieden = saison?.meister
  ? eine(
      `SELECT r.round AS runde, COALESCE(g.full_name, g.name || ' Grand Prix') AS gp FROM race r JOIN grand_prix g ON g.id = r.grand_prix_id
        WHERE r.year = ? AND r.drivers_title_decider = 1`,
      saison.jahr,
    )
  : null

/*
 * Der Satz zur Titelfrage am nächsten Rennen. Drei Lagen: Der Titel ist schon
 * vergeben, er kann an diesem Wochenende fallen, oder er bleibt offen – dann
 * steht da, wie viele Punkte noch zu holen sind.
 */
const titelSatz = !mitStand
  ? null
  : saison?.meister
    ? `${saison.meister} won the title${entschieden ? ` in round ${entschieden.runde}, at the ${entschieden.gp}` : ''}.`
    : titelKannFallen(stand)
      ? `The title can be settled here: ${fuehrend.name} leads by ${zahl(fuehrend.punkte - stand.fahrer[1].punkte)} points.`
      : `${zahl(stand.maxFuerEinenFahrer)} points are still to be won in ${stand.offen} ${stand.offen === 1 ? 'race' : 'races'}.`

/*
 * Die jüngste Rekordbewegung. Der Verlauf über alle Bestmarken kostet beim
 * Bauen rund eine Sekunde; das ist für eine einzelne Seite vertretbar und
 * spart eine zweite, vereinfachte Rechnung, die auseinanderlaufen könnte.
 */
const datenStand = datenstand(db())
const letzteMarke = datenStand
  ? (juengsteAenderungen(rekordVerlaeufe(db()), { seit: `${datenStand.jahr - 12}-01-01` }).einzeln[0] ?? null)
  : null
---

<Seite
  titel="Formula 1 statistics – every season since 1950"
  beschreibung={`Results, standings and records for every Formula 1 season from ${von} to ${bis}.`}
  lackierung={fuehrend?.teamId ?? null}
>
  <header class="start">
    <h1>Formula 1, {von} to {bis}</h1>
  </header>

  <Meisterband />

  <div class="start-raster">
    {naechstes && (
      <section class="abschnitt naechstes" aria-labelledby="naechstes-titel">
        <h2 id="naechstes-titel">Next: {naechstes.grandPrixVoll ?? naechstes.grandPrix}</h2>
        <p class="wann">
          Round {naechstes.runde}, {naechstes.strecke}, {datum(naechstes.datum)}.
        </p>
        <p class="countdown"><Countdown datum={naechstes.datum} zeit={naechstes.zeit} /></p>
        {titelSatz && <p class="titelsatz">{titelSatz}</p>}
        <p><a href={pfad.seite('/preview/')}>Read the preview</a></p>
      </section>
    )}

    {mitStand && (
      <section class="abschnitt wm" aria-labelledby="wm-titel">
        <div class="abschnitt-kopf">
          <div><h2 id="wm-titel">Championship after round {stand.bezug.runde}</h2></div>
        </div>
        {/*
          * Der Turm: Position, Teamstreifen, Kürzel, Name, Punkte, Abstand zum
          * Führenden. Am Telefon die ersten fünf, sonst zehn.
          */}
        <ol class="turm">
          {stand.fahrer.map((f, i) => (
            <li data-team={f.teamId ?? undefined} class:list={{ weitere: i >= 5 }}>
              <span class:list={['platz', { p1: f.position === 1, p2: f.position === 2, p3: f.position === 3 }]}>{f.position}</span>
              <span class="code" aria-hidden="true">{kuerzel.get(f.id)}</span>
              <span class="wer"><a class="zeile" href={pfad.fahrer(f.id)}>{f.name}</a> <i>{f.team}</i></span>
              <b class="wert">{zahl(f.punkte)}<span class="sr-only"> points</span></b>
              <span class="abstand">{i > 0 && <>−{zahl(fuehrend.punkte - f.punkte)}<span class="sr-only"> behind</span></>}</span>
            </li>
          ))}
        </ol>
        <p class="weiter"><a href={`${pfad.saison(stand.bezug.jahr)}#wertung`}>Full standings</a></p>
      </section>
    )}

    {letzteMarke && (
      <section class="abschnitt marke" aria-labelledby="marke-titel">
        <h2 id="marke-titel">Latest record change</h2>
        {/*
          * Der Wert der Übernahme und der von heute: Alonso übernahm den
          * Startrekord 2022 mit 351 und baut ihn seither aus. „351 starts“
          * allein las sich wie der Stand von heute.
          */}
        <p>
          <b>{letzteMarke.kategorie.titel}:</b>{' '}
          {letzteMarke.halter.map((h) => h.name).join(' and ')}
          {letzteMarke.art === 'eingestellt' ? ' equalled it' : ' took it'} on {datum(letzteMarke.datum)}
          {' '}with {zahlwort(letzteMarke.wert, letzteMarke.kategorie)}
          {letzteMarke.rekordJetzt > letzteMarke.wert ? `, and has ${zahl(letzteMarke.rekordJetzt)} now` : ''}.
        </p>
        <p><a href={pfad.seite('/changes/')}>All record changes</a></p>
      </section>
    )}
  </div>

  {/*
    * „On this day": welcher Tag heute ist, weiß nur der Browser. Ohne Skript
    * fehlt der Abschnitt ganz, statt einen Tag zu zeigen, der nicht heute ist.
    */}
  <section class="abschnitt heute nur-mit-js" data-heute aria-labelledby="heute-titel">
    <div class="abschnitt-kopf">
      <div>
        <h2 id="heute-titel">On this day</h2>
        <p data-heute-datum>Races held on this date, and race winners born on it.</p>
      </div>
      <div class="blaettern" role="group" aria-label="Choose a day">
        <button type="button" data-schritt="-1" aria-label="Previous day">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
        </button>
        <button type="button" class="heute-knopf" data-zurueck hidden>Today</button>
        <button type="button" data-schritt="1" aria-label="Next day">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
        </button>
      </div>
    </div>
    <div class="heute-inhalt" data-heute-inhalt aria-live="polite">
      <p class="heute-leer">Loading …</p>
    </div>
  </section>

  <Gefolgt />
</Seite>

<script>
  /*
   * „On this day": den Tag des Besuchers aus dem Kalender lesen
   * (/data/heute.json, gebaut von lib/heute.js) und zeigen. Geblättert wird
   * durch ein Schaltjahr, damit auch der 29. Februar erreichbar bleibt.
   */
  const BASIS = import.meta.env.BASE_URL.replace(/\/$/, '')
  const abschnitt = document.querySelector<HTMLElement>('[data-heute]')

  type Rennen = [number, string, string, string, string]
  type Geboren = [number, string, string, number, number]
  type Tag = { rennen: Rennen[]; geboren: Geboren[] }

  if (abschnitt) {
    const inhalt = abschnitt.querySelector<HTMLElement>('[data-heute-inhalt]')!
    const kopf = abschnitt.querySelector<HTMLElement>('[data-heute-datum]')!
    const zurueck = abschnitt.querySelector<HTMLButtonElement>('[data-zurueck]')!
    const jetzt = new Date()
    const diesesJahr = jetzt.getFullYear()
    /* Der Tag als Datum im Schaltjahr 2024, in UTC – nur Monat und Tag zählen. */
    const heute = Date.UTC(2024, jetzt.getMonth(), jetzt.getDate())
    let gezeigt = heute
    let kalender: Record<string, Tag> = {}

    const TAG_MS = 86_400_000
    const schluessel = (t: number) => new Date(t).toISOString().slice(5, 10)
    const alsText = (t: number) =>
      new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', timeZone: 'UTC' }).format(t)
    /* Einen Tag weiter, über das Jahresende hinweg im Kreis. */
    const weiter = (t: number, n: number) => {
      const neu = t + n * TAG_MS
      if (neu >= Date.UTC(2025, 0, 1)) return neu - 366 * TAG_MS
      if (neu < Date.UTC(2024, 0, 1)) return neu + 366 * TAG_MS
      return neu
    }

    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, klasse?: string, text?: string) => {
      const e = document.createElement(tag)
      if (klasse) e.className = klasse
      if (text !== undefined) e.textContent = text
      return e
    }
    const verweis = (weg: string, text: string) => {
      const a = el('a', undefined, text)
      a.href = `${BASIS}${weg}`
      return a
    }
    const vor = (jahr: number) => {
      const n = diesesJahr - jahr
      return n === 0 ? 'this year' : n === 1 ? 'a year ago' : `${n} years ago`
    }

    function spalte(titel: string) {
      const s = el('div', 'heute-spalte')
      s.append(el('h3', undefined, titel))
      const liste = el('ol', 'heute-liste')
      s.append(liste)
      return { s, liste }
    }

    function zeige() {
      const tag = kalender[schluessel(gezeigt)] ?? { rennen: [], geboren: [] }
      const istHeute = gezeigt === heute
      kopf.textContent = istHeute
        ? `Today, ${alsText(gezeigt)}: races held on this date, and race winners born on it.`
        : `${alsText(gezeigt)}: races held on this date, and race winners born on it.`
      zurueck.hidden = istHeute
      inhalt.replaceChildren()

      if (tag.rennen.length) {
        const { s, liste } = spalte(`${tag.rennen.length} ${tag.rennen.length === 1 ? 'race' : 'races'}`)
        for (const [jahr, gp, id, sieger, siegerId] of tag.rennen) {
          const li = el('li')
          li.append(el('b', 'anzeige', String(jahr)))
          const was = el('span', 'was')
          was.append(verweis(`/races/${id}/`, gp))
          const wer = el('span', 'wer', 'won by ')
          wer.append(verweis(`/drivers/${siegerId}/`, sieger))
          was.append(wer)
          li.append(was, el('span', 'wann', vor(jahr)))
          liste.append(li)
        }
        inhalt.append(s)
      } else {
        /* Kein Rennen an diesem Tag – dann wenigstens sagen, wann das nächste war. */
        let t = gezeigt
        for (let i = 0; i < 366 && !kalender[schluessel(t)]?.rennen.length; i++) t = weiter(t, 1)
        const p = el('div', 'heute-spalte heute-leer')
        p.append(el('p', undefined, `No World Championship race has ever been held on ${alsText(gezeigt)}.`))
        const sprung = el('button', 'leise-knopf', `Go to the next race day, ${alsText(t)}`)
        sprung.type = 'button'
        sprung.addEventListener('click', () => { gezeigt = t; zeige() })
        p.append(sprung)
        inhalt.append(p)
      }

      if (tag.geboren.length) {
        const { s, liste } = spalte('Born on this day')
        for (const [jahr, name, id, siege, titel] of tag.geboren) {
          const li = el('li')
          li.append(el('b', 'anzeige', String(jahr)))
          const was = el('span', 'was')
          was.append(verweis(`/drivers/${id}/`, name))
          was.append(el('span', 'wer', titel > 0
            ? `${titel}× World Champion, ${siege} ${siege === 1 ? 'win' : 'wins'}`
            : `${siege} ${siege === 1 ? 'win' : 'wins'}`))
          li.append(was)
          liste.append(li)
        }
        s.classList.add('geboren')
        inhalt.append(s)
      }
    }

    for (const knopf of abschnitt.querySelectorAll<HTMLButtonElement>('[data-schritt]')) {
      knopf.addEventListener('click', () => {
        gezeigt = weiter(gezeigt, Number(knopf.dataset.schritt))
        zeige()
      })
    }
    zurueck.addEventListener('click', () => { gezeigt = heute; zeige() })

    fetch(`${BASIS}/data/heute.json`)
      .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
      .then((d) => { kalender = d; zeige() })
      .catch(() => { abschnitt.hidden = true })
  }
</script>
<style>
  /*
   * Der Titel der Startseite ist der größte der Seite, sonst nichts: keine
   * Oberzeile, kein Lead, kein farbiges Wort. Was darunter folgt, ist Daten.
   */
  .start { margin-bottom: var(--abstand-5); }
  .weiter { margin: var(--abstand-3) 0 0; }

  @media (max-width: 40rem) {
    .start { margin-bottom: var(--abstand-4); }
  }
  .start h1 { font-size: clamp(var(--text-7), 1.4rem + 3.4vw, var(--text-9)); max-width: none; }

  /*
   * Unter dem Band zwei Spalten: links der WM-Stand (7 von 12), rechts das
   * nächste Rennen und der jüngste Rekordwechsel (5 von 12). Schmal untereinander,
   * in derselben Reihenfolge – so liest die Tastatur, was das Auge liest.
   */
  .start-raster {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    grid-template-rows: auto 1fr;
    gap: 0 var(--abstand-7);
    align-items: start;
  }

  /*
   * Im Quelltext stehen das nächste Rennen, der Stand und der Rekordwechsel in
   * dieser Reihenfolge: So liest es am Telefon und für Vorleser, und am Telefon
   * stehen Band, nächstes Rennen und Stand so in den ersten 800 Pixeln. Breit
   * stellt das Raster den Stand links neben die beiden anderen.
   */
  .start-raster > .wm { grid-column: 1; grid-row: 1 / span 2; }
  .start-raster > .naechstes { grid-column: 2; grid-row: 1; }
  .start-raster > .marke { grid-column: 2; grid-row: 2; }
  .start-raster > :only-child { grid-column: 1 / -1; }
  .start-raster > .naechstes { margin-top: var(--abstand-7); }

  @media (max-width: 56rem) {
    .start-raster { grid-template-columns: minmax(0, 1fr); }
    .start-raster > * { grid-column: 1 !important; grid-row: auto !important; }
    .start-raster > .naechstes { margin-top: 0; }
  }

  /* Am Telefon fünf Zeilen im Turm: Sonst rückte das nächste Rennen aus den ersten 800 Pixeln. */
  @media (max-width: 40rem) {
    .turm .weitere { display: none; }
  }

  .naechstes .wann { margin: var(--abstand-2) 0 0; }
  .naechstes p, .marke p { margin: var(--abstand-3) 0 0; max-width: var(--mass); }

  /* Die Tage bis zum Rennen: die eine Zahl, die sich bewegt. Eng und groß. */
  .countdown { color: var(--muted); }
  .countdown :global(b) {
    font-size: var(--text-7);
    font-stretch: var(--eng);
    font-weight: 700;
    line-height: 1;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .titelsatz { color: var(--ink-2); }
  .marke b { color: var(--ink); }

  /*
   * „On this day": links die Rennen des Tages, rechts die Geburtstage. Die
   * Einträge schreibt das Skript – daher :global, Astros Bereichsattribut
   * tragen nur die Elemente aus dem Gerüst.
   */
  .blaettern { display: flex; flex: none; align-items: center; gap: var(--abstand-1); }

  .blaettern button {
    display: grid;
    place-items: center;
    min-width: 2.5rem;
    height: 2.5rem;
    padding: 0 0.6rem;
    font-size: var(--text-2);
    font-weight: 650;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--border-input);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .blaettern button:hover { border-color: var(--ink); }
  .blaettern button[hidden] { display: none; }
  .blaettern svg { width: 1.05rem; height: 1.05rem; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }

  .heute-inhalt {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--abstand-4) var(--abstand-7);
    min-height: 8rem;
  }

  .heute-inhalt :global(.heute-spalte) { flex: 1 1 26rem; min-width: 0; }
  .heute-inhalt :global(.heute-spalte.geboren) { flex: 0 1 22rem; }

  .heute-inhalt :global(h3) {
    margin: 0 0 var(--abstand-2);
    font-size: var(--text-2);
    font-weight: 600;
    color: var(--muted);
  }

  .heute-inhalt :global(.heute-liste) { margin: 0; padding: 0; list-style: none; background: var(--surface); }

  .heute-inhalt :global(.heute-liste li) {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--abstand-3);
    padding: var(--abstand-2) var(--abstand-3);
    border-bottom: 1px solid var(--border);
  }

  .heute-inhalt :global(.heute-liste li b) {
    font-size: var(--text-5);
    font-stretch: var(--eng);
    font-weight: 700;
    line-height: 1;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .heute-inhalt :global(.was) { display: grid; min-width: 0; }
  .heute-inhalt :global(.was > a) { font-weight: 650; text-decoration: none; }
  .heute-inhalt :global(.was > a:hover) { text-decoration: underline 2px; text-decoration-color: var(--lackierung-linie); }
  .heute-inhalt :global(.wer) { font-size: var(--text-2); color: var(--muted); }
  .heute-inhalt :global(.wer a) { color: var(--ink-2); text-decoration-thickness: 1px; text-decoration-color: var(--border-input); }
  .heute-inhalt :global(.wann) { font-size: var(--text-2); color: var(--muted); white-space: nowrap; }

  .heute-inhalt :global(.heute-leer p) { margin: 0 0 var(--abstand-3); color: var(--ink-2); }
  .heute-leer { color: var(--muted); }

  @media (max-width: 34rem) {
    .heute-inhalt :global(.heute-liste li) { grid-template-columns: 2.75rem minmax(0, 1fr); }
    .heute-inhalt :global(.wann) { display: none; }
  }
</style>
