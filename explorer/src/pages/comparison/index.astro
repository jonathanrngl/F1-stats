---
import Seite from '../../layouts/Seite.astro'
import Vergleich from '../../components/Vergleich.jsx'
import { pfad } from '../../lib/db.js'

/*
 * Ein Vergleich beliebiger Paare lässt sich nicht vorrendern, und der Zeitraum
 * soll sich einstellen lassen, ohne bei jedem Schritt nachzuladen. Die Insel
 * holt die Fahrerliste und die beiden Profile aus der JSON-API.
 *
 * Die Liste stand vorher eingebettet in der Seite – 289 KB HTML, auch für
 * jeden, der nur kurz hereinsah.
 */
---

<Seite
  titel="Driver comparison – two careers side by side"
  beschreibung="Two Formula 1 drivers head to head: wins, podiums, rates, averages and the share of possible points, across a full career or a period of your own choosing."
>
  <header class="seitenkopf">
    <div>
      <p class="oberzeile">Analysis</p>
      <div class="titelblock">
        <h1>Compare two drivers</h1>
        <p class="lead">
          Two careers side by side, in full or over a period you choose. If the two were
          team-mates, their head-to-head in the same car follows below.
        </p>
      </div>
    </div>
  </header>

  <p class="hinweis nur-ohne-js">
    The comparison is worked out in your browser and needs JavaScript. Each driver's page has the
    full career figures and the record against every team-mate –
    {' '}<a href={pfad.seite('/drivers/')}>find a driver</a>, or see the
    {' '}<a href={pfad.seite('/teammates/')}>team-mate ratings</a>.
  </p>

  <div class="nur-mit-js vergleich">
    <Vergleich client:load />
  </div>
</Seite>

<style is:global>
  /*
   * Die Farben der beiden Fahrer: das geprüfte erste Paar der Serienpalette.
   * Dieselben an den Köpfen, an den Linien des Bildes und an den Balken der
   * Tabelle – wer A in Rot sieht, sieht ihn überall in Rot.
   */
  .vgl {
    --farbe-0: var(--s1);
    --farbe-1: var(--s2);
  }

  .waehler {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    gap: var(--abstand-4);
  }

  .auswahl > label {
    display: block;
    margin-bottom: var(--abstand-2);
    font-size: var(--text-2);
    font-weight: 600;
    color: var(--muted);
  }

  .auswahl .feld { position: relative; }

  .auswahl input {
    width: 100%;
    min-height: 2.75rem;
    padding: var(--abstand-2) var(--abstand-3);
    font: inherit;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--border-input);
    border-radius: var(--radius);
    appearance: none;
  }

  .auswahl input:hover { border-color: var(--ink); }
  .auswahl input:focus-visible { border-color: var(--ink); outline: 2px solid var(--ink); outline-offset: 1px; }

  /* Die Trefferliste liegt über der Seite – sie darf einen Schatten haben. */
  .auswahl ul {
    position: absolute;
    z-index: 5;
    top: calc(100% + var(--abstand-1));
    left: 0;
    right: 0;
    margin: 0;
    padding: var(--abstand-1);
    list-style: none;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .auswahl li[role='option'],
  .auswahl .gewaehlt {
    display: flex;
    align-items: center;
    gap: var(--abstand-2);
    width: 100%;
    min-height: 2.75rem;
    padding: var(--abstand-2);
    text-align: left;
    background: none;
    border: none;
    border-radius: var(--radius-s);
    cursor: pointer;
    font: inherit;
  }

  .auswahl .gewaehlt {
    padding: var(--abstand-2) var(--abstand-3);
    background: var(--surface);
    border: 1px solid var(--border-input);
    border-radius: var(--radius);
  }

  .auswahl .gewaehlt:hover { border-color: var(--ink); }
  .auswahl li[aria-selected='true'] { background: var(--surface-2); }
  .auswahl .kein-treffer { padding: var(--abstand-2) var(--abstand-3); font-size: var(--text-2); color: var(--muted); }
  .auswahl b { flex: 1; min-width: 0; color: var(--ink); font-weight: 600;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .auswahl i { flex: none; font-style: normal; font-size: var(--text-2); color: var(--muted); font-variant-numeric: tabular-nums; }

  /* Das Länderkürzel: der Rahmen aus theme.css, ohne dessen Abstand nach rechts. */
  .vgl .kuerzel { margin: 0; flex: none; }

  /* Der Zeitraum: eine Zeile Bedienung auf dem Grund, kein Kasten. */
  .zeitwahl {
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--abstand-2) var(--abstand-4);
    margin: var(--abstand-5) 0 0;
    padding: 0;
    border: none;
  }

  .zeitwahl > legend {
    float: left;
    margin-right: var(--abstand-2);
    padding: 0;
    font-size: var(--text-2);
    font-weight: 600;
    color: var(--muted);
  }

  .zeitwahl .knoepfe { display: flex; flex-wrap: wrap; gap: var(--abstand-1); }

  /* Gedrückt heißt gefüllt in Tinte, wie bei den Pillen in theme.css. */
  .zeitwahl button {
    min-height: 2.25rem;
    padding: var(--abstand-1) var(--abstand-3);
    font: inherit;
    font-size: var(--text-2);
    font-weight: 550;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--border-input);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .zeitwahl button:hover { border-color: var(--ink); }
  .zeitwahl button[aria-pressed='true'] { color: var(--plane); background: var(--ink); border-color: var(--ink); }

  .zeitwahl .regler { display: flex; gap: var(--abstand-3); margin-left: auto; }
  .zeitwahl .regler label { display: flex; align-items: center; gap: var(--abstand-2);
    font-size: var(--text-2); color: var(--muted); }
  .zeitwahl .regler input {
    width: 5rem; min-height: 2.25rem; padding: var(--abstand-1) var(--abstand-2); font: inherit; font-size: var(--text-2);
    color: var(--ink); background: var(--surface);
    border: 1px solid var(--border-input); border-radius: var(--radius);
    font-variant-numeric: tabular-nums;
  }

  .vgl-kopf {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--abstand-3);
    margin-top: var(--abstand-5);
  }

  /*
   * Der Kopf je Fahrer: flach auf der Fläche. Der Streifen oben ist der
   * Schlüssel zu Linie und Balken darunter – er trägt eine Bedeutung.
   */
  .kopfkarte {
    display: grid;
    gap: var(--abstand-1);
    padding: var(--abstand-3) var(--abstand-4);
    background: var(--surface);
  }

  .kopfkarte.s0 { border-top: 4px solid var(--farbe-0); }
  .kopfkarte.s1 { border-top: 4px solid var(--farbe-1); }
  .kopfkarte a { color: var(--ink); font-weight: 650; text-decoration: none; }
  .kopfkarte a:hover { text-decoration: underline; text-decoration-thickness: 2px; }
  .kopfkarte i { font-style: normal; font-size: var(--text-2); color: var(--muted); }
  .kopfkarte .kuerzel { justify-self: start; margin-bottom: var(--abstand-1); }

  table.gegen { width: 100%; border-collapse: collapse; margin-top: var(--abstand-5); background: var(--surface); }

  table.gegen tr.gruppe,
  table.gegen tr.gruppe:hover { background: none; }

  table.gegen tr.gruppe th {
    padding: var(--abstand-4) 0 var(--abstand-2);
    font-size: var(--text-2);
    font-weight: 600;
    color: var(--muted);
    text-align: center;
    background: none;
    border: none;
  }

  table.gegen th[scope='row'] {
    width: 34%;
    padding: var(--abstand-2) var(--abstand-3);
    text-align: center;
    font-size: var(--text-2);
    font-weight: 600;
    color: var(--ink-2);
    border-bottom: 1px solid var(--border);
    white-space: normal;
  }

  /* Die Erklärung einer Zeile, sichtbar statt als Tooltip hinter einem „?“. */
  table.gegen th small {
    display: block;
    margin-top: var(--abstand-1);
    font-size: var(--text-2);
    font-weight: 400;
    line-height: 1.35;
    color: var(--muted);
    text-wrap: pretty;
  }

  /* Der Balken läuft von der Mitte nach außen: So zeigt die Länge sofort,
     wer bei welcher Zeile vorn liegt, ohne dass man Zahlen vergleichen muss. */
  td.wert {
    position: relative;
    width: 33%;
    padding: var(--abstand-2) var(--abstand-3);
    border-bottom: 1px solid var(--border);
    font-stretch: var(--schmal);
    font-variant-numeric: tabular-nums lining-nums;
    color: var(--ink-2);
  }

  td.wert b { position: relative; z-index: 1; font-weight: 600; }
  td.links { text-align: right; }
  td.rechts { text-align: left; }

  td.wert .balken {
    position: absolute;
    top: var(--abstand-1);
    bottom: var(--abstand-1);
    background: var(--surface-3);
  }

  td.wert .balken.b0 { width: 0%; }
  td.wert .balken.b1 { width: 5%; }
  td.wert .balken.b2 { width: 10%; }
  td.wert .balken.b3 { width: 15%; }
  td.wert .balken.b4 { width: 20%; }
  td.wert .balken.b5 { width: 25%; }
  td.wert .balken.b6 { width: 30%; }
  td.wert .balken.b7 { width: 35%; }
  td.wert .balken.b8 { width: 40%; }
  td.wert .balken.b9 { width: 45%; }
  td.wert .balken.b10 { width: 50%; }
  td.wert .balken.b11 { width: 55%; }
  td.wert .balken.b12 { width: 60%; }
  td.wert .balken.b13 { width: 65%; }
  td.wert .balken.b14 { width: 70%; }
  td.wert .balken.b15 { width: 75%; }
  td.wert .balken.b16 { width: 80%; }
  td.wert .balken.b17 { width: 85%; }
  td.wert .balken.b18 { width: 90%; }
  td.wert .balken.b19 { width: 95%; }
  td.wert .balken.b20 { width: 100%; }

  /* Bündig an der Mittelspalte: b20 ist so breit wie die Zelle und ragt nicht hinaus. */
  td.links .balken { right: 0; }
  td.rechts .balken { left: 0; }

  /* Wer vorn liegt: die Zahl fett, der Balken in der Farbe des Fahrers getönt. */
  td.fuehrt b { color: var(--ink); font-weight: 700; }
  td.links.fuehrt .balken { background: color-mix(in srgb, var(--farbe-0) 18%, var(--surface)); }
  td.rechts.fuehrt .balken { background: color-mix(in srgb, var(--farbe-1) 18%, var(--surface)); }

  .vergleich .status { margin: var(--abstand-5) 0 0; color: var(--muted); text-wrap: pretty; }
  .vergleich .leer .status { color: var(--ink-2); }
  .vgl .hinweis { margin: var(--abstand-5) 0 0; }

  /* Ein Fehler ist eine blaue Flagge wie jeder Hinweis – Rot heißt hier „Ausfall“. */
  .vergleich .fehler {
    max-width: 50rem;
    margin: var(--abstand-5) 0 0;
    padding: var(--abstand-3) var(--abstand-4);
    color: var(--ink-2);
    background: var(--surface);
    border-left: 4px solid var(--flagge-blau);
    text-wrap: pretty;
  }

  /* Der leere Zustand: kein Hinweis auf eine Sackgasse, sondern der Einstieg. */
  .vgl .anstoss {
    margin: var(--abstand-6) 0 var(--abstand-3);
    font-size: var(--text-2);
    font-weight: 600;
    color: var(--muted);
  }

  .vgl .paarungen {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(15rem, 100%), 1fr));
    gap: var(--abstand-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Wie .karte in theme.css: flach auf der Fläche, beim Überfahren eine Linie in Tinte. */
  .vgl .paarungen a {
    display: block;
    height: 100%;
    padding: var(--abstand-3) var(--abstand-4);
    color: inherit;
    background: var(--surface);
    text-decoration: none;
  }

  .vgl .paarungen a:hover { box-shadow: inset 0 -3px 0 var(--ink); }
  .vgl .paarungen b { display: block; color: var(--ink); font-weight: 650; }
  .vgl .paarungen span { font-size: var(--text-2); color: var(--muted); }

  .duell { margin-top: var(--abstand-7); }
  .duell h2 { margin: 0 0 var(--abstand-2); }
  .duell p { max-width: var(--mass); margin: 0; color: var(--muted); text-wrap: pretty; }
  .duell .fuss { margin-top: var(--abstand-3); font-size: var(--text-2); }

  @media (max-width: 40rem) {
    .zeitwahl .regler { margin-left: 0; }
    table.gegen th[scope='row'] { width: 40%; }
  }
</style>

<style is:global>
  /*
   * Die beiden Karrieren als Linien (KarrierenBild.jsx). Die Farben kommen
   * aus .vgl – dieselben wie an den Köpfen darüber.
   */
  .karrieren {
    margin: var(--abstand-4) 0 var(--abstand-5);
    padding: var(--abstand-4) var(--abstand-4) var(--abstand-3);
    background: var(--surface);
  }

  .karrieren-kopf { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: var(--abstand-2) var(--abstand-4); }
  .karrieren figcaption { display: grid; gap: var(--abstand-1); font-size: var(--text-2); color: var(--muted); }
  .karrieren figcaption b { font-size: var(--text-3); color: var(--ink); font-weight: 650; }

  /* Welche Zahl gezeichnet wird: gedrückt heißt gefüllt in Tinte, wie bei den Pillen. */
  .masswahl { display: flex; flex-wrap: wrap; gap: var(--abstand-1); }
  .masswahl button {
    min-height: 2.25rem;
    padding: var(--abstand-1) var(--abstand-3);
    font: inherit;
    font-size: var(--text-2);
    font-weight: 550;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--border-input);
    border-radius: var(--radius);
    cursor: pointer;
  }
  .masswahl button:hover { border-color: var(--ink); }
  .masswahl button[aria-pressed='true'] { color: var(--plane); background: var(--ink); border-color: var(--ink); }

  .karrieren-stand {
    display: flex;
    flex-wrap: wrap;
    gap: var(--abstand-1) var(--abstand-5);
    min-height: 1.4rem;
    margin: var(--abstand-2) 0 var(--abstand-1);
    font-size: var(--text-2);
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  .karrieren-stand span { display: inline-flex; align-items: center; gap: var(--abstand-2); }
  .karrieren-stand b { color: var(--ink); }
  /* Ein kurzer Strich in der Farbe der Linie, kein Kästchen. */
  .karrieren-stand i { width: 1rem; height: 3px; }
  .karrieren-stand .s0 i { background: var(--farbe-0); }
  .karrieren-stand .s1 i { background: var(--farbe-1); }

  .karrieren svg { display: block; overflow: visible; touch-action: pan-y; }
  .karrieren .gitter { stroke: var(--grid); }
  /* Die Achse in Tinte, wie auf dem Monitor. */
  .karrieren .grundlinie { stroke: var(--ink); }
  .karrieren .achse { font-size: var(--text-1); font-stretch: var(--schmal); fill: var(--muted); font-variant-numeric: tabular-nums; }
  .karrieren .fadenkreuz { stroke: var(--border-input); stroke-dasharray: 3 3; }
  .karrieren .linie polyline { fill: none; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .karrieren .linie circle { stroke: var(--surface); stroke-width: 1.5; }
  .karrieren .linie.s0 polyline { stroke: var(--farbe-0); }
  .karrieren .linie.s1 polyline { stroke: var(--farbe-1); }
  .karrieren .linie.s0 circle, .karrieren .zeiger.s0 { fill: var(--farbe-0); }
  .karrieren .linie.s1 circle, .karrieren .zeiger.s1 { fill: var(--farbe-1); }
  .karrieren .zeiger { stroke: var(--surface); stroke-width: 2; }
  .karrieren .ende { font-size: var(--text-1); font-weight: 650; fill: var(--ink); font-variant-numeric: tabular-nums; }
</style>
