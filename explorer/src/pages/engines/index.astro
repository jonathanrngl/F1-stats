---
/**
 * Alle Motorenhersteller.
 *
 * Die Seite kannte bisher Fahrer und Teams, nicht aber den Motor – dabei steht
 * er in jeder der 27.599 Ergebniszeilen. Ohne ihn fehlt die Geschichte der
 * Kundenmotoren, und die ist ein gutes Stück der Geschichte dieses Sports.
 */
import Seite from '../../layouts/Seite.astro'
import Filter from '../../components/Filter.astro'
import Sortierung from '../../components/Sortierung.astro'
import { zahl } from '../../lib/format.js'
import { db, pfad } from '../../lib/db.js'
import { motorenListe } from '../../engine/motor.js'

const motoren = motorenListe(db())
const mitSieg = motoren.filter((m) => m.siege > 0).length
---

<Seite
  titel="Formula 1 engine manufacturers"
  beschreibung={`${motoren.length} engine manufacturers since 1950, with races, wins and titles.`}
>
  <header class="seitenkopf">
    <div>
      <p class="oberzeile">Engines</p>
      <h1>Engine manufacturers</h1>
      <p class="lead">
        {motoren.length} manufacturers have entered a World Championship race since 1950;
        {' '}{mitSieg} of them have won one.
      </p>
    </div>
  </header>

  <Filter
    platzhalter="Filter by manufacturer or country"
    einheit={['manufacturer', 'manufacturers']}
    pillen={[
      { label: 'Race winners', spalte: 3, art: 'gefuellt' },
      { label: 'Title winners', spalte: 5, art: 'gefuellt' },
    ]}
  />

  <div class="tabelle lang">
    <table>
      <thead>
        <tr>
          <th><button type="button" data-spalte="0" data-art="name">Engine</button></th>
          <th><button type="button" data-spalte="1" data-art="jahr">Period</button></th>
          <th class="num"><button type="button" data-spalte="2" data-art="zahl">Races</button></th>
          <th class="num"><button type="button" data-spalte="3" data-art="zahl" data-aktiv="1">Wins</button></th>
          <th class="num"><button type="button" data-spalte="4" data-art="zahl">Podiums</button></th>
          <th class="num"><button type="button" data-spalte="5" data-art="zahl">Titles</button></th>
        </tr>
      </thead>
      <tbody>
        {motoren.map((m) => (
          <tr data-name={m.name}>
            <td>
              <span class="kuerzel" title={m.landName ?? ''}>{m.land ?? '—'}</span>
              <a class="zeile" href={pfad.seite(`/engines/${m.id}/`)}>{m.name}</a>
            </td>
            <td class="leise">{m.von === m.bis ? m.von : `${m.von}–${m.bis}`}</td>
            <td class="num">{zahl(m.rennen)}</td>
            <td class="num">{m.siege || ''}</td>
            <td class="num">{m.podien || ''}</td>
            <td class="num meister">{m.titel || ''}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="fussnote">
    Counted per race, not per car: an engine that powered four cars in a race was in one race,
    not four.
  </p>

  <Sortierung vorsortiert={3} gleichstand={2} />
</Seite>
