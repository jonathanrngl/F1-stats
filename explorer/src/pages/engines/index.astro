---
/**
 * Alle Motorenhersteller.
 *
 * Die Seite kannte bisher Fahrer und Teams, nicht aber den Motor – dabei steht
 * er in jeder der 27.599 Ergebniszeilen. Ohne ihn fehlt die Geschichte der
 * Kundenmotoren, und die ist ein gutes Stück der Geschichte dieses Sports.
 */
import Seite from '../../layouts/Seite.astro'
import { zahl } from '../../lib/format.js'
import { db, pfad } from '../../lib/db.js'
import { motorenListe } from '../../engine/motor.js'

const motoren = motorenListe(db())
const mitSieg = motoren.filter((m) => m.siege > 0).length
---

<Seite
  titel="Formula 1 engine manufacturers"
  beschreibung={`${motoren.length} engine manufacturers since 1950, with races, wins and titles.`}
>
  <h1>Engines</h1>
  <p class="lead">
    {motoren.length} engine manufacturers have entered a World Championship race since 1950;
    {' '}{mitSieg} of them have won one. Counted per race, not per car: an engine that powered
    four cars in a race was in one race, not four.
  </p>

  <div class="tabelle">
    <table>
      <thead>
        <tr>
          <th><button type="button" data-spalte="0" data-art="name">Engine</button></th>
          <th><button type="button" data-spalte="1" data-art="jahr">Period</button></th>
          <th class="num"><button type="button" data-spalte="2" data-art="zahl">Races</button></th>
          <th class="num"><button type="button" data-spalte="3" data-art="zahl" data-aktiv="1">Wins</button></th>
          <th class="num"><button type="button" data-spalte="4" data-art="zahl">Podiums</button></th>
          <th class="num"><button type="button" data-spalte="5" data-art="zahl">Titles</button></th>
        </tr>
      </thead>
      <tbody>
        {motoren.map((m) => (
          <tr data-name={m.name}>
            <td>
              <span class="kuerzel" title={m.landName ?? ''}>{m.land ?? '—'}</span>
              <a class="zeile" href={pfad.seite(`/engines/${m.id}/`)}>{m.name}</a>
            </td>
            <td style="color:var(--muted)">{m.von === m.bis ? m.von : `${m.von}–${m.bis}`}</td>
            <td class="num">{zahl(m.rennen)}</td>
            <td class="num">{m.siege || ''}</td>
            <td class="num">{m.podien || ''}</td>
            <td class="num">{m.titel || ''}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Seite>

<script>
  /* Dieselbe Sortierung wie auf der Fahrerliste – siehe dort für die Gründe. */
  const koerper = document.querySelector('main tbody')
  const zeilen = [...koerper.querySelectorAll('tr')]
  const knoepfe = [...document.querySelectorAll('main thead button')]
  const RENNEN = 2

  let sortiert = { spalte: 3, ab: true }
  const zellen = new Map(zeilen.map((tr) => [tr, [...tr.cells]]))
  const zahlAus = (tr, i) =>
    Number(zellen.get(tr)[i].textContent.trim().replace(/,/g, '')) || 0

  function wert(tr, spalte, art) {
    if (art === 'name') return tr.dataset.name ?? ''
    if (art === 'jahr') return Number(zellen.get(tr)[spalte].textContent.trim().slice(-4)) || 0
    return zahlAus(tr, spalte)
  }

  function sortiere(spalte, art) {
    const ab = sortiert.spalte === spalte ? !sortiert.ab : art !== 'name'
    sortiert = { spalte, ab }

    zeilen.sort((a, b) => {
      const x = wert(a, spalte, art)
      const y = wert(b, spalte, art)
      const v = art === 'name' ? String(x).localeCompare(String(y), 'en') : x - y
      return (ab ? -v : v) || zahlAus(b, RENNEN) - zahlAus(a, RENNEN)
    })

    const stueck = document.createDocumentFragment()
    for (const tr of zeilen) stueck.append(tr)
    koerper.append(stueck)

    for (const k of knoepfe) {
      const an = Number(k.dataset.spalte) === spalte
      k.dataset.aktiv = an ? '1' : ''
      k.closest('th').setAttribute('aria-sort', an ? (ab ? 'descending' : 'ascending') : 'none')
      k.dataset.richtung = an && !ab ? 'auf' : ''
    }
  }

  for (const k of knoepfe) {
    k.addEventListener('click', () => sortiere(Number(k.dataset.spalte), k.dataset.art))
  }
</script>
