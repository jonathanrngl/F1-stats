---
/**
 * Ein Motorenhersteller.
 *
 * Die interessanteste Tabelle ist die der Teams: Bei einem Werksmotor steht
 * dort ein Name, beim Ford-Cosworth DFV siebenundsechzig. Genau dieser
 * Unterschied ist der Grund, warum es diese Seiten gibt.
 */
import Seite from '../../layouts/Seite.astro'
import Karriere from '../../components/Karriere.astro'
import Sprung from '../../components/Sprung.astro'
import Epochenband from '../../components/Epochenband.astro'
import { zeitraumImBand } from '../../components/epochen.js'
import { ein, prozent, raenge, zahl } from '../../lib/format.js'
import { alle, db, eine, pfad } from '../../lib/db.js'
import { land } from '../../lib/laender.js'
import {
  motorProSaison, motorProfil, motorSieger, motorTeams, motorTitel, motorenListe,
} from '../../engine/motor.js'

export async function getStaticPaths() {
  return motorenListe(db()).map((m) => ({ params: { id: m.id } }))
}

const { id } = Astro.params
const motor = motorProfil(db(), id)
const heimat = land(null, motor.landName, motor.land)
/*
 * Ohne Grenze holen und erst danach kürzen. Mit dem Standardwert von 40 stand
 * auf der Ford-Seite „40 teams", obwohl es 67 sind – die Zahl im Text kam aus
 * der abgeschnittenen Liste. Eine Obergrenze fürs Anzeigen darf die Aussage
 * darüber nicht verändern.
 */
const alleTeams = motorTeams(db(), id, 1000)
const teams = alleTeams.slice(0, 25)
const sieger = motorSieger(db(), id)
const titel = motorTitel(db(), id)
const saisons = motorProSaison(db(), id)

const zeitraum = motor.von === motor.bis ? String(motor.von) : `${motor.von}–${motor.bis}`

/*
 * Dasselbe Bild wie bei einer Fahrerkarriere – die Balken bedeuten hier nur
 * etwas anderes: Rennen statt Starts, und ein Sieg ist der Sieg irgendeines
 * Autos mit diesem Motor. Ein Titel trägt keine Marke, weil ein Motor keinen
 * Titel gewinnt; das tut der Fahrer im Auto.
 */
const bild = saisons.map((s) => ({
  jahr: s.jahr,
  starts: s.rennen,
  siege: s.siege,
  podien: s.podien,
  wmPlatz: null,
  meister: false,
}))

const beschreibung =
  `${motor.name} in Formula 1: ${zahl(motor.rennen)} races, ${motor.siege} wins, ` +
  `${motor.podien} podiums (${zeitraum}).`

/*
 * Die Motoren selbst: Hubraum, Bauart, Aufladung, und wann sie liefen. Vorher
 * stand auf der Seite nur der Hersteller – dabei ist der Weg vom 2,5-Liter-
 * Reihenmotor der 1950er zum 1,6-Liter-Turbo-Hybrid die halbe Geschichte.
 */
const AUFLADUNG = { NATURALLY_ASPIRATED: 'naturally aspirated', TURBOCHARGED: 'turbo', SUPERCHARGED: 'supercharged' }
const modelle = alle(
  `SELECT COALESCE(e.full_name, e.name) AS name, e.capacity_l AS hubraum, e.configuration AS bauart,
          e.aspiration AS aufladung, MIN(se.year) AS von, MAX(se.year) AS bis,
          GROUP_CONCAT(DISTINCT k.name) AS teams
     FROM season_entrant_engine se
     JOIN engine e ON e.id = se.engine_id
     JOIN constructor k ON k.id = se.constructor_id
    WHERE se.engine_manufacturer_id = ?
    GROUP BY e.id
    ORDER BY von, name`,
  id,
)

/*
 * Das Epochenband: Saisons mit einem Start, Titeljahre aus der Liste der
 * Fahrertitel weiter unten – ein Motor gewinnt keinen Titel, der Fahrer im
 * Auto tut es (docs/DESIGN.md 8.3).
 */
const startJahre = saisons.filter((s) => s.starts > 0).map((s) => s.jahr)
const titelJahre = titel.map((t) => t.jahr)

/*
 * Den Zeitraum zeigt das Epochenband. In Worten steht er nur, wenn das Band
 * erstes oder letztes Jahr nicht beschriftet – es lässt eine Zahl weg, die
 * näher als acht Saisons an einer anderen steht (components/epochen.js).
 */
const bandNenntZeitraum = zeitraumImBand(startJahre)

/*
 * Der Kopfsatz: Herkunft und wie viele Teams den Motor fuhren, in einem Satz
 * statt einer Zeile Eckdaten mit Trennlinien (docs/DESIGN.md 8.2).
 */
const herkunft = motor.land ? eine('SELECT demonym FROM country WHERE ioc = ?', motor.land)?.demonym : null
const kopfsatz = [
  `${herkunft ? `${herkunft} engine manufacturer` : 'Engine manufacturer'}, used by ${alleTeams.length === 1 ? 'one team' : `${alleTeams.length} teams`}.`,
  !bandNenntZeitraum && (motor.von === motor.bis ? `Raced only in ${motor.von}.` : `First race in ${motor.von}, last in ${motor.bis}.`),
]
  .filter(Boolean)
  .join(' ')

/*
 * Die Kennzahlen. Die tragende zuerst: Titel, wenn es welche gibt; sonst
 * Siege; sonst Rennen (docs/DESIGN.md 8.6). Unter den Konstrukteurstiteln
 * stehen die Fahrertitel – sie sind die Marken im Epochenband.
 */
const kennzahlListe = [
  { art: 'rennen', label: 'Races', wert: zahl(motor.rennen) },
  { art: 'siege', label: 'Wins', wert: zahl(motor.siege), dazu: motor.rennen > 0 ? `${prozent(motor.siege / motor.rennen)} of races` : null },
  { label: 'Podiums', wert: zahl(motor.podien) },
  { label: 'Pole positions', wert: zahl(motor.poles) },
  { label: 'Fastest laps', wert: zahl(motor.schnellsteRunden) },
  {
    art: 'titel',
    label: "Constructors' titles",
    wert: zahl(motor.titel ?? 0),
    dazu: titel.length > 0 ? `${titel.length} drivers' ${titel.length === 1 ? 'title' : 'titles'}` : null,
  },
]
const traegt = (motor.titel ?? 0) > 0 ? 'titel' : motor.siege > 0 ? 'siege' : 'rennen'
const kennzahlen = [
  ...kennzahlListe.filter((k) => k.art === traegt),
  ...kennzahlListe.filter((k) => k.art !== traegt),
]

const ziele = [
  bild.length > 1 && { id: 'verlauf', label: 'Season by season' },
  titel.length > 0 && { id: 'titel', label: 'Titles' },
  { id: 'teams', label: 'Teams' },
  modelle.length > 0 && { id: 'modelle', label: 'Engines' },
  sieger.length > 0 && { id: 'sieger', label: 'Winners' },
].filter(Boolean)
---

<Seite titel={`${motor.name}: Formula 1 engine statistics`} beschreibung={beschreibung} brotkrumen={[{ name: 'Engines', pfad: '/engines/' }]}>
  <header class="seitenkopf">
    <span class="wappen" title={heimat.name}>{heimat.code}</span>
    <div>
      <p class="oberzeile">
        <a href={pfad.seite('/engines/')}>Engines</a>
      </p>
      <div class="titelblock">
        <h1>{motor.name}</h1>
        <p class="kopfsatz">{kopfsatz}</p>
      </div>
      <Epochenband jahre={startJahre} titel={titelJahre} wort="Seasons" />
    </div>
  </header>

  <ul class="kacheln">
    {kennzahlen.map((k) => (
      <li class={k.art === traegt ? 'stark' : undefined}>
        <span>{k.label}</span>
        <b>{k.wert}</b>
        {k.dazu && <i>{k.dazu}</i>}
      </li>
    ))}
  </ul>

  <p class="fussnote">
    Counted per race, not per car: an engine that powered four cars in one race was in one
    race. A win means that a car with this engine won, not necessarily a works team.
  </p>

  <Sprung ziele={ziele} />

  {bild.length > 1 && (
    <section class="abschnitt" id="verlauf">
      <div class="abschnitt-kopf"><div><h2>Season by season</h2></div></div>
      <Karriere saisons={bild} name={motor.name} />
    </section>
  )}

  {titel.length > 0 && (
    <section class="abschnitt" id="titel">
      <div class="abschnitt-kopf">
        <div>
          <h2>Drivers' titles won with this engine</h2>
          <p>The engine does not win the championship; the driver does. These are the seasons in which the champion raced with it.</p>
        </div>
      </div>
      <ul class="titelliste">
        {titel.map((t) => (
          <li>
            <b>{t.jahr}</b>
            <a class="zeile" href={pfad.fahrer(t.fahrerId)}>{t.fahrer}</a>
            <span>{t.teamId ? <a class="leise" href={pfad.team(t.teamId)}>{t.team}</a> : t.team}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="abschnitt" id="teams">
    <div class="abschnitt-kopf">
      <div>
        <h2>Teams that used it</h2>
        <p>
          {alleTeams.length === 1
            ? 'One team, which built the engine itself or had it exclusively.'
            : `${alleTeams.length} teams. A customer engine makes its supplier part of several teams' histories at once.`}
          {alleTeams.length > teams.length && ` The ${teams.length} most successful are listed.`}
        </p>
      </div>
    </div>
    <div class="tabelle">
      <table>
        <thead>
          <tr><th scope="col">Team</th><th scope="col">Period</th><th class="num" scope="col">Races</th><th class="num" scope="col">Wins</th></tr>
        </thead>
        <tbody>
          {teams.map((t) => (
            <tr>
              <th scope="row"><a class="zeile" href={pfad.team(t.id)}>{t.name}</a></th>
              <td class="leise">{t.von === t.bis ? t.von : `${t.von}–${t.bis}`}</td>
              <td class="num">{t.rennen}</td>
              <td class="num">{t.siege || ''}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  {modelle.length > 0 && (
    <section class="abschnitt" id="modelle">
      <div class="abschnitt-kopf"><div><h2>The engines</h2><p>All specifications that raced, with the teams that used them.</p></div></div>
      <div class="tabelle">
        <table>
          <thead>
            <tr><th scope="col">Engine</th><th scope="col">Years</th><th class="num" scope="col">Capacity</th><th scope="col">Layout</th><th scope="col">Teams</th></tr>
          </thead>
          <tbody>
            {modelle.map((m) => (
              <tr>
                <th scope="row">{m.name}</th>
                <td class="leise">{m.von === m.bis ? m.von : `${m.von}–${m.bis}`}</td>
                <td class="num">{m.hubraum ? `${ein(m.hubraum)} l` : '–'}</td>
                <td class="leise">{[m.bauart, AUFLADUNG[m.aufladung] ?? m.aufladung?.toLowerCase()].filter(Boolean).join(', ') || '–'}</td>
                <td class="leise">{m.teams.split(',').join(', ')}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {sieger.length > 0 && (
    <section class="abschnitt" id="sieger">
      <div class="abschnitt-kopf"><div><h2>Drivers who won with it</h2></div></div>
      <div class="rangkarte sieger">
        <ol class="rangliste">
          {raenge(sieger, (f) => f.siege).map((f) => (
            <li data-rang={f.rang} class={f.vorn ? 'vorn' : undefined}>
              <a href={pfad.fahrer(f.id)}>{f.name}</a>
              <b>{f.siege}</b>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}
</Seite>

<style>
  /* Die Fußnote zur Kennzahlleiste: mit Abstand zur Sprungleiste darunter. */
  .kacheln + .fussnote { margin: 0 0 var(--abstand-6); }

  /* Die Titeljahre flach auf der Fläche: das Jahr groß und schmal, daneben Fahrer und Team. */
  .titelliste {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(16rem, 100%), 1fr));
    gap: var(--abstand-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .titelliste li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    gap: 0 var(--abstand-3);
    padding: var(--abstand-3) var(--abstand-4);
    background: var(--surface);
  }

  .titelliste b {
    grid-row: span 2;
    font-size: var(--text-4);
    font-stretch: var(--schmal);
    font-weight: 800;
    color: var(--ink);
    font-variant-numeric: tabular-nums lining-nums;
  }

  .titelliste span { font-size: var(--text-2); color: var(--muted); }

  /* Die Siegerliste kann lang sein: zweispaltig, damit sie nicht die halbe Seite füllt. */
  .sieger .rangliste { columns: 2 16rem; column-gap: var(--abstand-6); }
  .sieger .rangliste li { break-inside: avoid; }
</style>
