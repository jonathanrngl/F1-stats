---
/**
 * Fahrerprofil. Eine Seite je Fahrer, beim Bauen erzeugt.
 *
 * Alle Zahlen kommen aus der Engine, nicht aus SQL an dieser Stelle – damit
 * dieselbe Kennzahl hier, in der API und später im Explorer aus derselben
 * Quelle stammt. Wo eine Kennzahl nicht belegt ist, steht „nicht überliefert“
 * statt einer Null.
 */
import Seite from '../../layouts/Seite.astro'
import { alle, eine, fahrerListe, pfad } from '../../lib/db.js'
import { land } from '../../lib/laender.js'
import { db } from '../../lib/db.js'
import {
  calculateAverageFinish, calculateAverageStart, calculateChampionships,
  calculateDNFRate, calculateEntries, calculateFastestLaps, calculatePodiumRate,
  calculatePodiums, calculatePoints, calculatePoles, calculatePoleToWinRate,
  calculatePositionsGained, calculateStarts, calculateStartsFromPole,
  calculateStreaks, calculateTeamMateComparison, calculateTrackPerformance,
  calculateWinRate, calculateWins, driverRaces,
} from '../../engine/driver.js'

export async function getStaticPaths() {
  return fahrerListe().map((f) => ({ params: { id: f.id } }))
}

const { id } = Astro.params

const fahrer = eine(
  `SELECT d.*, c.ioc AS land, c.name AS landName, c.demonym AS demonym
     FROM driver d LEFT JOIN country c ON c.id = d.nationality_id
    WHERE d.id = ?`,
  id,
)

const heimat = land(fahrer.demonym, fahrer.landName, fahrer.land)

const rennen = driverRaces(db(), id)
const titel = calculateChampionships(db(), id)
const serien = calculateStreaks(rennen)
const duelle = calculateTeamMateComparison(db(), id).slice(0, 8)
const strecken = calculateTrackPerformance(db(), id, 2).slice(0, 10)

const namen = new Map(
  alle('SELECT id, full_name AS name FROM driver').map((d) => [d.id, d.name]),
)
const teamNamen = new Map(alle('SELECT id, name FROM constructor').map((t) => [t.id, t.name]))
const streckenNamen = new Map(alle('SELECT id, name FROM circuit').map((z) => [z.id, z.name]))

/*
 * Teams mit ihren Jahren. Nach Team gebündelt, nicht nach Abschnitt: Fangio
 * fuhr 1953 und noch einmal 1957/58 für Maserati – zweimal „Maserati" ohne
 * Jahreszahl sähe nach einem Fehler aus.
 */
const proTeam = new Map()
for (const r of rennen) {
  const e = proTeam.get(r.constructorId) ?? { id: r.constructorId, jahre: new Set() }
  e.jahre.add(r.year)
  proTeam.set(r.constructorId, e)
}
/** Zusammenhängende Jahre zu Spannen zusammenfassen: 1953, 1957–1958. */
const spannen = (jahre) => {
  const s = [...jahre].sort((a, b) => a - b)
  const teile = []
  let von = s[0]
  let bis = s[0]
  for (const j of s.slice(1)) {
    if (j === bis + 1) bis = j
    else {
      teile.push(von === bis ? String(von) : `${von}–${bis}`)
      von = bis = j
    }
  }
  teile.push(von === bis ? String(von) : `${von}–${bis}`)
  return teile.join(', ')
}
const teams = [...proTeam.values()].sort((a, b) => Math.min(...a.jahre) - Math.min(...b.jahre))

const nf = new Intl.NumberFormat('de-DE')
const ein = (n) => (n === null || n === undefined ? '–' : nf.format(Math.round(n * 10) / 10))
const proz = (m) => (m.value === null ? '–' : `${Math.round(m.value * 100)} %`)
/** Zeigt den Wert, oder den Grund, warum es keinen gibt. */
const wert = (m, f = (v) => nf.format(v)) => (m.value === null ? '–' : f(m.value))

const zeitraum =
  rennen.length === 0
    ? '–'
    : rennen[0].year === rennen.at(-1).year
      ? String(rennen[0].year)
      : `${rennen[0].year}–${rennen.at(-1).year}`

const jahre = (d) => {
  if (!d) return ''
  const j = new Date(d)
  return `${j.getDate()}.${j.getMonth() + 1}.${j.getFullYear()}`
}

const beschreibung =
  `${fahrer.full_name}: ${calculateStarts(rennen).value} Starts, ` +
  `${calculateWins(rennen).value} Siege, ${calculatePodiums(rennen).value} Podien, ` +
  `${titel.titles.value} Weltmeisterschaften (${zeitraum}).`
---

<Seite titel={`${fahrer.full_name} – Statistik und Karriere`} beschreibung={beschreibung}>
  <header class="profil">
    <span class="kuerzel gross" title={heimat.name}>{heimat.code}</span>
    <div>
      <h1>{fahrer.full_name}</h1>
      <p class="lead">
        {[
          heimat.name,
          fahrer.date_of_birth && `geboren ${jahre(fahrer.date_of_birth)}`,
          fahrer.date_of_death && `gestorben ${jahre(fahrer.date_of_death)}`,
          zeitraum,
          fahrer.abbreviation,
        ]
          .filter(Boolean)
          .join(' · ')}
      </p>
    </div>
  </header>

  <ul class="kacheln">
    <li><b>{wert(calculateStarts(rennen))}</b><span>Starts</span>
      {calculateEntries(rennen).value !== calculateStarts(rennen).value && (
        <i>{calculateEntries(rennen).value} Nennungen</i>
      )}
    </li>
    <li><b>{wert(calculateWins(rennen))}</b><span>Siege</span><i>{proz(calculateWinRate(rennen))} der Starts</i></li>
    <li><b>{wert(calculatePodiums(rennen))}</b><span>Podien</span><i>{proz(calculatePodiumRate(rennen))}</i></li>
    <li><b>{wert(calculatePoles(rennen))}</b><span>Pole-Positions</span>
      <i>{wert(calculateStartsFromPole(rennen))}× von Platz 1 gestartet</i></li>
    <li><b>{wert(calculateFastestLaps(rennen))}</b><span>Schnellste Runden</span></li>
    <li><b>{wert(titel.titles)}</b><span>Weltmeisterschaften</span>
      <i>bester Platz {wert(titel.best, (v) => 'P' + v)}</i></li>
  </ul>

  <section>
    <h2>Zahlen zur Karriere</h2>
    <ul class="daten">
      <li><span>Ø Startplatz</span><b>{ein(calculateAverageStart(rennen).value)}</b></li>
      <li><span>Ø Zielposition</span><b>{ein(calculateAverageFinish(rennen).value)}</b></li>
      <li><span>Ausfallquote</span><b>{proz(calculateDNFRate(rennen))}</b></li>
      <li><span>Pole zu Sieg</span><b>{proz(calculatePoleToWinRate(rennen))}</b></li>
      <li><span>Plätze gutgemacht</span><b>{wert(calculatePositionsGained(rennen), (v) => (v > 0 ? '+' : '') + nf.format(v))}</b></li>
      <li><span>Punkte in Rennen</span><b>{ein(calculatePoints(rennen).value)}</b></li>
      <li><span>Längste Siegesserie</span><b>{serien.wins.length || '–'}</b></li>
      <li><span>Längste Podiumsserie</span><b>{serien.podiums.length || '–'}</b></li>
      <li><span>Längste Punkteserie</span><b>{serien.points.length || '–'}</b></li>
      <li><span>Teams</span><b>{teams.map((t) => `${teamNamen.get(t.id)} (${spannen(t.jahre)})`).join(', ')}</b></li>
    </ul>
    <p class="fussnote">
      Pole-Position heißt: schnellste Zeit im Qualifying. Das ist nicht dasselbe wie ein Start
      von Platz 1 – Strafversetzungen verschieben den Startplatz. Bis in die 2000er fallen
      beide Zahlen zusammen.
    </p>
  </section>

  {titel.seasons.length > 0 && (
    <section>
      <h2>Saison für Saison</h2>
      <div class="tabelle">
        <table>
          <thead>
            <tr>
              <th>Saison</th><th>Team</th>
              <th class="num">Rennen</th><th class="num">Siege</th><th class="num">Podien</th>
              <th class="num">WM-Platz</th><th class="num">WM-Punkte</th>
            </tr>
          </thead>
          <tbody>
            {titel.seasons.map((s) => {
              const jahrRennen = rennen.filter((r) => r.year === s.year)
              return (
                <tr>
                  <td><a class="zeile" href={pfad.saison(s.year)}>{s.year}</a></td>
                  <td style="color:var(--muted)">
                    {[...new Set(jahrRennen.map((r) => teamNamen.get(r.constructorId)))].join(', ')}
                  </td>
                  <td class="num">{jahrRennen.filter((r) => r.started).length}</td>
                  <td class="num">{jahrRennen.filter((r) => r.position === 1).length || ''}</td>
                  <td class="num">{jahrRennen.filter((r) => r.classified && r.position <= 3).length || ''}</td>
                  <td class={`num${s.won ? ' meister' : ''}`}>{s.position ? 'P' + s.position : '–'}</td>
                  <td class="num">{ein(s.points)}</td>
                </tr>
              )
            })}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {duelle.length > 0 && (
    <section>
      <h2>Gegen die Teamkollegen</h2>
      <p class="lead">
        Gleiches Auto, gleiche Rennen. Gezählt wird im Rennen nur, wo beide ins Ziel kamen –
        ein Ausfall sagt nichts über den Zweikampf.
      </p>
      <div class="tabelle">
        <table>
          <thead>
            <tr>
              <th>Teamkollege</th><th>Jahre</th>
              <th class="num">Rennen</th><th class="num">Qualifying</th><th class="num">Punkte</th>
            </tr>
          </thead>
          <tbody>
            {duelle.map((d) => (
              <tr>
                <td><a class="zeile" href={pfad.fahrer(d.driverId)}>{namen.get(d.driverId)}</a></td>
                <td style="color:var(--muted)">
                  {d.years.length === 1 ? d.years[0] : `${d.years[0]}–${d.years.at(-1)}`}
                </td>
                <td class="num">{d.raceWins}:{d.raceDuels - d.raceWins}</td>
                <td class="num">{d.qualiWins}:{d.qualiDuels - d.qualiWins}</td>
                <td class="num">{ein(d.pointsSelf)} : {ein(d.pointsOther)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {strecken.length > 0 && (
    <section>
      <h2>Stärkste Strecken</h2>
      <div class="tabelle">
        <table>
          <thead>
            <tr>
              <th>Strecke</th><th class="num">Starts</th><th class="num">Siege</th>
              <th class="num">Podien</th><th class="num">Ø Ziel</th>
            </tr>
          </thead>
          <tbody>
            {strecken.map((s) => (
              <tr>
                <td><a class="zeile" href={pfad.strecke(s.circuitId)}>{streckenNamen.get(s.circuitId)}</a></td>
                <td class="num">{s.starts}</td>
                <td class="num">{s.wins.value || ''}</td>
                <td class="num">{s.podiums.value || ''}</td>
                <td class="num">{ein(s.averageFinish.value)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}
</Seite>

<style>
  .profil {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .kuerzel.gross {
    flex: none;
    min-width: 3.6rem;
    padding: 0.5rem 0.35rem;
    margin: 0;
    font-size: 0.86rem;
    color: var(--accent);
    background: var(--accent-wash);
  }

  .kacheln {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(9rem, 100%), 1fr));
    gap: 0.75rem;
    margin: 0 0 2.5rem;
    padding: 0;
    list-style: none;
  }

  .kacheln li {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.9rem 1rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 0.6rem;
  }

  .kacheln b {
    font-size: 1.6rem;
    font-weight: 680;
    line-height: 1.1;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  .kacheln span {
    font-size: 0.78rem;
    color: var(--muted);
  }

  .kacheln i {
    font-style: normal;
    font-size: 0.72rem;
    color: var(--muted);
    opacity: 0.8;
  }

  section {
    margin-top: 2.5rem;
  }

  h2 {
    font-size: 1.15rem;
    margin: 0 0 0.75rem;
  }

  .daten {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
    gap: 0 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .daten li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.88rem;
  }

  .daten span {
    color: var(--muted);
  }

  .daten b {
    color: var(--ink);
    font-weight: 600;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .fussnote {
    margin: 0.85rem 0 0;
    font-size: 0.79rem;
    color: var(--muted);
    max-width: 44rem;
    text-wrap: pretty;
  }

  td.meister {
    color: var(--accent);
    font-weight: 700;
  }
</style>
