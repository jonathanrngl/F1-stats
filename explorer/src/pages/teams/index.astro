---
import Seite from '../../layouts/Seite.astro'
import Filter from '../../components/Filter.astro'
import Sortierung from '../../components/Sortierung.astro'
import { teamListe, pfad } from '../../lib/db.js'

const teams = teamListe().sort((a, b) => (b.siege ?? 0) - (a.siege ?? 0) || (b.starts ?? 0) - (a.starts ?? 0))
const neuestesJahr = Math.max(...teams.map((t) => t.bis ?? 0))
---

<Seite titel="All Formula 1 teams" beschreibung={`${teams.length} constructors since 1950.`}>
  <header class="seitenkopf">
    <div>
      <p class="oberzeile">Teams</p>
      <h1>Every constructor since 1950</h1>
      <p class="lead">
        {teams.length} constructors. Name changes and predecessor teams are set out on each
        team's own page.
      </p>
    </div>
  </header>

  <Filter
    platzhalter="Filter by team, country or period"
    einheit={['team', 'teams']}
    pillen={[
      { label: 'Race winners', spalte: 3, art: 'gefuellt' },
      { label: 'Constructors’ champions', spalte: 5, art: 'gefuellt' },
      { label: `Active in ${neuestesJahr}`, spalte: 1, art: 'bis', wert: neuestesJahr },
    ]}
  />

  <div class="tabelle lang">
    <table>
      <thead>
        <tr>
          <th><button type="button" data-spalte="0" data-art="name">Team</button></th>
          <th><button type="button" data-spalte="1" data-art="jahr">Period</button></th>
          <th class="num"><button type="button" data-spalte="2" data-art="zahl">Starts</button></th>
          <th class="num"><button type="button" data-spalte="3" data-art="zahl" data-aktiv="1">Wins</button></th>
          <th class="num"><button type="button" data-spalte="4" data-art="zahl">One-twos</button></th>
          <th class="num"><button type="button" data-spalte="5" data-art="zahl">Titles</button></th>
        </tr>
      </thead>
      <tbody>
        {teams.map((t) => (
          <tr data-name={t.name}>
            <td>
              <span class="kuerzel" title={t.landName ?? ''}>{t.land ?? '—'}</span>
              <a class="zeile" href={pfad.team(t.id)}>{t.name}</a>
            </td>
            <td class="leise">{t.von === t.bis ? t.von : `${t.von}–${t.bis}`}</td>
            <td class="num">{t.starts ?? 0}</td>
            <td class="num">{t.siege || ''}</td>
            <td class="num">{t.doppelsiege || ''}</td>
            <td class="num meister">{t.titel || ''}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <Sortierung vorsortiert={3} gleichstand={2} />
</Seite>
