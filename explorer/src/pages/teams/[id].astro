---
import Seite from '../../layouts/Seite.astro'
import { eine, teamListe, pfad, db } from '../../lib/db.js'
import { land } from '../../lib/laender.js'
import {
  calculateLineage, calculateOneTwos, calculateTeamAverageFinish, calculateTeamAverageStart,
  calculateTeamChampionships, calculateTeamDrivers, calculateTeamFastestLaps, calculateTeamPodiums,
  calculateTeamPoints, calculateTeamPoles, calculateTeamReliability, calculateTeamStarts,
  calculateTeamWins, constructorRaces,
} from '../../engine/constructor.js'

export async function getStaticPaths() {
  return teamListe().map((t) => ({ params: { id: t.id } }))
}

const { id } = Astro.params
const team = eine(
  `SELECT k.*, c.ioc AS ioc, c.name AS landName, c.demonym AS demonym
     FROM constructor k LEFT JOIN country c ON c.id = k.nationality_id WHERE k.id = ?`,
  id,
)
const heimat = land(team.demonym, team.landName, team.ioc)
const rennen = constructorRaces(db(), id)
const titel = calculateTeamChampionships(db(), id)
const fahrer = calculateTeamDrivers(db(), id)
const abstammung = calculateLineage(db(), id)

const nf = new Intl.NumberFormat('de-DE')
const ein = (n) => (n === null || n === undefined ? '–' : nf.format(Math.round(n * 10) / 10))
const proz = (m) => (m.value === null ? '–' : `${Math.round(m.value * 100)} %`)
const wert = (m) => (m.value === null ? '–' : nf.format(m.value))
const zeitraum =
  rennen.length === 0
    ? '–'
    : rennen[0].year === rennen.at(-1).year
      ? String(rennen[0].year)
      : `${rennen[0].year}–${rennen.at(-1).year}`
---

<Seite
  titel={`${team.name} – Statistik und Geschichte`}
  beschreibung={`${team.name}: ${calculateTeamStarts(rennen).value} Rennen, ${calculateTeamWins(rennen).value} Siege, ${titel.titles.value} Konstrukteurstitel (${zeitraum}).`}
>
  <header class="profil">
    <span class="kuerzel gross" title={heimat.name}>{heimat.code}</span>
    <div>
      <h1>{team.name}</h1>
      <p class="lead">
        {[team.full_name !== team.name ? team.full_name : null, heimat.name, zeitraum]
          .filter(Boolean)
          .join(' · ')}
      </p>
    </div>
  </header>

  <ul class="kacheln">
    <li><b>{wert(calculateTeamStarts(rennen))}</b><span>Rennen</span></li>
    <li><b>{wert(calculateTeamWins(rennen))}</b><span>Siege</span></li>
    <li><b>{wert(calculateOneTwos(rennen))}</b><span>Doppelsiege</span><i>beide Autos vorn</i></li>
    <li><b>{wert(calculateTeamPodiums(rennen))}</b><span>Podestrennen</span></li>
    <li><b>{wert(calculateTeamPoles(rennen))}</b><span>Pole-Positions</span></li>
    <li>
      <b>{wert(titel.titles)}</b><span>Konstrukteurstitel</span>
      <i>bester Platz {titel.best.value ? 'P' + titel.best.value : '–'}</i>
    </li>
  </ul>

  {abstammung.length > 1 && (
    <section>
      <h2>Rennstall im Wandel</h2>
      <p class="lead">
        Derselbe Rennstall unter wechselndem Namen. F1DB führt diese Abstammung mit – ohne sie
        wäre jede Team-Historie an jedem Verkauf zu Ende.
      </p>
      <ol class="kette">
        {abstammung.map((a) => (
          <li class={a.id === id ? 'hier' : ''}>
            <a href={pfad.team(a.id)}>{a.name}</a>
            <span>{a.von}{a.bis ? `–${a.bis}` : '–heute'}</span>
          </li>
        ))}
      </ol>
    </section>
  )}

  <section>
    <h2>Zahlen</h2>
    <ul class="daten">
      <li><span>Ø Startplatz</span><b>{ein(calculateTeamAverageStart(rennen).value)}</b></li>
      <li><span>Ø Zielposition</span><b>{ein(calculateTeamAverageFinish(rennen).value)}</b></li>
      <li><span>Autos ins Ziel</span><b>{proz(calculateTeamReliability(rennen))}</b></li>
      <li><span>Schnellste Runden</span><b>{wert(calculateTeamFastestLaps(rennen))}</b></li>
      <li><span>Punkte in Rennen</span><b>{ein(calculateTeamPoints(rennen).value)}</b></li>
      <li><span>Eingesetzte Fahrer</span><b>{fahrer.length}</b></li>
    </ul>
    <p class="fussnote">
      „Rennen“ zählt Wochenenden, nicht Autos – sonst hätte jedes Zweiwagenteam doppelt so viele
      Starts wie Rennen. „Autos ins Ziel“ zählt dagegen Autos: Jedes ist ein eigener Versuch der
      Technik.
    </p>
  </section>

  {titel.seasons.length > 0 && (
    <section>
      <h2>Saison für Saison</h2>
      <div class="tabelle">
        <table>
          <thead>
            <tr>
              <th>Saison</th><th class="num">WM-Platz</th><th class="num">Punkte</th>
              <th class="num">Siege</th><th>Fahrer</th>
            </tr>
          </thead>
          <tbody>
            {titel.seasons.map((s) => {
              const jahr = rennen.filter((r) => r.year === s.year)
              const namen = [...new Set(jahr.flatMap((r) => r.autos.map((a) => a.driverId)))]
              return (
                <tr>
                  <td><a class="zeile" href={pfad.saison(s.year)}>{s.year}</a></td>
                  <td class={`num${s.won ? ' meister' : ''}`}>{s.position ? 'P' + s.position : '–'}</td>
                  <td class="num">{ein(s.points)}</td>
                  <td class="num">{jahr.filter((r) => r.autos.some((a) => a.position === 1)).length || ''}</td>
                  <td style="color:var(--muted)">
                    {namen.map((n) => fahrer.find((f) => f.driverId === n)?.name).filter(Boolean).join(', ')}
                  </td>
                </tr>
              )
            })}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <section>
    <h2>Fahrer</h2>
    <div class="tabelle">
      <table>
        <thead>
          <tr>
            <th>Fahrer</th><th>Jahre</th><th class="num">Starts</th>
            <th class="num">Siege</th><th class="num">Punkte</th>
          </tr>
        </thead>
        <tbody>
          {fahrer.map((f) => (
            <tr>
              <td><a class="zeile" href={pfad.fahrer(f.driverId)}>{f.name}</a></td>
              <td style="color:var(--muted)">{f.von === f.bis ? f.von : `${f.von}–${f.bis}`}</td>
              <td class="num">{f.starts}</td>
              <td class="num">{f.siege || ''}</td>
              <td class="num">{ein(f.punkte)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Seite>

<style>
  .profil { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; }
  .kuerzel.gross {
    flex: none; min-width: 3.6rem; padding: 0.5rem 0.35rem; margin: 0;
    font-size: 0.86rem; color: var(--accent); background: var(--accent-wash);
  }
  .kacheln {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(9rem, 100%), 1fr));
    gap: 0.75rem; margin: 0 0 2.5rem; padding: 0; list-style: none;
  }
  .kacheln li {
    display: flex; flex-direction: column; gap: 0.1rem; padding: 0.9rem 1rem;
    background: var(--surface-2); border: 1px solid var(--border); border-radius: 0.6rem;
  }
  .kacheln b {
    font-size: 1.6rem; font-weight: 680; line-height: 1.1; color: var(--ink);
    font-variant-numeric: tabular-nums; letter-spacing: -0.02em;
  }
  .kacheln span { font-size: 0.78rem; color: var(--muted); }
  .kacheln i { font-style: normal; font-size: 0.72rem; color: var(--muted); opacity: 0.8; }
  section { margin-top: 2.5rem; }
  h2 { font-size: 1.15rem; margin: 0 0 0.75rem; }
  .daten {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
    gap: 0 1.5rem; margin: 0; padding: 0; list-style: none;
  }
  .daten li {
    display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;
    padding: 0.45rem 0; border-bottom: 1px solid var(--border); font-size: 0.88rem;
  }
  .daten span { color: var(--muted); }
  .daten b { color: var(--ink); font-weight: 600; text-align: right; font-variant-numeric: tabular-nums; }
  .fussnote { margin: 0.85rem 0 0; font-size: 0.79rem; color: var(--muted); max-width: 44rem; text-wrap: pretty; }
  td.meister { color: var(--accent); font-weight: 700; }
  .kette { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0.75rem 0 0; padding: 0; list-style: none; }
  .kette li {
    display: grid; padding: 0.5rem 0.8rem; background: var(--surface-2);
    border: 1px solid var(--border); border-radius: 0.5rem;
  }
  .kette li.hier { border-color: var(--accent); background: var(--accent-wash); }
  .kette a { color: var(--ink); font-weight: 600; text-decoration: none; font-size: 0.9rem; }
  .kette li.hier a { color: var(--accent); }
  .kette span { font-size: 0.75rem; color: var(--muted); font-variant-numeric: tabular-nums; }
</style>
