---
import { ein, plakette, prozent as proz, zahl } from '../../lib/format.js'
import Seite from '../../layouts/Seite.astro'
import Sprung from '../../components/Sprung.astro'
import Folgen from '../../components/Folgen.astro'
import Epochenband from '../../components/Epochenband.astro'
import { zeitraumImBand } from '../../components/epochen.js'
import { teamrekordwerte } from '../../components/teamrekordwerte.js'
import { alle, eine, teamListe, pfad, db } from '../../lib/db.js'
import { land } from '../../lib/laender.js'
import {
  calculateLineage, calculateOneTwos, calculateTeamAverageFinish, calculateTeamAverageStart,
  calculateTeamChampionships, calculateTeamDrivers, calculateTeamFastestLaps, calculateTeamPodiums,
  calculateTeamPoints, calculateTeamPoles, calculateTeamReliability, calculateTeamStarts,
  calculateTeamWins, constructorRaces,
} from '../../engine/constructor.js'

export async function getStaticPaths() {
  return teamListe().map((t) => ({ params: { id: t.id } }))
}

const { id } = Astro.params
const team = eine(
  `SELECT k.*, c.ioc AS ioc, c.name AS landName, c.demonym AS demonym
     FROM constructor k LEFT JOIN country c ON c.id = k.nationality_id WHERE k.id = ?`,
  id,
)
const heimat = land(team.demonym, team.landName, team.ioc)
const rennen = constructorRaces(db(), id)
const titel = calculateTeamChampionships(db(), id)
const fahrer = calculateTeamDrivers(db(), id)
const abstammung = calculateLineage(db(), id)

/*
 * Die ganze Linie in Zahlen. Toro Rosso, AlphaTauri, RB und Racing Bulls sind
 * ein Rennstall unter vier Namen; jede Seite zählte bisher nur ihren eigenen
 * Abschnitt, und die Summe stand nirgends.
 */
const linienIds = abstammung.map((a) => a.id)
const linie = linienIds.length > 1
  ? eine(
      `SELECT COUNT(DISTINCT rr.race_id) AS rennen,
              COUNT(DISTINCT CASE WHEN rr.position = 1 THEN rr.race_id END) AS siege,
              COUNT(DISTINCT CASE WHEN rr.qualifying_position = 1 THEN rr.race_id END) AS poles,
              (SELECT COUNT(*) FROM season_constructor_standing s
                WHERE s.championship_won = 1 AND s.constructor_id IN (${linienIds.map(() => '?').join(', ')})) AS titel
         FROM race_result rr WHERE rr.constructor_id IN (${linienIds.map(() => '?').join(', ')})`,
      ...linienIds, ...linienIds,
    )
  : null

/* Motor und Chassis je Saison – womit das Team fuhr, nicht nur wer. */
const technik = new Map()
for (const z of alle(
  `SELECT r.year AS jahr, m.id AS motorId, m.name AS motor
     FROM race_result rr JOIN race r ON r.id = rr.race_id JOIN engine_manufacturer m ON m.id = rr.engine_id
    WHERE rr.constructor_id = ? GROUP BY r.year, m.id ORDER BY r.year`,
  id,
)) {
  const e = technik.get(z.jahr) ?? { motoren: [], chassis: [] }
  e.motoren.push({ id: z.motorId, name: z.motor })
  technik.set(z.jahr, e)
}
for (const z of alle(
  `SELECT sc.year AS jahr, GROUP_CONCAT(DISTINCT c.name) AS chassis
     FROM season_entrant_chassis sc JOIN chassis c ON c.id = sc.chassis_id
    WHERE sc.constructor_id = ? GROUP BY sc.year`,
  id,
)) {
  const e = technik.get(z.jahr) ?? { motoren: [], chassis: [] }
  e.chassis = z.chassis.split(',')
  technik.set(z.jahr, e)
}

const SEITE = 'https://jonathanrngl.github.io'
const sportteam = {
  '@context': 'https://schema.org',
  '@type': 'SportsTeam',
  name: team.name,
  sport: 'Formula One',
  ...(team.full_name && team.full_name !== team.name ? { alternateName: team.full_name } : {}),
  url: `${SEITE}${pfad.team(id)}`,
}

const wert = (m) => (m.value === null ? '–' : zahl(m.value))
const zeitraum =
  rennen.length === 0
    ? '–'
    : rennen[0].year === rennen.at(-1).year
      ? String(rennen[0].year)
      : `${rennen[0].year}–${rennen.at(-1).year}`

const titelZahl = titel.titles.value ?? 0

/*
 * Die Saisons kommen aus den Rennen, die Wertung wird dazugesucht: In ihr
 * steht nur, wer Punkte holte – Minardi fehlten so sieben Jahre. Vor 1958 gab
 * es keine Konstrukteurswertung, dort bleiben Platz und Punkte leer statt null.
 */
const ERSTE_WERTUNG = 1958
const wmProJahr = new Map(titel.seasons.map((s) => [s.year, s]))
const saisons = [...new Set(rennen.map((r) => r.year))].map(
  (year) =>
    wmProJahr.get(year) ?? { year, position: null, points: year >= ERSTE_WERTUNG ? 0 : null, won: 0 },
)

/*
 * Das Epochenband: Saisons mit mindestens einem Start, Titeljahre aus der
 * Konstrukteurswertung (docs/DESIGN.md 8.3).
 */
const startJahre = [...new Set(rennen.filter((r) => r.autos.some((a) => a.started)).map((r) => r.year))]
const titelJahre = titel.seasons.filter((s) => s.won).map((s) => s.year)

/*
 * Den Zeitraum zeigt das Epochenband. In Worten steht er nur, wenn das Band
 * erstes oder letztes Jahr nicht beschriftet – es lässt eine Zahl weg, die
 * näher als acht Saisons an einer anderen steht (components/epochen.js).
 */
const bandNenntZeitraum = zeitraumImBand(startJahre)

/*
 * Der Kopfsatz: was keine Zahl sagt, in ganzen Sätzen statt einer Zeile
 * Eckdaten mit Trennlinien (docs/DESIGN.md 8.2). Titel – ohne Titel der beste
 * Platz in der Wertung –, Herkunft, voller Name.
 */
const vollerName = team.full_name && team.full_name !== team.name ? team.full_name : null
const herkunft = team.demonym ? `${/^[AEIOU]/.test(team.demonym) ? 'An' : 'A'} ${team.demonym} team` : null
const kopfsatz = [
  titelZahl > 1 && `${zahl(titelZahl)} constructors' titles, the last in ${titelJahre.at(-1)}.`,
  titelZahl === 1 && `One constructors' title, in ${titelJahre[0]}.`,
  titelZahl === 0 && titel.best.value && `Best finish in the constructors' championship: P${titel.best.value}.`,
  !bandNenntZeitraum && rennen.length > 0 &&
    (rennen[0].year === rennen.at(-1).year
      ? `Raced only in ${rennen[0].year}.`
      : `First race in ${rennen[0].year}, last in ${rennen.at(-1).year}.`),
  herkunft && `${herkunft}${vollerName ? `, full name ${vollerName}` : ''}.`,
  !herkunft && vollerName && `Full name ${vollerName}.`,
]
  .filter(Boolean)
  .join(' ')

/*
 * Die Kennzahlen der Kopfleiste. Die tragende zuerst: Titel, wenn es welche
 * gibt; sonst Siege; sonst Rennen (docs/DESIGN.md 8.6). Ohne Titel entfällt
 * die Titelzahl – der beste Platz steht dann im Kopfsatz.
 *
 * Lila heißt „absolute Bestmarke“: Titel, Siege und Pole-Positionen, die den
 * Allzeitrekord eines Teams halten oder einstellen. Für die übrigen Zählungen
 * gibt es keine Bestenliste in der Engine, also kein Lila.
 */
const REKORD = teamrekordwerte()
const istRekord = (art, m) => m.value !== null && m.value > 0 && REKORD[art] != null && m.value >= REKORD[art]
const siege = calculateTeamWins(rennen)
const kennzahlListe = [
  { art: 'rennen', label: 'Races', m: calculateTeamStarts(rennen) },
  { art: 'siege', label: 'Wins', m: siege },
  { label: 'One-twos', m: calculateOneTwos(rennen), dazu: 'both cars at the front' },
  { label: 'Races with a podium', m: calculateTeamPodiums(rennen), dazu: 'at least one car in the top three' },
  { art: 'poles', label: 'Pole positions', m: calculateTeamPoles(rennen) },
  titelZahl > 0 && {
    art: 'titel',
    label: "Constructors' titles",
    m: titel.titles,
    dazu: rennen[0]?.year < ERSTE_WERTUNG ? `awarded since ${ERSTE_WERTUNG}` : null,
  },
].filter(Boolean)
const traegt = titelZahl > 0 ? 'titel' : (siege.value ?? 0) > 0 ? 'siege' : 'rennen'
const kennzahlen = [
  ...kennzahlListe.filter((k) => k.art === traegt),
  ...kennzahlListe.filter((k) => k.art !== traegt),
].map((k) => ({
  label: k.label,
  wert: wert(k.m),
  dazu: k.dazu ?? null,
  traegt: k.art === traegt,
  rekord: k.art !== undefined && k.art in REKORD && istRekord(k.art, k.m),
}))

const ziele = [
  { id: 'zahlen', label: 'Numbers' },
  abstammung.length > 1 && { id: 'linie', label: 'Name changes' },
  saisons.length > 0 && { id: 'saisons', label: 'Seasons' },
  { id: 'fahrer', label: 'Drivers' },
].filter(Boolean)
---

<Seite
  titel={`${team.name}: statistics and history`}
  beschreibung={`${team.name}: ${zahl(calculateTeamStarts(rennen).value)} races, ${zahl(calculateTeamWins(rennen).value)} wins, ${titel.titles.value} constructors' titles (${zeitraum}).`}
  strukturiert={[sportteam]}
  brotkrumen={[{ name: 'Teams', pfad: '/teams/' }]}
  lackierung={id}
>
  {/*
    * Der Kopf: Brotkrume, der Name auf dem Streifen seiner Lackierung, ein
    * Satz mit dem, was keine Zahl sagt, das Epochenband, die Kennzahlen.
    * Hat teams.css keine Farbe für das Team, bleibt der Streifen Tinte.
    */}
  <header class="seitenkopf" data-team={id}>
    <span class="wappen" title={heimat.name}>{heimat.code}</span>
    <div>
      <p class="oberzeile">
        <a href={pfad.seite('/teams/')}>Teams</a>
      </p>
      <div class="titelblock">
        <h1>{team.name}</h1>
        {kopfsatz && <p class="kopfsatz">{kopfsatz}</p>}
      </div>
      <Epochenband jahre={startJahre} titel={titelJahre} wort="Seasons" />
    </div>
  </header>

  <ul class="kacheln">
    {kennzahlen.map((k) => (
      <li class={k.traegt ? 'stark' : undefined}>
        <span>{k.label}</span>
        <b class={k.rekord ? 'rekord' : undefined}>{k.wert}</b>
        {(k.dazu || k.rekord) && <i>{[k.rekord && 'All-time record', k.dazu].filter(Boolean).join(', ')}</i>}
      </li>
    ))}
  </ul>

  <p class="aktionen nur-mit-js">
    <Folgen art="t" id={id} name={team.name} />
  </p>

  <Sprung ziele={ziele} />

  <section class="abschnitt" id="zahlen">
    <div class="abschnitt-kopf"><div><h2>Numbers</h2></div></div>
    <ul class="daten">
      <li><span>Avg grid position</span><b>{ein(calculateTeamAverageStart(rennen).value)}</b></li>
      <li><span>Avg finish</span><b>{ein(calculateTeamAverageFinish(rennen).value)}</b></li>
      <li><span>Cars finishing</span><b>{proz(calculateTeamReliability(rennen))}</b></li>
      <li><span>Fastest laps</span><b>{wert(calculateTeamFastestLaps(rennen))}</b></li>
      <li><span>Points scored in races</span><b>{ein(calculateTeamPoints(rennen).value)}</b></li>
      <li><span>Drivers fielded</span><b>{fahrer.length}</b></li>
    </ul>
    <p class="fussnote">
      “Races” counts weekends, not cars; otherwise every two-car team would have twice as many
      starts as races. “Cars finishing”, by contrast, counts cars: each one is a separate test of
      the engineering.
    </p>
  </section>

  {abstammung.length > 1 && (
    <section class="abschnitt" id="linie">
      <div class="abschnitt-kopf">
        <div>
          <h2>The team through its name changes</h2>
          <p>The same team under a succession of names.</p>
        </div>
      </div>
      {linie && (
        <p class="linie-summe">
          Across the whole line: <b>{zahl(linie.rennen)}</b> races, <b>{zahl(linie.siege)}</b>
          {' '}{linie.siege === 1 ? 'win' : 'wins'}, <b>{zahl(linie.poles)}</b>
          {' '}{linie.poles === 1 ? 'pole position' : 'pole positions'} and <b>{linie.titel}</b>
          {' '}constructors' {linie.titel === 1 ? 'title' : 'titles'}.
        </p>
      )}
      <ol class="kette">
        {abstammung.map((a) => (
          <li class={a.id === id ? 'hier' : ''}>
            <a href={pfad.team(a.id)}>{a.name}</a>
            <span>{a.von}{a.bis ? `–${a.bis}` : '–present'}</span>
          </li>
        ))}
      </ol>
    </section>
  )}

  {saisons.length > 0 && (
    <section class="abschnitt" id="saisons">
      <div class="abschnitt-kopf">
        <div>
          <h2>Season by season</h2>
          {saisons[0].year < ERSTE_WERTUNG && (
            <p>The constructors' championship began in {ERSTE_WERTUNG}; earlier seasons have no position.</p>
          )}
        </div>
      </div>
      <div class="tabelle">
        <table>
          <thead>
            <tr>
              <th scope="col">Season</th><th class="num" scope="col">Championship</th><th class="num" scope="col">Points</th>
              <th class="num" scope="col">Wins</th><th scope="col">Car and engine</th><th scope="col">Drivers</th>
            </tr>
          </thead>
          <tbody>
            {saisons.map((s) => {
              const jahr = rennen.filter((r) => r.year === s.year)
              const namen = [...new Set(jahr.flatMap((r) => r.autos.map((a) => a.driverId)))]
              return (
                <tr class={s.won ? 'meister' : undefined}>
                  <th scope="row"><a class="zeile" href={pfad.saison(s.year)}>{s.year}</a></th>
                  <td class="num">{s.position ? <span class={plakette(s.position)}>P{s.position}</span> : '–'}</td>
                  <td class="num">{ein(s.points)}</td>
                  <td class="num">{jahr.filter((r) => r.autos.some((a) => a.position === 1)).length || ''}</td>
                  {/* Chassis, darunter leise der Motor – zwei Angaben, zwei Zeilen. */}
                  <td class="leise">
                    {technik.get(s.year)?.chassis.join(', ')}
                    {technik.get(s.year)?.motoren.length > 0 && (
                      <span class="neben">
                        {technik.get(s.year).motoren.map((m, i) => (
                          <>{i > 0 && ', '}<a href={pfad.seite(`/engines/${m.id}/`)}>{m.name}</a></>
                        ))}
                      </span>
                    )}
                  </td>
                  <td class="leise">
                    {namen.map((n, i) => (
                      <>{i > 0 && ', '}<a class="leise" href={pfad.fahrer(n)}>{fahrer.find((f) => f.driverId === n)?.name ?? n}</a></>
                    ))}
                  </td>
                </tr>
              )
            })}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <section class="abschnitt" id="fahrer">
    <div class="abschnitt-kopf"><div><h2>Drivers</h2></div></div>
    <div class={`tabelle${fahrer.length > 25 ? ' lang' : ''}`}>
      <table>
        <thead>
          <tr>
            <th>Driver</th><th>Years</th><th class="num">Starts</th>
            <th class="num">Wins</th><th class="num">Points</th>
          </tr>
        </thead>
        <tbody>
          {fahrer.map((f) => (
            <tr>
              <th scope="row"><a class="zeile" href={pfad.fahrer(f.driverId)}>{f.name}</a></th>
              <td class="leise">{f.von === f.bis ? f.von : `${f.von}–${f.bis}`}</td>
              <td class="num">{f.starts}</td>
              <td class="num">{f.siege || ''}</td>
              <td class="num">{ein(f.punkte)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Seite>

<style>
  .aktionen { display: flex; flex-wrap: wrap; gap: var(--abstand-2); margin: 0 0 var(--abstand-6); }

  .linie-summe { max-width: var(--mass); margin: 0 0 var(--abstand-4); color: var(--ink-2); }
  .linie-summe b { color: var(--ink); font-variant-numeric: tabular-nums; }

  /*
   * Die Namen des Teams nacheinander, flach auf der Fläche. Der Name dieser
   * Seite ist unterstrichen wie der gelesene Reiter der Sprungleiste.
   */
  .kette { display: flex; flex-wrap: wrap; align-items: stretch; gap: var(--abstand-2); margin: 0; padding: 0; list-style: none; }
  .kette li {
    display: grid;
    padding: var(--abstand-2) var(--abstand-3);
    background: var(--surface);
    border-bottom: 3px solid transparent;
  }
  .kette li.hier { border-bottom-color: var(--lackierung-linie); }
  .kette a { font-size: var(--text-3); font-weight: 650; color: var(--ink); text-decoration: none; }
  .kette a:hover { text-decoration: underline 2px; text-decoration-color: var(--lackierung-linie); }
  .kette li.hier a { font-weight: 750; }
  .kette span { font-size: var(--text-2); font-stretch: var(--schmal); color: var(--muted); font-variant-numeric: tabular-nums; }
</style>
