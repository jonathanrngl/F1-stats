---
/**
 * Die Fehlerseite. GitHub Pages liefert sie unter jeder Adresse aus, die es
 * nicht gibt – vorher stand dort die nackte Meldung von GitHub, ohne
 * Navigation und ohne Weg zurück.
 *
 * Die meisten falschen Adressen sind fast richtig: ein Tippfehler im Namen,
 * ein alter Link auf /drivers/hamilton/. Aus dem Pfad wird deshalb eine
 * Suchanfrage, und die Treffer stehen gleich da. Das geschieht im Browser,
 * denn die Seite ist für alle falschen Adressen dieselbe Datei.
 *
 * Dazu die alten deutschen Adressen: Für die Übersichten gibt es
 * Weiterleitungen (astro.config.mjs), für die rund 2.300 Einzelseiten nicht.
 * Beginnt der Pfad mit einem alten Wort, schickt das Skript zur neuen Adresse
 * weiter – die Kennungen sind gleich geblieben, nur das erste Wort wechselte.
 */
import Seite from '../layouts/Seite.astro'
import { pfad } from '../lib/db.js'

const WEITER = [
  { weg: '/preview/', titel: 'Next race' },
  { weg: '/seasons/', titel: 'Seasons' },
  { weg: '/races/', titel: 'Races' },
  { weg: '/drivers/', titel: 'Drivers' },
  { weg: '/teams/', titel: 'Teams' },
  { weg: '/records/', titel: 'Records' },
]
---

<Seite titel="Page not found" beschreibung="There is no page at this address." ohneIndex>
  <header class="seitenkopf">
    <div>
      <h1>Off the track</h1>
      <p class="lead">
        There is no page at <code data-pfad>this address</code>. It may have moved, or the link
        has a typo in it.
      </p>
      <p class="lead" data-weiterleitung hidden>This address has moved. Taking you to its new place …</p>
    </div>
  </header>

  <section class="abschnitt" data-vorschlaege hidden>
    <div class="abschnitt-kopf"><div><h2>Did you mean</h2></div></div>
    <ul class="vorschlaege" data-liste></ul>
  </section>

  {/* Eine schlichte Liste von Verweisen – sechs gleiche Karten wiederholten nur die Navigation. */}
  <section class="abschnitt">
    <div class="abschnitt-kopf"><div><h2>Or start from here</h2></div></div>
    <ul class="weiter">
      {WEITER.map((w) => (
        <li><a href={pfad.seite(w.weg)}>{w.titel}</a></li>
      ))}
    </ul>
  </section>
</Seite>

<script>
  import { ARTEN, anfrageAusPfad, vorschlaege } from '../lib/suche.js'

  const BASIS = import.meta.env.BASE_URL.replace(/\/$/, '')
  const weg = decodeURIComponent(window.location.pathname)
  const code = document.querySelector('[data-pfad]')
  if (code) code.textContent = weg

  const ohneBasis = weg.slice(BASIS.length)
  const abschnitt = document.querySelector<HTMLElement>('[data-vorschlaege]')
  const liste = document.querySelector<HTMLElement>('[data-liste]')

  const ALT: Record<string, string> = {
    fahrer: 'drivers', rennen: 'races', saisons: 'seasons', strecken: 'circuits', rekorde: 'records',
    aenderungen: 'changes', vergleich: 'comparison', vorschau: 'preview', klassisch: 'classic',
  }
  const alt = /^\/([a-z]+)(\/.*)?$/.exec(window.location.pathname.slice(BASIS.length))
  const umziehen = !!(alt && ALT[alt[1]])
  if (alt && umziehen) {
    document.querySelector<HTMLElement>('[data-weiterleitung]')?.removeAttribute('hidden')
    // replace statt assign: Die tote Adresse soll nicht im Verlauf stehen bleiben.
    window.location.replace(`${BASIS}/${ALT[alt[1]]}${alt[2] ?? '/'}${window.location.search}${window.location.hash}`)
  }

  // Den Index nur holen, wenn im Pfad überhaupt etwas zu raten steht.
  if (!umziehen && anfrageAusPfad(ohneBasis) && abschnitt && liste) {
    fetch(`${BASIS}/data/suche.json`)
      .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
      .then((index) => {
        const gefunden = vorschlaege(index, ohneBasis)
        if (!gefunden.length) return
        liste.replaceChildren(
          ...gefunden.map((e) => {
            /* Ein Verweis je Treffer, die Art leise dahinter: „Lewis Hamilton, Driver“. */
            const li = document.createElement('li')
            const a = Object.assign(document.createElement('a'), {
              href: `${BASIS}/${ARTEN[e.a as keyof typeof ARTEN].pfad}/${e.i}/`,
              textContent: e.n,
            })
            const art = Object.assign(document.createElement('span'), {
              textContent: `, ${ARTEN[e.a as keyof typeof ARTEN].label}`,
            })
            li.append(a, art)
            return li
          }),
        )
        abschnitt.hidden = false
      })
      // Ohne Index bleibt es bei den festen Verweisen darunter – die reichen.
      .catch(() => {})
  }
</script>

<style>
  [data-vorschlaege][hidden] { display: none; }
  .seitenkopf code {
    padding: 0 var(--abstand-1);
    font-size: var(--text-3);
    word-break: break-all;
    background: var(--surface-2);
    border-radius: var(--radius-s);
  }

  /* Zwei schlichte Listen von Verweisen, einer je Zeile. */
  .vorschlaege,
  .weiter {
    display: grid;
    gap: var(--abstand-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-4);
  }

  .weiter a,
  .vorschlaege :global(a) { font-weight: 600; }
  /* :global – die Vorschläge schreibt erst das Skript, ohne Astros Kennung für diese Seite. */
  .vorschlaege :global(span) { color: var(--muted); }
</style>
