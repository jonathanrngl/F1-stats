---
import { km } from '../../lib/format.js'
import Seite from '../../layouts/Seite.astro'
import Filter from '../../components/Filter.astro'
import Sortierung from '../../components/Sortierung.astro'
import { eine, streckenListe, pfad } from '../../lib/db.js'
import Weltkarte from '../../components/Weltkarte.astro'

const strecken = streckenListe()

/*
 * Was heisst "heute benutzt"? Der Kalender wechselt, und eine Strecke faellt
 * auch mal ein Jahr aus. Fuenf Saisons sind lang genug, um Imola und Zandvoort
 * nicht faelschlich fuer verschwunden zu erklaeren, und kurz genug, um
 * Hockenheim nicht als aktuell auszugeben.
 */
const neuestesJahr = eine('SELECT MAX(year) AS jahr FROM race').jahr
const aktuellAb = neuestesJahr - 4
---

<Seite
  titel="All Formula 1 circuits"
  beschreibung={`${strecken.length} circuits that have hosted World Championship rounds since 1950.`}
>
  <header class="seitenkopf">
    <div>
      <p class="oberzeile">Circuits</p>
      <h1>Every circuit since 1950</h1>
      <p class="lead">
        {strecken.length} circuits have hosted a World Championship round. Click a circle on
        the map, or find one in the list below.
      </p>
    </div>
  </header>

  <Weltkarte strecken={strecken} aktuellAb={aktuellAb} pfadZu={pfad.strecke} />

  <section class="abschnitt">
    <div class="abschnitt-kopf"><div><h2>All circuits</h2></div></div>

    <Filter
      platzhalter="Filter by circuit, place or country"
      einheit={['circuit', 'circuits']}
      pillen={[{ label: `Used since ${aktuellAb}`, spalte: 2, art: 'bis', wert: aktuellAb }]}
    />

    <div class="tabelle lang">
      <table>
        <thead>
          <tr>
            <th><button type="button" data-spalte="0" data-art="name">Circuit</button></th>
            <th>Location</th>
            <th><button type="button" data-spalte="2" data-art="jahr">Period</button></th>
            <th class="num"><button type="button" data-spalte="3" data-art="zahl" data-aktiv="1">Races</button></th>
            <th class="num"><button type="button" data-spalte="4" data-art="zahl">Length</button></th>
            <th class="num"><button type="button" data-spalte="5" data-art="zahl">Corners</button></th>
          </tr>
        </thead>
        <tbody>
          {strecken.map((z) => (
            <tr data-name={z.name}>
              <td>
                <span class="kuerzel" title={z.landName ?? ''}>{z.land ?? '—'}</span>
                <a class="zeile" href={pfad.strecke(z.id)}>{z.name}</a>
              </td>
              <td class="leise">{z.ort}</td>
              <td class="leise">{z.von === z.bis ? z.von : `${z.von}–${z.bis}`}</td>
              <td class="num">{z.rennen}</td>
              <td class="num">{z.laenge ? km(z.laenge) : '–'}</td>
              <td class="num">{z.kurven ?? '–'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <Sortierung vorsortiert={3} gleichstand={3} />
</Seite>
