---
import { km, prozent as proz } from '../../lib/format.js'
import Seite from '../../layouts/Seite.astro'
import Filter from '../../components/Filter.astro'
import Sortierung from '../../components/Sortierung.astro'
import { alle, db, eine, streckenListe, pfad } from '../../lib/db.js'
import { startplatzGewicht } from '../../engine/circuit.js'
import Weltkarte from '../../components/Weltkarte.astro'

const strecken = streckenListe()

/* Die Jahre je Strecke – die Zeitleiste der Karte zeigt damit jede Saison einzeln. */
const jahre: Record<string, number[]> = {}
for (const r of alle('SELECT DISTINCT circuit_id AS id, year AS jahr FROM race ORDER BY year')) {
  ;(jahre[r.id] ??= []).push(r.jahr)
}

/*
 * Was heisst "heute benutzt"? Der Kalender wechselt, und eine Strecke faellt
 * auch mal ein Jahr aus. Fuenf Saisons sind lang genug, um Imola und Zandvoort
 * nicht faelschlich fuer verschwunden zu erklaeren, und kurz genug, um
 * Hockenheim nicht als aktuell auszugeben.
 */
const neuestesJahr = eine('SELECT MAX(year) AS jahr FROM race').jahr
const aktuellAb = neuestesJahr - 4

const GEWICHT_AB = 2000
const GEWICHT_MIN = 8
const gewicht = startplatzGewicht(db(), { ab: GEWICHT_AB, minRennen: GEWICHT_MIN })
---

<Seite
  titel="All Formula 1 circuits"
  beschreibung={`${strecken.length} circuits that have hosted World Championship rounds since 1950.`}
>
  <header class="seitenkopf">
    <div>
      <p class="oberzeile">Circuits</p>
      <h1>Every circuit since 1950</h1>
      <p class="lead">
        {strecken.length} circuits have hosted a World Championship round. Zoom into a region,
        step through the seasons, or find a circuit in the list below.
      </p>
    </div>
  </header>

  <Weltkarte strecken={strecken} jahre={jahre} aktuellAb={aktuellAb} pfadZu={pfad.strecke} />

  <section class="abschnitt">
    <div class="abschnitt-kopf"><div><h2>All circuits</h2></div></div>

    <Filter
      platzhalter="Filter by circuit, place or country"
      einheit={['circuit', 'circuits']}
      pillen={[{ label: `Used since ${aktuellAb}`, spalte: 2, art: 'bis', wert: aktuellAb }]}
    />

    <div class="tabelle lang">
      <table>
        <thead>
          <tr>
            <th><button type="button" data-spalte="0" data-art="name">Circuit</button></th>
            <th>Location</th>
            <th><button type="button" data-spalte="2" data-art="jahr">Period</button></th>
            <th class="num"><button type="button" data-spalte="3" data-art="zahl" data-aktiv="1">Races</button></th>
            <th class="num"><button type="button" data-spalte="4" data-art="zahl">Length</button></th>
            <th class="num"><button type="button" data-spalte="5" data-art="zahl">Corners</button></th>
          </tr>
        </thead>
        <tbody>
          {strecken.map((z) => (
            <tr data-name={z.name}>
              <td>
                <span class="kuerzel" title={z.landName ?? ''}>{z.land ?? '—'}</span>
                <a class="zeile" href={pfad.strecke(z.id)}>{z.name}</a>
              </td>
              <td class="leise">{z.ort}</td>
              <td class="leise">{z.von === z.bis ? z.von : `${z.von}–${z.bis}`}</td>
              <td class="num">{z.rennen}</td>
              <td class="num">{z.laenge ? km(z.laenge) : '–'}</td>
              <td class="num">{z.kurven ?? '–'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="abschnitt" id="startplatz">
    <div class="abschnitt-kopf">
      <div>
        <h2>Where the grid decides</h2>
        <p>
          Since {GEWICHT_AB}, circuits with at least {GEWICHT_MIN} races: how often pole won, where
          the winner started on average, and how much the order changed between start and finish –
          the closest thing in the results to how hard it is to overtake.
        </p>
      </div>
    </div>
    <div class="tabelle">
      <table>
        <thead>
          <tr>
            <th scope="col">Circuit</th>
            <th class="num" scope="col">Races</th>
            <th class="num" scope="col">Pole won</th>
            <th class="num" scope="col">Winner started</th>
            <th class="num" scope="col">Places changed</th>
          </tr>
        </thead>
        <tbody>
          {gewicht.map((g) => (
            <tr>
              <th scope="row"><a class="zeile" href={pfad.strecke(g.id)}>{g.name}</a></th>
              <td class="num">{g.rennen}</td>
              <td class="num">{proz(g.poleQuote)}</td>
              <td class="num">P{g.siegerStart.toFixed(1)}</td>
              <td class="num">{g.platzwechsel.toFixed(1)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="fussnote">
      Pole is the fastest time in qualifying, even where a penalty moved that driver back. Places
      changed: among the drivers who were classified, how far each one's finishing position was
      from their order on the grid, either way. Retirements do not count – moving up past a car
      that stopped is not an overtake.
    </p>
  </section>

  <Sortierung vorsortiert={3} gleichstand={3} />
</Seite>
