---
import { ein, zahl } from '../../lib/format.js'
import Seite from '../../layouts/Seite.astro'
import { eine, streckenListe, pfad } from '../../lib/db.js'
import Weltkarte from '../../components/Weltkarte.astro'

const strecken = streckenListe()

/*
 * Was heisst "heute benutzt"? Der Kalender wechselt, und eine Strecke faellt
 * auch mal ein Jahr aus. Fuenf Saisons sind lang genug, um Imola und Zandvoort
 * nicht faelschlich fuer verschwunden zu erklaeren, und kurz genug, um
 * Hockenheim nicht als aktuell auszugeben.
 */
const neuestesJahr = eine('SELECT MAX(year) AS jahr FROM race').jahr
const aktuellAb = neuestesJahr - 4
---

<Seite
  titel="All Formula 1 circuits"
  beschreibung={`${strecken.length} circuits that have hosted World Championship rounds since 1950.`}
>
  <h1>Circuits</h1>
  <p class="lead">
    {strecken.length} circuits that have hosted World Championship rounds since 1950. Sorted
    by the number of races.
  </p>

  <Weltkarte strecken={strecken} aktuellAb={aktuellAb} pfadZu={pfad.strecke} />

  <div class="tabelle">
    <table>
      <thead>
        <tr>
          <th>Circuit</th><th>Location</th><th>Period</th>
          <th class="num">Races</th><th class="num">Length</th><th class="num">Corners</th>
        </tr>
      </thead>
      <tbody>
        {strecken.map((z) => (
          <tr>
            <td>
              <span class="kuerzel" title={z.landName ?? ''}>{z.land ?? '—'}</span>
              <a class="zeile" href={pfad.strecke(z.id)}>{z.name}</a>
            </td>
            <td style="color:var(--muted)">{z.ort}</td>
            <td style="color:var(--muted)">{z.von === z.bis ? z.von : `${z.von}–${z.bis}`}</td>
            <td class="num">{z.rennen}</td>
            <td class="num">{z.laenge ? `${ein(z.laenge)} km` : '–'}</td>
            <td class="num">{z.kurven ?? '–'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Seite>
