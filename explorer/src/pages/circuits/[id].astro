---
import { ein, km, plakette, prozent as proz, raenge, zahl, zeit } from '../../lib/format.js'
import Seite from '../../layouts/Seite.astro'
import Sprung from '../../components/Sprung.astro'
import Lagekarte from '../../components/Lagekarte.astro'
import Epochenband from '../../components/Epochenband.astro'
import { zeitraumImBand } from '../../components/epochen.js'
import { eine, streckenListe, pfad, db } from '../../lib/db.js'
import { land } from '../../lib/laender.js'
import {
  circuitLapRecords, circuitLayouts, circuitLeaders, circuitRaces, circuitSpecialists, circuitStats,
  circuitTeamLeaders,
} from '../../engine/circuit.js'

export async function getStaticPaths() {
  return streckenListe().map((z) => ({ params: { id: z.id } }))
}

const { id } = Astro.params
const strecke = eine(
  `SELECT z.*, c.name AS landName, c.ioc AS ioc, c.demonym AS demonym
     FROM circuit z LEFT JOIN country c ON c.id = z.country_id WHERE z.id = ?`,
  id,
)
const heimat = land(strecke.demonym, strecke.landName, strecke.ioc)
const rennen = circuitRaces(db(), id)
const sieger = circuitLeaders(db(), id, 'siege')
const polesetter = circuitLeaders(db(), id, 'poles')
const teams = circuitTeamLeaders(db(), id)
const zahlen = circuitStats(db(), id)
const spezialisten = circuitSpecialists(db(), id)
const layouts = circuitLayouts(db(), id)
const rekorde = new Map(circuitLapRecords(db(), id).map((r) => [r.layout, r]))
const heutigesLayout = layouts.find((l) => l.aktuell === 1) ?? layouts.at(-1)
const rekordHeute = heutigesLayout ? rekorde.get(heutigesLayout.id) : null

const SEITE = 'https://jonathanrngl.github.io'
const ort = {
  '@context': 'https://schema.org',
  '@type': 'SportsActivityLocation',
  name: strecke.full_name ?? strecke.name,
  address: [strecke.place_name, heimat.name].filter(Boolean).join(', '),
  ...(strecke.latitude !== null ? { geo: { '@type': 'GeoCoordinates', latitude: strecke.latitude, longitude: strecke.longitude } } : {}),
  url: `${SEITE}${pfad.strecke(id)}`,
}

/* Dieselbe Grenze wie auf der Übersicht: im Kalender der letzten fünf Saisons. */
const aktuellAb = eine('SELECT MAX(year) AS jahr FROM race').jahr - 4
const strecken = streckenListe()
const hierListe = strecken.find((z) => z.id === id)

const zeitraum = rennen.length ? `${rennen.at(-1).year}–${rennen[0].year}` : '–'

/*
 * Das Epochenband: die Jahre mit einem Rennen auf dieser Strecke, auch ein
 * angesetztes der laufenden Saison (docs/DESIGN.md 8.3).
 */
const jahreHier = [...new Set(rennen.map((r) => r.year))].sort((a, b) => a - b)

/*
 * Den Zeitraum zeigt das Epochenband. In Worten steht er nur, wenn das Band
 * erstes oder letztes Jahr nicht beschriftet – es lässt eine Zahl weg, die
 * näher als acht Saisons an einer anderen steht (components/epochen.js).
 */
const bandNenntZeitraum = zeitraumImBand(jahreHier)

/*
 * Der Kopfsatz: was keine Zahl sagt, in ganzen Sätzen statt einer Zeile
 * Eckdaten mit Trennlinien (docs/DESIGN.md 8.2). Art und Ort, Fahrtrichtung,
 * Länge und Kurven, die Zahl der Layouts, frühere Namen.
 */
const ART_SATZ = { RACE: 'A permanent circuit', STREET: 'A street circuit', ROAD: 'A road course' }
const RICHTUNG_SATZ = { CLOCKWISE: 'run clockwise', ANTI_CLOCKWISE: 'run anti-clockwise' }
const ortText = [strecke.place_name, heimat.name].filter(Boolean).join(', ')
const masse = [strecke.length_km > 0 && km(strecke.length_km), strecke.turns > 0 && `${strecke.turns} corners`].filter(Boolean).join(', ')
const kopfsatz = [
  ortText &&
    `${ART_SATZ[strecke.type] ? `${ART_SATZ[strecke.type]} in` : 'In'} ${ortText}${RICHTUNG_SATZ[strecke.direction] ? `, ${RICHTUNG_SATZ[strecke.direction]}` : ''}.`,
  !bandNenntZeitraum && jahreHier.length > 0 &&
    (jahreHier.length === 1
      ? `Raced only in ${jahreHier[0]}.`
      : `First race in ${jahreHier[0]}, last in ${jahreHier.at(-1)}.`),
  masse && (layouts.length > 1 ? `${masse} on the current layout, one of ${layouts.length}.` : `${masse}.`),
  strecke.previous_names && `Also known as ${strecke.previous_names.split(/[;,]\s*/).join(', ')}.`,
]
  .filter(Boolean)
  .join(' ')

const ziele = [
  { id: 'bestenliste', label: 'Most successful' },
  spezialisten.length > 0 && { id: 'spezialisten', label: 'Specialists' },
  layouts.length > 1 && { id: 'layouts', label: 'Layouts' },
  { id: 'rennen', label: 'All races' },
].filter(Boolean)
---

<Seite
  titel={`${strecke.name}: Formula 1 circuit statistics`}
  beschreibung={`${rennen.length} Formula 1 races in ${strecke.place_name} (${zeitraum}): winners, pole-sitters, specialists, lap records and every result.`}
  strukturiert={[ort]}
  brotkrumen={[{ name: 'Circuits', pfad: '/circuits/' }]}
>
  {/*
    * Der Kopf: Brotkrume, der Name, ein Satz mit dem, was keine Zahl sagt,
    * das Epochenband mit den Jahren, in denen hier gefahren wurde. Rechts das
    * Länderkürzel und darunter die Lage auf der Karte. Keine Lackierung – eine
    * Strecke gehört keinem Team (docs/DESIGN.md, Prinzip 1).
    */}
  <header class="seitenkopf">
    <span class="wappen" title={heimat.name}>{heimat.code}</span>
    <div>
      <p class="oberzeile">
        <a href={pfad.seite('/circuits/')}>Circuits</a>
        <span class="trenner">/</span>
        <span class="still">{heimat.name}</span>
      </p>
      <div class="titelblock">
        <h1>{strecke.name}</h1>
        {kopfsatz && <p class="kopfsatz">{kopfsatz}</p>}
      </div>
      <Epochenband jahre={jahreHier} wort="Races here" />
    </div>
    {hierListe && <Lagekarte strecke={hierListe} alle={strecken} aktuellAb={aktuellAb} />}
  </header>

  {/*
    * Die Rennen tragen die Seite und stehen zuerst. Der Rundenrekord ist die
    * schnellste Rennrunde, die je auf diesem Layout gefahren wurde – die
    * absolute Bestmarke der Strecke, darum in Lila.
    */}
  <ul class="kacheln">
    <li class="stark"><span>Races</span><b>{rennen.length}</b></li>
    <li><span>Not classified</span><b>{proz(zahlen.ausfallquote)}</b><i>of all starts</i></li>
    <li><span>Pole to win</span><b>{proz(zahlen.poleZuSieg)}</b><i>pole-sitter won</i></li>
    <li><span>Winner's grid slot</span><b>{ein(zahlen.mittlererSiegerStart.value)}</b><i>on average</i></li>
    {rekordHeute && (
      <li>
        <span>Lap record</span><b class="rekord">{zeit(rekordHeute.zeit)}</b>
        <i><a href={pfad.fahrer(rekordHeute.fahrerId)}>{rekordHeute.fahrer}</a>, <a href={pfad.rennen(rekordHeute.raceId)}>{rekordHeute.jahr}</a>{layouts.length > 1 ? ', current layout' : ''}</i>
      </li>
    )}
  </ul>

  {zahlen.groessteAufholjagd && (
    <p class="hinweis akzent">
      <b>Furthest charge to victory here:</b>{' '}
      <a href={pfad.fahrer(zahlen.groessteAufholjagd.id)}>{zahlen.groessteAufholjagd.name}</a>
      {' '}won in {zahlen.groessteAufholjagd.year} from P{zahlen.groessteAufholjagd.start} on the grid.
    </p>
  )}

  <Sprung ziele={ziele} />

  <section class="abschnitt" id="bestenliste">
    <div class="abschnitt-kopf"><div><h2>Most successful here</h2></div></div>
    <div class="spalten">
      <div class="rangkarte">
        <h3>Most wins</h3>
        <ol class="rangliste">
          {raenge(sieger, (s) => s.anzahl).map((s) => (
            <li data-rang={s.rang} class={s.vorn ? 'vorn' : undefined}><a href={pfad.fahrer(s.id)}>{s.name}</a><b>{s.anzahl}</b></li>
          ))}
        </ol>
      </div>

      {polesetter.length > 0 && (
        <div class="rangkarte">
          <h3>Most pole positions</h3>
          <ol class="rangliste">
            {raenge(polesetter, (s) => s.anzahl).map((s) => (
              <li data-rang={s.rang} class={s.vorn ? 'vorn' : undefined}><a href={pfad.fahrer(s.id)}>{s.name}</a><b>{s.anzahl}</b></li>
            ))}
          </ol>
        </div>
      )}

      <div class="rangkarte">
        <h3>Most successful teams</h3>
        <ol class="rangliste">
          {raenge(teams, (t) => t.anzahl).map((t) => (
            <li data-rang={t.rang} class={t.vorn ? 'vorn' : undefined}><a href={pfad.team(t.id)}>{t.name}</a><b>{t.anzahl}</b></li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  {spezialisten.length > 0 && (
    <section class="abschnitt" id="spezialisten">
      <div class="abschnitt-kopf">
        <div>
          <h2>Circuit specialists</h2>
          <p>
            A driver's average finish here, set against the same driver's average everywhere
            else, so a driver who wins everywhere is no specialist here. At least three starts
            here and three elsewhere.
          </p>
        </div>
      </div>
      <div class="tabelle">
        <table>
          <thead>
            <tr>
              <th scope="col">Driver</th><th class="num" scope="col">Starts here</th><th class="num" scope="col">Wins</th>
              <th class="num" scope="col">Avg finish here</th><th class="num" scope="col">Avg finish elsewhere</th>
              <th class="num" scope="col"><abbr title="Places better here than elsewhere, on average">Better by</abbr></th>
            </tr>
          </thead>
          <tbody>
            {spezialisten.map((s) => (
              <tr>
                <th scope="row"><a class="zeile" href={pfad.fahrer(s.id)}>{s.name}</a></th>
                <td class="num">{s.startsHier}</td>
                <td class="num">{s.siegeHier || ''}</td>
                <td class="num">{ein(s.hier)}</td>
                <td class="num leise">{ein(s.sonst)}</td>
                <td class="num gut">+{ein(s.vorteil)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {layouts.length > 1 && (
    <section class="abschnitt" id="layouts">
      <div class="abschnitt-kopf">
        <div>
          <h2>Layouts</h2>
          <p>The circuit has been rebuilt. Comparing lap times across a change of layout is not valid; each layout has its own lap record.</p>
        </div>
      </div>
      <div class="tabelle schmal">
        <table>
          <thead><tr><th scope="col">Period</th><th class="num" scope="col">Length</th><th class="num" scope="col">Corners</th><th class="num" scope="col">Races</th><th scope="col">Lap record</th></tr></thead>
          <tbody>
            {layouts.map((l) => (
              <tr>
                <td>
                  {l.von ? (l.von === l.bis ? l.von : `${l.von}–${l.bis}`) : 'never raced'}
                  {l.aktuell === 1 && <span class="etikett akzent">today</span>}
                </td>
                <td class="num">{l.laenge ? km(l.laenge) : '–'}</td>
                <td class="num">{l.kurven ?? '–'}</td>
                <td class="num">{l.rennen}</td>
                {/* Die Zeit, darunter leise, wer sie wann fuhr – zwei Angaben, zwei Zeilen. */}
                <td class="rekordzelle">
                  {rekorde.get(l.id)
                    ? <>{zeit(rekorde.get(l.id).zeit)}<span class="neben"><a href={pfad.fahrer(rekorde.get(l.id).fahrerId)}>{rekorde.get(l.id).fahrer}</a>, {rekorde.get(l.id).jahr}</span></>
                    : '–'}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <section class="abschnitt" id="rennen">
    <div class="abschnitt-kopf"><div><h2>All races</h2></div></div>
    <div class={`tabelle${rennen.length > 25 ? ' lang' : ''}`}>
      <table>
        <thead><tr><th scope="col">Year</th><th scope="col">Race</th><th scope="col">Winner</th><th scope="col">Team</th><th class="num" scope="col">From grid</th></tr></thead>
        <tbody>
          {rennen.map((r) => (
            <tr>
              <th scope="row"><a class="zeile" href={pfad.rennen(r.id)}>{r.year}</a></th>
              <td class="leise">{r.grandPrix}</td>
              <td>{r.siegerId ? <a class="zeile" href={pfad.fahrer(r.siegerId)}>{r.sieger}</a> : <span class="leise">still to come</span>}</td>
              <td class="leise">{r.siegerTeamId ? <a class="leise" href={pfad.team(r.siegerTeamId)}>{r.siegerTeam}</a> : ''}</td>
              <td class="num">{r.siegerStart ? <span class={plakette(r.siegerStart)}>{r.siegerStart}</span> : '–'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Seite>

<style>
  /*
   * Rechts im Kopf das Länderkürzel und darunter die Lage auf der Karte; der
   * Titel mit Kopfsatz und Epochenband steht links über beide Zeilen. Am
   * Telefon steht die Karte unter dem Kopf, über die volle Breite.
   */
  .seitenkopf > div { grid-row: 1 / span 2; }
  .seitenkopf > .wappen { justify-self: end; }
  .seitenkopf > :global(.lage) { grid-column: 2; grid-row: 2; width: 19rem; margin-top: var(--abstand-4); }

  @media (max-width: 48rem) {
    .seitenkopf > :global(.lage) { grid-column: 1 / -1; grid-row: 3; width: auto; margin-top: 0; }
  }

  .schmal { max-width: 52rem; }
  .rekordzelle { font-variant-numeric: tabular-nums lining-nums; }
</style>
