---
/**
 * Vorschau auf das nächste Rennen.
 *
 * Die Seite ist statisch. Was hier „das nächste Rennen“ heißt, war es zum
 * Zeitpunkt des Bauens – deshalb steht das Datum des Datenstands sichtbar
 * darunter, statt den Eindruck von Echtzeit zu erwecken.
 */
import Seite from '../../layouts/Seite.astro'
import { db, pfad } from '../../lib/db.js'
import { land } from '../../lib/laender.js'
import {
  circuitLeaders, circuitRaces, circuitSpecialists, circuitStats, circuitTeamLeaders,
} from '../../engine/circuit.js'
import {
  feld, naechstesRennen, rekordeInReichweite, standVorRennen, streckenHistorie,
} from '../../engine/vorschau.js'

const heute = new Date().toISOString().slice(0, 10)
const rennen = naechstesRennen(db(), heute)

// Alles Weitere hängt am Rennen. Gibt es keines, bleibt die Seite eine
// ehrliche Leermeldung statt einer Halde aus Platzhaltern.
const stand = rennen ? standVorRennen(db(), rennen) : null
const dasFeld = stand ? feld(db(), stand.bezug.id) : []
const rekorde = rennen && dasFeld.length ? rekordeInReichweite(db(), rennen, dasFeld) : []

const historie = rennen ? streckenHistorie(db(), rennen.streckeId) : null
const sieger = rennen ? circuitLeaders(db(), rennen.streckeId, 'siege', 6) : []
const polesetter = rennen ? circuitLeaders(db(), rennen.streckeId, 'poles', 6) : []
const teamsHier = rennen ? circuitTeamLeaders(db(), rennen.streckeId, 6) : []
const zahlenHier = rennen ? circuitStats(db(), rennen.streckeId) : null
const spezialisten = rennen ? circuitSpecialists(db(), rennen.streckeId) : []
// Ohne Sieger ist ein Rennen nicht gefahren - darunter das anstehende selbst,
// das sonst als Zeile aus Gedankenstrichen in der eigenen Vorschau stuende.
const letzteHier = rennen
  ? circuitRaces(db(), rennen.streckeId).filter((r) => r.siegerId).slice(0, 5)
  : []

const heimat = rennen ? land(rennen.demonym, rennen.land, rennen.ioc) : null

const nf = new Intl.NumberFormat('de-DE')
const ein = (n) => (n === null || n === undefined ? '–' : nf.format(Math.round(n * 10) / 10))
const proz = (m) => (!m || m.value === null ? '–' : `${Math.round(m.value * 100)} %`)
const datum = (s) =>
  s
    ? new Intl.DateTimeFormat('de-DE', { dateStyle: 'long', timeZone: 'UTC' }).format(
        new Date(`${s}T12:00:00Z`),
      )
    : '–'

/** Ganze Tage bis zum Rennen, gerechnet auf dem Datenstand. */
const tageBis = rennen
  ? Math.round((Date.parse(`${rennen.datum}T12:00:00Z`) - Date.parse(`${heute}T12:00:00Z`)) / 86400000)
  : null

const ART = { RACE: 'Permanente Rennstrecke', STREET: 'Stadtkurs', ROAD: 'Straßenkurs' }
const RICHTUNG = { CLOCKWISE: 'im Uhrzeigersinn', ANTI_CLOCKWISE: 'gegen den Uhrzeigersinn' }

/*
 * Kann der Fahrertitel hier schon fallen? Nur wenn der Vorsprung auf Platz 2
 * größer ist als alles, was nach diesem Rennen noch zu holen ist. Das ist die
 * notwendige Bedingung, nicht die hinreichende – die tatsächliche Rechnung
 * hängt an Streichresultaten und Gleichstandsregeln. Die Seite sagt deshalb
 * „kann“, nicht „wird“.
 */
const fuehrender = stand?.fahrer?.[0] ?? null
const zweiter = stand?.fahrer?.[1] ?? null
const vorsprung = fuehrender && zweiter ? fuehrender.punkte - zweiter.punkte : null
const titelMoeglich =
  stand && !stand.vorsaison && vorsprung !== null && vorsprung > stand.maxDanach

const rekordeNachFahrer = rekorde.reduce((karte, r) => {
  if (!karte.has(r.fahrer)) karte.set(r.fahrer, { name: r.name, punkte: [] })
  karte.get(r.fahrer).punkte.push(r)
  return karte
}, new Map())

const titel = rennen ? `${rennen.grandPrix} ${rennen.jahr} – Vorschau` : 'Rennvorschau'
---

<Seite
  titel={titel}
  beschreibung={
    rennen
      ? `Vorschau auf den ${rennen.grandPrix} ${rennen.jahr} in ${rennen.ort}: Strecke, WM-Stand und Marken in Reichweite.`
      : 'Vorschau auf das nächste Formel-1-Rennen.'
  }
>
  {!rennen && (
    <>
      <h1>Keine Vorschau</h1>
      <p class="lead">
        In den Daten steht kein Rennen, das noch aussteht. Entweder ist die Saison zu Ende und
        der Kalender des nächsten Jahres noch nicht veröffentlicht, oder der Datenstand vom
        {' '}{datum(heute)} ist älter als das letzte Rennen.
      </p>
      <p><a href={pfad.seite('/saisons/')}>Zu den Saisons</a></p>
    </>
  )}

  {rennen && (
    <>
      <header class="profil">
        <span class="kuerzel gross" title={heimat?.name}>{heimat?.code}</span>
        <div>
          <h1>{rennen.grandPrix} {rennen.jahr}</h1>
          <p class="lead">
            {[
              `Lauf ${rennen.runde} von ${rennen.rennenImJahr}`,
              rennen.strecke,
              rennen.ort,
              datum(rennen.datum),
            ].filter(Boolean).join(' · ')}
          </p>
        </div>
      </header>

      <p class="hinweis">
        {tageBis > 1
          ? `Noch ${tageBis} Tage. `
          : tageBis === 1
            ? 'Morgen. '
            : tageBis === 0
              ? 'Heute. '
              : `Das Datum liegt ${Math.abs(tageBis)} Tage zurück – zu diesem Rennen liegt noch kein Ergebnis vor. `}
        Alle Zahlen auf dieser Seite stehen auf dem Datenstand vom {datum(heute)}
        {stand && !stand.vorsaison && `, also nach Lauf ${stand.bezug.runde} (${stand.bezug.grandPrix})`}.
        {rennen.offiziell && <> Offiziell: <i>{rennen.offiziell}</i>.</>}
      </p>

      <section>
        <h2>Die Strecke</h2>
        <ul class="kacheln">
          <li><b>{ein(rennen.streckenlaenge ?? rennen.laenge)} km</b><span>Rundenlänge</span></li>
          <li><b>{rennen.streckenkurven ?? rennen.kurven ?? '–'}</b><span>Kurven</span></li>
          <li><b>{rennen.runden ?? '–'}</b><span>geplante Runden</span></li>
          <li><b>{rennen.distanz ? `${ein(rennen.distanz)} km` : '–'}</b><span>Renndistanz</span></li>
        </ul>
        <p class="notiz">
          {[
            rennen.streckeVoll && rennen.streckeVoll !== rennen.strecke ? rennen.streckeVoll : null,
            ART[rennen.art] ?? null,
            RICHTUNG[rennen.richtung] ?? null,
            historie?.rennen
              ? `${historie.rennen} Formel-1-Rennen hier, ${historie.von}–${historie.bis}`
              : 'Zum ersten Mal im Formel-1-Kalender',
            rennen.mitSprint ? 'Wochenende mit Sprint' : null,
          ].filter(Boolean).join(' · ')}
        </p>

        {historie?.rennen > 0 && (
          <ul class="kacheln">
            <li><b>{proz(zahlenHier?.ausfallquote)}</b><span>Starts ohne Wertung</span></li>
            <li><b>{proz(zahlenHier?.poleZuSieg)}</b><span>Pole wurde Sieg</span></li>
            <li>
              <b>{ein(zahlenHier?.mittlererSiegerStart?.value)}</b>
              <span>Ø Startplatz des Siegers</span>
            </li>
          </ul>
        )}

        {zahlenHier?.groessteAufholjagd && (
          <p class="notiz">
            Weiteste Aufholjagd zum Sieg hier:
            {' '}<a href={pfad.fahrer(zahlenHier.groessteAufholjagd.id)}>
              {zahlenHier.groessteAufholjagd.name}
            </a>{' '}
            {zahlenHier.groessteAufholjagd.year} von Startplatz {zahlenHier.groessteAufholjagd.start}.
          </p>
        )}
      </section>

      {historie?.rennen > 0 && (
        <section>
          <h2>Wer hier stark war</h2>
          <div class="spalten">
            <section>
              <h3>Meiste Siege</h3>
              <ol class="rangliste">
                {sieger.map((s) => (
                  <li>
                    <a class="zeile" href={pfad.fahrer(s.id)}>{s.name}</a>
                    <b>{s.anzahl}</b>
                  </li>
                ))}
              </ol>
            </section>
            <section>
              <h3>Meiste Pole-Positions</h3>
              <ol class="rangliste">
                {polesetter.map((s) => (
                  <li>
                    <a class="zeile" href={pfad.fahrer(s.id)}>{s.name}</a>
                    <b>{s.anzahl}</b>
                  </li>
                ))}
              </ol>
            </section>
            <section>
              <h3>Erfolgreichste Teams</h3>
              <ol class="rangliste">
                {teamsHier.map((t) => (
                  <li>
                    <a class="zeile" href={pfad.team(t.id)}>{t.name}</a>
                    <b>{t.anzahl}</b>
                  </li>
                ))}
              </ol>
            </section>
          </div>

          {spezialisten.length > 0 && (
            <>
              <h3 class="weit">Streckenspezialisten</h3>
              <p class="notiz">
                Mittlere Zielposition hier, verglichen mit der desselben Fahrers überall sonst.
                Wer überall gewinnt, ist hier kein Spezialist.
              </p>
              <div class="tabelle">
                <table>
                  <thead>
                    <tr>
                      <th>Fahrer</th>
                      <th class="num">hier</th>
                      <th class="num">sonst</th>
                      <th class="num">Differenz</th>
                    </tr>
                  </thead>
                  <tbody>
                    {spezialisten.slice(0, 6).map((s) => (
                      <tr>
                        <td><a class="zeile" href={pfad.fahrer(s.id)}>{s.name}</a></td>
                        <td class="num">{ein(s.hier)}</td>
                        <td class="num">{ein(s.sonst)}</td>
                        <td class="num stark">{ein(s.vorteil)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </>
          )}

          <h3 class="weit">Zuletzt hier</h3>
          <div class="tabelle">
            <table>
              <thead>
                <tr><th class="num">Jahr</th><th>Sieger</th><th>Team</th><th class="num">von Startplatz</th></tr>
              </thead>
              <tbody>
                {letzteHier.map((r) => (
                  <tr>
                    <td class="num"><a class="zeile" href={pfad.rennen(r.id)}>{r.year}</a></td>
                    <td>{r.siegerId ? <a class="zeile" href={pfad.fahrer(r.siegerId)}>{r.sieger}</a> : '–'}</td>
                    <td style="color:var(--muted)">{r.siegerTeam ?? '–'}</td>
                    <td class="num">{r.siegerStart ?? '–'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      {stand && (
        <section>
          <h2>Stand der Meisterschaft</h2>
          <p class="notiz">
            {stand.vorsaison
              ? `Die Saison ${rennen.jahr} hat noch kein Ergebnis. Gezeigt ist der Endstand ${stand.bezug.jahr}.`
              : `Nach Lauf ${stand.bezug.runde} (${stand.bezug.grandPrix}) vom ${datum(stand.bezug.datum)}.`}
            {' '}Noch {stand.offen} Rennen in dieser Saison
            {stand.sprints > 0 && ` (davon ${stand.sprints} mit Sprint)`},
            also höchstens {stand.maxFuerEinenFahrer} Punkte für einen einzelnen Fahrer.
          </p>

          {titelMoeglich && (
            <p class="hinweis stark">
              Der Fahrertitel kann hier fallen: {fuehrender.name} führt mit {ein(vorsprung)} Punkten
              Vorsprung, und nach diesem Rennen sind nur noch {stand.maxDanach} zu holen. Ob es
              tatsächlich reicht, hängt am Ausgang – die Zahl sagt nur, dass es rechnerisch geht.
            </p>
          )}

          <div class="spalten">
            <section>
              <h3>Fahrer</h3>
              <div class="tabelle">
                <table>
                  <thead>
                    <tr><th class="num">#</th><th>Fahrer</th><th>Team</th><th class="num">Punkte</th></tr>
                  </thead>
                  <tbody>
                    {stand.fahrer.map((f) => (
                      <tr>
                        <td class="num">{f.position ?? '–'}</td>
                        <td><a class="zeile" href={pfad.fahrer(f.id)}>{f.name}</a></td>
                        <td style="color:var(--muted)">{f.team ?? '–'}</td>
                        <td class="num">{ein(f.punkte)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>

            <section>
              <h3>Konstrukteure</h3>
              <div class="tabelle">
                <table>
                  <thead><tr><th class="num">#</th><th>Team</th><th class="num">Punkte</th></tr></thead>
                  <tbody>
                    {stand.teams.map((t) => (
                      <tr>
                        <td class="num">{t.position ?? '–'}</td>
                        <td><a class="zeile" href={pfad.team(t.id)}>{t.name}</a></td>
                        <td class="num">{ein(t.punkte)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>
          </div>
        </section>
      )}

      <section>
        <h2>Marken in Reichweite</h2>
        {rekordeNachFahrer.size === 0 ? (
          <p class="notiz">
            Bei diesem Rennen steht keine runde Zahl und keine Bestmarke auf der Kippe –
            jedenfalls keine, die ein einzelnes Wochenende bewegen kann.
          </p>
        ) : (
          <>
            <p class="notiz">
              Nur was dieses eine Rennen bewegen kann: runde Zahlen in der Karriere, die
              Bestmarke auf dieser Strecke und ewige Wertungen, in denen einer fehlt.
              Gerechnet für die {dasFeld.length} Fahrer, die zuletzt am Start standen.
            </p>
            <ul class="marken">
              {[...rekordeNachFahrer.entries()].map(([id, eintrag]) => (
                <li>
                  <a class="zeile" href={pfad.fahrer(id)}>{eintrag.name}</a>
                  <ul>
                    {eintrag.punkte.map((p) => (
                      <li class={p.art}>{p.text}</li>
                    ))}
                  </ul>
                </li>
              ))}
            </ul>
          </>
        )}
      </section>
    </>
  )}
</Seite>

<style>
  .profil { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; }
  .kuerzel.gross {
    flex: none; min-width: 3.6rem; padding: 0.5rem 0.35rem; margin: 0;
    font-size: 0.86rem; color: var(--accent); background: var(--accent-wash);
  }
  .kacheln {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(9rem, 100%), 1fr));
    gap: 0.75rem; margin: 0 0 1rem; padding: 0; list-style: none;
  }
  .kacheln li {
    display: flex; flex-direction: column; gap: 0.1rem; padding: 0.9rem 1rem;
    background: var(--surface-2); border: 1px solid var(--border); border-radius: 0.6rem;
  }
  .kacheln b {
    font-size: 1.6rem; font-weight: 680; line-height: 1.1; color: var(--ink);
    font-variant-numeric: tabular-nums; letter-spacing: -0.02em;
  }
  .kacheln span { font-size: 0.78rem; color: var(--muted); }
  .hinweis {
    margin: 0 0 1.5rem; padding: 0.8rem 1rem; font-size: 0.87rem;
    background: var(--accent-wash); border: 1px solid var(--border);
    border-left: 3px solid var(--accent); border-radius: 0.5rem; max-width: 46rem;
  }
  .hinweis.stark { font-weight: 560; }
  .notiz { margin: 0 0 1rem; font-size: 0.87rem; color: var(--ink-2); max-width: 46rem; }
  .spalten {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    gap: 1.5rem;
  }
  .spalten section { margin-top: 0; }
  section { margin-top: 2.5rem; }
  h2 { font-size: 1.15rem; margin: 0 0 0.75rem; }
  h3 { font-size: 0.95rem; margin: 0 0 0.5rem; }
  h3.weit { margin-top: 2rem; }
  .rangliste { margin: 0; padding: 0; list-style: none; counter-reset: rang; }
  .rangliste li {
    display: flex; align-items: baseline; justify-content: space-between; gap: 0.75rem;
    padding: 0.4rem 0; border-bottom: 1px solid var(--border); font-size: 0.89rem;
  }
  .rangliste li::before {
    counter-increment: rang; content: counter(rang);
    min-width: 1.2rem; color: var(--muted); font-variant-numeric: tabular-nums;
  }
  .rangliste b { font-variant-numeric: tabular-nums; }
  .stark { color: var(--good); }
  .marken { margin: 0; padding: 0; list-style: none; }
  .marken > li {
    padding: 0.75rem 0; border-bottom: 1px solid var(--border);
  }
  .marken > li > ul { margin: 0.3rem 0 0; padding-left: 1.1rem; }
  .marken > li > ul > li { font-size: 0.89rem; color: var(--ink-2); padding: 0.1rem 0; }
  /* Eine Bestmarke wiegt schwerer als eine runde Zahl - das darf man sehen. */
  .marken li.strecke, .marken li.bestenliste { color: var(--ink); }
</style>
