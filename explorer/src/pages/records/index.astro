---
import { zahl } from '../../lib/format.js'
import Seite from '../../layouts/Seite.astro'
import { pfad, db } from '../../lib/db.js'
import {
  altersrekord, altersrekordMeister, groessteAufholjagden, laengsteKarrieren,
  laengstePauseZwischenSiegen, laengsteSerien, meistePlaetzeGutgemacht, meistePodien,
  meistePoles, meistePunkte, meisteSchnellsteRunden, meisteSiege, meisteStarts,
  meisteTitel, teamRekorde, grandSlams, zielabstand,
} from '../../engine/records.js'

const d = db()
const N = 10

const slams = grandSlams(d, N)
const knapp = zielabstand(d, 'knapp', N)
const weit = zielabstand(d, 'weit', N)

const ganz = (v) => zahl(Math.round(v))
/** Ein Zielabstand: unter zehn Sekunden auf Tausendstel, darueber auf Zehntel. */
const sekunden = (v) => (v < 10 ? v.toFixed(3) : v.toFixed(1)) + 's'
const jahreAlt = (v) => {
  const j = Math.floor(v)
  const tage = Math.round((v - j) * 365.25)
  return `${j}y ${tage}d`
}
const jahreSpanne = (v) => `${zahl(Math.round(v * 10) / 10)} years`

/*
 * Jeder Block nennt seine eigene Einheit und, wo nötig, seine Einschränkung.
 * Eine Bestenliste ohne Angabe, worüber sie zählt, ist eine Zahlenwand.
 */
const bloecke = [
  {
    titel: 'Most wins',
    liste: meisteSiege(d, N),
    format: ganz,
  },
  {
    titel: 'Most podiums',
    liste: meistePodien(d, N),
    format: ganz,
  },
  {
    titel: 'Most pole positions',
    liste: meistePoles(d, N),
    format: ganz,
    hinweis: 'Fastest time in qualifying – not the grid position, which penalties shift.',
  },
  {
    titel: 'Most starts',
    liste: meisteStarts(d, N),
    format: ganz,
    hinweis: 'Starts are counted, not entries: a driver who did not qualify was not in the race.',
  },
  {
    titel: 'Most fastest laps',
    liste: meisteSchnellsteRunden(d, N),
    format: ganz,
  },
  {
    titel: 'Most World Championships',
    liste: meisteTitel(d, N),
    format: ganz,
  },
  {
    titel: 'Most points scored in races',
    liste: meistePunkte(d, N),
    format: (v) => zahl(Math.round(v)),
    hinweis:
      'Comparable only up to a point: the points system has changed more than a dozen times since 1950, and until 1990 some of the points lapsed as dropped scores.',
  },
]

const serien = [
  { titel: 'Longest winning streak', liste: laengsteSerien(d, 'siege', N) },
  { titel: 'Longest podium streak', liste: laengsteSerien(d, 'podien', N) },
  { titel: 'Longest points-scoring streak', liste: laengsteSerien(d, 'punkte', N) },
  { titel: 'Longest finishing streak', liste: laengsteSerien(d, 'zielankuenfte', N) },
]

const alter = [
  { titel: 'Youngest winners', liste: altersrekord(d, 'sieg', 'jung', N) },
  { titel: 'Oldest winners', liste: altersrekord(d, 'sieg', 'alt', N) },
  { titel: 'Youngest pole-sitters', liste: altersrekord(d, 'pole', 'jung', N) },
  { titel: 'Youngest World Champions', liste: altersrekordMeister(d, 'jung', N) },
  { titel: 'Oldest World Champions', liste: altersrekordMeister(d, 'alt', N) },
]

const aufholjagden = groessteAufholjagden(d, N)
const plaetze = meistePlaetzeGutgemacht(d, N)
const karrieren = laengsteKarrieren(d, N)
const pausen = laengstePauseZwischenSiegen(d, N)

const teamSiege = teamRekorde(d, 'siege', N)
const teamTitel = teamRekorde(d, 'titel', N)
---

<Seite
  titel="Formula 1 records – the records set since 1950"
  beschreibung="Most wins, podiums and pole positions, longest streaks, youngest and oldest record holders – every entry linked to the race."
>
  <h1>Records</h1>
  <p class="lead">
    Records since 1950, computed from the race results rather than copied out of a curated
    list. Every entry links to the driver and, where there is one, to the race.
  </p>

  <div class="raster">
    {bloecke.map((b) => (
      <section>
        <h2>{b.titel}</h2>
        {b.hinweis && <p class="hinweis">{b.hinweis}</p>}
        <ol class="rangliste">
          {b.liste.map((e) => (
            <li>
              <a href={pfad.fahrer(e.driverId)}>{e.name}</a>
              <b>{b.format(e.wert)}</b>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>

  <h2 class="gruppe">Streaks</h2>
  <p class="lead">
    Unbroken runs across a driver's starts. A race missed does not break a streak – a driver who
    was not there had nothing to lose.
  </p>
  <div class="raster">
    {serien.map((s) => (
      <section>
        <h2>{s.titel}</h2>
        <ol class="rangliste breit">
          {s.liste.map((e) => (
            <li>
              <span>
                <a href={pfad.fahrer(e.driverId)}>{e.name}</a>
                <i>{e.rennen}</i>
              </span>
              <b>{e.wert}</b>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>

  <h2 class="gruppe">Winning margins</h2>
  <p class="lead">
    The gap is recorded against the second-placed car. Races that ended a lap or more apart
    have no gap in seconds and are left out – a lap is not a number of seconds, and treating
    it as an enormous one would say something different.
  </p>
  <div class="raster">
    <section>
      <h2>Closest finishes</h2>
      <ol class="rangliste breit">
        {knapp.map((e) => (
          <li>
            <span>
              <a href={pfad.fahrer(e.driverId)}>{e.name}</a>
              <i><a class="leise" href={pfad.rennen(e.raceId)}>{e.rennen}</a></i>
            </span>
            <b>{sekunden(e.wert)}</b>
          </li>
        ))}
      </ol>
    </section>

    <section>
      <h2>Biggest winning margins</h2>
      <ol class="rangliste breit">
        {weit.map((e) => (
          <li>
            <span>
              <a href={pfad.fahrer(e.driverId)}>{e.name}</a>
              <i><a class="leise" href={pfad.rennen(e.raceId)}>{e.rennen}</a></i>
            </span>
            <b>{sekunden(e.wert)}</b>
          </li>
        ))}
      </ol>
    </section>

    <section>
      <h2>Grand Slams</h2>
      <p class="hinweis">
        Pole position, win, fastest lap and every lap led – all in one race.
      </p>
      <ol class="rangliste breit">
        {slams.map((e) => (
          <li>
            <span>
              <a href={pfad.fahrer(e.driverId)}>{e.name}</a>
              <i><a class="leise" href={pfad.rennen(e.raceId)}>most recently</a></i>
            </span>
            <b>{e.wert}</b>
          </li>
        ))}
      </ol>
    </section>
  </div>

  <p class="quelle">
    The Grand Slam is the one figure on this page that is not recalculated here: “led every
    lap” appears in no result row, and the lap data that would settle it is not loaded. It is
    taken from F1DB as it stands.
  </p>

  <h2 class="gruppe">Age</h2>
  <p class="lead">
    Drivers whose date of birth is not recorded are missing from these lists – a missing date is
    not an age of zero.
  </p>
  <div class="raster">
    {alter.map((a) => (
      <section>
        <h2>{a.titel}</h2>
        <ol class="rangliste breit">
          {a.liste.map((e) => (
            <li>
              <span>
                <a href={pfad.fahrer(e.driverId)}>{e.name}</a>
                <i>{e.raceId ? <a class="leise" href={pfad.rennen(e.raceId)}>{e.rennen}</a> : e.rennen}</i>
              </span>
              <b>{jahreAlt(e.wert)}</b>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>

  <h2 class="gruppe">Charges through the field, and long careers</h2>
  <div class="raster">
    <section>
      <h2>Wins from the back of the grid</h2>
      <p class="hinweis">The grid position the race was won from.</p>
      <ol class="rangliste breit">
        {aufholjagden.map((e) => (
          <li>
            <span>
              <a href={pfad.fahrer(e.driverId)}>{e.name}</a>
              <i><a class="leise" href={pfad.rennen(e.raceId)}>{e.rennen}</a></i>
            </span>
            <b>P{e.wert}</b>
          </li>
        ))}
      </ol>
    </section>

    <section>
      <h2>Most positions gained in a race</h2>
      <p class="hinweis">Grid position minus finishing position, classified races only.</p>
      <ol class="rangliste breit">
        {plaetze.map((e) => (
          <li>
            <span>
              <a href={pfad.fahrer(e.driverId)}>{e.name}</a>
              <i><a class="leise" href={pfad.rennen(e.raceId)}>{e.rennen}</a></i>
            </span>
            <b>+{e.wert}</b>
          </li>
        ))}
      </ol>
    </section>

    <section>
      <h2>Longest careers</h2>
      <p class="hinweis">From the first start to the last, breaks included.</p>
      <ol class="rangliste breit">
        {karrieren.map((e) => (
          <li>
            <span>
              <a href={pfad.fahrer(e.driverId)}>{e.name}</a>
              <i>{e.rennen}</i>
            </span>
            <b>{jahreSpanne(e.wert)}</b>
          </li>
        ))}
      </ol>
    </section>

    <section>
      <h2>Longest gap between wins</h2>
      <ol class="rangliste breit">
        {pausen.map((e) => (
          <li>
            <span>
              <a href={pfad.fahrer(e.driverId)}>{e.name}</a>
              <i><a class="leise" href={pfad.rennen(e.raceId)}>{e.rennen}</a></i>
            </span>
            <b>{jahreSpanne(e.wert)}</b>
          </li>
        ))}
      </ol>
    </section>
  </div>

  <h2 class="gruppe">Teams</h2>
  <div class="raster">
    <section>
      <h2>Most wins</h2>
      <ol class="rangliste">
        {teamSiege.map((t) => (
          <li><a href={pfad.team(t.id)}>{t.name}</a><b>{t.wert}</b></li>
        ))}
      </ol>
    </section>
    <section>
      <h2>Most constructors' titles</h2>
      <ol class="rangliste">
        {teamTitel.map((t) => (
          <li><a href={pfad.team(t.id)}>{t.name}</a><b>{t.wert}</b></li>
        ))}
      </ol>
    </section>
  </div>
</Seite>

<style>
  .raster {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(19rem, 100%), 1fr));
    gap: 1.25rem 2rem;
    margin-top: 1.5rem;
  }

  section { min-width: 0; }

  h2 {
    font-size: 1.02rem;
    margin: 0 0 0.5rem;
  }

  h2.gruppe {
    margin: 3rem 0 0;
    padding-top: 1.25rem;
    border-top: 2px solid var(--border);
    font-size: 1.3rem;
  }

  h2.gruppe + .lead { margin-top: 0.4rem; }

  /* Eine Anmerkung zur Herkunft einer Zahl – leiser als ein Hinweis. */
  .quelle {
    max-width: 46rem;
    margin: 1rem 0 0;
    font-size: 0.79rem;
    color: var(--muted);
    text-wrap: pretty;
  }

  .hinweis {
    margin: 0 0 0.5rem;
    font-size: 0.76rem;
    color: var(--muted);
    text-wrap: pretty;
  }

  .rangliste { margin: 0; padding: 0; list-style: none; counter-reset: rang; }

  .rangliste li {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.38rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.88rem;
  }

  .rangliste li::before {
    counter-increment: rang;
    content: counter(rang);
    min-width: 1.15rem;
    flex: none;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    font-size: 0.76rem;
  }

  .rangliste span { flex: 1; min-width: 0; display: grid; }
  .rangliste > li > a { flex: 1; min-width: 0; }

  .rangliste a {
    color: var(--ink);
    text-decoration: none;
    font-weight: 550;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .rangliste a:hover { color: var(--accent); }

  .rangliste i {
    font-style: normal;
    font-size: 0.75rem;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .rangliste i a.leise { color: var(--muted); font-weight: 400; }
  .rangliste i a.leise:hover { color: var(--accent); }

  .rangliste b {
    flex: none;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    font-weight: 650;
  }

  /* Die erste Zeile jeder Liste ist der Rekord – sie trägt die Akzentfarbe. */
  .rangliste li:first-child b { color: var(--accent); }
</style>
