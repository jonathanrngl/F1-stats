---
import { alter, raenge, sekunden, zahl } from '../../lib/format.js'
import Seite from '../../layouts/Seite.astro'
import Sprung from '../../components/Sprung.astro'
import Wahl from '../../components/Wahl.astro'
import { pfad, db } from '../../lib/db.js'
import {
  altersrekord, altersrekordMeister, groessteAufholjagden, laengsteKarrieren,
  laengstePauseZwischenSiegen, laengsteSerien, meistePlaetzeGutgemacht, meistePodien,
  meistePoles, meistePunkte, meisteSchnellsteRunden, meisteSiege, meisteStarts,
  meisteTitel, teamRekorde, grandSlams, zielabstand,
} from '../../engine/records.js'

const d = db()
const N = 10

const slams = grandSlams(d, N)
const knapp = zielabstand(d, 'knapp', N)
const weit = zielabstand(d, 'weit', N)

const ganz = (v) => zahl(Math.round(v))
const jahreSpanne = (v) => `${zahl(Math.round(v * 10) / 10)} years`

/*
 * Die Karrierewerte je Ära. „Die meisten Siege“ ist über 76 Jahre eine Frage
 * der Kalenderlänge – Fangio fuhr 51 Rennen, Hamilton über 350. Innerhalb
 * einer Ära vergleicht man Gleiches mit Gleichem, und die Frage „wer war in
 * den 1980ern der Beste“ bekommt eine eigene Antwort.
 *
 * Gezählt wird, was im Zeitraum geschah, nicht die Karrieresumme derer, die
 * darin fuhren.
 */
const AEREN = [
  { wert: 'alle', label: 'All time' },
  { wert: '1950', label: '1950–1969', von: 1950, bis: 1969 },
  { wert: '1970', label: '1970–1989', von: 1970, bis: 1989 },
  { wert: '1990', label: '1990–2009', von: 1990, bis: 2009 },
  { wert: '2010', label: 'Since 2010', von: 2010 },
]

/*
 * Jeder Block nennt seine eigene Einheit und, wo nötig, seine Einschränkung.
 * Eine Bestenliste ohne Angabe, worüber sie zählt, ist eine Zahlenwand.
 */
const bloecke = (z) => [
  { titel: 'Most wins', liste: meisteSiege(d, N, z), format: ganz },
  { titel: 'Most podiums', liste: meistePodien(d, N, z), format: ganz },
  {
    titel: 'Most pole positions',
    liste: meistePoles(d, N, z),
    format: ganz,
    hinweis: 'Fastest time in qualifying – not the grid position, which penalties shift.',
  },
  {
    titel: 'Most starts',
    liste: meisteStarts(d, N, z),
    format: ganz,
    hinweis: 'Starts are counted, not entries: a driver who did not qualify was not in the race.',
  },
  { titel: 'Most fastest laps', liste: meisteSchnellsteRunden(d, N, z), format: ganz },
  { titel: 'Most World Championships', liste: meisteTitel(d, N, z), format: ganz },
  {
    titel: 'Most points scored in races',
    liste: meistePunkte(d, N, z),
    format: ganz,
    hinweis:
      'Comparable only up to a point: the race points scale has changed seven times since 1950, and until 1990 some of the points lapsed as dropped scores.',
  },
]
const jeAera = AEREN.map((a) => ({ ...a, bloecke: bloecke({ von: a.von, bis: a.bis }) }))

const serien = [
  { titel: 'Longest winning streak', liste: laengsteSerien(d, 'siege', N) },
  { titel: 'Longest podium streak', liste: laengsteSerien(d, 'podien', N) },
  { titel: 'Longest points-scoring streak', liste: laengsteSerien(d, 'punkte', N) },
  { titel: 'Longest finishing streak', liste: laengsteSerien(d, 'zielankuenfte', N) },
]

const altersListen = [
  { titel: 'Youngest winners', liste: altersrekord(d, 'sieg', 'jung', N) },
  { titel: 'Oldest winners', liste: altersrekord(d, 'sieg', 'alt', N) },
  { titel: 'Youngest pole-sitters', liste: altersrekord(d, 'pole', 'jung', N) },
  { titel: 'Youngest World Champions', liste: altersrekordMeister(d, 'jung', N) },
  { titel: 'Oldest World Champions', liste: altersrekordMeister(d, 'alt', N) },
]

const aufholjagden = groessteAufholjagden(d, N)
const plaetze = meistePlaetzeGutgemacht(d, N)
const karrieren = laengsteKarrieren(d, N)
const pausen = laengstePauseZwischenSiegen(d, N)

const teamSiege = teamRekorde(d, 'siege', N)
const teamTitel = teamRekorde(d, 'titel', N)

/** Gleich ist beim Alter derselbe Tag, nicht derselbe Bruchteil eines Jahres. */
const tage = (e) => e.alter.jahre * 400 + e.alter.tage

const ziele = [
  { id: 'fahrer', label: 'Career totals' },
  { id: 'serien', label: 'Streaks' },
  { id: 'abstaende', label: 'Winning margins' },
  { id: 'alter', label: 'Age' },
  { id: 'aufholjagden', label: 'Charges & careers' },
  { id: 'teams', label: 'Teams' },
]
---

<Seite
  titel="Formula 1 records – the records set since 1950"
  kopf="Records"
  beschreibung="Most wins, podiums and pole positions, all time or by era, longest streaks, youngest and oldest record holders – every entry linked to the race."
>
  <header class="seitenkopf">
    <div>
      <p class="oberzeile">Analysis</p>
      <h1>Records</h1>
      <p class="lead">
        Every all-time mark since 1950, computed from the race results rather than copied out of
        a curated list. Each entry links to the driver and, where there is one, to the race.
        Equal values share a rank: “=1” means joint first.
      </p>
    </div>
  </header>

  <Sprung ziele={ziele} />

  <section class="abschnitt" id="fahrer">
    <div class="abschnitt-kopf">
      <div>
        <h2>Career totals</h2>
        <p>All time, or only what happened within one era.</p>
      </div>
    </div>
    <Wahl name="aera" legende="Era" optionen={AEREN} vorwahl="alle" />
    {jeAera.map((a) => (
      <div class="raster" data-wahl="aera" data-wahl-wert={a.wert} hidden={a.wert !== 'alle'}>
        {a.bloecke.map((b) => (
          <div class="rangkarte">
            <h3>{b.titel}{a.von && <span class="sr-only">, {a.label}</span>}</h3>
            {b.hinweis && <p class="unter">{b.hinweis}</p>}
            <ol class="rangliste">
              {raenge(b.liste).map((e) => (
                <li data-rang={e.rang} class={e.vorn ? 'vorn' : undefined}>
                  <a href={pfad.fahrer(e.driverId)}>{e.name}</a>
                  <b>{b.format(e.wert)}</b>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    ))}
  </section>

  <section class="abschnitt" id="serien">
    <div class="abschnitt-kopf">
      <div>
        <h2>Streaks</h2>
        <p>Unbroken runs across a driver's starts. A race missed does not break a streak – a driver who was not there had nothing to lose.</p>
      </div>
    </div>
    <div class="raster">
      {serien.map((s) => (
        <div class="rangkarte">
          <h3>{s.titel}</h3>
          <ol class="rangliste">
            {raenge(s.liste).map((e) => (
              <li data-rang={e.rang} class={e.vorn ? 'vorn' : undefined}>
                <span class="wer">
                  <a href={pfad.fahrer(e.driverId)}>{e.name}</a>
                  <i>{e.rennen}</i>
                </span>
                <b>{e.wert}</b>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </section>

  <section class="abschnitt" id="abstaende">
    <div class="abschnitt-kopf">
      <div>
        <h2>Winning margins</h2>
        <p>The gap to the second-placed car. Races that ended a lap or more apart have no gap in seconds and are left out.</p>
      </div>
    </div>
    <div class="raster">
      <div class="rangkarte">
        <h3>Closest finishes</h3>
        <ol class="rangliste">
          {raenge(knapp).map((e) => (
            <li data-rang={e.rang} class={e.vorn ? 'vorn' : undefined}>
              <span class="wer">
                <a href={pfad.fahrer(e.driverId)}>{e.name}</a>
                <i><a href={pfad.rennen(e.raceId)}>{e.rennen}</a></i>
              </span>
              <b>{sekunden(e.wert)}</b>
            </li>
          ))}
        </ol>
      </div>

      <div class="rangkarte">
        <h3>Biggest winning margins</h3>
        <ol class="rangliste">
          {raenge(weit).map((e) => (
            <li data-rang={e.rang} class={e.vorn ? 'vorn' : undefined}>
              <span class="wer">
                <a href={pfad.fahrer(e.driverId)}>{e.name}</a>
                <i><a href={pfad.rennen(e.raceId)}>{e.rennen}</a></i>
              </span>
              <b>{sekunden(e.wert)}</b>
            </li>
          ))}
        </ol>
      </div>

      <div class="rangkarte">
        <h3>Grand Slams</h3>
        <p class="unter">Pole position, win, fastest lap and every lap led – all in one race.</p>
        <ol class="rangliste">
          {raenge(slams).map((e) => (
            <li data-rang={e.rang} class={e.vorn ? 'vorn' : undefined}>
              <span class="wer">
                <a href={pfad.fahrer(e.driverId)}>{e.name}</a>
                <i>Latest: <a href={pfad.rennen(e.raceId)}>{e.rennen}</a></i>
              </span>
              <b>{e.wert}</b>
            </li>
          ))}
        </ol>
      </div>
    </div>
    <p class="fussnote">
      The Grand Slam is the one figure on this page that is not recalculated here: “led every
      lap” appears in no result row, and lap data exists only for part of the races since 1996.
      It is taken from F1DB as it stands.
    </p>
  </section>

  <section class="abschnitt" id="alter">
    <div class="abschnitt-kopf">
      <div>
        <h2>Age</h2>
        <p>
          Exact to the day: full years, then the days since the last birthday. Drivers whose date
          of birth is not recorded are missing from these lists – a missing date is not an age of
          zero.
        </p>
      </div>
    </div>
    <div class="raster">
      {altersListen.map((a) => (
        <div class="rangkarte">
          <h3>{a.titel}</h3>
          <ol class="rangliste">
            {raenge(a.liste, tage).map((e) => (
              <li data-rang={e.rang} class={e.vorn ? 'vorn' : undefined}>
                <span class="wer">
                  <a href={pfad.fahrer(e.driverId)}>{e.name}</a>
                  <i>{e.raceId ? <a href={pfad.rennen(e.raceId)}>{e.rennen}</a> : e.rennen}</i>
                </span>
                <b>{alter(e.alter)}</b>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
    <p class="fussnote">“18y 228d” reads as 18 years and 228 days.</p>
  </section>

  <section class="abschnitt" id="aufholjagden">
    <div class="abschnitt-kopf">
      <div>
        <h2>Charges through the field, and long careers</h2>
        <p>
          Formula 1 races only. The Indianapolis 500 started 33 cars, where thirty places made up
          was routine – it would otherwise fill eight of the ten places for positions gained.
        </p>
      </div>
    </div>
    <div class="raster">
      <div class="rangkarte">
        <h3>Wins from the back of the grid</h3>
        <p class="unter">The grid position the race was won from.</p>
        <ol class="rangliste">
          {raenge(aufholjagden).map((e) => (
            <li data-rang={e.rang} class={e.vorn ? 'vorn' : undefined}>
              <span class="wer">
                <a href={pfad.fahrer(e.driverId)}>{e.name}</a>
                <i><a href={pfad.rennen(e.raceId)}>{e.rennen}</a></i>
              </span>
              <b>P{e.wert}</b>
            </li>
          ))}
        </ol>
      </div>

      <div class="rangkarte">
        <h3>Most positions gained in a race</h3>
        <p class="unter">Grid position minus finishing position, classified races only.</p>
        <ol class="rangliste">
          {raenge(plaetze).map((e) => (
            <li data-rang={e.rang} class={e.vorn ? 'vorn' : undefined}>
              <span class="wer">
                <a href={pfad.fahrer(e.driverId)}>{e.name}</a>
                <i><a href={pfad.rennen(e.raceId)}>{e.rennen}</a></i>
              </span>
              <b>+{e.wert}</b>
            </li>
          ))}
        </ol>
      </div>

      <div class="rangkarte">
        <h3>Longest careers</h3>
        <p class="unter">From the first start to the last, breaks included.</p>
        <ol class="rangliste">
          {raenge(karrieren).map((e) => (
            <li data-rang={e.rang} class={e.vorn ? 'vorn' : undefined}>
              <span class="wer">
                <a href={pfad.fahrer(e.driverId)}>{e.name}</a>
                <i>{e.rennen}</i>
              </span>
              <b>{jahreSpanne(e.wert)}</b>
            </li>
          ))}
        </ol>
      </div>

      <div class="rangkarte">
        <h3>Longest gap between wins</h3>
        <ol class="rangliste">
          {raenge(pausen).map((e) => (
            <li data-rang={e.rang} class={e.vorn ? 'vorn' : undefined}>
              <span class="wer">
                <a href={pfad.fahrer(e.driverId)}>{e.name}</a>
                <i><a href={pfad.rennen(e.raceId)}>{e.rennen}</a></i>
              </span>
              <b>{jahreSpanne(e.wert)}</b>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="abschnitt" id="teams">
    <div class="abschnitt-kopf"><div><h2>Teams</h2></div></div>
    <div class="raster">
      <div class="rangkarte">
        <h3>Most wins</h3>
        <ol class="rangliste">
          {raenge(teamSiege).map((t) => (
            <li data-rang={t.rang} class={t.vorn ? 'vorn' : undefined}><a href={pfad.team(t.id)}>{t.name}</a><b>{t.wert}</b></li>
          ))}
        </ol>
      </div>
      <div class="rangkarte">
        <h3>Most constructors' titles</h3>
        <ol class="rangliste">
          {raenge(teamTitel).map((t) => (
            <li data-rang={t.rang} class={t.vorn ? 'vorn' : undefined}><a href={pfad.team(t.id)}>{t.name}</a><b>{t.wert}</b></li>
          ))}
        </ol>
      </div>
    </div>
  </section>
</Seite>

<style>
  .raster {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(21rem, 100%), 1fr));
    gap: 1rem;
  }

  .raster[hidden] { display: none; }
</style>
