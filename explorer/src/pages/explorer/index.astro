---
import { gzipSync } from 'node:zlib'
import Seite from '../../layouts/Seite.astro'
import Explorer from '../../components/Explorer.jsx'
import { eine, pfad } from '../../lib/db.js'
import { wuerfel } from '../../lib/wuerfel.js'

const z = eine('SELECT COUNT(*) AS n FROM race_result')

/*
 * Wie groß der Datensatz wirklich ist, gemessen beim Bauen: Hier stand „130 KB“,
 * als er längst größer war. Gepackt, weil es das ist, was über die Leitung geht.
 */
const kb = Math.round(gzipSync(JSON.stringify(wuerfel())).length / 1024)
const groesse = `about ${kb} KB`

/*
 * Beispiele als Links: Jeder öffnet den Explorer mit genau dieser Abfrage.
 * Die Adressen sind dieselben, die der Explorer selbst schreibt.
 */
const BEISPIELE = [
  { frage: 'Who has the most wins at Monaco?', wie: 'Group by Driver, filter Circuit: Monaco, sort by wins.', q: { strecke: 'monaco' } },
  {
    frage: 'All drivers from 2000 to today with at least five wins and twenty podiums',
    wie: 'Group by Driver, year from 2000, conditions: wins at least 5, podiums at least 20.',
    q: { von: '2000', b: 'siege>=5,podien>=20' },
  },
  {
    frage: 'Which drivers have won from outside the top ten on the grid?',
    wie: 'Group by Driver, tick “wins from outside the top ten on the grid only”.',
    q: { hinten: '1' },
  },
  {
    frage: 'Which season had the most different winners?',
    wie: 'Group by Season, sort by “Different winners”.',
    q: { d: 'saison', k: 'starts,siege,verschiedeneSieger', s: 'verschiedeneSieger' },
  },
  {
    frage: 'Who has scored the most points for Ferrari?',
    wie: 'Group by Driver, filter Team: Ferrari, sort by points.',
    q: { team: 'ferrari', s: 'punkte' },
  },
  {
    frage: 'Who scored the highest share of the points on offer, era for era?',
    wie: 'Sort by “Share of possible points”, with at least 50 starts. A win was 9 points in 1955 and 26 in 2024, and this share evens that out.',
    q: { k: 'starts,siege,punkte,normiert', s: 'normiert', b: 'starts>=50' },
  },
]
---

<Seite
  titel="Statistics Explorer: your own queries across Formula 1 history"
  beschreibung={`Freely combinable queries across ${z.n.toLocaleString('en-GB')} result rows: group, filter, sort, share as a link, export.`}
>
  <header class="seitenkopf">
    <div>
      <div class="titelblock">
        <h1>Explorer</h1>
        <p class="lead">
          Choose what to count and how to group it, across {z.n.toLocaleString('en-GB')} result
          rows since 1950. The query is kept in the address, so a result can be shared as a link.
        </p>
      </div>
    </div>
  </header>

  {/* Zugeklappt wie jede Erklärung (.erklaerung in theme.css): Wer fragen will, fragt. */}
  <details class="erklaerung beispiele">
    <summary>Example questions and how to ask them</summary>
    <div>
      <dl>
        {BEISPIELE.map((b) => (
          <>
            <dt><a href={`${pfad.seite('/explorer/')}?${new URLSearchParams(b.q)}`}>{b.frage}</a></dt>
            <dd>{b.wie}</dd>
          </>
        ))}
      </dl>
    </div>
  </details>

  <p class="hinweis nur-ohne-js">
    The Explorer runs in your browser and needs JavaScript. Everything it counts is also on the
    static pages: start from the <a href={pfad.seite('/records/')}>records</a>, a
    {' '}<a href={pfad.seite('/seasons/')}>season</a> or a <a href={pfad.seite('/drivers/')}>driver</a>.
  </p>

  <div class="nur-mit-js explorer-insel">
    <Explorer client:load groesse={groesse} />
  </div>
</Seite>

<style is:global>
  .erklaerung.beispiele { margin: 0 0 var(--abstand-6); }
  .beispiele dl { display: grid; gap: var(--abstand-3); margin: var(--abstand-2) 0 0; }
  .beispiele dt { font-size: var(--text-3); font-weight: 600; }
  .beispiele dd { margin: var(--abstand-1) 0 0; font-size: var(--text-2); color: var(--muted); text-wrap: pretty; }

  /*
   * Die Bedienung steht auf dem Grund, in Gruppen ohne Kasten: Beschriftung,
   * darunter die Wahl. Gewählt heißt gefüllt in Tinte (.wahl-chip in theme.css).
   */
  .steuerung { display: grid; gap: var(--abstand-5); }

  .steuerung fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: none;
  }

  .steuerung legend {
    margin-bottom: var(--abstand-2);
    padding: 0;
    font-size: var(--text-2);
    font-weight: 600;
    color: var(--muted);
  }

  .felder {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(11rem, 100%), 1fr));
    gap: var(--abstand-2) var(--abstand-3);
  }

  .felder label { display: grid; gap: var(--abstand-1); font-size: var(--text-2); color: var(--muted); }

  .felder input,
  .felder select,
  .bedingung input,
  .bedingung select {
    min-width: 0;
    min-height: 2.25rem;
    padding: var(--abstand-1) var(--abstand-2);
    font: inherit;
    font-size: var(--text-2);
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--border-input);
    border-radius: var(--radius);
  }

  .bedingungen { display: grid; gap: var(--abstand-2); margin-top: var(--abstand-3); justify-items: start; }
  .bedingung { display: flex; flex-wrap: wrap; gap: var(--abstand-2); align-items: center; }
  .bedingung input { width: 6rem; }

  .schalter { display: flex; flex-wrap: wrap; gap: var(--abstand-2) var(--abstand-5); margin-top: var(--abstand-3); }
  .schalter label { display: flex; align-items: center; gap: var(--abstand-2); min-height: 2rem; font-size: var(--text-2); color: var(--ink-2); }
  .schalter input { width: 1.1rem; height: 1.1rem; margin: 0; accent-color: var(--ink); }

  .kopfzeile {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--abstand-3);
    margin-top: var(--abstand-6);
  }

  .kopfzeile p { margin: 0; color: var(--muted); }
  .kopfzeile b { color: var(--ink); font-variant-numeric: tabular-nums; }

  .beschreibung { max-width: var(--mass); margin: var(--abstand-2) 0 var(--abstand-4); color: var(--ink-2); text-wrap: pretty; }

  /* Leise Knöpfe wie .knopf.leise in theme.css, eine Stufe kleiner. */
  .export { display: flex; flex-wrap: wrap; gap: var(--abstand-1); }

  .export button {
    min-height: 2.25rem;
    padding: var(--abstand-1) var(--abstand-3);
    font: inherit;
    font-size: var(--text-2);
    font-weight: 600;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--border-input);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .export button:hover { background: var(--surface-2); border-color: var(--ink); }

  /* Namen in der Tabelle: Verweise in Tinte, der Strich kommt mit dem Zeiger (wie a.zeile). */
  .explorer td a { color: var(--ink); font-weight: 600; text-decoration: none; }
  .explorer td a:hover,
  .explorer td a:focus-visible { text-decoration: underline; text-decoration-thickness: 2px; text-decoration-color: var(--lackierung-linie); }

  .mehr-zeilen { margin-top: var(--abstand-3); font-size: var(--text-2); color: var(--muted); }

  .explorer .hinweis { margin: var(--abstand-4) 0; }
  .explorer-insel .status { margin: 0; color: var(--muted); }

  /* Ein Fehler ist eine blaue Flagge wie jeder Hinweis – Rot heißt hier „Ausfall“. */
  .explorer-insel .fehler {
    max-width: 50rem;
    margin: 0;
    padding: var(--abstand-3) var(--abstand-4);
    color: var(--ink-2);
    background: var(--surface);
    border-left: 4px solid var(--flagge-blau);
    text-wrap: pretty;
  }
</style>

<style is:global>
  /* Die Frage in eigenen Worten: ein Feld und die eine Hauptaktion der Seite, gefüllt in Tinte. */
  .frage { margin-bottom: var(--abstand-6); }

  .frage > label {
    display: block;
    margin-bottom: var(--abstand-2);
    font-size: var(--text-2);
    font-weight: 600;
    color: var(--muted);
  }

  .frage .zeile { display: flex; gap: var(--abstand-2); max-width: 46rem; }

  .frage input {
    flex: 1;
    min-width: 0;
    min-height: 2.75rem;
    padding: var(--abstand-2) var(--abstand-3);
    font: inherit;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--border-input);
    border-radius: var(--radius);
    appearance: none;
  }

  .frage input:hover { border-color: var(--ink); }
  .frage input:focus-visible { border-color: var(--ink); outline: 2px solid var(--ink); outline-offset: 1px; }

  .frage button {
    flex: none;
    padding: var(--abstand-2) var(--abstand-4);
    font: inherit;
    font-weight: 650;
    color: var(--plane);
    background: var(--ink);
    border: 1px solid var(--ink);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .frage button:hover { background: var(--ink-2); border-color: var(--ink-2); }

  .verstanden { max-width: var(--mass); margin-top: var(--abstand-3); }
  .verstanden p { margin: 0 0 var(--abstand-1); color: var(--ink-2); }
  .verstanden ul { margin: 0 0 var(--abstand-2); padding-left: var(--abstand-5); }
  .verstanden li { color: var(--ink); }
  .verstanden li span { color: var(--muted); }
  .verstanden b { color: var(--ink); }
  .verstanden .luecke { color: var(--warn); font-weight: 600; }
  .verstanden .quelle { font-size: var(--text-2); color: var(--muted); text-wrap: pretty; }
</style>

<style is:global>
  /*
   * Das Ergebnis als Bild (ErgebnisBild.jsx): eine Reihe, in Tinte, die Reihe
   * unter dem Zeiger etwas heller. Keine Legende – die Überschrift nennt die
   * Kennzahl. Global, weil React die Elemente erzeugt.
   */
  .ergebnisbild {
    margin: 0 0 var(--abstand-4);
    padding: var(--abstand-4) var(--abstand-4) var(--abstand-3);
    background: var(--surface);
  }

  .ergebnisbild figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--abstand-1) var(--abstand-4);
    margin-bottom: var(--abstand-2);
    font-size: var(--text-2);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .ergebnisbild figcaption b { color: var(--ink); font-weight: 650; }
  .ergebnisbild svg { display: block; overflow: visible; }
  .ergebnisbild .treffer { fill: transparent; }
  .ergebnisbild .balken { fill: var(--ink); }
  .ergebnisbild .reihe.an .balken { fill: var(--ink-2); }
  .ergebnisbild .reihe.an .treffer { fill: var(--surface-2); }
  .ergebnisbild .name { font-size: var(--text-1); font-weight: 600; fill: var(--ink); }
  /* Ein Name ist ein Verweis wie in der Tabelle: ohne Strich, der kommt mit dem Zeiger. */
  .ergebnisbild .name a { fill: var(--ink); text-decoration: none; }
  .ergebnisbild .name a:hover,
  .ergebnisbild .name a:focus-visible { text-decoration: underline; }
  .ergebnisbild .wert { font-size: var(--text-1); font-stretch: var(--schmal); font-weight: 650; fill: var(--ink-2); font-variant-numeric: tabular-nums; }
  .ergebnisbild .achse { font-size: var(--text-1); font-stretch: var(--schmal); fill: var(--muted); font-variant-numeric: tabular-nums; }
  .ergebnisbild .gitter { stroke: var(--grid); }
  /* Die Achse und die Null in Tinte, wie auf dem Monitor. */
  .ergebnisbild .grundlinie, .ergebnisbild .null { stroke: var(--ink); }
</style>
