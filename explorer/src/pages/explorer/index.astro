---
import Seite from '../../layouts/Seite.astro'
import Explorer from '../../components/Explorer.jsx'
import { eine } from '../../lib/db.js'

const z = eine('SELECT COUNT(*) AS n FROM race_result')
---

<Seite
  titel="Statistik-Explorer – eigene Abfragen über die ganze F1-Geschichte"
  beschreibung="Frei kombinierbare Abfragen über 27.599 Ergebniszeilen: gruppieren, filtern, sortieren, exportieren."
>
  <h1>Explorer</h1>
  <p class="lead">
    Eigene Abfragen über {z.n.toLocaleString('de-DE')} Ergebniszeilen seit 1950. Wähle, worüber
    gezählt wird und was gezählt wird – das Ergebnis steht sofort, weil der ganze Bestand im
    Browser liegt und keine Anfrage nötig ist.
  </p>

  <details class="beispiele">
    <summary>Beispielfragen und wie man sie stellt</summary>
    <dl>
      <dt>Wer hat die meisten Siege in Monaco?</dt>
      <dd>Gruppieren nach <b>Fahrer</b>, Filter <b>Strecke: Monaco</b>, sortieren nach Siegen.</dd>
      <dt>Alle Fahrer von 2000 bis heute mit mindestens fünf Siegen und zwanzig Podien</dt>
      <dd>Gruppieren nach <b>Fahrer</b>, Jahr von <b>2000</b>, <b>min. Siege 5</b>, <b>min. Podien 20</b>.</dd>
      <dt>Welche Fahrer haben von außerhalb der ersten zehn gewonnen?</dt>
      <dd>Gruppieren nach <b>Fahrer</b>, Schalter <b>nur Siege von jenseits Startplatz 10</b>.</dd>
      <dt>Welche Saison hatte die meisten verschiedenen Sieger?</dt>
      <dd>Gruppieren nach <b>Saison</b>, Schalter <b>nur Siege</b>, sortieren nach Starts.</dd>
      <dt>Wer hat für Ferrari die meisten Punkte geholt?</dt>
      <dd>Gruppieren nach <b>Fahrer</b>, Filter <b>Team: Ferrari</b>, sortieren nach Punkten.</dd>
    </dl>
  </details>

  <Explorer client:load />
</Seite>

<style is:global>
  .beispiele {
    margin-top: 1.5rem;
    padding: 0.85rem 1rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 0.6rem;
  }

  .beispiele summary { cursor: pointer; font-size: 0.88rem; font-weight: 600; color: var(--ink); }
  .beispiele dl { margin: 0.85rem 0 0; display: grid; gap: 0.6rem; }
  .beispiele dt { font-size: 0.88rem; color: var(--ink); font-weight: 550; }
  .beispiele dd { margin: 0.15rem 0 0; font-size: 0.83rem; color: var(--muted); }
  .beispiele b { color: var(--ink-2); font-weight: 600; }

  .explorer { margin-top: 1.75rem; }

  .steuerung { display: grid; gap: 1rem; }

  .steuerung fieldset {
    margin: 0;
    padding: 0.8rem 1rem 0.9rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.6rem;
  }

  .steuerung legend {
    padding: 0 0.35rem;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .chips { display: flex; flex-wrap: wrap; gap: 0.35rem; }

  .chips button {
    padding: 0.3rem 0.7rem;
    font: inherit;
    font-size: 0.82rem;
    color: var(--ink-2);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
  }

  .chips button:hover { border-color: var(--accent); }
  .chips button.on { color: var(--accent); background: var(--accent-wash); border-color: var(--accent); }

  .felder {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(9rem, 100%), 1fr));
    gap: 0.6rem 0.8rem;
  }

  .felder label { display: grid; gap: 0.2rem; font-size: 0.74rem; color: var(--muted); }

  .felder input,
  .felder select {
    padding: 0.35rem 0.5rem;
    font: inherit;
    font-size: 0.85rem;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.35rem;
    min-width: 0;
  }

  .schalter { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; margin-top: 0.75rem; }
  .schalter label { display: flex; align-items: center; gap: 0.4rem; font-size: 0.83rem; color: var(--ink-2); }

  .kopfzeile {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .kopfzeile p { margin: 0; font-size: 0.86rem; color: var(--muted); }
  .kopfzeile b { color: var(--ink); font-variant-numeric: tabular-nums; }

  .export { display: flex; gap: 0.35rem; }

  .export button {
    padding: 0.3rem 0.8rem;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink-2);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.4rem;
    cursor: pointer;
  }

  .export button:hover { border-color: var(--accent); color: var(--accent); }

  .explorer th button {
    padding: 0;
    font: inherit;
    font-size: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: var(--muted);
    background: none;
    border: none;
    cursor: pointer;
  }

  .explorer th button:hover { color: var(--ink); }
  .explorer th button.sortiert { color: var(--accent); }
  .explorer th i { font-style: normal; margin-left: 0.2rem; }
  .explorer td a { color: var(--ink); font-weight: 600; text-decoration: none; }
  .explorer td a:hover { color: var(--accent); }

  .explorer .hinweis,
  .explorer .status,
  .explorer .fehler {
    margin-top: 1rem;
    padding: 0.8rem 1rem;
    font-size: 0.86rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
  }

  .explorer .fehler {
    color: var(--danger-fg);
    background: var(--danger-bg);
    border-color: var(--danger-border);
  }
</style>
