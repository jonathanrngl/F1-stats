---
/**
 * Vorschau auf das nächste Rennen.
 *
 * Die Seite ist statisch und hängt allein an den Daten: „Das nächste Rennen“
 * ist das erste ohne Ergebnis in der gepinnten F1DB-Fassung. Wie viele Tage
 * es noch sind, rechnet der Browser beim Ansehen (Countdown.astro); welche
 * Fassung dahintersteht, steht sichtbar darunter.
 */
import { datum, ein, km, plakette, prozent as proz, raenge, zahl } from '../../lib/format.js'
import Seite from '../../layouts/Seite.astro'
import Sprung from '../../components/Sprung.astro'
import Countdown from '../../components/Countdown.astro'
import { db, herkunft, pfad } from '../../lib/db.js'
import { land } from '../../lib/laender.js'
import {
  circuitLeaders, circuitRaces, circuitSpecialists, circuitStats, circuitTeamLeaders,
} from '../../engine/circuit.js'
import {
  feld, naechstesRennen, rekordeInReichweite, standVorRennen, streckenHistorie, titelKannFallen, zeitplan,
} from '../../engine/vorschau.js'

const rennen = naechstesRennen(db())
const quelle = herkunft()
const sessions = rennen ? zeitplan(db(), rennen.id) : []
/** Mit Uhrzeit als ISO-Zeitpunkt, sonst nur das Datum. */
const zeitpunkt = (s) => (s.zeit ? `${s.datum}T${s.zeit.slice(0, 5)}Z` : s.datum)

// Alles Weitere hängt am Rennen. Gibt es keines, bleibt die Seite eine
// ehrliche Leermeldung statt einer Halde aus Platzhaltern.
const stand = rennen ? standVorRennen(db(), rennen) : null
const dasFeld = stand ? feld(db(), stand.bezug.id) : []
const rekorde = rennen && dasFeld.length ? rekordeInReichweite(db(), rennen, dasFeld) : []

const historie = rennen ? streckenHistorie(db(), rennen.streckeId) : null
const sieger = rennen ? circuitLeaders(db(), rennen.streckeId, 'siege', 6) : []
const polesetter = rennen ? circuitLeaders(db(), rennen.streckeId, 'poles', 6) : []
const teamsHier = rennen ? circuitTeamLeaders(db(), rennen.streckeId, 6) : []
const zahlenHier = rennen ? circuitStats(db(), rennen.streckeId) : null
const spezialisten = rennen ? circuitSpecialists(db(), rennen.streckeId) : []
// Ohne Sieger ist ein Rennen nicht gefahren - darunter das anstehende selbst,
// das sonst als Zeile aus Gedankenstrichen in der eigenen Vorschau stuende.
const letzteHier = rennen
  ? circuitRaces(db(), rennen.streckeId).filter((r) => r.siegerId).slice(0, 5)
  : []

const heimat = rennen ? land(rennen.demonym, rennen.land, rennen.ioc) : null

const ART = { RACE: 'Permanent circuit', STREET: 'Street circuit', ROAD: 'Road course' }
const RICHTUNG = { CLOCKWISE: 'clockwise', ANTI_CLOCKWISE: 'anti-clockwise' }

/* Kann der Fahrertitel hier fallen? Die Rechnung und ihre Grenzen: vorschau.js. */
const fuehrender = stand?.fahrer?.[0] ?? null
const zweiter = stand?.fahrer?.[1] ?? null
const vorsprung = fuehrender && zweiter ? fuehrender.punkte - zweiter.punkte : null
const titelMoeglich = titelKannFallen(stand)

const rekordeNachFahrer = rekorde.reduce((karte, r) => {
  if (!karte.has(r.fahrer)) karte.set(r.fahrer, { name: r.name, punkte: [] })
  karte.get(r.fahrer).punkte.push(r)
  return karte
}, new Map())

const gpName = rennen ? (rennen.grandPrixVoll ?? `${rennen.grandPrix} Grand Prix`) : null
const titel = rennen ? `${gpName} ${rennen.jahr} – preview` : 'Race preview'

const ziele = rennen
  ? [
      sessions.length > 1 && { id: 'zeitplan', label: 'Schedule' },
      { id: 'strecke', label: 'The circuit' },
      historie?.rennen > 0 && { id: 'stark', label: 'Strong here' },
      stand && { id: 'wertung', label: 'Standings' },
      { id: 'marken', label: 'Marks within reach' },
    ].filter(Boolean)
  : []
---

<Seite
  titel={titel}
  beschreibung={
    rennen
      ? `Preview of the ${rennen.jahr} ${gpName} in ${rennen.ort ?? rennen.strecke}: schedule, circuit, championship standings and the marks within reach.`
      : 'Preview of the next Formula 1 race.'
  }
>
  {!rennen && (
    <>
      <header class="seitenkopf">
        <div>
          <p class="oberzeile">Next race</p>
          <h1>No preview</h1>
          <p class="lead">
            No race is still outstanding in the data. The season is over and next year’s
            calendar is not in the data yet
            {quelle.stand && <> – the most recent result is the {quelle.stand.grandPrix} on {datum(quelle.stand.datum)}</>}.
          </p>
        </div>
      </header>
      <p><a href={pfad.seite('/seasons/')}>To the seasons →</a></p>
    </>
  )}

  {rennen && (
    <>
      <header class="seitenkopf">
        <span class="wappen" title={heimat?.name}>{heimat?.code}</span>
        <div>
          <p class="oberzeile">
            <span>Next race</span>
            <span class="trenner">/</span>
            <span class="still">Round {rennen.runde} of {rennen.rennenImJahr}</span>
          </p>
          <h1>{gpName} {rennen.jahr}</h1>
          <ul class="eckdaten">
            <li><a href={pfad.strecke(rennen.streckeId)}>{rennen.strecke}</a></li>
            {rennen.ort && rennen.ort !== rennen.strecke && <li>{rennen.ort}</li>}
            <li>{datum(rennen.datum)}</li>
            {rennen.mitSprint === 1 && <li class="stark">Sprint weekend</li>}
          </ul>
        </div>
      </header>

      {/* Der Countdown: groß, weil er die Frage ist, mit der man hierher kommt. */}
      <div class="countdown">
        <div class="tage">
          <Countdown datum={rennen.datum} zeit={rennen.zeit} />
        </div>
        <p>
          The numbers on this page come from F1DB {quelle.version}
          {stand && !stand.vorsaison && `, up to round ${stand.bezug.runde} (${stand.bezug.grandPrix})`}.
          {rennen.offiziell && <> Officially: <i>{rennen.offiziell}</i>.</>}
        </p>
      </div>

      {titelMoeglich && (
        <p class="hinweis akzent">
          <b>The drivers’ title can be settled here.</b>{' '}
          {fuehrender.name} leads {zweiter.name} by {ein(vorsprung)} points. This weekend offers
          {' '}up to {stand.maxDiesesRennen}, and after it at most {stand.maxDanach} remain to be won.
          Whether that actually settles it depends on the result – the number says only that it
          is arithmetically possible.
        </p>
      )}

      <Sprung ziele={ziele} />

      {sessions.length > 1 && (
        <section class="abschnitt" id="zeitplan">
          <div class="abschnitt-kopf">
            <div>
              <h2>Weekend schedule</h2>
              <p>
                <span data-ortszeit-hinweis hidden>Times in your time zone.</span>
                <noscript>Times in UTC.</noscript>
              </p>
            </div>
          </div>
          <ol class="zeitplan">
            {sessions.map((s) => (
              <li class={s.rennen ? 'rennen' : undefined}>
                <span class="session">{s.name}</span>
                {s.zeit ? (
                  <time datetime={zeitpunkt(s)} data-ortszeit>{datum(s.datum)}, {s.zeit.slice(0, 5)} UTC</time>
                ) : (
                  <time datetime={s.datum}>{datum(s.datum)}</time>
                )}
              </li>
            ))}
          </ol>
        </section>
      )}

      <section class="abschnitt" id="strecke">
        <div class="abschnitt-kopf">
          <div>
            <h2>The circuit</h2>
            <p>
              {[
                rennen.streckeVoll && rennen.streckeVoll !== rennen.strecke ? rennen.streckeVoll : null,
                ART[rennen.art] ?? null,
                RICHTUNG[rennen.richtung] ?? null,
                historie?.rennen
                  ? `${historie.rennen} Formula 1 races here, ${historie.von}–${historie.bis}`
                  : 'First time on the Formula 1 calendar',
              ].filter(Boolean).join(' · ')}
            </p>
          </div>
          <a class="mehr" href={pfad.strecke(rennen.streckeId)}>Circuit page →</a>
        </div>
        <ul class="kacheln">
          <li><span>Lap length</span><b>{km(rennen.streckenlaenge ?? rennen.laenge)}</b></li>
          <li><span>Corners</span><b>{rennen.streckenkurven ?? rennen.kurven ?? '–'}</b></li>
          <li><span>Scheduled laps</span><b>{rennen.runden ?? '–'}</b></li>
          <li><span>Race distance</span><b>{rennen.distanz ? `${ein(rennen.distanz)} km` : '–'}</b></li>
          {historie?.rennen > 0 && (
            <>
              <li><span>Not classified</span><b>{proz(zahlenHier?.ausfallquote)}</b><i>of starts here</i></li>
              <li><span>Pole to win</span><b>{proz(zahlenHier?.poleZuSieg)}</b><i>pole-sitter won</i></li>
              <li><span>Winner's grid slot</span><b>{ein(zahlenHier?.mittlererSiegerStart?.value)}</b><i>on average</i></li>
            </>
          )}
        </ul>

        {zahlenHier?.groessteAufholjagd && (
          <p class="fussnote">
            Furthest charge to victory here:
            {' '}<a href={pfad.fahrer(zahlenHier.groessteAufholjagd.id)}>
              {zahlenHier.groessteAufholjagd.name}
            </a>{' '}
            {zahlenHier.groessteAufholjagd.year}, from grid position {zahlenHier.groessteAufholjagd.start}.
          </p>
        )}
      </section>

      {historie?.rennen > 0 && (
        <section class="abschnitt" id="stark">
          <div class="abschnitt-kopf"><div><h2>Who has been strong here</h2></div></div>
          <div class="spalten">
            <div class="rangkarte">
              <h3>Most wins</h3>
              <ol class="rangliste">
                {raenge(sieger, (s) => s.anzahl).map((s) => (
                  <li data-rang={s.rang} class={s.vorn ? 'vorn' : undefined}><a href={pfad.fahrer(s.id)}>{s.name}</a><b>{s.anzahl}</b></li>
                ))}
              </ol>
            </div>
            <div class="rangkarte">
              <h3>Most pole positions</h3>
              <ol class="rangliste">
                {raenge(polesetter, (s) => s.anzahl).map((s) => (
                  <li data-rang={s.rang} class={s.vorn ? 'vorn' : undefined}><a href={pfad.fahrer(s.id)}>{s.name}</a><b>{s.anzahl}</b></li>
                ))}
              </ol>
            </div>
            <div class="rangkarte">
              <h3>Most successful teams</h3>
              <ol class="rangliste">
                {raenge(teamsHier, (t) => t.anzahl).map((t) => (
                  <li data-rang={t.rang} class={t.vorn ? 'vorn' : undefined}><a href={pfad.team(t.id)}>{t.name}</a><b>{t.anzahl}</b></li>
                ))}
              </ol>
            </div>
          </div>

          <div class="spalten zwei unten">
            <div>
              <h3>Most recent races here</h3>
              <div class="tabelle">
                <table>
                  <thead>
                    <tr><th class="num">Year</th><th>Winner</th><th>Team</th><th class="num">Grid</th></tr>
                  </thead>
                  <tbody>
                    {letzteHier.map((r) => (
                      <tr>
                        <td class="num"><a class="zeile" href={pfad.rennen(r.id)}>{r.year}</a></td>
                        <td>{r.siegerId ? <a class="zeile" href={pfad.fahrer(r.siegerId)}>{r.sieger}</a> : '–'}</td>
                        <td class="leise">{r.siegerTeamId ? <a class="leise" href={pfad.team(r.siegerTeamId)}>{r.siegerTeam}</a> : '–'}</td>
                        <td class="num">{r.siegerStart ? <span class={plakette(r.siegerStart)}>{r.siegerStart}</span> : '–'}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>

            {spezialisten.length > 0 && (
              <div>
                <h3>Circuit specialists</h3>
                <div class="tabelle">
                  <table>
                    <thead>
                      <tr>
                        <th>Driver</th>
                        <th class="num">Here</th>
                        <th class="num">Elsewhere</th>
                        <th class="num"><abbr title="Places better here than elsewhere, on average">Better by</abbr></th>
                      </tr>
                    </thead>
                    <tbody>
                      {spezialisten.slice(0, 5).map((s) => (
                        <tr>
                          <td><a class="zeile" href={pfad.fahrer(s.id)}>{s.name}</a></td>
                          <td class="num">{ein(s.hier)}</td>
                          <td class="num leise">{ein(s.sonst)}</td>
                          <td class="num gut">+{ein(s.vorteil)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                <p class="fussnote">
                  Average finish here against the same driver's average everywhere else.
                </p>
              </div>
            )}
          </div>
        </section>
      )}

      {stand && (
        <section class="abschnitt" id="wertung">
          <div class="abschnitt-kopf">
            <div>
              <h2>Championship standings</h2>
              <p>
                {stand.vorsaison
                  ? `The ${rennen.jahr} season has no result yet. Shown are the final ${stand.bezug.jahr} standings.`
                  : `After round ${stand.bezug.runde} (${stand.bezug.grandPrix}) on ${datum(stand.bezug.datum)}.`}
                {' '}{stand.offen} races remain
                {stand.sprints > 0 && ` (${stand.sprints} with a sprint)`},
                so at most {stand.maxFuerEinenFahrer} points for any single driver.
              </p>
            </div>
          </div>

          <div class="wertungen">
            <div>
              <h3>Drivers</h3>
              <div class="tabelle">
                <table>
                  <thead>
                    <tr><th class="num">Pos</th><th>Driver</th><th>Team</th><th class="num">Points</th></tr>
                  </thead>
                  <tbody>
                    {stand.fahrer.map((f) => (
                      <tr>
                        <td class="num"><span class={plakette(f.position)}>{f.position ?? '–'}</span></td>
                        <td><a class="zeile" href={pfad.fahrer(f.id)}>{f.name}</a></td>
                        <td class="leise">{f.teamId ? <a class="leise" href={pfad.team(f.teamId)}>{f.team}</a> : '–'}</td>
                        <td class="num fett">{ein(f.punkte)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>

            <div>
              <h3>Constructors</h3>
              <div class="tabelle">
                <table>
                  <thead><tr><th class="num">Pos</th><th>Team</th><th class="num">Points</th></tr></thead>
                  <tbody>
                    {stand.teams.map((t) => (
                      <tr>
                        <td class="num"><span class={plakette(t.position)}>{t.position ?? '–'}</span></td>
                        <td><a class="zeile" href={pfad.team(t.id)}>{t.name}</a></td>
                        <td class="num fett">{ein(t.punkte)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </section>
      )}

      <section class="abschnitt" id="marken">
        <div class="abschnitt-kopf">
          <div>
            <h2>Marks within reach</h2>
            {rekordeNachFahrer.size > 0 && (
              <p>
                Only what this one race can move: round numbers in a career, the record at this
                circuit, and all-time lists where a single result is missing. For the
                {' '}{dasFeld.length} drivers who were on the grid most recently.
              </p>
            )}
          </div>
        </div>
        {rekordeNachFahrer.size === 0 ? (
          <p class="hinweis">
            No round number and no record is in the balance at this race –
            at least none that a single weekend could move.
          </p>
        ) : (
          <ul class="marken">
            {[...rekordeNachFahrer.entries()].map(([id, eintrag]) => (
              <li class="karte">
                <a class="zeile" href={pfad.fahrer(id)}>{eintrag.name}</a>
                <ul>
                  {eintrag.punkte.map((p) => (
                    <li class={p.art}>{p.text}</li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
        )}
      </section>
    </>
  )}
</Seite>

<style>
  .countdown {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    margin: 0 0 1.5rem;
    padding: 1.1rem 1.35rem;
    color: var(--kopf-muted);
    background: var(--kopf-bg);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius);
  }

  /*
   * :global, weil Zahl und Beschriftung aus Countdown.astro kommen – teils erst
   * vom Skript im Browser geschrieben, also ohne die Kennung dieser Seite.
   */
  .countdown .tage { flex: none; }
  .countdown .tage :global(.countdown-wert) { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem; }
  .countdown .tage :global(b) { font-size: 2.6rem; font-weight: 800; line-height: 1; letter-spacing: -0.04em; color: var(--kopf-ink); }
  .countdown .tage :global(span span) { font-size: 0.95rem; font-weight: 600; color: var(--kopf-ink); }
  .countdown p { flex: 1 1 22rem; margin: 0; font-size: 0.86rem; text-wrap: pretty; }

  /* Der Zeitplan: eine Zeile je Session, das Rennen hervorgehoben. */
  /*
   * auto-fit: Fünf Sessions füllen eine Reihe. Mit auto-fill und 15rem
   * standen vier oben und das Rennen – der Grund, warum man nachsieht – allein
   * darunter.
   */
  .zeitplan {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(10.5rem, 100%), 1fr));
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .zeitplan li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.7rem 0.9rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .zeitplan .session { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .zeitplan time { font-weight: 650; color: var(--ink); font-variant-numeric: tabular-nums; }
  .zeitplan .rennen { border-left: 4px solid var(--accent); }
  .zeitplan .rennen .session { color: var(--accent-strong); }

  /* Zwei Spalten am Telefon: Das Rennen als fünfte Karte bekommt die ganze Breite statt einer halben Zeile. */
  @media (max-width: 34rem) {
    .zeitplan .rennen:last-child:nth-child(odd) { grid-column: 1 / -1; }
  }

  .unten { margin-top: 1.25rem; }

  .wertungen {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: start;
    gap: 1.25rem;
  }

  @media (max-width: 60rem) {
    .wertungen { grid-template-columns: minmax(0, 1fr); }
  }

  .marken {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(20rem, 100%), 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .marken > li > ul { margin: 0.45rem 0 0; padding-left: 1.1rem; display: grid; gap: 0.2rem; }
  .marken > li > ul > li { font-size: 0.88rem; color: var(--ink-2); text-wrap: pretty; }
  /* Eine Bestmarke wiegt schwerer als eine runde Zahl - das darf man sehen. */
  .marken li.strecke, .marken li.bestenliste { color: var(--ink); font-weight: 600; }
  .marken li.strecke::marker, .marken li.bestenliste::marker { color: var(--accent); }
</style>
