---
/**
 * Gerüst jeder Seite: Kopfleiste mit Navigation, Inhalt, Fußzeile.
 *
 * Die Navigation steht oben links und ist auf jeder Seite dieselbe – sie
 * gehört zur Website, nicht zum Inhalt. Welcher Punkt aktiv ist, entscheidet
 * der Pfad, nicht ein übergebener Wert: So kann keine Seite vergessen, sich
 * selbst zu markieren.
 */
import '../styles/theme.css'
import Suche from '../components/Suche.astro'
import { MODUS_SKRIPT } from '../lib/modus.js'
import { herkunft } from '../lib/db.js'
import { datum } from '../lib/format.js'

/* Worauf die Zahlen beruhen – im Fuß jeder Seite, siehe herkunft() in db.js. */
const quelle = herkunft()

interface Props {
  titel: string
  beschreibung: string
  /**
   * Strukturierte Daten nach schema.org – eine Person, ein Rennen, eine
   * Brotkrumenleiste. Suchmaschinen lesen daraus, was die Seite ist.
   */
  strukturiert?: object[]
  /** Pfade für die Brotkrumen, vom Allgemeinen zum Besonderen, ohne die Seite selbst. */
  brotkrumen?: { name: string; pfad: string }[]
  /** Nicht in Suchmaschinen – für die Fehlerseite, die unter jeder falschen Adresse steht. */
  ohneIndex?: boolean
}

const { titel, beschreibung, strukturiert = [], brotkrumen = [], ohneIndex = false } = Astro.props

/*
 * Die Leiste zerfiel in zwei Arten von Punkten, und mit zwölf davon lief sie
 * über: Ab „Engines" waren „Compare" und „Explorer" bei 1280 px nicht mehr zu
 * sehen. Sie sind deshalb getrennt.
 *
 * NAV führt zu den Dingen selbst – Fahrer, Teams, Rennen. WERKZEUGE führt zu
 * dem, was man mit ihnen anstellt. Das ist keine Notlösung für zu wenig Platz,
 * sondern die Gliederung, die ohnehin bestand.
 */
const NAV = [
  { pfad: '/preview/', label: 'Next race' },
  { pfad: '/seasons/', label: 'Seasons' },
  { pfad: '/races/', label: 'Races' },
  { pfad: '/drivers/', label: 'Drivers' },
  { pfad: '/teams/', label: 'Teams' },
  { pfad: '/engines/', label: 'Engines' },
  { pfad: '/circuits/', label: 'Circuits' },
]

const WERKZEUGE = [
  { pfad: '/records/', label: 'Records', dazu: 'Every all-time mark, linked to its race' },
  { pfad: '/changes/', label: 'Changes', dazu: 'What has moved, and what is close' },
  { pfad: '/teammates/', label: 'Team-mates', dazu: 'Drivers rated against the same car' },
  { pfad: '/comparison/', label: 'Compare', dazu: 'Two careers side by side' },
  { pfad: '/explorer/', label: 'Explorer', dazu: 'Your own queries over every result' },
  { pfad: '/quiz/', label: 'Quiz', dazu: 'Test yourself, from easy to expert' },
]

/*
 * Der Vorsatz, unter dem die Seite liegt: auf GitHub Pages "/F1-stats/", beim
 * Entwickeln "/". Jeder seiteninterne Verweis trägt ihn.
 */
const BASIS = import.meta.env.BASE_URL.replace(/\/$/, '')

/*
 * Astro.url.pathname enthält den Vorsatz, die Einträge in NAV nicht. Erst
 * abschneiden, dann vergleichen – sonst wäre unter /F1-stats/ nie ein Punkt
 * aktiv.
 */
const hier = Astro.url.pathname.slice(BASIS.length) || '/'
/** Aktiv ist auch die Übersicht, wenn man auf einer ihrer Unterseiten steht. */
const istAktiv = (pfad: string) => hier === pfad || hier.startsWith(pfad)
const werkzeugAktiv = WERKZEUGE.some((w) => istAktiv(w.pfad))

/*
 * Titel und Adressen für Suchmaschinen und geteilte Links.
 *
 * Die Marke steht hinter jedem Titel außer dem der Startseite, die sie schon
 * trägt. Die kanonische Adresse ist die ohne Abfrage – der Explorer mit
 * ?strecke=monaco ist dieselbe Seite wie ohne.
 */
const MARKE = 'Formula 1 Statistics'
const istStart = hier === '/'
const seitentitel = istStart ? titel : `${titel} · ${MARKE}`
const kanonisch = new URL(Astro.url.pathname, Astro.site ?? 'https://jonathanrngl.github.io').href
const vorschaubild = new URL(`${BASIS}/og.png`, Astro.site ?? 'https://jonathanrngl.github.io').href

/*
 * JSON-LD: Die Brotkrumen kommen aus der Seite, Startseite vorn. Der Text
 * wird für ein <script> abgesichert – ein „</script>“ in einem Namen beendete
 * sonst den Block.
 */
const ld = [...strukturiert]
if (brotkrumen.length) {
  ld.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: 'Home', pfad: '/' }, ...brotkrumen, { name: titel.split(' – ')[0], pfad: hier }].map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.name,
      item: new URL(`${BASIS}${b.pfad}`, Astro.site ?? 'https://jonathanrngl.github.io').href,
    })),
  })
}
const ldText = ld.length ? JSON.stringify(ld.length === 1 ? ld[0] : ld).replace(/</g, '\\u003c') : null
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Fremde Ziele erfahren die Herkunft, nicht die besuchte Unterseite. */}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" type="image/svg+xml" href={`${BASIS}/favicon.svg`} />
    <meta name="theme-color" content="#111113" />
    <title>{seitentitel}</title>
    <meta name="description" content={beschreibung} />
    {ohneIndex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={kanonisch} />}
    <link rel="sitemap" type="application/xml" href={`${BASIS}/sitemap.xml`} />
    <link rel="alternate" type="application/atom+xml" title="Formula 1 Statistics – changes" href={`${BASIS}/feed.xml`} />
    <meta property="og:site_name" content={MARKE} />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={kanonisch} />
    <meta property="og:image" content={vorschaubild} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Formula 1 Statistics – every season since 1950, in numbers" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    {ldText && <script type="application/ld+json" is:inline set:html={ldText} />}
    {/* Hell/dunkel vor dem ersten Zeichnen – Begründung in lib/modus.js. */}
    <script is:inline set:html={MODUS_SKRIPT} />
  </head>

  <body>
    {/*
      * Der erste Tabstopp jeder Seite: Wer mit der Tastatur kommt, müsste sonst
      * durch elf Punkte der Kopfleiste, bevor der Inhalt beginnt.
      */}
    <a class="sprung-link" href="#inhalt">Skip to content</a>

    <header class="kopf">
      <div class="wrap">
        <a class="logo" href={`${BASIS}/`} aria-label="Formula 1 Statistics – home">
          <span class="logo-zeichen" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="logo-text"><b>Formula 1</b><span>Statistics</span></span>
        </a>

        {/*
          * Die Navigation mit dem Werkzeugmenü darin – beide sind Teil
          * derselben Orientierung, und ein Vorleser findet sie so an einer
          * Stelle. Früher stand das Menü daneben, weil die Leiste waagerecht
          * scrollte und ein ausgeklapptes Feld darin beschnitten worden wäre.
          * Gescrollt wird nicht mehr: Wird es eng, übernimmt das Menü unten.
          *
          * <details> statt eines Skripts: Ein Ausklappmenü braucht kein
          * JavaScript, und ohne eines funktioniert es auch dann, wenn nichts lädt.
          */}
        <nav class="hauptnav" aria-label="Main navigation">
          <ul>
            {NAV.map((n) => (
              <li>
                <a href={`${BASIS}${n.pfad}`} aria-current={istAktiv(n.pfad) ? 'page' : undefined}>{n.label}</a>
              </li>
            ))}
            <li>
              <details class={`werkzeuge klappe${werkzeugAktiv ? ' aktiv' : ''}`}>
                <summary>Analysis<span class="sr-only"> tools</span></summary>
                <ul>
                  {WERKZEUGE.map((w) => (
                    <li>
                      <a href={`${BASIS}${w.pfad}`} aria-current={istAktiv(w.pfad) ? 'page' : undefined}>
                        <b>{w.label}</b>
                        <span>{w.dazu}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            </li>
          </ul>
        </nav>

        <Suche />

        <button class="modus" type="button" aria-label="Colour scheme: follow system" title="Colour scheme">
          <svg data-zeigt="system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>
          <svg data-zeigt="light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg data-zeigt="dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
        </button>

        {/*
          * Das Menü am schmalen Schirm. Vorher scrollte die Leiste dort
          * waagerecht mit verborgenem Balken: Bei 360 px waren Drivers, Teams
          * und Circuits außerhalb des Bildes, und nichts sagte, dass es sie gab.
          * Jetzt stehen alle Ziele auf einen Blick, jedes groß genug für einen
          * Finger.
          */}
        <details class="menue klappe">
          <summary>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            <span>Menu</span>
          </summary>
          <div class="menue-feld">
            <nav aria-label="Browse">
              <h2>Browse</h2>
              <ul>
                {NAV.map((n) => (
                  <li><a href={`${BASIS}${n.pfad}`} aria-current={istAktiv(n.pfad) ? 'page' : undefined}>{n.label}</a></li>
                ))}
              </ul>
            </nav>
            <nav aria-label="Analysis">
              <h2>Analysis</h2>
              <ul>
                {WERKZEUGE.map((w) => (
                  <li><a href={`${BASIS}${w.pfad}`} aria-current={istAktiv(w.pfad) ? 'page' : undefined}>{w.label}</a></li>
                ))}
              </ul>
            </nav>
          </div>
        </details>
      </div>
    </header>

    {/* tabindex="-1": Der Sprunglink setzt den Fokus hierher, nicht nur die Ansicht. */}
    <main id="inhalt" tabindex="-1">
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer>
      <div class="wrap">
        <div class="fuss-raster">
          <div>
            <a class="logo" href={`${BASIS}/`}>
              <span class="logo-zeichen" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="logo-text"><b>Formula 1</b><span>Statistics</span></span>
            </a>
            <p>
              Every number on this site is worked out from the race results themselves – not
              copied from a curated list.
            </p>
          </div>
          <nav aria-label="Browse (footer)">
            <h2>Browse</h2>
            <ul>
              {NAV.map((n) => <li><a href={`${BASIS}${n.pfad}`}>{n.label}</a></li>)}
            </ul>
          </nav>
          <nav aria-label="Analysis (footer)">
            <h2>Analysis</h2>
            <ul>
              {WERKZEUGE.map((w) => <li><a href={`${BASIS}${w.pfad}`}>{w.label}</a></li>)}
            </ul>
          </nav>
        </div>
        <p class="fuss-klein">
          Data from <a href="https://github.com/f1db/f1db">F1DB</a>
          {quelle.version && <> {quelle.version}</>}, Creative Commons BY 4.0
          {quelle.stand && <>, up to the {quelle.stand.jahr} {quelle.stand.grandPrixVoll} on {datum(quelle.stand.datum)}</>}.
          Also available as <a href={`${BASIS}/api/v1/`}>JSON</a> and as a{' '}
          <a href={`${BASIS}/feed.xml`}>feed of record changes</a>.
          Not an official Formula 1 site. F1, FORMULA ONE and Formula 1 are trade marks of
          Formula One Licensing BV. The earlier version of this site is still available{' '}
          <a href={`${BASIS}/classic/`}>here</a>.
        </p>
      </div>
    </footer>

    <script>
      /*
       * Der Umschalter: System → hell → dunkel → System. Die Wahl steht im
       * localStorage und wird vom Skript im Kopf gelesen, bevor die nächste
       * Seite gezeichnet wird.
       */
      const FOLGE = ['system', 'light', 'dark'] as const
      const TEXT = { system: 'follow system', light: 'light', dark: 'dark' }
      const knopf = document.querySelector<HTMLButtonElement>('.modus')
      const wurzel = document.documentElement

      const jetzt = () => (wurzel.dataset.theme as 'light' | 'dark' | undefined) ?? 'system'
      const beschrifte = () => knopf?.setAttribute('aria-label', `Colour scheme: ${TEXT[jetzt()]}`)

      beschrifte()
      knopf?.addEventListener('click', () => {
        const naechster = FOLGE[(FOLGE.indexOf(jetzt()) + 1) % FOLGE.length]
        if (naechster === 'system') delete wurzel.dataset.theme
        else wurzel.dataset.theme = naechster
        try {
          if (naechster === 'system') localStorage.removeItem('modus')
          else localStorage.setItem('modus', naechster)
        } catch {}
        beschrifte()
      })

      /*
       * Die Klappen der Kopfleiste schließen, wenn man daneben klickt – das tut
       * <details> nicht von sich aus. Escape schließt sie auch und gibt den
       * Fokus an ihren Knopf zurück, statt ihn im Nichts stehen zu lassen.
       * Es ist immer nur eine offen.
       */
      const klappen = [...document.querySelectorAll<HTMLDetailsElement>('.kopf .klappe')]
      document.addEventListener('pointerdown', (e) => {
        for (const k of klappen) if (k.open && !k.contains(e.target as Node)) k.open = false
      })
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return
        for (const k of klappen) {
          if (!k.open) continue
          k.open = false
          k.querySelector('summary')?.focus()
        }
      })
      for (const k of klappen) {
        k.addEventListener('toggle', () => {
          if (k.open) for (const andere of klappen) if (andere !== k) andere.open = false
        })
      }
    </script>
  </body>
</html>
