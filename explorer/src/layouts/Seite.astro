---
/**
 * Gerüst jeder Seite: Kopfleiste mit Navigation, Inhalt, Fußzeile.
 *
 * Die Navigation steht oben links und ist auf jeder Seite dieselbe – sie
 * gehört zur Website, nicht zum Inhalt. Welcher Punkt aktiv ist, entscheidet
 * der Pfad, nicht ein übergebener Wert: So kann keine Seite vergessen, sich
 * selbst zu markieren.
 */
import '../styles/theme.css'

interface Props {
  titel: string
  beschreibung: string
  /** Wird an den Seitentitel angehängt; ohne ihn steht nur der Name. */
  kopf?: string
}

const { titel, beschreibung } = Astro.props

const NAV = [
  { pfad: '/preview/', label: 'Preview' },
  { pfad: '/drivers/', label: 'Drivers' },
  { pfad: '/teams/', label: 'Teams' },
  { pfad: '/seasons/', label: 'Seasons' },
  { pfad: '/races/', label: 'Races' },
  { pfad: '/circuits/', label: 'Circuits' },
  { pfad: '/records/', label: 'Records' },
  { pfad: '/changes/', label: 'Changes' },
  { pfad: '/comparison/', label: 'Comparison' },
  { pfad: '/explorer/', label: 'Explorer' },
]

/*
 * Der Vorsatz, unter dem die Seite liegt: auf GitHub Pages "/F1-stats/", beim
 * Entwickeln "/". Jeder seiteninterne Verweis trägt ihn.
 */
const BASIS = import.meta.env.BASE_URL.replace(/\/$/, '')

/*
 * Astro.url.pathname enthält den Vorsatz, die Einträge in NAV nicht. Erst
 * abschneiden, dann vergleichen – sonst wäre unter /F1-stats/ nie ein Punkt
 * aktiv.
 */
const hier = Astro.url.pathname.slice(BASIS.length) || '/'
/** Aktiv ist auch die Übersicht, wenn man auf einer ihrer Unterseiten steht. */
const istAktiv = (pfad: string) => hier === pfad || hier.startsWith(pfad)
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Fremde Ziele erfahren die Herkunft, nicht die besuchte Unterseite. */}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" type="image/svg+xml" href={`${BASIS}/favicon.svg`} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <title>{titel}</title>
    <meta name="description" content={beschreibung} />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:type" content="website" />
  </head>

  <body>
    <header class="kopf">
      <div class="wrap">
        <a class="marke" href={`${BASIS}/`}>
          <b>Formula 1</b><span>Statistics</span>
        </a>
        <nav class="hauptnav" aria-label="Main navigation">
          {
            NAV.map((n) => (
              <a href={`${BASIS}${n.pfad}`} aria-current={istAktiv(n.pfad) ? 'page' : undefined}>
                {n.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer>
      <div class="wrap">
        Data from <a href="https://github.com/f1db/f1db">F1DB</a>, Creative Commons BY 4.0.
        Not an official Formula 1 site. F1, FORMULA ONE and Formula 1 are trade marks of
        Formula One Licensing BV.
        <br />
        The previous application is still available{' '}
        <a href={`${BASIS}/classic/`}>here</a>.
      </div>
    </footer>
  </body>
</html>
