---
/**
 * Gerüst jeder Seite: Kopfleiste mit Navigation, Inhalt, Fußzeile.
 *
 * Die Navigation steht oben links und ist auf jeder Seite dieselbe – sie
 * gehört zur Website, nicht zum Inhalt. Welcher Punkt aktiv ist, entscheidet
 * der Pfad, nicht ein übergebener Wert: So kann keine Seite vergessen, sich
 * selbst zu markieren.
 */
import '../styles/theme.css'
import Suche from '../components/Suche.jsx'

interface Props {
  titel: string
  beschreibung: string
  /** Wird an den Seitentitel angehängt; ohne ihn steht nur der Name. */
  kopf?: string
}

const { titel, beschreibung } = Astro.props

/*
 * Die Leiste zerfiel in zwei Arten von Punkten, und mit zwölf davon lief sie
 * über: Ab „Engines" waren „Compare" und „Explorer" bei 1280 px nicht mehr zu
 * sehen. Sie sind deshalb getrennt.
 *
 * NAV führt zu den Dingen selbst – Fahrer, Teams, Rennen. WERKZEUGE führt zu
 * dem, was man mit ihnen anstellt. Das ist keine Notlösung für zu wenig Platz,
 * sondern die Gliederung, die ohnehin bestand.
 */
const NAV = [
  { pfad: '/preview/', label: 'Preview' },
  { pfad: '/drivers/', label: 'Drivers' },
  { pfad: '/teams/', label: 'Teams' },
  { pfad: '/engines/', label: 'Engines' },
  { pfad: '/seasons/', label: 'Seasons' },
  { pfad: '/races/', label: 'Races' },
  { pfad: '/circuits/', label: 'Circuits' },
]

const WERKZEUGE = [
  { pfad: '/records/', label: 'Records', dazu: 'Every all-time mark, linked to its race' },
  { pfad: '/changes/', label: 'Changes', dazu: 'What has moved, and what is close' },
  { pfad: '/teammates/', label: 'Team-mates', dazu: 'Drivers rated against the same car' },
  { pfad: '/comparison/', label: 'Compare', dazu: 'Two careers side by side' },
  { pfad: '/explorer/', label: 'Explorer', dazu: 'Your own queries over every result' },
]

/*
 * Der Vorsatz, unter dem die Seite liegt: auf GitHub Pages "/F1-stats/", beim
 * Entwickeln "/". Jeder seiteninterne Verweis trägt ihn.
 */
const BASIS = import.meta.env.BASE_URL.replace(/\/$/, '')

/*
 * Astro.url.pathname enthält den Vorsatz, die Einträge in NAV nicht. Erst
 * abschneiden, dann vergleichen – sonst wäre unter /F1-stats/ nie ein Punkt
 * aktiv.
 */
const hier = Astro.url.pathname.slice(BASIS.length) || '/'
/** Aktiv ist auch die Übersicht, wenn man auf einer ihrer Unterseiten steht. */
const istAktiv = (pfad: string) => hier === pfad || hier.startsWith(pfad)
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Fremde Ziele erfahren die Herkunft, nicht die besuchte Unterseite. */}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" type="image/svg+xml" href={`${BASIS}/favicon.svg`} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <title>{titel}</title>
    <meta name="description" content={beschreibung} />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:type" content="website" />
  </head>

  <body>
    <header class="kopf">
      <div class="wrap">
        <a class="marke" href={`${BASIS}/`}>
          <b>Formula 1</b><span>Statistics</span>
        </a>
        <nav class="hauptnav" aria-label="Main navigation">
          {
            NAV.map((n) => (
              <a href={`${BASIS}${n.pfad}`} aria-current={istAktiv(n.pfad) ? 'page' : undefined}>
                {n.label}
              </a>
            ))
          }
        </nav>
        {/*
          * <details> statt eines Skripts: Ein Ausklappmenü braucht kein
          * JavaScript, und ohne eines funktioniert es auch dann, wenn nichts
          * lädt. `open` bleibt gesetzt, solange man auf einer der Seiten
          * darunter steht – sonst verschwände der aktive Punkt.
          */}
        <details class="werkzeuge" open={WERKZEUGE.some((w) => istAktiv(w.pfad))}>
          <summary aria-label="Analysis tools">Analysis</summary>
          <ul>
            {
              WERKZEUGE.map((w) => (
                <li>
                  <a
                    href={`${BASIS}${w.pfad}`}
                    aria-current={istAktiv(w.pfad) ? 'page' : undefined}
                  >
                    <b>{w.label}</b>
                    <span>{w.dazu}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
        {/*
          * Die Suche ist die einzige Insel im Gerüst, und sie lädt ihren Index
          * erst beim ersten Tastendruck. Ohne sie führte der Weg zu einem von
          * 917 Fahrern nur über eine Liste mit 860 Zeilen.
          */}
        <Suche client:idle />
      </div>
    </header>

    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer>
      <div class="wrap">
        Data from <a href="https://github.com/f1db/f1db">F1DB</a>, Creative Commons BY 4.0.
        Not an official Formula 1 site. F1, FORMULA ONE and Formula 1 are trade marks of
        Formula One Licensing BV.
        <br />
        The earlier version of this site is still available{' '}
        <a href={`${BASIS}/classic/`}>here</a>.
      </div>
    </footer>
  </body>
</html>
