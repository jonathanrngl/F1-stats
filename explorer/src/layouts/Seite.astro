---
/**
 * Gerüst jeder Seite: Kopfleiste mit Navigation, Inhalt, Fußzeile.
 *
 * Die Navigation steht oben links und ist auf jeder Seite dieselbe – sie
 * gehört zur Website, nicht zum Inhalt. Welcher Punkt aktiv ist, entscheidet
 * der Pfad, nicht ein übergebener Wert: So kann keine Seite vergessen, sich
 * selbst zu markieren.
 */
import '../styles/theme.css'
import Suche from '../components/Suche.jsx'
import { MODUS_SKRIPT } from '../lib/modus.js'

interface Props {
  titel: string
  beschreibung: string
  /** Wird an den Seitentitel angehängt; ohne ihn steht nur der Name. */
  kopf?: string
}

const { titel, beschreibung } = Astro.props

/*
 * Die Leiste zerfiel in zwei Arten von Punkten, und mit zwölf davon lief sie
 * über: Ab „Engines" waren „Compare" und „Explorer" bei 1280 px nicht mehr zu
 * sehen. Sie sind deshalb getrennt.
 *
 * NAV führt zu den Dingen selbst – Fahrer, Teams, Rennen. WERKZEUGE führt zu
 * dem, was man mit ihnen anstellt. Das ist keine Notlösung für zu wenig Platz,
 * sondern die Gliederung, die ohnehin bestand.
 */
const NAV = [
  { pfad: '/preview/', label: 'Next race' },
  { pfad: '/seasons/', label: 'Seasons' },
  { pfad: '/races/', label: 'Races' },
  { pfad: '/drivers/', label: 'Drivers' },
  { pfad: '/teams/', label: 'Teams' },
  { pfad: '/engines/', label: 'Engines' },
  { pfad: '/circuits/', label: 'Circuits' },
]

const WERKZEUGE = [
  { pfad: '/records/', label: 'Records', dazu: 'Every all-time mark, linked to its race' },
  { pfad: '/changes/', label: 'Changes', dazu: 'What has moved, and what is close' },
  { pfad: '/teammates/', label: 'Team-mates', dazu: 'Drivers rated against the same car' },
  { pfad: '/comparison/', label: 'Compare', dazu: 'Two careers side by side' },
  { pfad: '/explorer/', label: 'Explorer', dazu: 'Your own queries over every result' },
  { pfad: '/quiz/', label: 'Quiz', dazu: 'Test yourself, from easy to expert' },
]

/*
 * Der Vorsatz, unter dem die Seite liegt: auf GitHub Pages "/F1-stats/", beim
 * Entwickeln "/". Jeder seiteninterne Verweis trägt ihn.
 */
const BASIS = import.meta.env.BASE_URL.replace(/\/$/, '')

/*
 * Astro.url.pathname enthält den Vorsatz, die Einträge in NAV nicht. Erst
 * abschneiden, dann vergleichen – sonst wäre unter /F1-stats/ nie ein Punkt
 * aktiv.
 */
const hier = Astro.url.pathname.slice(BASIS.length) || '/'
/** Aktiv ist auch die Übersicht, wenn man auf einer ihrer Unterseiten steht. */
const istAktiv = (pfad: string) => hier === pfad || hier.startsWith(pfad)
const werkzeugAktiv = WERKZEUGE.some((w) => istAktiv(w.pfad))
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Fremde Ziele erfahren die Herkunft, nicht die besuchte Unterseite. */}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" type="image/svg+xml" href={`${BASIS}/favicon.svg`} />
    <meta name="theme-color" content="#111113" />
    <title>{titel}</title>
    <meta name="description" content={beschreibung} />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:type" content="website" />
    {/* Hell/dunkel vor dem ersten Zeichnen – Begründung in lib/modus.js. */}
    <script is:inline set:html={MODUS_SKRIPT} />
  </head>

  <body>
    <header class="kopf">
      <div class="wrap">
        <a class="logo" href={`${BASIS}/`} aria-label="Formula 1 Statistics – home">
          <span class="logo-zeichen" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="logo-text"><b>Formula 1</b><span>Statistics</span></span>
        </a>
        <nav class="hauptnav" aria-label="Main navigation">
          {
            NAV.map((n) => (
              <a href={`${BASIS}${n.pfad}`} aria-current={istAktiv(n.pfad) ? 'page' : undefined}>
                {n.label}
              </a>
            ))
          }
        </nav>
        {/*
          * <details> statt eines Skripts: Ein Ausklappmenü braucht kein
          * JavaScript, und ohne eines funktioniert es auch dann, wenn nichts
          * lädt. Anders als vorher bleibt es auf den Werkzeugseiten zu – offen
          * lag es über dem Seitenkopf. Welches Werkzeug gerade gilt, zeigt der
          * helle Reiter.
          */}
        <details class={`werkzeuge${werkzeugAktiv ? ' aktiv' : ''}`}>
          <summary aria-label="Analysis tools">Analysis</summary>
          <ul>
            {
              WERKZEUGE.map((w) => (
                <li>
                  <a
                    href={`${BASIS}${w.pfad}`}
                    aria-current={istAktiv(w.pfad) ? 'page' : undefined}
                  >
                    <b>{w.label}</b>
                    <span>{w.dazu}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
        {/*
          * Die Suche ist die einzige Insel im Gerüst, und sie lädt ihren Index
          * erst beim ersten Tastendruck. Ohne sie führte der Weg zu einem von
          * 917 Fahrern nur über eine Liste mit 860 Zeilen.
          */}
        <Suche client:idle />
        <button class="modus" type="button" aria-label="Colour scheme: follow system" title="Colour scheme">
          <svg data-zeigt="system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>
          <svg data-zeigt="light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg data-zeigt="dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
        </button>
      </div>
    </header>

    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer>
      <div class="wrap">
        <div class="fuss-raster">
          <div>
            <a class="logo" href={`${BASIS}/`}>
              <span class="logo-zeichen" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="logo-text"><b>Formula 1</b><span>Statistics</span></span>
            </a>
            <p>
              Every number on this site is worked out from the race results themselves – not
              copied from a curated list.
            </p>
          </div>
          <nav aria-label="Browse">
            <h2>Browse</h2>
            <ul>
              {NAV.map((n) => <li><a href={`${BASIS}${n.pfad}`}>{n.label}</a></li>)}
            </ul>
          </nav>
          <nav aria-label="Analysis">
            <h2>Analysis</h2>
            <ul>
              {WERKZEUGE.map((w) => <li><a href={`${BASIS}${w.pfad}`}>{w.label}</a></li>)}
            </ul>
          </nav>
        </div>
        <p class="fuss-klein">
          Data from <a href="https://github.com/f1db/f1db">F1DB</a>, Creative Commons BY 4.0.
          Not an official Formula 1 site. F1, FORMULA ONE and Formula 1 are trade marks of
          Formula One Licensing BV. The earlier version of this site is still available{' '}
          <a href={`${BASIS}/classic/`}>here</a>.
        </p>
      </div>
    </footer>

    <script>
      /*
       * Der Umschalter: System → hell → dunkel → System. Die Wahl steht im
       * localStorage und wird vom Skript im Kopf gelesen, bevor die nächste
       * Seite gezeichnet wird.
       */
      const FOLGE = ['system', 'light', 'dark'] as const
      const TEXT = { system: 'follow system', light: 'light', dark: 'dark' }
      const knopf = document.querySelector<HTMLButtonElement>('.modus')
      const wurzel = document.documentElement

      const jetzt = () => (wurzel.dataset.theme as 'light' | 'dark' | undefined) ?? 'system'
      const beschrifte = () => knopf?.setAttribute('aria-label', `Colour scheme: ${TEXT[jetzt()]}`)

      beschrifte()
      knopf?.addEventListener('click', () => {
        const naechster = FOLGE[(FOLGE.indexOf(jetzt()) + 1) % FOLGE.length]
        if (naechster === 'system') delete wurzel.dataset.theme
        else wurzel.dataset.theme = naechster
        try {
          if (naechster === 'system') localStorage.removeItem('modus')
          else localStorage.setItem('modus', naechster)
        } catch {}
        beschrifte()
      })

      /* Das Werkzeugmenü schließt, wenn man daneben klickt – <details> tut
         das von sich aus nicht. */
      const menue = document.querySelector<HTMLDetailsElement>('.werkzeuge')
      document.addEventListener('pointerdown', (e) => {
        if (menue?.open && !menue.contains(e.target as Node)) menue.open = false
      })
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menue?.open) menue.open = false
      })
    </script>
  </body>
</html>
