---
/**
 * „Follow“: ein Fahrer oder Team kommt auf die Startseite des Besuchers.
 *
 * Nur mit JavaScript sichtbar – ohne Skript gibt es nichts, wo es sich merken
 * ließe. Gespeichert wird in lib/folgen.js, im Browser und nirgends sonst.
 */
interface Props {
  art: 'f' | 't'
  id: string
  name: string
}

const { art, id, name } = Astro.props
---

<button
  type="button"
  class="knopf leise folgen nur-mit-js"
  data-folgen-art={art}
  data-folgen-id={id}
  aria-pressed="false"
  title={`Show ${name} on the home page`}
>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" /></svg>
  <span data-folgen-text>Follow</span>
</button>

<script>
  import { folgt, umschalten } from '../lib/folgen.js'

  for (const knopf of document.querySelectorAll<HTMLButtonElement>('[data-folgen-id]')) {
    const art = knopf.dataset.folgenArt as 'f' | 't'
    const id = knopf.dataset.folgenId!
    const text = knopf.querySelector('[data-folgen-text]')!
    const zeige = (an: boolean) => {
      knopf.setAttribute('aria-pressed', String(an))
      text.textContent = an ? 'Following' : 'Follow'
    }
    zeige(folgt(art, id))
    knopf.addEventListener('click', () => {
      const neu = umschalten(art, id)
      if (neu === null) {
        text.textContent = 'Could not save'
        return
      }
      zeige(neu)
    })
  }
</script>

<style>
  .folgen { display: inline-flex; align-items: center; gap: 0.4rem; }
  .folgen svg { width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linejoin: round; }
  .folgen[aria-pressed='true'] svg { fill: var(--accent); stroke: var(--accent); }
</style>
