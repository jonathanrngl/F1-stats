---
/**
 * WM-Punkteverlauf einer Saison als statisches SVG.
 *
 * Beim Bauen gezeichnet, nicht im Browser: Die Daten stehen fest, sobald die
 * Saison gefahren ist. Damit braucht die Seite kein JavaScript, und der
 * Verlauf steht auch in der Vorschau eines geteilten Links.
 *
 * Acht Fahrer bekommen eine eigene Farbe, alle weiteren laufen als graue
 * Sammelgruppe mit. Kategoriale Farben werden nie zyklisch weitergedreht – ab
 * Platz neun wäre keine weitere Farbe mehr sicher von den ersten acht zu
 * unterscheiden. Die Farbe hängt am Endstand, nicht am Rang im Moment: Sonst
 * wechselten die Linien mitten im Bild ihre Bedeutung.
 */
interface Fahrer {
  id: string
  name: string
  kuerzel: string | null
  /** Punktestand nach jeder Runde, `punkte[i]` gilt nach Runde i+1. */
  punkte: number[]
}

interface Props {
  fahrer: Fahrer[]
  runden: { runde: number; name: string }[]
  /** Streichresultate: Dann ist der WM-Stand nicht die Summe der Rennpunkte. */
  streichresultate?: boolean
}

import { zahl } from '../lib/format.js'
const { fahrer, runden, streichresultate = false } = Astro.props

const BENANNT = 8
const W = 900
const H = 420
const PAD = { oben: 16, rechts: 86, unten: 38, links: 46 }
const PLOT_B = W - PAD.links - PAD.rechts
const PLOT_H = H - PAD.oben - PAD.unten

const n = runden.length
const maxPunkte = Math.max(1, ...fahrer.flatMap((f) => f.punkte))

// Achsenschritte, die auf runde Zahlen fallen – 37er-Schritte liest niemand.
const SCHRITTE = [1, 2, 5, 10, 20, 25, 50, 100, 200, 250, 500]
const schritt = SCHRITTE.find((s) => s >= maxPunkte / 5) ?? 1000
const obergrenze = Math.ceil(maxPunkte / schritt) * schritt
const yWerte = []
for (let v = 0; v <= obergrenze; v += schritt) yWerte.push(v)

// Bei vielen Rennen nur jede k-te Runde beschriften, sonst kleben die Zahlen.
const jede = Math.ceil(n / 12)
const xWerte = runden.filter((r) => r.runde % jede === 0 || r.runde === n)

const x = (runde: number) => PAD.links + (runde / n) * PLOT_B
const y = (punkte: number) => PAD.oben + PLOT_H - (punkte / obergrenze) * PLOT_H

/** Runde 0 mit null Punkten als Startpunkt: Die Linien beginnen auf der Achse. */
const pfad = (punkte: number[]) =>
  [0, ...punkte]
    .map((p, i) => `${i === 0 ? 'M' : 'L'}${x(i).toFixed(1)},${y(p).toFixed(1)}`)
    .join(' ')

const benannt = fahrer.slice(0, BENANNT)
const rest = fahrer.slice(BENANNT)

/** Direktbeschriftung nur, wo sie sich nicht überlagert. */
const marken: { kuerzel: string; yPos: number; farbe: string }[] = []
benannt.slice(0, 5).forEach((f, i) => {
  const yPos = y(f.punkte.at(-1) ?? 0)
  if (marken.every((m) => Math.abs(m.yPos - yPos) > 13)) {
    marken.push({ kuerzel: f.kuerzel ?? f.name.slice(0, 3).toUpperCase(), yPos, farbe: `var(--s${i + 1})` })
  }
})

/* Vorsatz der Seite: auf GitHub Pages "/F1-stats", beim Entwickeln leer. */
const BASIS = import.meta.env.BASE_URL.replace(/\/$/, '')

---

<figure class="verlauf">
  <svg
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-label={`Points progression across ${n} races for ${fahrer.length} drivers. The full figures are in the standings table below.`}
  >
    {yWerte.map((v) => (
      <g>
        <line class="gitter" x1={PAD.links} x2={W - PAD.rechts} y1={y(v)} y2={y(v)} />
        <text class="achse" x={PAD.links - 8} y={y(v)} text-anchor="end" dominant-baseline="middle">
          {v}
        </text>
      </g>
    ))}

    <line class="achslinie" x1={PAD.links} x2={PAD.links} y1={PAD.oben} y2={y(0)} />
    <line class="achslinie" x1={PAD.links} x2={W - PAD.rechts} y1={y(0)} y2={y(0)} />

    {xWerte.map((r) => (
      <text class="achse" x={x(r.runde)} y={y(0) + 17} text-anchor="middle">{r.runde}</text>
    ))}
    <text class="achse" x={PAD.links + PLOT_B / 2} y={H - 4} text-anchor="middle">Races</text>

    {/* Sammelgruppe zuerst, damit die benannten Linien darüber liegen. */}
    {rest.map((f) => <path class="linie grau" d={pfad(f.punkte)} />)}
    {benannt.map((f, i) => <path class="linie" style={`stroke: var(--s${i + 1})`} d={pfad(f.punkte)} />)}
    {benannt.map((f, i) => (
      <circle class="punkt" cx={x(n)} cy={y(f.punkte.at(-1) ?? 0)} r="3.5" style={`fill: var(--s${i + 1})`} />
    ))}
    {marken.map((m) => (
      <text class="marke" x={x(n) + 10} y={m.yPos} dominant-baseline="middle" style={`fill: ${m.farbe}`}>
        {m.kuerzel}
      </text>
    ))}
  </svg>

  <ul class="legende">
    {benannt.map((f, i) => (
      <li>
        <span class="strich" style={`background: var(--s${i + 1})`}></span>
        <a href={`${BASIS}/drivers/${f.id}/`}>{f.name}</a>
        <b>{zahl(f.punkte.at(-1) ?? 0)}</b>
      </li>
    ))}
    {rest.length > 0 && (
      <li>
        <span class="strich" style="background: var(--s-rest)"></span>
        <span class="uebrige">{rest.length} further drivers</span>
      </li>
    )}
  </ul>

  <figcaption>
    Championship standings after each round.
    {streichresultate && (
      <>
        {' '}Not every result counted in this season: the chart shows the official championship
        standings, not the sum of the race points.
      </>
    )}
  </figcaption>
</figure>

<style>
  .verlauf {
    margin: 0;
    padding: 1rem 1rem 0.85rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0.6rem;
  }

  svg { display: block; width: 100%; height: auto; }

  .gitter { stroke: var(--grid); stroke-width: 1; shape-rendering: crispEdges; }
  .achslinie { stroke: var(--axis); stroke-width: 1; shape-rendering: crispEdges; }
  .achse { fill: var(--muted); font-size: 11px; font-variant-numeric: tabular-nums; }
  .linie { fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .linie.grau { stroke: var(--s-rest); stroke-width: 1.5; opacity: 0.5; }
  .punkt { stroke: var(--surface); stroke-width: 2; }
  .marke { font-size: 11.5px; font-weight: 650; }

  .legende {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    margin: 0.9rem 0 0;
    padding: 0.85rem 0 0;
    border-top: 1px solid var(--border);
    list-style: none;
  }

  .legende li { display: flex; align-items: center; gap: 0.45rem; font-size: 0.82rem; }
  .strich { width: 0.9rem; height: 2px; border-radius: 1px; flex: none; }
  .legende a { color: var(--ink-2); text-decoration: none; }
  .legende a:hover { color: var(--accent); }
  .legende b { color: var(--muted); font-weight: 500; font-variant-numeric: tabular-nums; }
  .uebrige { color: var(--muted); }

  figcaption {
    margin-top: 0.85rem;
    font-size: 0.78rem;
    color: var(--muted);
    text-wrap: pretty;
  }

  /* Am Telefon fällt die Direktbeschriftung weg – bei dieser Skalierung wäre
     sie ohnehin nicht zu lesen, und der Zeichenbereich gewinnt Platz. */
  @media (max-width: 40rem) {
    .marke { display: none; }
    .legende { display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem 0.75rem; }
    .legende a { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  }
</style>
