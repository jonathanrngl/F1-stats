---
/**
 * WM-Punkteverlauf einer Saison als statisches SVG.
 *
 * Beim Bauen gezeichnet, nicht im Browser: Die Daten stehen fest, sobald die
 * Saison gefahren ist. Damit braucht die Seite kein JavaScript, und der
 * Verlauf steht auch in der Vorschau eines geteilten Links.
 *
 * Acht Fahrer bekommen eine eigene Farbe, alle weiteren laufen als graue
 * Sammelgruppe mit. Kategoriale Farben werden nie zyklisch weitergedreht – ab
 * Platz neun wäre keine weitere Farbe mehr sicher von den ersten acht zu
 * unterscheiden. Die Farbe hängt am Endstand, nicht am Rang im Moment: Sonst
 * wechselten die Linien mitten im Bild ihre Bedeutung.
 *
 * Zwei Zeichnungen derselben Daten: breit für den Schreibtisch, schmal fürs
 * Telefon. Vorher gab es eine mit fester Breite 900, und am Telefon schrumpfte
 * die Achsenschrift auf dreieinhalb Pixel. Ein SVG skaliert Text mit – es
 * hilft nur, für die schmale Breite eigens zu zeichnen. Darunter stehen alle
 * Werte als Tabelle: Im Bild gab es sie nur beim Überfahren mit der Maus.
 */
interface Fahrer {
  id: string
  name: string
  kuerzel: string | null
  /** Punktestand nach jeder Runde, `punkte[i]` gilt nach Runde i+1. */
  punkte: number[]
}

interface Props {
  fahrer: Fahrer[]
  runden: { runde: number; name: string }[]
  /** Streichresultate: Dann ist der WM-Stand nicht die Summe der Rennpunkte. */
  streichresultate?: boolean
  /** Fahrer oder Teams – bestimmt Verweise und Beschriftung. */
  art?: 'fahrer' | 'team'
}

import { ein, zahl } from '../lib/format.js'
const { fahrer, runden, streichresultate = false, art = 'fahrer' } = Astro.props
const WER = art === 'team' ? { mehrzahl: 'teams', weg: 'teams', kopf: 'Team', wertung: "Constructors' championship" } : { mehrzahl: 'drivers', weg: 'drivers', kopf: 'Driver', wertung: 'Championship' }

const BENANNT = 8
const n = runden.length
const maxPunkte = Math.max(1, ...fahrer.flatMap((f) => f.punkte))

// Achsenschritte, die auf runde Zahlen fallen – 37er-Schritte liest niemand.
const SCHRITTE = [1, 2, 5, 10, 20, 25, 50, 100, 200, 250, 500]
const schritt = SCHRITTE.find((s) => s >= maxPunkte / 5) ?? 1000
const obergrenze = Math.ceil(maxPunkte / schritt) * schritt
const yWerte = []
for (let v = 0; v <= obergrenze; v += schritt) yWerte.push(v)

const benannt = fahrer.slice(0, BENANNT)
const rest = fahrer.slice(BENANNT)

/** Eine Zeichnung für eine Breite. Die schmale verzichtet auf Namen am Linienende. */
function zeichnung({ W, H, rechts, rundenJe }) {
  const PAD = { oben: 16, rechts, unten: 38, links: 42 }
  const PLOT_B = W - PAD.links - PAD.rechts
  const PLOT_H = H - PAD.oben - PAD.unten
  const x = (runde) => PAD.links + (runde / n) * PLOT_B
  const y = (punkte) => PAD.oben + PLOT_H - (punkte / obergrenze) * PLOT_H
  // Bei vielen Rennen nur jede k-te Runde beschriften, sonst kleben die Zahlen.
  const jede = Math.ceil(n / rundenJe)
  const xWerte = runden.filter((r) => r.runde % jede === 0 || r.runde === n)
  /** Runde 0 mit null Punkten als Startpunkt: Die Linien beginnen auf der Achse. */
  const pfad = (punkte) =>
    [0, ...punkte].map((p, i) => `${i === 0 ? 'M' : 'L'}${x(i).toFixed(1)},${y(p).toFixed(1)}`).join(' ')
  /** Direktbeschriftung nur, wo sie sich nicht überlagert. */
  const marken = []
  if (rechts > 40) {
    benannt.slice(0, 5).forEach((f, i) => {
      const yPos = y(f.punkte.at(-1) ?? 0)
      if (marken.every((m) => Math.abs(m.yPos - yPos) > 13)) {
        marken.push({ kuerzel: f.kuerzel ?? f.name.slice(0, 3).toUpperCase(), yPos, farbe: `f${i + 1}` })
      }
    })
  }
  return { W, H, PAD, PLOT_B, x, y, xWerte, pfad, marken }
}

const FASSUNGEN = [
  { klasse: 'breit', ...zeichnung({ W: 900, H: 420, rechts: 86, rundenJe: 12 }) },
  { klasse: 'schmal', ...zeichnung({ W: 380, H: 300, rechts: 14, rundenJe: 5 }) },
]

/* Vorsatz der Seite: auf GitHub Pages "/F1-stats", beim Entwickeln leer. */
const BASIS = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<figure class="verlauf">
  {FASSUNGEN.map((z) => (
    <svg
      class={z.klasse}
      viewBox={`0 0 ${z.W} ${z.H}`}
      role="img"
      aria-label={`Points progression across ${n} races for ${fahrer.length} ${WER.mehrzahl}. Every value is in the table below the chart.`}
    >
      {yWerte.map((v) => (
        <g>
          <line class="gitter" x1={z.PAD.links} x2={z.W - z.PAD.rechts} y1={z.y(v)} y2={z.y(v)} />
          <text class="achse" x={z.PAD.links - 8} y={z.y(v)} text-anchor="end" dominant-baseline="middle">{v}</text>
        </g>
      ))}

      <line class="achslinie" x1={z.PAD.links} x2={z.PAD.links} y1={z.PAD.oben} y2={z.y(0)} />
      <line class="achslinie" x1={z.PAD.links} x2={z.W - z.PAD.rechts} y1={z.y(0)} y2={z.y(0)} />

      {z.xWerte.map((r) => (
        <text class="achse" x={z.x(r.runde)} y={z.y(0) + 17} text-anchor="middle">{r.runde}</text>
      ))}
      <text class="achse" x={z.PAD.links + z.PLOT_B / 2} y={z.H - 4} text-anchor="middle">Races</text>

      {/* Sammelgruppe zuerst, damit die benannten Linien darüber liegen. */}
      {rest.map((f) => <path class="linie grau" d={z.pfad(f.punkte)} />)}
      {benannt.map((f, i) => <path class={`linie f${i + 1}`} d={z.pfad(f.punkte)} />)}
      {benannt.map((f, i) => (
        <circle class={`punkt f${i + 1}`} cx={z.x(n)} cy={z.y(f.punkte.at(-1) ?? 0)} r="4" />
      ))}
      {z.marken.map((m) => (
        <text class={`marke ${m.farbe}`} x={z.x(n) + 10} y={m.yPos} dominant-baseline="middle">{m.kuerzel}</text>
      ))}
    </svg>
  ))}

  <ul class="legende">
    {benannt.map((f, i) => (
      <li>
        <span class={`strich f${i + 1}`}></span>
        <a href={`${BASIS}/${WER.weg}/${f.id}/`}>{f.name}</a>
        <b>{zahl(f.punkte.at(-1) ?? 0)}</b>
      </li>
    ))}
    {rest.length > 0 && (
      <li>
        <span class="strich rest"></span>
        <span class="uebrige">{rest.length} further {WER.mehrzahl}</span>
      </li>
    )}
  </ul>

  <figcaption>
    {WER.wertung} standings after each round.
    {streichresultate && (
      <>
        {' '}Not every result counted in this season: the chart shows the official championship
        standings, not the sum of the race points.
      </>
    )}
  </figcaption>

  <details class="als-tabelle">
    <summary>Show every value as a table</summary>
    <div class="tabelle">
      <table>
        <caption class="sr-only">Championship points after each round</caption>
        <thead>
          <tr>
            <th scope="col">{WER.kopf}</th>
            {runden.map((r) => <th class="num" scope="col"><abbr title={r.name}>{r.runde}</abbr></th>)}
          </tr>
        </thead>
        <tbody>
          {fahrer.map((f) => (
            <tr>
              <th scope="row"><a class="zeile" href={`${BASIS}/${WER.weg}/${f.id}/`}>{f.name}</a></th>
              {f.punkte.map((p) => <td class="num">{ein(p)}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</figure>

<style>
  .verlauf {
    margin: 0;
    padding: 1rem 1rem 0.85rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-s);
  }

  svg { display: block; width: 100%; height: auto; }
  svg.schmal { display: none; }

  @media (max-width: 40rem) {
    svg.breit { display: none; }
    svg.schmal { display: block; }
  }

  .gitter { stroke: var(--grid); stroke-width: 1; shape-rendering: crispEdges; }
  .achslinie { stroke: var(--axis); stroke-width: 1; shape-rendering: crispEdges; }
  .achse { fill: var(--muted); font-size: 11px; font-variant-numeric: tabular-nums; }
  /*
   * Die Serienfarbe kommt über eine Klasse, nicht über ein style-Attribut: Die
   * Inhaltsrichtlinie erlaubt keine Inline-Stile, und im Browser blieben die
   * Linien sonst farblos – das Diagramm stand in der veröffentlichten Fassung
   * leer da, nur im Entwicklungsserver ohne Richtlinie war es zu sehen.
   */
  .f1 { --farbe: var(--s1); }
  .f2 { --farbe: var(--s2); }
  .f3 { --farbe: var(--s3); }
  .f4 { --farbe: var(--s4); }
  .f5 { --farbe: var(--s5); }
  .f6 { --farbe: var(--s6); }
  .f7 { --farbe: var(--s7); }
  .f8 { --farbe: var(--s8); }
  .rest { --farbe: var(--s-rest); }

  .linie { fill: none; stroke: var(--farbe); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .linie.grau { stroke: var(--s-rest); stroke-width: 1.5; opacity: 0.55; }
  .punkt { fill: var(--farbe); stroke: var(--surface); stroke-width: 2; }
  /* Die Beschriftung trägt die Tintenfarbe, nicht die Serienfarbe – Gelb auf Weiß liest niemand. */
  .marke { fill: var(--ink-2); font-size: 11.5px; font-weight: 700; }
  .strich { background: var(--farbe); }

  .legende {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    margin: 0.9rem 0 0;
    padding: 0.85rem 0 0;
    border-top: 1px solid var(--border);
    list-style: none;
  }

  .legende li { display: flex; align-items: center; gap: 0.45rem; font-size: 0.84rem; }
  .strich { width: 0.9rem; height: 3px; border-radius: 1px; flex: none; }
  .legende a { color: var(--ink-2); text-decoration: none; }
  .legende a:hover { color: var(--accent); text-decoration: underline; }
  .legende b { color: var(--muted); font-weight: 500; font-variant-numeric: tabular-nums; }
  .uebrige { color: var(--muted); }

  figcaption {
    margin-top: 0.85rem;
    font-size: 0.8rem;
    color: var(--muted);
    text-wrap: pretty;
  }

  .als-tabelle { margin-top: 0.75rem; }
  .als-tabelle summary { cursor: pointer; min-height: 2.25rem; font-size: 0.86rem; font-weight: 600; color: var(--ink); }
  .als-tabelle .tabelle { margin-top: 0.5rem; box-shadow: none; }
  .als-tabelle abbr { text-decoration: none; }

  @media (max-width: 40rem) {
    .legende { display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem 0.75rem; }
    .legende a { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  }
</style>
